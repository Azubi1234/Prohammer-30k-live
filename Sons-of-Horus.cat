        <profile name="Justaerin Terminator" typeId="prof-model" typeName="Model" hidden="false" id="live-r2-r41-unit-xvi-4-ezekyle-abaddon-first-captain-retinue-0-r41-unit-xvi-0-justaerin-terminator-squad-profile-0">
