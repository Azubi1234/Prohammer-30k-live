      <selectionEntryGroups>
        <selectionEntryGroup name="Options" hidden="false" id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-options" collective="false" import="true">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Chainfist" hidden="false" id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-opt-0-chainfist">
              <constraints>
                <constraint id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-opt-0-chainfist-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <rules>
                <rule name="Option restriction" id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-opt-0-context" hidden="true">
                  <description>• Any model equipped with a Power fist may replace it with:</description>
                </rule>
              </rules>
            </selectionEntry>
