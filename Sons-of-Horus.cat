              <costs>
                <cost name="Points" typeId="pts" value="30" id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-r57-veteran-unit-iw-servo-pts" />
              </costs>
              <rules>
                <rule id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-r57-veteran-unit-iw-servo-rule" name="Servo-Arm" hidden="false">
                  <description>Follows the normal Servo-Arm rules in the Legiones Astartes Army List. A model equipped with a Jump Pack may not purchase a Servo-Arm.</description>
