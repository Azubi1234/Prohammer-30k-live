                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="live-r2-r41-unit-xvi-5-horus-aximand-little-horus-retinue-0-hq-centurion-ret-command-vets" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
