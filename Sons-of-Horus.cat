        <selectionEntryGroup id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-transport" name="Dedicated Transport" hidden="false"><constraints><constraint id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-transport-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><entryLinks><entryLink id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-dreadclaw" name="Dreadclaw Drop Pod" hidden="false" type="selectionEntry" targetId="transport-dreadclaw" import="true"><modifiers><modifier id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-dreadclaw-r42-cov-hide" type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xviii" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xviii-0-the-covenant-of-fire" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier></modifiers><constraints><constraint id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-dreadclaw-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink></entryLinks><rules><rule id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-transport-rule" name="Dedicated Transport" hidden="false"><description>The squad may select a Land Raider, Dreadclaw Drop Pod or Spartan Assault Tank where Transport Capacity permits. The Dreadclaw is selectable here; use the normal Legion vehicle entry for the appropriate Land Raider or Spartan pattern.</description></rule></rules></selectionEntryGroup><selectionEntryGroup id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessings" name="Blessings of the Four" hidden="true"><constraints><constraint id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessings-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><modifiers><modifier id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessings-show" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r41-unit-xvi-13-xvi-horus-ascended-the-warmaster" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessings-show-r62-fixed-21303ce0ae02" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r41-unit-xvi-13-xvi-horus-ascended-the-warmaster" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shat-const-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessings-show-r62-fixed-6506dab94688" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r41-unit-xvi-13-xvi-horus-ascended-the-warmaster" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shat-const-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><selectionEntries><selectionEntry id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-khorne" name="Blessing of Khorne" type="upgrade" hidden="false" import="true"><constraints><constraint id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-khorne-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-khorne-scale" type="increment" field="pts" value="5"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-khorne-rule" name="Blessing of Khorne" hidden="false"><description>All models gain +1 Attack.</description></rule></rules></selectionEntry><selectionEntry id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-slaanesh" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><constraints><constraint id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-slaanesh-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-slaanesh-scale" type="increment" field="pts" value="4"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-slaanesh-rule" name="Blessing of Slaanesh" hidden="false"><description>All models gain +1 Initiative.</description></rule></rules></selectionEntry><selectionEntry id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-nurgle" name="Blessing of Nurgle" type="upgrade" hidden="false" import="true"><constraints><constraint id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-nurgle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-nurgle-scale" type="increment" field="pts" value="7"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-nurgle-rule" name="Blessing of Nurgle" hidden="false"><description>All models gain +1 Toughness and Slow and Purposeful. Not available to Bikes, Jetbikes or Jump Infantry.

Slow and Purposeful: Relentless and always moves as if in Difficult Terrain.</description></rule></rules></selectionEntry><selectionEntry id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-tzeentch" name="Blessing of Tzeentch" type="upgrade" hidden="false" import="true"><constraints><constraint id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-tzeentch-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-tzeentch-scale" type="increment" field="pts" value="8"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-r32-blessing-tzeentch-rule" name="Blessing of Tzeentch" hidden="false"><description>All models gain a 5+ Invulnerable Save, or improve an existing Invulnerable Save by one step to a maximum of 4+.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
