            <selectionEntry type="upgrade" import="true" name="Pair of Lightning Claws" hidden="false" id="r41-unit-xvi-13-xvi-horus-ascended-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-opt-5-pair-of-lightning-claws">
              <constraints>
                <constraint id="r41-unit-xvi-13-xvi-horus-ascended-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-opt-5-pair-of-lightning-claws-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
