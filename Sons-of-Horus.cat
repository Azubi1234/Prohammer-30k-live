      <profiles>
        <profile name="Maloghurst" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xvi-7-maloghurst-the-twisted-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
