d Slow and Purposeful. Not available while mounted on a Bike/Jetbike or equipped with a Jump Pack.</description></rule></rules></selectionEntry><selectionEntry id="r41-unit-xvi-4-ezekyle-abaddon-first-captain-r32-blessing-tzeentch" name="Blessing of Tzeentch" type="upgrade" hidden="false" import="true"><constraints><constraint id="r41-unit-xvi-4-ezekyle-abaddon-first-captain-r32-blessing-tzeentch-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="25" /></costs><rules><rule id="r41-unit-xvi-4-ezekyle-abaddon-first-captain-r32-blessing-tzeentch-rule" name="Blessing of Tzeentch" hidden="false"><description>Gain a 5+ Invulnerable Save, or improve an existing Invulnerable Save by one step to a maximum of 4+.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r32-abaddon-warlord-group" name="Warlord" hidden="false"><constraints><constraint id="r32-abaddon-warlord-group-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="r32-abaddon-is-warlord" name="Abaddon is the Warlord" type="upgrade" hidden="false" import="true"><constraints><constraint id="r32-abaddon-is-warlord-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><rules><rule id="r32-abaddon-is-warlord-rule" name="First Captain" hidden="false"><description>Select this only if Abaddon is the army Warlord. This unlocks his additional Justaerin allowance.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry>
