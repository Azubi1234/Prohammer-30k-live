Slow and Purposeful: Relentless and always moves as if in Difficult Terrain.</description></rule></rules></selectionEntry><selectionEntry id="live-r2-r41-unit-xvi-5-horus-aximand-little-horus-retinue-1-r41-unit-xvi-2-chieftain-squad-r32-blessing-tzeentch" name="Blessing of Tzeentch" type="upgrade" hidden="false" import="true"><constraints><constraint id="live-r2-r41-unit-xvi-5-horus-aximand-little-horus-retinue-1-r41-unit-xvi-2-chieftain-squad-r32-blessing-tzeentch-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="live-r2-r41-unit-xvi-5-horus-aximand-little-horus-retinue-1-r41-unit-xvi-2-chieftain-squad-r32-blessing-tzeentch-scale" type="increment" field="pts" value="8"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="live-r2-r41-unit-xvi-5-horus-aximand-little-horus-retinue-1-r41-unit-xvi-2-chieftain-squad-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="live-r2-r41-unit-xvi-5-horus-aximand-little-horus-retinue-1-r41-unit-xvi-2-chieftain-squad-r32-blessing-tzeentch-rule" name="Blessing of Tzeentch" hidden="false"><description>All models gain a 5+ Invulnerable Save, or improve an existing Invulnerable Save by one step to a maximum of 4+.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
