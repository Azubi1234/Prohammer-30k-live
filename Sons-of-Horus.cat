      <profiles>
        <profile name="Justaerin Terminator" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xvi-12-xvi-horus-lupercal-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-profile-0">
