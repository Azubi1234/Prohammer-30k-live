            <selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="false" id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-veteran-unit">
      <infoLinks><infoLink id="r36-link-0a2b19e4fea1" name="Veteran Tactics" hidden="false" targetId="r36-exact-veteran-tactics-f7215db" type="rule" /></infoLinks><rules>
        <rule name="Standard Wargear" id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-veteran-standard" hidden="false">
          <description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</description>
        </rule>
        <rule name="Legiones Astartes" id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-veteran-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Dedicated Transport" id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-veteran-transport-rule" hidden="false">
          <description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Veterans" hidden="false" id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-veteran-included" defaultAmount="4">
