    <selectionEntry type="unit" name="Legion Terminator Command Squad" id="live-r2-r41-unit-xvi-4-ezekyle-abaddon-first-captain-retinue-1-hq-praetor-ret-termcommand" hidden="false" import="true">
              <constraints>
                <constraint id="live-r2-r41-unit-xvi-4-ezekyle-abaddon-first-captain-retinue-1-hq-praetor-ret-termcommand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
