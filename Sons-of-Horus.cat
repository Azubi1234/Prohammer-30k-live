-unit-xvi-0-justaerin-terminator-squad-opt-7-reaper-autocannon" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier><modifier id="r41-unit-xvi-13-xvi-horus-ascended-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-opt-9-banestrike-ammunition-discount--opt-8-multi-melta" type="increment" field="pts" value="-2"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r41-unit-xvi-13-xvi-horus-ascended-the-warmaster-r32-ret-just-r41-unit-xvi-0-justaerin-terminator-squad-opt-8-multi-melta" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers></selectionEntry>
