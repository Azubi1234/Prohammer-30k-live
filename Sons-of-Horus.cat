                <selectionEntry id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-0-r71-nl-gen-10-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="0" />
                  </costs>
                  <constraints>
