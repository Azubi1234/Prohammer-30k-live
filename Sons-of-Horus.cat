      <profiles>
        <profile name="Justaerin Terminator" typeId="prof-model" typeName="Model" hidden="false" id="r32-abaddon-extra-justaerin-r41-unit-xvi-0-justaerin-terminator-squad-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
