      <selectionEntryGroup id="live-r2-r41-unit-xvi-8-tybalt-marr-the-either-retinue" name="Retinue (does not occupy a separate FOC slot)" hidden="false" collective="false" import="true"><constraints><constraint id="live-r2-r41-unit-xvi-8-tybalt-marr-the-either-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="false" id="live-r2-r41-unit-xvi-8-tybalt-marr-the-either-retinue-0-veteran-unit">
      <infoLinks><infoLink id="r36-link-9fbd3ba96760" name="Veteran Tactics" hidden="false" targetId="r36-exact-veteran-tactics-f7215db" type="rule" /></infoLinks><rules>
        <rule name="Standard Wargear" id="live-r2-r41-unit-xvi-8-tybalt-marr-the-either-retinue-0-veteran-standard" hidden="false">
          <description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</description>
        </rule>
        <rule name="Legiones Astartes" id="live-r2-r41-unit-xvi-8-tybalt-marr-the-either-retinue-0-veteran-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Dedicated Transport" id="live-r2-r41-unit-xvi-8-tybalt-marr-the-either-retinue-0-veteran-transport-rule" hidden="false">
          <description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</description>
        </rule>
      </rules>
