        <selectionEntryGroup id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-r57-veteran-unit-iw" name="Iron Warriors Armoury" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-r57-veteran-unit-iw-shrapnel" name="Shrapnel Bolts" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-r57-veteran-unit-iw-shrapnel-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-r57-veteran-unit-iw-shrapnel-pts" />
              </costs>
              <rules>
                <rule id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-r57-veteran-unit-iw-shrapnel-rule" name="Shrapnel Bolts" hidden="false">
                  <description>Bolt Pistols, Bolters, Combi-Bolters, Storm Bolters, Heavy Bolters, Twin-linked Bolters and bolter components of Combi-Weapons carried by models in this unit gain Pinning. May not be combined with Special Issue Ammunition, Hellfire Rounds or another special ammunition type.

Pinning: Unsaved Wounds caused by this weapon force the unit to take a Pinning Test.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-r57-veteran-unit-iw-servo" name="Servo-Arm" type="upgrade" hidden="false" import="true">
