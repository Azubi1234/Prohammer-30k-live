                      </repeats>
                    </modifier>
                    <modifier id="r6-guilliman-ret-0-r71-nl-gen-9-stealth-cost-1" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r6-guilliman-ret-0-hq-praetor-ret-honour-base" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
