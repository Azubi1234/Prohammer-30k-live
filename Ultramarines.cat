                    <selectionEntry type="upgrade" name="Psychic Maelstrom" id="r7-prayto-r29-lib-power-27" hidden="false" import="true">
                      <constraints>
                        <constraint id="r7-prayto-r29-lib-power-27-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <profiles>
                        <profile name="Psychic Maelstrom" id="r7-prayto-r29-lib-power-27-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">12”</characteristic>
                            <characteristic name="S" typeId="ranged-s">10</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Assault 1, Barrage, Large Blast</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Psychic Maelstrom" id="r7-prayto-r29-lib-power-27-rule" hidden="false">
                          <description>Witchfire. Range 12”, S10 AP1 Assault 1, Barrage, Large Blast.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        </modifiers>
                      <categoryLinks>
                        <categoryLink id="r7-prayto-r80-ih-consul-cat-70" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Psychic Shriek" id="r7-prayto-r29-lib-power-28" hidden="false" import="true">
                      <constraints>
                        <constraint id="r7-prayto-r29-lib-power-28-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Psychic Shriek" id="r7-prayto-r29-lib-power-28-rule" hidden="false">
                          <description>Witchfire — range 18”. Roll 3D6 and subtract target Leadership; target suffers Wounds equal to the result with no Armour or Cover Saves.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        </modifiers>
                      <categoryLinks>
                        <categoryLink id="r7-prayto-r80-ih-consul-cat-71" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Dominate" id="r7-prayto-r29-lib-power-29" hidden="false" import="true">
                      <constraints>
                        <constraint id="r7-prayto-r29-lib-power-29-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Dominate" id="r7-prayto-r29-lib-power-29-rule" hidden="false">
                          <description>Malediction — enemy unit within 24”. Target must pass a Leadership test whenever it attempts to move, Advance, shoot, charge or use a psychic power.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        </modifiers>
                      <categoryLinks>
                        <categoryLink id="r7-prayto-r80-ih-consul-cat-72" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Mental Fortitude" id="r7-prayto-r29-lib-power-30" hidden="false" import="true">
                      <constraints>
                        <constraint id="r7-prayto-r29-lib-power-30-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Mental Fortitude" id="r7-prayto-r29-lib-power-30-rule" hidden="false">
                          <description>Blessing — friendly unit within 24”. If Falling Back, immediately Regroups; target gains Fearless.

Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        </modifiers>
                      <categoryLinks>
                        <categoryLink id="r7-prayto-r80-ih-consul-cat-73" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Terrify" id="r7-prayto-r29-lib-power-31" hidden="false" import="true">
                      <constraints>
                        <constraint id="r7-prayto-r29-lib-power-31-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Terrify" id="r7-prayto-r29-lib-power-31-rule" hidden="false">
                          <description>Malediction — enemy unit within 24”. -1 Leadership; treats opposing units as causing Fear; must take a Casualty Test at end of turn.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        </modifiers>
                      <categoryLinks>
                        <categoryLink id="r7-prayto-r80-ih-consul-cat-74" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Hallucination" id="r7-prayto-r29-lib-power-32" hidden="false" import="true">
                      <constraints>
                        <constraint id="r7-prayto-r29-lib-power-32-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Hallucination" id="r7-prayto-r29-lib-power-32-rule" hidden="false">
                          <description>Malediction — enemy unit within 24”. Roll a D6 and apply the ProHammer Hallucination result.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        </modifiers>
                      <categoryLinks>
                        <categoryLink id="r7-prayto-r80-ih-consul-cat-75" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Invisibility" id="r7-prayto-r29-lib-power-33" hidden="false" import="true">
                      <constraints>
                        <constraint id="r7-prayto-r29-lib-power-33-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Invisibility" id="r7-prayto-r29-lib-power-33-rule" hidden="false">
                          <description>Blessing — friendly unit within 24”. Opposing units suffer -1 To Hit with ranged and melee attacks against the target.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        </modifiers>
                      <categoryLinks>
                        <categoryLink id="r7-prayto-r80-ih-consul-cat-76" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Shrouding" id="r7-prayto-r29-lib-power-34" hidden="false" import="true">
                      <constraints>
                        <constraint id="r7-prayto-r29-lib-power-34-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Shrouding" id="r7-prayto-r29-lib-power-34-rule" hidden="false">
                          <description>Blessing — targets Psyker. All friendly models within 6” gain Shrouded.

Shrouded: Adds +2 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 5+ Cover Save. Does not stack with Stealth.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        </modifiers>
                      <categoryLinks>
                        <categoryLink id="r7-prayto-r80-ih-consul-cat-77" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                  </selectionEntries>
                  <modifiers>
                    <modifier type="set" value="2" field="r29-lib-power-min">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-consul-librarian-epistolary" shared="true" includeChildSelections="true" />
                      </conditions>
                    </modifier>
                    <modifier type="set" value="2" field="r29-lib-power-max">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-consul-librarian-epistolary" shared="true" includeChildSelections="true" />
                      </conditions>
                    </modifier>
                  </modifiers>
