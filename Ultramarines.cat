      <selectionEntryGroup id="live-r2-r41-unit-xiii-8-titus-prayto-retinue" name="Retinue — choose up to one (no separate FOC slot)" hidden="false" collective="false" import="true"><constraints><constraint id="live-r2-r41-unit-xiii-8-titus-prayto-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="unit" name="Legion Command Squad" id="live-r2-r41-unit-xiii-8-titus-prayto-retinue-0-hq-centurion-ret-command" hidden="false" import="true">
              <constraints>
                <constraint id="live-r2-r41-unit-xiii-8-titus-prayto-retinue-0-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="90" />
