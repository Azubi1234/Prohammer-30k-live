      <selectionEntryGroup id="live-r2-r41-unit-xiii-4-marius-gage-first-master-retinue" name="Retinue — choose up to one (no separate FOC slot)" hidden="false" collective="false" import="true"><constraints><constraint id="live-r2-r41-unit-xiii-4-marius-gage-first-master-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="unit" name="Legion Command Squad" id="live-r2-r41-unit-xiii-4-marius-gage-first-master-retinue-0-hq-centurion-ret-command" hidden="false" import="true">
              <constraints>
