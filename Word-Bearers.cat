              <constraints>
                <constraint id="r37-wb-lorgar-legion-honour-guard-squad-hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              <constraint id="r37-wb-lorgar-legion-honour-guard-squad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
