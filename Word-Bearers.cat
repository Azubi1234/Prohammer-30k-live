    <selectionEntry type="unit" import="true" name="Ashen Circle" hidden="true" id="r41-unit-xvii-2-ashen-circle">
      <rules><rule id="r37-wb-ashen-axe-rule" name="Axe-rake" hidden="false"><description>A close-combat weapon. Attacks are resolved at +1 Strength. If an enemy Retreats from a close combat involving one or more Axe-rakes, reduce its Retreat distance by 1", to a minimum of 1".</description></rule><rule id="r37-wb-ashen-wg" name="Wargear" hidden="false"><description>Hardened Power Armour, Jump Pack, Hand Flamer, Axe-rake, Frag Grenades.</description></rule></rules><infoLinks><infoLink id="r41-unit-xvii-2-ashen-circle-wb-leg" name="Legiones Astartes (Word Bearers)" targetId="r37-wb-rule-legiones-astartes-word-bearers" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-2-ashen-circle-wb-atsknf" name="And They Shall Know No Fear" targetId="r36-shared-and-they-shall-know-no-fear-c9d3c20" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-2-ashen-circle-wb-fan" name="Fanatical Devotion" targetId="r37-wb-rule-fanatical-devotion" type="rule" hidden="false" /><infoLink id="r37-wb-ashen-hard" name="Hardened Armour" targetId="r37-wb-rule-hardened-armour" type="rule" hidden="false" /><infoLink id="r37-wb-ashen-bitter" name="Bitter Duty" targetId="r37-wb-rule-bitter-duty" type="rule" hidden="false" /><infoLink id="r37-wb-ashen-axe" name="Axe-rake" targetId="r37-wb-prof-axe-rake" type="profile" hidden="false" /></infoLinks><costs>
        <cost name="Points" typeId="pts" value="50" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-xvii-2-ashen-circle-cat" name="Fast Attack" hidden="false" targetId="cat-fast" primary="true" />
      <categoryLink id="r41-unit-xvii-2-ashen-circle-r40-covsup" name="Covenant of Fire — Fast/Heavy choices" targetId="r40-sal-covenant-support" hidden="false" /><categoryLink id="r62-limit-link-42a4cac93d3c" name="Shattered 0–1 — Ashen Circle" targetId="r62-shat-limit-29ec47a9062f" hidden="false" /></categoryLinks>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xvii" shared="true" includeChildSelections="true" includeChildForces="false" />
