      <selectionEntryGroup id="r37-wb-zar-malefic" name="Malefic Daemonology — select 2 powers" hidden="false"><constraints><constraint id="r37-wb-zar-malefic-min" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r37-wb-zar-malefic-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="r37-wb-zar-mal-summoning" name="Summoning" type="upgrade" hidden="false"><rules><rule id="r37-wb-zar-mal-summoning-rule" name="Summoning" hidden="false"><description>Conjuration — Range 12". Summon 8 Bloodletters, 9 Pink Horrors, 7 Plaguebearers, 6 Daemonettes, 4 Flesh Hounds, 3 Flamers, 4 Nurglings or 6 Seekers.</description></rule></rules><constraints><constraint id="r37-wb-zar-mal-summoning-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry><selectionEntry id="r37-wb-zar-mal-cursed-earth" name="Cursed Earth" type="upgrade" hidden="false"><rules><rule id="r37-wb-zar-mal-cursed-earth-rule" name="Cursed Earth" hidden="false"><description>Blessing — targets Psyker. All Daemon models within 12" gain +1 to Invulnerable Saves; Deep Striking Daemons do not scatter if the centre model is placed within 12".</description></rule></rules><constraints><constraint id="r37-wb-zar-mal-cursed-earth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry><selectionEntry id="r37-wb-zar-mal-dark-flame" name="Dark Flame" type="upgrade" hidden="false"><profiles><profile id="r37-wb-zar-mal-dark-flame-prof" name="Dark Flame" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">Template</characteristic><characteristic name="S" typeId="weapon-s">4</characteristic><characteristic name="AP" typeId="weapon-ap">5</characteristic><characteristic name="Type" typeId="weapon-type">Assault 1, Soul Blaze, Torrent</characteristic></characteristics></profile></profiles><rules><rule id="r37-wb-zar-mal-dark-flame-rule" name="Dark Flame" hidden="false"><description>Template, S4 AP5, Assault 1, Soul Blaze, Torrent.</description></rule></rules><constraints><constraint id="r37-wb-zar-mal-dark-flame-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry><selectionEntry id="r37-wb-zar-mal-possession" name="Possession" type="upgrade" hidden="false"><rules><rule id="r37-wb-zar-mal-possession-rule" name="Possession" hidden="false"><description>Conjuration — Range 6". Summon one Bloodthirster, Lord of Change, Great Unclean One or Keeper of Secrets. If successful, the invoking Psyker is removed as a casualty. Only usable by Mastery Level 2+.</description></rule></rules><constraints><constraint id="r37-wb-zar-mal-possession-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry><selectionEntry id="r37-wb-zar-mal-sacrifice" name="Sacrifice" type="upgrade" hidden="false"><rules><rule id="r37-wb-zar-mal-sacrifice-rule" name="Sacrifice" hidden="false"><description>Conjuration — Range 6". Summon one Herald of Khorne, Tzeentch, Nurgle or Slaanesh with 30 points of wargear. If successful, one friendly model within 6" suffers a Wound with no saves of any kind.</description></rule></rules><constraints><constraint id="r37-wb-zar-mal-sacrifice-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry><selectionEntry id="r37-wb-zar-mal-incursion" name="Incursion" type="upgrade" hidden="false"><rules><rule id="r37-wb-zar-mal-incursion-rule" name="Incursion" hidden="false"><description>Conjuration — Range 12". Summon 3 Bloodcrushers, 4 Screamers, 3 Plague Drones or 3 Fiends.</description></rule></rules><constraints><constraint id="r37-wb-zar-mal-incursion-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry><selectionEntry id="r37-wb-zar-mal-infernal-gaze" name="Infernal Gaze" type="upgrade" hidden="false"><profiles><profile id="r37-wb-zar-mal-infernal-gaze-prof" name="Infernal Gaze" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">18"</characteristic><characteristic name="S" typeId="weapon-s">3</characteristic><characteristic name="AP" typeId="weapon-ap">4</characteristic><characteristic name="Type" typeId="weapon-type">Assault 1, Armourbane, Fleshbane</characteristic></characteristics></profile></profiles><rules><rule id="r37-wb-zar-mal-infernal-gaze-rule" name="Infernal Gaze" hidden="false"><description>Beam — Range 18", S3 AP4, Assault 1, Armourbane, Fleshbane.</description></rule></rules><constraints><constraint id="r37-wb-zar-mal-infernal-gaze-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Anakatis Kul Blade-Slaves" hidden="true" id="r41-unit-xvii-10-anakatis-kul-blade-slaves">
      <selectionEntries><selectionEntry id="r37-wb-ak-models" name="Anakatis Kul Blade-Slaves" type="model" hidden="false" defaultAmount="2"><constraints><constraint id="r37-wb-ak-models-min" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r37-wb-ak-models-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry></selectionEntries><rules><rule id="r37-wb-ak-mind" name="Mindless Killers" hidden="false"><description>The Anakatis Kul may only be selected as part of Zardu Layak's unit. While Zardu lives they remain part of his unit. If he is slain, surviving Blade-Slaves must charge the nearest eligible enemy in each Assault phase if able and must Pursue retreating enemies whenever legally able.</description></rule><rule id="r37-wb-ak-wg" name="Wargear" hidden="false"><description>Power Armour, pair of Rending Weapons, Plasma Pistol.</description></rule></rules><infoLinks><infoLink id="r41-unit-xvii-10-anakatis-kul-blade-slaves-daemon" name="Daemon" targetId="r36-shared-daemon-48e6659" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-10-anakatis-kul-blade-slaves-fearless" name="Fearless" targetId="r36-shared-fearless-8699dbc" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-10-anakatis-kul-blade-slaves-furious-charge" name="Furious Charge" targetId="r36-shared-furious-charge-5750d05" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-10-anakatis-kul-blade-slaves-it-will-not-die" name="It Will Not Die" targetId="r36-shared-it-will-not-die-422c865" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-10-anakatis-kul-blade-slaves-bulky" name="Bulky" targetId="r36-shared-bulky-73510e7" type="rule" hidden="false" /></infoLinks><selectionEntryGroups><selectionEntryGroup id="r62-shat-assign-group-404f9de7a122" name="Shattered Legions — Assigned Legion" hidden="false"><selectionEntries><selectionEntry id="r62-shat-assign-d57b42d772ea" name="Dark Angels" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-d57b42d772ea-identity" name="Legiones Astartes (Dark Angels)" hidden="false"><description>This unit is assigned to Dark Angels for the Shattered Legions Theme. It uses the normal Dark Angels Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-d57b42d772ea-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-i" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-d57b42d772ea-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-4cf568be2428" name="Emperor's Children" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-4cf568be2428-identity" name="Legiones Astartes (Emperor's Children)" hidden="false"><description>This unit is assigned to Emperor's Children for the Shattered Legions Theme. It uses the normal Emperor's Children Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-4cf568be2428-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-iii" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-4cf568be2428-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-d1ebc86927d9" name="Iron Warriors" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-d1ebc86927d9-identity" name="Legiones Astartes (Iron Warriors)" hidden="false"><description>This unit is assigned to Iron Warriors for the Shattered Legions Theme. It uses the normal Iron Warriors Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-d1ebc86927d9-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-d1ebc86927d9-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-ae6105482e63" name="White Scars" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-ae6105482e63-identity" name="Legiones Astartes (White Scars)" hidden="false"><description>This unit is assigned to White Scars for the Shattered Legions Theme. It uses the normal White Scars Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-ae6105482e63-hide-not-const" type="set" fie