                            <categoryLink id="r37-wb-kor-powers-p-biomancy-endurance-r80-ih-consul-cat-8" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
