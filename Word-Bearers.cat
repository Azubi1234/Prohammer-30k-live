    <selectionEntry type="unit" import="true" name="Ashen Circle — Reign of Fire Troops" hidden="true" id="r37-wb-zardu-ashen-troops">
      <rules><rule id="r37-wb-zardu-ashen-copy-r37-wb-ashen-axe-rule" name="Axe-rake" hidden="false"><description>A close-combat weapon. Attacks are resolved at +1 Strength. If an enemy Retreats from a close combat involving one or more Axe-rakes, reduce its Retreat distance by 1", to a minimum of 1".</description></rule><rule id="r37-wb-zardu-ashen-copy-r37-wb-ashen-wg" name="Wargear" hidden="false"><description>Hardened Power Armour, Jump Pack, Hand Flamer, Axe-rake, Frag Grenades.</description></rule></rules><infoLinks><infoLink id="r37-wb-zardu-ashen-copy-r41-unit-xvii-2-ashen-circle-wb-leg" name="Legiones Astartes (Word Bearers)" targetId="r37-wb-rule-legiones-astartes-word-bearers" type="rule" hidden="false" /><infoLink id="r37-wb-zardu-ashen-copy-r41-unit-xvii-2-ashen-circle-wb-atsknf" name="And They Shall Know No Fear" targetId="r36-shared-and-they-shall-know-no-fear-c9d3c20" type="rule" hidden="false" /><infoLink id="r37-wb-zardu-ashen-copy-r41-unit-xvii-2-ashen-circle-wb-fan" name="Fanatical Devotion" targetId="r37-wb-rule-fanatical-devotion" type="rule" hidden="false" /><infoLink id="r37-wb-zardu-ashen-copy-r37-wb-ashen-hard" name="Hardened Armour" targetId="r37-wb-rule-hardened-armour" type="rule" hidden="false" /><infoLink id="r37-wb-zardu-ashen-copy-r37-wb-ashen-bitter" name="Bitter Duty" targetId="r37-wb-rule-bitter-duty" type="rule" hidden="false" /><infoLink id="r37-wb-zardu-ashen-copy-r37-wb-ashen-axe" name="Axe-rake" targetId="r37-wb-prof-axe-rake" type="profile" hidden="false" /></infoLinks><costs>
        <cost name="Points" typeId="pts" value="50" />
      </costs>
