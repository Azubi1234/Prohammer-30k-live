            </selectionEntries></selectionEntryGroup><selectionEntryGroup id="r37-wb-ere-powers" name="Burning Lore — select 1 power" hidden="false"><selectionEntries><selectionEntry id="r37-wb-ere-powers-p-biomancy-endurance" name="Biomancy — Endurance" type="upgrade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r37-wb-ere-powers-p-biomancy-endurance-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="0" />
                          </costs>
                          <profiles>
                            <profile id="r37-wb-ere-powers-p-biomancy-endurance-r61-librarian-power2-biomancy-endurance-profile" name="Endurance" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                                <characteristic name="S" typeId="ranged-s">—</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-wb-ere-powers-p-biomancy-endurance-r61-librarian-power2-biomancy-endurance-rule" name="Endurance" hidden="false">
                              <description>Target friendly unit gains Eternal Warrior, Feel No Pain (5+) and Relentless.

Relentless: Model may move and fire Heavy, Ordnance, Salvo or Rapid Fire weapons as if it remained stationary. It may still charge even after firing such weapons.
Eternal Warrior: Immune to Instant Death / Massive Wounds. The model suffers 1 Wound instead of D3 Wounds.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-wb-ere-powers-p-biomancy-endurance-r80-ih-consul-cat-8" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                          </categoryLinks>
                        </selectionEntry>
                        <selectionEntry id="r37-wb-ere-powers-p-biomancy-enfeeble" name="Biomancy — Enfeeble" type="upgrade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r37-wb-ere-powers-p-biomancy-enfeeble-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
