                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-wb-ere-powers-p-telepathy-invisibility-r61-librarian-power2-telepathy-invisibility-rule" name="Invisibility" hidden="false">
                              <description>Opposing units suffer -1 To Hit with ranged and melee attacks against the target friendly unit.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-wb-ere-powers-p-telepathy-invisibility-r80-ih-consul-cat-36" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
