    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Kor Phaeron, the Black Cardinal" hidden="true" id="r41-unit-xvii-8-kor-phaeron-the-black-cardinal">
      <rules><rule id="r37-wb-kor-term" name="Terminus Consolaris" hidden="false"><description>Counts as Cataphractii Terminator Armour. Its life-support systems grant Feel No Pain (6+), already reflected in Kor Phaeron's profile/rules.</description></rule><rule id="r37-wb-kor-black" name="Black Cardinal" hidden="false"><description>Kor Phaeron counts as both a Dark Apostle and a Diabolist for all Word Bearers rules, requirements and Rites. He fulfils The Dark Shepherds and enables Dark Channelling.</description></rule><rule id="r37-wb-kor-jealous" name="Jealous Command" hidden="false"><description>If Kor Phaeron is included, he must be the army's Warlord unless Lorgar is also included.</description></rule><rule id="r37-wb-kor-psy" name="Psyker (Mastery Level 1)" hidden="false"><description>Kor Phaeron is a Mastery Level 1 Psyker and has Burning Lore at no additional cost.</description></rule></rules><infoLinks><infoLink id="r41-unit-xvii-8-kor-phaeron-the-black-cardinal-wb-leg" name="Legiones Astartes (Word Bearers)" targetId="r37-wb-rule-legiones-astartes-word-bearers" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-8-kor-phaeron-the-black-cardinal-wb-atsknf" name="And They Shall Know No Fear" targetId="r36-shared-and-they-shall-know-no-fear-c9d3c20" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-8-kor-phaeron-the-black-cardinal-wb-fan" name="Fanatical Devotion" targetId="r37-wb-rule-fanatical-devotion" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-8-kor-phaeron-the-black-cardinal-independent-character" name="Independent Character" targetId="r36-shared-independent-character-4fbd2ae" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-8-kor-phaeron-the-black-cardinal-master-of-the-legion" name="Master of the Legion" targetId="r36-shared-master-of-the-legion-a3a88da" type="rule" hidden="false" /><infoLink id="r37-wb-kor-fnp" name="Feel No Pain (6+)" targetId="r37-wb-rule-feel-no-pain-6" type="rule" hidden="false" /><infoLink id="r38-r41-unit-xvii-8-kor-phaeron-the-black-cardinal-burning" name="Burning Lore" targetId="r38-wb-shared-burning-lore" type="rule" hidden="false" /></infoLinks><costs>
        <cost name="Points" typeId="pts" value="165" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-xvii-8-kor-phaeron-the-black-cardinal-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      <categoryLink id="r41-unit-xvii-8-kor-phaeron-the-black-cardinal-r37-darkap" name="Word Bearers — Dark Shepherd" targetId="r37-wb-dark-apostle-req" hidden="false" /><categoryLink id="r41-unit-xvii-8-kor-phaeron-the-black-cardinal-r37-diab" name="Word Bearers — Diabolist" targetId="r37-wb-diabolist-req" hidden="false" /><categoryLink id="r62-limit-link-6aa910ca2664" name="Shattered 0–1 — Kor Phaeron, the Black Cardinal" targetId="r62-shat-limit-1e14c14cd33b" hidden="false" /></categoryLinks>
