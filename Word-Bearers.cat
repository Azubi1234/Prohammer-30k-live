                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">Self</characteristic>
                                <characteristic name="S" typeId="ranged-s">—</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-wb-ere-powers-p-biomancy-warp-speed-r61-librarian-power2-biomancy-warp-speed-rule" name="Warp Speed" hidden="false">
                              <description>The Psyker gains +3 Initiative, +3 Attacks and Fleet.

Fleet: Unit may still charge into melee combat even if it advanced this turn.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-wb-ere-powers-p-biomancy-warp-speed-r80-ih-consul-cat-7" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
