                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">18"</characteristic>
                                <characteristic name="S" typeId="ranged-s">Special</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">Special</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Focused Witchfire</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-wb-ere-powers-p-biomancy-haemorrhage-r61-librarian-power2-biomancy-haemorrhage-rule" name="Haemorrhage" hidden="false">
                              <description>Target model must pass two Toughness tests or suffer a Wound with no Armour or Cover save. If slain, select another model within 2 inches; it takes one Toughness test or suffers a Wound. Continue until a test is passed.</description>
                            </rule>
                          </rules>
