                        <selectionEntry id="r37-wb-ere-powers-p-telepathy-dominate" name="Telepathy — Dominate" type="upgrade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r37-wb-ere-powers-p-telepathy-dominate-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="0" />
                          </costs>
                          <profiles>
                            <profile id="r37-wb-ere-powers-p-telepathy-dominate-r61-librarian-power2-telepathy-dominate-profile" name="Dominate" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                                <characteristic name="S" typeId="ranged-s">—</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Malediction</characteristic>
                              </characteristics>
                            </profile>
