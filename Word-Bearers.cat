    <selectionEntry type="unit" import="true" name="Hol Beloth" hidden="true" id="r41-unit-xvii-11-hol-beloth">
      <rules><rule id="r37-wb-hol-ward" name="Hexaglyphic Ward" hidden="false"><description>The first unsaved Wound suffered by Hol Beloth during the battle is ignored. If it would be a Massive Wound, the Ward is used before rolling D3 Wounds. The Ward then has no further effect.</description></rule><rule id="r37-wb-hol-exhort" name="Exhortation of Battle" hidden="false"><description>Once per battle at the beginning of a Word Bearers Assault phase, until the end of that phase Word Bearers models with WS lower than 5 count as WS5; models already WS5+ are unaffected.</description></rule></rules><infoLinks><infoLink id="r41-unit-xvii-11-hol-beloth-wb-leg" name="Legiones Astartes (Word Bearers)" targetId="r37-wb-rule-legiones-astartes-word-bearers" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-11-hol-beloth-wb-atsknf" name="And They Shall Know No Fear" targetId="r36-shared-and-they-shall-know-no-fear-c9d3c20" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-11-hol-beloth-wb-fan" name="Fanatical Devotion" targetId="r37-wb-rule-fanatical-devotion" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-11-hol-beloth-independent-character" name="Independent Character" targetId="r36-shared-independent-character-4fbd2ae" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-11-hol-beloth-master-of-the-legion" name="Master of the Legion" targetId="r36-shared-master-of-the-legion-a3a88da" type="rule" hidden="false" /><infoLink id="r38-wb-hol-tainted" name="Tainted Weapon" targetId="r38-wb-shared-tainted-weapon" type="rule" hidden="false" /></infoLinks><costs>
        <cost name="Points" typeId="pts" value="175" />
      </costs>
