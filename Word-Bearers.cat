                    <constraint id="r37-wb-lorgar-legion-terminator-command-squad-hq-praetor-ret-tc-vets-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r37-wb-lorgar-legion-terminator-command-squad-hq-praetor-ret-tc-vets-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
