                          <constraints>
                            <constraint id="r37-wb-ere-powers-p-telepathy-shrouding-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="0" />
                          </costs>
                          <profiles>
                            <profile id="r37-wb-ere-powers-p-telepathy-shrouding-r61-librarian-power2-telepathy-shrouding-profile" name="Shrouding" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">Self / 6"</characteristic>
                                <characteristic name="S" typeId="ranged-s">—</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-wb-ere-powers-p-telepathy-shrouding-r61-librarian-power2-telepathy-shrouding-rule" name="Shrouding" hidden="false">
                              <description>All friendly models within 6 inches of the Psyker gain the Shrouded special rule.

Shrouded: Adds +2 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 5+ Cover Save. Does not stack with Stealth.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-wb-ere-powers-p-telepathy-shrouding-r80-ih-consul-cat-37" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                          </categoryLinks>
                        </selectionEntry>
                      <selectionEntry id="r37-wb-ere-powers-p-telepathy-terrify" name="Telepathy — Terrify" type="upgrade" hidden="false" import="true">
                          <constraints>
