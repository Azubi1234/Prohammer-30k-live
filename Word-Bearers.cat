      <rules><rule id="r37-wb-arg-spear-rule" name="Custodian Spear" hidden="false"><description>Two-Handed, Master-crafted Power Weapon with an inbuilt Foeblaster Boltgun. During the first round of each close combat, melee attacks are resolved at +1 Strength and +1 Initiative.</description></rule><rule id="r37-wb-arg-ret" name="Lord of the Gal Vorbak" hidden="false"><description>Argel Tal may select one Gal Vorbak Dark Brethren Squad as his personal retinue. It occupies no separate Elites selection; together they count as a single HQ selection.</description></rule></rules><infoLinks><infoLink id="r41-unit-xvii-6-argel-tal-wb-leg" name="Legiones Astartes (Word Bearers)" targetId="r37-wb-rule-legiones-astartes-word-bearers" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-6-argel-tal-wb-atsknf" name="And They Shall Know No Fear" targetId="r36-shared-and-they-shall-know-no-fear-c9d3c20" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-6-argel-tal-independent-character" name="Independent Character" targetId="r36-shared-independent-character-4fbd2ae" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-6-argel-tal-master-of-the-legion" name="Master of the Legion" targetId="r36-shared-master-of-the-legion-a3a88da" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-6-argel-tal-daemon" name="Daemon" targetId="r36-shared-daemon-48e6659" type="rule" hidden="false" /><infoLink id="r41-unit-xvii-6-argel-tal-fearless" name="Fearless" targetId="r36-shared-fearless-8699dbc" type="rule" hidden="false" /><infoLink id="r37-wb-arg-cust" name="Custodian Spear" targetId="r37-wb-prof-custodian-spear" type="profile" hidden="false" /><infoLink id="r37-wb-arg-custg" name="Custodian Spear — Foeblaster Boltgun" targetId="r37-wb-prof-custodian-gun" type="profile" hidden="false" /></infoLinks><costs>
