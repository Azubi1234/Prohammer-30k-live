              <selectionEntryGroup id="live-r2-fabius-enhanced-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-group" name="Fabius Bile" hidden="false" collective="false" import="true"><selectionEntries><entryLink id="live-r2-fabius-enhanced-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command" name="Enhanced Warriors" targetId="r41-universal-gear-fee9d22f000bad" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="live-r2-fabius-enhanced-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="live-r2-fabius-enhanced-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-scale-0" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-vets" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-scale-1" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-land-land-raider-phobos" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-scale-2" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-land-land-raider-proteus" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-scale-3" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-land-land-raider-achilles" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-hide" type="set" field="hidden" value="true"><conditions /></modifier></modifiers></entryLink></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r2-fulgrim-blessing-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="25" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-live-r2-r41-unit-xvii-11-hol-beloth-retinue-0-hq-centurion-ret-command-hide" type="set" field="hidden" value="true"><conditions /></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
