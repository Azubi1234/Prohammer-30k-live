                          <rules>
                            <rule id="r37-wb-ere-powers-p-biomancy-smite-r61-librarian-power2-biomancy-smite-rule" name="Smite" hidden="false">
                              <description>Witchfire. Resolve as a normal psychic shooting attack.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-wb-ere-powers-p-biomancy-smite-r80-ih-consul-cat-3" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
