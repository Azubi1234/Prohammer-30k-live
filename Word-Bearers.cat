      <selectionEntryGroups><selectionEntryGroup id="live-r2-r41-unit-xvii-8-kor-phaeron-the-black-cardinal-retinue" name="Retinue (does not occupy a separate FOC slot)" hidden="false" collective="false" import="true"><constraints><constraint id="live-r2-r41-unit-xvii-8-kor-phaeron-the-black-cardinal-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="unit" name="Legion Terminator Command Squad" id="live-r2-r41-unit-xvii-8-kor-phaeron-the-black-cardinal-retinue-0-hq-praetor-ret-termcommand" hidden="false" import="true">
              <constraints>
                <constraint id="live-r2-r41-unit-xvii-8-kor-phaeron-the-black-cardinal-retinue-0-hq-praetor-ret-termcommand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
