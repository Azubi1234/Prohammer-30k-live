                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                                <characteristic name="S" typeId="ranged-s">—</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Malediction</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-wb-ere-powers-p-telepathy-hallucination-r61-librarian-power2-telepathy-hallucination-rule" name="Hallucination" hidden="false">
                              <description>Roll D6: 1-2 the unit takes a Pinning test; 3-4 it suffers -1 WS, BS, Initiative and Attacks; 5-6 randomly select a model, which takes one hit for every other model in the unit at Strength equal to the unit's majority Strength.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-wb-ere-powers-p-telepathy-hallucination-r80-ih-consul-cat-35" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
