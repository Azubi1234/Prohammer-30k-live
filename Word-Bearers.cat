                          <rules>
                            <rule id="r37-wb-ere-powers-p-biomancy-life-leech-r61-librarian-power2-biomancy-life-leech-rule" name="Life Leech" hidden="false">
                              <description>If this power causes at least one unsaved Wound, one model within 6 inches of the Psyker regains one Wound.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-wb-ere-powers-p-biomancy-life-leech-r80-ih-consul-cat-6" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
