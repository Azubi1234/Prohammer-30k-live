<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="mod-xvii-bc22103543a05b67a2e9" name="Word Bearers" revision="3" battleScribeVersion="2.03" gameSystemId="sys-6f3a-91d2-b47c-5e08" gameSystemRevision="16" library="false"><catalogueLinks><catalogueLink id="link-generic-xvii" name="Legiones Astartes — Generic Library" targetId="cat-7b24-e6f1-83a9-4c50" type="catalogue"  importRootEntries="true" /></catalogueLinks><sharedRules><rule id="r37-wb-rule-legiones-astartes-word-bearers" name="Legiones Astartes (Word Bearers)" hidden="false"><description>This is the named XVII Legion version of Legiones Astartes. Models with this rule also use the normal Legiones Astartes rules and And They Shall Know No Fear. A model may only possess one named Legiones Astartes rule.</description></rule></sharedRules><selectionEntries><selectionEntry type="unit" import="true" name="Covenant Zealot Mob" hidden="true" id="r41-unit-xvii-0-covenant-zealot-mob">
      <rules><rule id="r37-wb-zeal-wargear" name="Wargear" hidden="false"><description>Covenant Zealots: Autopistol, close combat weapon, Flak Armour. Legion Overseer: Power Armour, Refractor Field, Bolt Pistol, close combat weapon, Frag Grenades, Krak Grenades.</description></rule></rules><infoLinks><infoLink id="r37-wb-zeal-driven" name="Driven to Slaughter" targetId="r37-wb-rule-driven-to-slaughter" type="rule" hidden="false" /><infoLink id="r37-wb-zeal-exp" name="Expendable" targetId="r37-wb-rule-expendable" type="rule" hidden="false" /></infoLinks><selectionEntries><selectionEntry id="r37-wb-zeal-models" name="Covenant Zealots" type="model" hidden="false" defaultAmount="10"><constraints><constraint id="r37-wb-zeal-models-min" type="min" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r37-wb-zeal-models-max" type="max" value="40" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="5" /></costs></selectionEntry><selectionEntry id="r37-wb-zeal-overseer" name="Legion Overseer" type="model" hidden="false" defaultAmount="1"><constraints><constraint id="r37-wb-zeal-overseer-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r37-wb-zeal-overseer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntryGroups><selectionEntryGroup id="r37-wb-zeal-overseer-weapon" name="Replace close combat weapon" hidden="false"><constraints><constraint id="r37-wb-zeal-overseer-weapon-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r37-wb-zeal-overseer-weapon-max" type="max" value="1" f