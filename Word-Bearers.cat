                          <profiles>
                            <profile id="r37-wb-ere-powers-p-biomancy-enfeeble-r61-librarian-power2-biomancy-enfeeble-profile" name="Enfeeble" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                                <characteristic name="S" typeId="ranged-s">—</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Malediction</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-wb-ere-powers-p-biomancy-enfeeble-r61-librarian-power2-biomancy-enfeeble-rule" name="Enfeeble" hidden="false">
                              <description>Target enemy unit suffers -1 Strength and -1 Toughness and treats all movement as Difficult Terrain.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-wb-ere-powers-p-biomancy-enfeeble-r80-ih-consul-cat-5" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
