                                <characteristic name="Range" typeId="ranged-range">18"</characteristic>
                                <characteristic name="S" typeId="ranged-s">4</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Assault 4, Witchfire</characteristic>
