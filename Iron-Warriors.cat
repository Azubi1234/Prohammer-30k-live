      <rules>
        <rule id="r57-iw-circle-rule-0" name="Cybernetica Cortex" hidden="false">
          <description>This unit has Cybernetica Cortex.</description>
        </rule>
        <rule id="r57-iw-circle-rule-1" name="Reactor Blast" hidden="false">
          <description>This unit has Reactor Blast.</description>
        </rule>
        <rule id="r57-iw-circle-rule-3" name="Moving Bulwark" hidden="false">
          <description>If a Domitar-Ferrum is in base contact with another friendly Domitar-Ferrum from the same unit, both improve their Invulnerable Save from 5+ to 4+. The bonus is lost as soon as the models are no longer in base contact.</description>
        </rule>
        <rule id="r57-iw-circle-rule-4" name="Iron Warriors Construct" hidden="false">
          <description>The Iron Circle counts as an Iron Warriors unit for rules which specifically affect friendly Iron Warriors units. It does not possess the Legiones Astartes special rule.</description>
        </rule>
        <rule id="r57-iw-circle-rule-5" name="Karceri Battle Shield" hidden="false">
          <description>The Karceri Battle Shield grants the Domitar-Ferrum its 5+ Invulnerable Save; this is already included in its profile.</description>
        </rule>
        <rule id="r57-iw-circle-rule-6" name="Graviton Maul" hidden="false">
          <description>Power Weapon. Attacks are resolved at Strength 10 and have Concussive.</description>
        </rule>
        <rule id="r57-iw-circle-rule-7" name="Olympia-pattern Bolt Cannon" hidden="false">
          <description>Range 36", Strength 5, AP4, Heavy 5, Pinning.</description>
        </rule>
      </rules>
    </selectionEntry>
