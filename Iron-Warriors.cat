      <rules>
        <rule id="r57-iw-kroeger-rule-0" name="Legiones Astartes (Iron Warriors)" hidden="false">
          <description>This model has Legiones Astartes (Iron Warriors).</description>
        </rule>
        <rule id="r57-iw-kroeger-rule-2" name="The Bloody-Handed" hidden="false">
          <description>Kroeger has Furious Charge. Any Iron Warriors unit he has joined also gains Furious Charge while he remains part of the unit.

Furious Charge: Models gain +1 Strength and +1 Initiative in assault on the turn they charged.</description>
        </rule>
        <rule id="r57-iw-kroeger-rule-3" name="No Surrender" hidden="false">
          <description>Whenever Kroeger and his unit win close combat and one or more defeated enemy units Retreat, Kroeger's unit must Pursue if legally permitted. It may not choose to Consolidate instead.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r57-iw-kroeger-options" name="Options" hidden="false" collective="false" import="true">
