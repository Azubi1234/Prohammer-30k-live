                <selectionEntryGroup id="r57-iw-golg-retinue-dominator-cohort-r57-iw-dom-armoury" name="Iron Warriors Armoury" hidden="false" collective="false" import="true">
                  <selectionEntries>
                    <selectionEntry id="r57-iw-golg-retinue-dominator-cohort-r57-iw-dom-armoury-shrapnel" name="Shrapnel Bolts" type="upgrade" hidden="false" import="true">
                      <constraints>
                        <constraint id="r57-iw-golg-retinue-dominator-cohort-r57-iw-dom-armoury-shrapnel-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="5" id="r57-iw-golg-retinue-dominator-cohort-r57-iw-dom-armoury-shrapnel-pts" />
                      </costs>
                      <rules>
                        <rule id="r57-iw-golg-retinue-dominator-cohort-r57-iw-dom-armoury-shrapnel-rule" name="Shrapnel Bolts" hidden="false">
                          <description>Bolt Pistols, Bolters, Combi-Bolters, Storm Bolters, Heavy Bolters, Twin-linked Bolters and bolter components of Combi-Weapons carried by models in this unit gain Pinning. May not be combined with Special Issue Ammunition, Hellfire Rounds or another special ammunition type.

Pinning: Unsaved Wounds caused by this weapon force the unit to take a Pinning Test.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                  </selectionEntries>
                  <modifiers>
