                  </constraints>
                  <modifiers>
                    <modifier id="live-r2-r41-unit-xviii-5-artellus-numeon-retinue-1-r71-nl-gen-10-stealth-cost-0" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="live-r2-r41-unit-xviii-5-artellus-numeon-retinue-1-hq-centurion-ret-command-vets" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
