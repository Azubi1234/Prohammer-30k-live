    <selectionEntry type="unit" name="Legion Command Squad" id="live-r2-r41-unit-xviii-5-artellus-numeon-retinue-1-hq-centurion-ret-command" hidden="false" import="true">
              <constraints>
                <constraint id="live-r2-r41-unit-xviii-5-artellus-numeon-retinue-1-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
