iii-2-salamanders-infernus-destroyer-squad-dual-pistols" name="Dual Pistols" targetId="r40-sal-dual-pistols" type="rule" hidden="false" /><infoLink id="r40-sal-cov-infernus-copy-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-destroyer-cadre" name="Destroyer Cadre" targetId="r40-sal-destroyer-cadre" type="rule" hidden="false" /></infoLinks><costs>
