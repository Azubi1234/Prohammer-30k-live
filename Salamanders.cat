    <selectionEntry type="unit" import="true" name="Lord Chaplain Nomus Rhy'tan" hidden="true" id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan">
      <rules><rule id="r40-nom-wg" name="Wargear" hidden="false"><description>Artificer Armour, Iron Halo, Darkstar Falling, Combi-flamer, Bolt Pistol, Frag Grenades, Mantle of the Elder Drake.</description></rule><rule id="r40-nom-mantle" name="Mantle of the Elder Drake" hidden="false"><description>Counts as a Salamanders Mantle and therefore uses the normal Salamanders Mantle rule.</description></rule><rule id="r40-nom-dark-rule" name="Darkstar Falling" hidden="false"><description>Two-Handed, Master-crafted Power Weapon. Attacks are resolved at +2 Strength and have Concussive; against Vehicles they also have Armourbane.</description></rule><rule id="r40-nom-chap" name="Lord Chaplain" hidden="false"><description>Nomus counts as a Legion Chaplain Consul for all rules, army construction requirements and Rites of War.</description></rule><rule id="r40-nom-key" name="Keeper of the Keys" hidden="false"><description>One Legion Dreadnought or Legion Contemptor Dreadnought may be selected as a non-compulsory HQ choice. It may not be the Warlord.</description></rule><rule id="r40-nom-ret" name="Command Retinue" hidden="false"><description>Nomus may select a Legion Command Squad, Legion Terminator Command Squad or Firedrake Terminator Squad as his retinue.</description></rule></rules><infoLinks><infoLink id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan-sal-leg" name="Legiones Astartes (Salamanders)" targetId="r40-sal-legiones-astartes-salamanders" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan-sal-promethean-cult" name="Promethean Cult" targetId="r40-sal-promethean-cult" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan-sal-sturdy" name="Sturdy" targetId="r40-sal-sturdy" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan-sal-never-give-up" name="Never Give Up" targetId="r40-sal-never-give-up" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan-independent-character" name="Independent Character" targetId="r36-shared-independent-character-4fbd2ae" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan-master-of-the-legion" name="Master of the Legion" targetId="r36-shared-master-of-the-legion-a3a88da" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan-zealot" name="Zealot" targetId="r36-shared-zealot-18abf21" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan-salamanders-mantle" name="Salamanders Mantle" targetId="r40-sal-salamanders-mantle" type="rule" hidden="false" /><infoLink id="r40-nom-dark" name="Darkstar Falling" targetId="r40-sal-prof-darkstar" type="profile" hidden="false" /></infoLinks><costs>
