      <rules>
        <rule id="r74-ba-pal-rule-blood" name="The Blood is Forever" hidden="false">
          <description>At the beginning of each Assault phase, if the number of enemy models engaged in the same combat is greater than the number of models in this unit, the Crimson Paladins gain Feel No Pain (5+) until the end of that Assault phase. If the enemy outnumbers the unit by at least two models to one, they instead gain Feel No Pain (4+).</description>
        </rule>
      </rules>
