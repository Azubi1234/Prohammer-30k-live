        <selectionEntry id="r74-ba-sang-wings" name="Great Wings" type="upgrade" hidden="false" import="true" defaultAmount="1">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r74-ba-sang-wings-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="r74-ba-sang-wings-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r74-ba-sang-wings-rule" name="Great Wings" hidden="false">
              <description>Sanguinius is Jump Infantry and follows normal ProHammer Jump Infantry rules. This movement ability may never be lost, disabled or destroyed as the result of damage to wargear.</description>
            </rule>
          </rules>
