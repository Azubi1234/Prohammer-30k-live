            <constraint id="r74-ba-sang-frag-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule id="r74-ba-sang-charge" name="Angelic Charge" hidden="false">
          <description>During an Assault phase in which Sanguinius charged, increase his Strength and Attacks characteristics by +1 for that Assault phase.</description>
        </rule>
        <rule id="r74-ba-sang-sire" name="Sire of the Blood Angels" hidden="false">
          <description>Friendly Blood Angels units with at least one model within 12 inches of Sanguinius may re-roll failed Morale and Pinning tests. The second result must be accepted.

Pinning: Unsaved Wounds caused by this weapon force the unit to take a Pinning Test.</description>
        </rule>
        <rule id="r74-ba-sang-descends" name="The Angel Descends" hidden="false">
          <description>When Sanguinius enters play using Deep Strike, he does not scatter. If he charges during the same turn, he receives the normal +1 Attack for charging and normal benefits of any Assault Grenades carried; this overrides the normal ProHammer restriction on charging after Deep Strike.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r74-ba-sang-weapon" name="Primary Weapon" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r74-ba-sang-weapon-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
            <constraint id="r74-ba-sang-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="r74-ba-sang-blade" name="Blade Encarmine" type="upgrade" hidden="false" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="0" />
              </costs>
              <constraints>
                <constraint id="r74-ba-sang-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r74-ba-sang-blade-rule" name="Blade Encarmine" hidden="false">
                  <description>Master-crafted Power Weapon. Attacks are resolved at +1 Strength and have Shred and Rampage.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r74-ba-sang-spear" name="Spear of Telesto" type="upgrade" hidden="false" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="0" />
              </costs>
              <constraints>
                <constraint id="r74-ba-sang-spear-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r74-ba-sang-spear-rule" name="Spear of Telesto" hidden="false">
                  <description>Master-crafted, Two-Handed Power Weapon. Attacks are resolved at +3 Strength and have Lance.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="r74-ba-sang-retinue" name="RETINUE — choose up to one (no separate FOC slot)" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r74-ba-sang-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Honour Guard Squad" id="r74-ba-sang-honour-hq-praetor-ret-honour" hidden="false" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="55" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r74-ba-sang-honour-hq-praetor-ret-honour-std" hidden="false">
                  <description>Every model wears Artificer Armour and carries a Refractor Field, Power Weapon, Bolt Pistol and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="r74-ba-sang-honour-hq-praetor-ret-honour-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Honour or Death" id="r74-ba-sang-honour-hq-praetor-ret-honour-hod" hidden="false">
                  <description>If the Legion Champion is in base contact with one or more enemy Independent Characters, he must direct all of his close-combat attacks against one of them. When attacking an enemy Independent Character in close combat, he may re-roll failed To Hit and To Wound rolls.</description>
                </rule>
                <rule name="Retinue" id="r74-ba-sang-honour-hq-praetor-ret-honour-ret" hidden="false">
                  <description>Selected for an eligible Praetor or Primarch. It occupies no separate Force Organisation slot; the commander and Honour Guard count as a single HQ selection but do not have to deploy together and operate as separate units after deployment.</description>
                </rule>
              </rules>
