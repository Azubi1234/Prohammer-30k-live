        <selectionEntryGroup id="r89-we-delvarus-wargear" name="Wargear" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="r89-we-delvarus-wargear-0-power-armour" name="Power Armour" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-delvarus-wargear-0-power-armour-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-delvarus-wargear-0-power-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-delvarus-wargear-0-power-armour-rule" name="Power Armour" hidden="false"><description>Confers a 3+ Armour Save.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-delvarus-wargear-1-caedere-weapon" name="Caedere Weapon" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-delvarus-wargear-1-caedere-weapon-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-delvarus-wargear-1-caedere-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-delvarus-wargear-1-caedere-weapon-rule" name="Caedere Weapon" hidden="false"><description>A Caedere Weapon is a one-handed close-combat weapon at User +1 Strength with Rending. It does not count as a Power Weapon.

Rending: On a To Wound roll of 6, causes an automatic Wound and the weapon is treated as AP2 for ranged attacks and a Power Weapon attack for melee attacks. Against Vehicles, an Armour Penetration roll of 6 adds an additional D3 to the penetration result.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-delvarus-wargear-2-bolt-pistol" name="Bolt pistol" type="upgrade" hidden="false" import="true" defaultAmount="1"><infoLinks><infoLink id="r36-link-4e72e26b8baf" name="Bolt pistol" hidden="false" targetId="r36-exact-bolt-pistol-b5f8436" type="rule" /></infoLinks><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-delvarus-wargear-2-bolt-pistol-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-delvarus-wargear-2-bolt-pistol-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r89-we-delvarus-wargear-3-boarding-shield" name="Boarding Shield" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-delvarus-wargear-3-boarding-shield-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-delvarus-wargear-3-boarding-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-delvarus-wargear-3-boarding-shield-rule" name="Boarding Shield" hidden="false"><description>Uses the normal Boarding Shield rules.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-delvarus-wargear-4-frag-grenades" name="Frag grenades" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-delvarus-wargear-4-frag-grenades-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-delvarus-wargear-4-frag-grenades-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-delvarus-wargear-4-frag-grenades-rule" name="Frag grenades" hidden="false"><description>Uses the normal Frag grenade rules.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-delvarus-special-rules" name="Special Rules" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="r89-we-delvarus-special-rules-0-legiones-astartes-world-eaters" name="Legiones Astartes (World Eaters)" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-delvarus-special-rules-0-legiones-astartes-world-eaters-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-delvarus-special-rules-0-legiones-astartes-world-eaters-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-delvarus-special-rules-0-legiones-astartes-world-eaters-rule" name="Legiones Astartes (World Eaters)" hidden="false"><description>Uses the World Eaters Legion special rule.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-delvarus-special-rules-1-independent-character" name="Independent Character" type="upgrade" hidden="false" import="true" defaultAmount="1"><infoLinks><infoLink id="r36-link-25c9ded10998" name="Independent Character" hidden="false" targetId="r36-shared-independent-character-4fbd2ae" type="rule" /></infoLinks><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-delvarus-special-rules-1-independent-character-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-delvarus-special-rules-1-independent-character-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r89-we-delvarus-special-rules-2-gladiator-champion" name="Gladiator Champion" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-delvarus-special-rules-2-gladiator-champion-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-delvarus-special-rules-2-gladiator-champion-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-delvarus-special-rules-2-gladiator-champion-rule" name="Gladiator Champion" hidden="false"><description>Any Triarii Breacher Squad joined by Delvarus gains Stubborn and Furious Charge.

Furious Charge: Models gain +1 Strength and +1 Initiative in assault on the turn they charged.
Stubborn: Ignore negative Leadership modifiers on Morale and Pinning tests.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-delvarus-special-rules-3-command-retinue" name="Command Retinue" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-delvarus-special-rules-3-command-retinue-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-delvarus-special-rules-3-command-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-delvarus-special-rules-3-command-retinue-rule" name="Command Retinue" hidden="false"><description>Delvarus may select one Legion Triarii Breacher Squad as his retinue. The selected squad does not occupy a separate Force Organisation slot.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-delvarus-options" name="Options" hidden="false" collective="false" import="true"><selectionEntries><entryLink id="r89-we-delvarus-opt-0-krak-grenades" name="Krak grenades" targetId="gear-krak" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r89-we-delvarus-opt-0-krak-grenades-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="2" /></costs></entryLink><selectionEntry id="r89-we-delvarus-opt-1-melta-bombs" name="Melta bombs" type="upgrade" hidden="false" import="true"><infoLinks><infoLink id="r36-link-d1432a540413" name="Melta bombs" hidden="false" targetId="r36-exact-melta-bombs-404bfc7" type="rule" /></infoLinks><cost