    </selectionEntries><rules><rule id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-rule" name="Retinue" hidden="false"><description>Shabran Darr may select one of the listed retinue units. The selected unit does not occupy a separate Force Organisation slot.</description></rule></rules></selectionEntryGroup><selectionEntryGroup id="r62-shat-assign-group-29c70ae777f5" name="Shattered Legions — Assigned Legion" hidden="false"><selectionEntries><selectionEntry id="r62-shat-assign-2e000a9728d4" name="Dark Angels" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-2e000a9728d4-identity" name="Legiones Astartes (Dark Angels)" hidden="false"><description>This unit is assigned to Dark Angels for the Shattered Legions Theme. It uses the normal Dark Angels Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-2e000a9728d4-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-i" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-2e000a9728d4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-b56ce956a766" name="Emperor's Children" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-b56ce956a766-identity" name="Legiones Astartes (Emperor's Children)" hidden="false"><description>This unit is assigned to Emperor's Children for the Shattered Legions Theme. It uses the normal Emperor's Children Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its mod