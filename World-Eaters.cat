es-3-warrior-apothecary" name="Warrior-Apothecary" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kargos-special-rules-3-warrior-apothecary-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kargos-special-rules-3-warrior-apothecary-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kargos-special-rules-3-warrior-apothecary-rule" name="Warrior-Apothecary" hidden="false"><description>Kargos may use his Narthecium even while he is in base contact with an enemy model. All other normal Narthecium restrictions continue to apply.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-kargos-special-rules-4-command-retinue" name="Command Retinue" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kargos-special-rules-4-command-retinue-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kargos-special-rules-4-command-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kargos-special-rules-4-command-retinue-rule" name="Command Retinue" hidden="false"><description>Kargos may select one Legion Command Squad. If Kargos has a Jump Pack, the Command Squad may purchase Jump Packs normally. The selected squad does not occupy a separate Force Organisation slot.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-kargos-options" name="Options" hidden="false" collective="false" import="true"><selectionEntries><entryLink id="r89-we-kargos-opt-0-krak-grenades" name="Krak grenades" targetId="gear-krak" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r89-we-kargos-opt-0-krak-grenades-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="2" /></costs></entryLink><selectionEntry id="r89-we-kargos-opt-1-melta-bombs" name="Melta bombs" type="upgrade" hidden="false" import="true"><infoLinks><infoLink id="r36-link-acfaaeaaa6cf" name="Melta bombs" hidden="false" targetId="r36-exact-melta-bombs-404bfc7" type="rule" /></infoLinks><costs><cost name="Points" typeId="pts" value="5" /></costs><constraints><constraint id="r89-we-kargos-opt-1-melta-bombs-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r89-we-kargos-opt-2-jump-pack" name="Jump Pack" type="upgrade" hidden="false" import="true"><categoryLinks><categoryLink id="r89-we-kargos-opt-2-jump-pack-r40-jump" name="Awakening Fire — Jump Infantry" targetId="r40-sal-awakening-jump" hidden="false" /></categoryLinks><costs><cost name="Points" typeId="pts" value="20" /></costs><constraints><constraint id="r89-we-kargos-opt-2-jump-pack-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kargos-opt-2-jump-pack-rule" name="Jump Pack" hidden="false"><description>Changes Kargos to Jump Infantry while equipped.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r3-we-r41-unit-xii-9-kargos-the-bloodspitter-retinue" name="RETINUE — choose up to one (no separate FOC slot)" hidden="false" collective="false" import="true"><constraints><constraint id="live-r3-we-r41-unit-xii-9-kargos-the-bloodspitter-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="unit" name="Legion Command Squad" id="live-r3-we-r41-unit-xii-9-kargos-the-bloodspitter-retinue-0-hq-centurion-ret-command" hidden="false" import="true">
              <constraints>
                <constraint id="live-r3-we-r41-unit-xii-9-kargos-the-bloodspitter-retinue-0-hq-centurion-ret-command-ret-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints>
              <costs>
                <cost name="Points" typeId="pts" value="90" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="live-r3-we-r41-unit-xii-9-kargos-the-bloodspitter-retinue-0-hq-centurion-ret-command-std" hidden="false">
                  <description>Five Legion Veterans, each equipped with Power Armour, Bolt Pistol, Chainsword and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="live-r3-we-r41-unit-xii-9-kargos-the-bloodspitter-retinue-0-hq-centurion-ret-command-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Retinue" id="live-r3-we-r41-unit-xii-9-kargos-the-bloodspitter-retinue-0-hq-centurion-ret-command-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character. It occupies no separate Force Organisation slot; character and Command Squad count as one HQ choice but may deploy and operate separately.</description>
                </rule>
              </rules>
