        <selectionEntryGroup id="r89-we-kargos-wargear" name="Wargear" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="r89-we-kargos-wargear-0-power-armour" name="Power Armour" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kargos-wargear-0-power-armour-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kargos-wargear-0-power-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kargos-wargear-0-power-armour-rule" name="Power Armour" hidden="false"><description>Confers a 3+ Armour Save.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-kargos-wargear-1-narthecium" name="Narthecium" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kargos-wargear-1-narthecium-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kargos-wargear-1-narthecium-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kargos-wargear-1-narthecium-rule" name="Narthecium" hidden="false"><description>Uses the normal Narthecium rules.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-kargos-wargear-2-reductor" name="Reductor" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we