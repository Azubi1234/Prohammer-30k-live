        <selectionEntryGroup id="r60-ws-hasik-retinue" name="Retinue (does not occupy a separate FOC slot)" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r60-ws-hasik-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Command Squad" id="r60-ws-hasik-retinue-legion-command-squad" hidden="false" import="true">
              <constraints>
                <constraint id="r60-ws-hasik-retinue-legion-command-squad-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="90" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r60-ws-hasik-retinue-legion-command-squad-hq-centurion-ret-command-std" hidden="false">
                  <description>Five Legion Veterans, each equipped with Power Armour, Bolt Pistol, Chainsword and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="r60-ws-hasik-retinue-legion-command-squad-hq-centurion-ret-command-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Retinue" id="r60-ws-hasik-retinue-legion-command-squad-hq-centurion-ret-command-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character. It occupies no separate Force Organisation slot; character and Command Squad count as one HQ choice but may deploy and operate separately.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Legion Veterans" id="r60-ws-hasik-retinue-legion-command-squad-hq-centurion-ret-command-vets" hidden="false" import="true" defaultAmount="5">
