            </entryLink><selectionEntry id="r60-ws-hibou-bike" name="Space Marine Bike" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r60-ws-hibou-bike-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="35" id="r60-ws-hibou-bike-pts" />
