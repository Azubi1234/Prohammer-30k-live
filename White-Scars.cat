      <rules>
        <rule id="r60-ws-falcon-sabotage" name="Sabotage" hidden="false">
          <description>After deployment but before the first turn, nominate one enemy unit, Vehicle or Fortification. It suffers D6 S5 AP6 hits; against Vehicles/Fortifications use the lowest Armour Value. These casualties do not cause Morale or Pinning tests.</description>
        </rule>
      </rules>
    </selectionEntry>
