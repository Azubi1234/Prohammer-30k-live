            <constraint id="r41-unit-xv-1-khenetai-occult-blade-cabal-additional-min-total" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="38" />
          </costs>
