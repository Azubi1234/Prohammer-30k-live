        <profile name="Sekhmet Inceptor" typeId="prof-model" typeName="Model" hidden="false" id="live-r2-r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-retinue-2-r41-unit-xv-0-sekhmet-terminator-cabal-profile-1">
