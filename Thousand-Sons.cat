ive-r2-fulgrim-blessing-live-r2-r41-unit-xv-6-ahzek-ahriman-retinue-0-hq-centurion-ret-command-hide" type="set" field="hidden" value="true"><conditions /></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r18-final-ahriman-cabal-group" name="Ahriman's Cabal" hidden="false"><selectionEntries><selectionEntry id="r18-final-ahriman-cabal-upgrade" name="Ahriman's Cabal" type="upgrade" hidden="false" import="true"><constraints><constraint id="r18-final-ahriman-cabal-upgrade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="50" /></costs><rules><rule id="r18-final-ahriman-cabal-rule" name="Ahriman's Cabal" hidden="false"><description>The Command Squad becomes Brotherhood of Psykers (Mastery Level 2), is fixed to the Corvidae, receives Corvidae Cult Arcana and Cult Mastery, and selects two Divination powers. It remains a separate Psyker from Ahriman.</description></rule></rules><categoryLinks><categoryLink id="r18-final-ahriman-cabal-brotherhood" name="Thousand Sons Psychic Brotherhood" targetId="r18-ts-cat-brotherhood" hidden="false" primary="false" /></categoryLinks></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r18-final-ahriman-cabal-force-group" name="Ahriman's Cabal — Prosperine Force Weapon upgrades" hidden="false"><constraints><constraint id="r18-final-ahriman-cabal-force-max" type="max" value="0" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><modifiers><modifier id="r18-final-ahriman-cabal-force-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r18-final-ahriman-cabal-upgrade" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier