        <profile name="Sekhmet Inceptor" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-0-sekhmet-terminator-cabal-profile-1">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
