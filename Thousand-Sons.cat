            <modifiers><modifier id="r18-final-sekhmet-harness-inceptor" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r41-unit-xv-0-sekhmet-terminator-cabal-opt-5-sekhmet-inceptor" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
