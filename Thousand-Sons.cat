                            <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-30a1a71834bd" shared="true" includeChildSelections="true" includeChildForces="false" />
                          <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
