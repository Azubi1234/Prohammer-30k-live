          </selectionEntries><modifiers><modifier id="r18-final-castellax-bolter-max2" type="set" field="r18-final-castellax-bolter-repl-max" value="2"><conditions><condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r41-unit-xv-3-castellax-achea-maniple-additional" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-final-castellax-bolter-max3" type="set" field="r18-final-castellax-bolter-repl-max" value="3"><conditions><condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r41-unit-xv-3-castellax-achea-maniple-additional" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntryGroup></selectionEntryGroups></selectionEntryGroup>
