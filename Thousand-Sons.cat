      <categoryLink id="r18-ts-sekhmet-root-limit" name="Thousand Sons Sekhmet 0-1" hidden="false" targetId="r18-ts-cat-sekhmet-limit" primary="false" /><categoryLink id="r18-final-bro-0" name="Thousand Sons Psychic Brotherhood" targetId="r18-ts-cat-brotherhood" hidden="false" primary="false" /><categoryLink id="r18-final-cat-sekhmet-01-tag-0" name="Sekhmet Cabal 0-1" targetId="r18-final-cat-sekhmet-01" hidden="false" primary="false" /><categoryLink id="r19-guard-sekhmet-troops" name="Troops — Guard of the Crimson King" targetId="cat-troops" primary="true" hidden="true"><modifiers><modifier id="r19-guard-sekhmet-show-troops" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xv-1-the-guard-of-the-crimson-king" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></categoryLink><categoryLink id="r36-long-comp-e41ba4b24f" name="Long March — compulsory Troops" targetId="r36-soh-long-compulsory-troops" hidden="false" /><categoryLink id="r41-unit-xv-0-sekhmet-terminator-cabal-r40-covcomp" name="Covenant of Fire — compulsory Troops" targetId="r40-sal-covenant-compulsory" hidden="false" /><categoryLink id="r41-unit-xv-0-sekhmet-terminator-cabal-r42-sal-comp" name="Salamanders — compulsory-capable Troops" targetId="r42-sal-compulsory-troops" hidden="false" /><categoryLink id="r41-unit-xv-0-sekhmet-terminator-cabal-r43-rg-comp" name="Raven Guard — compulsory-capable Troops" targetId="r43-rg-compulsory-troops" hidden="false" /><categoryLink id="r41-unit-xv-0-sekhmet-terminator-cabal-r45-coils-comp" name="Coils — compulsory-capable Troops" targetId="r45-al-coils-compulsory" hidden="false" /><categoryLink id="r41-unit-xv-0-sekhmet-terminator-cabal-primarchs-chosen-troops" name="Troops — Pride / Primarch's Chosen" hidden="true" targetId="cat-troops" primary="true"><modifiers><modifier id="r41-unit-xv-0-sekhmet-terminator-cabal-pc-show-t