          <modifier id="live-r2-r41-unit-xv-8-magistus-amon-the-hidden-retinue-1-r71-nl-gen-7-stealth-show-r62-shat-02169c518c56" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-d1b0d24ff349" shared="true" includeChildSelections="true" includeChildForces="false" />
