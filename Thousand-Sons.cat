      <selectionEntryGroup id="r19-ts-osiron-disciplines" name="Psychic Dreadnought — Psychic Discipline(s)" hidden="false"><constraints><constraint id="r19-ts-osiron-disc-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /><constraint id="r19-ts-osiron-disc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><entryLink id="r19-ts-osiron-disc-biomancy" name="Biomancy" targetId="r41-universal-gear-706f9080995c1b" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r19-ts-osiron-disc-biomancy-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink><entryLink id="r19-ts-osiron-disc-divination" name="Divination" targetId="r41-universal-gear-bfc6aadae625e5" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r19-ts-osiron-disc-divination-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink><entryLink id="r19-ts-osiron-disc-pyromancy" name="Pyromancy" targetId="r41-universal-gear-60848d7505639d" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r19-ts-osiron-disc-pyromancy-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink><entryLink id="r19-ts-osiron-disc-telekinesis" name="Telekinesis" targetId="r41-universal-gear-009614a01cab65" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r19-ts-osiron-disc-telekinesis-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><