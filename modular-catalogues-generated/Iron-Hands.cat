    <selectionEntry type="unit" import="true" name="Ferrus Manus, the Gorgon" hidden="false" id="r41-unit-x-7-x-ferrus-manus-the-gorgon">
      <infoLinks><infoLink id="r36-link-7591bc597b80" name="Primarch" hidden="false" targetId="r36-shared-primarch-842ed37" type="rule" /><infoLink id="r36-link-564339d085d7" name="The Gorgon" hidden="false" targetId="r36-exact-the-gorgon-474fc9e" type="rule" /><infoLink id="r36-link-5024d9933792" name="Master of the Forge" hidden="false" targetId="r36-exact-master-of-the-forge-6ad54a1" type="rule" /></infoLinks><costs>
