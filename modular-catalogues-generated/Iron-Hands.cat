        <selectionEntry type="upgrade" import="true" name="Nuncio Vox" hidden="false" id="r81-ih-ferrus-nuncio-vox" defaultAmount="1">
          <rules>
            <rule name="Nuncio Vox" id="r81-ih-ferrus-nuncio-vox-rule-nuncio" hidden="false">
              <description>A friendly unit arriving by Deep Strike does not scatter if its centre model is initially placed within 6" of the bearer. The bearer must have been on the battlefield at the beginning of the turn, must not be Pinned or Falling Back, and must not be embarked upon a Transport.</description>
            </rule>
          </rules>
          <constraints>
            <constraint id="r81-ih-ferrus-nuncio-vox-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
            <constraint id="r81-ih-ferrus-nuncio-vox-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
        </selectionEntry>
