        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" />
          <condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
        </modifier>
      <modifier type="set" value="true" field="hidden" id="mod-r62-shat-4f497ff6d5c1">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-7fc0e1a0a666" shared="true" includeChildSelections="true" includeChildForces="false" />
          <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="r41-unit-x-3-venerable-forge-lord-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <rules>
        <rule id="r79-ih-rule-r41-unit-x-3-venerable-forge-lord-old-wise" name="Old &amp; Wise" hidden="false">
          <description>If the mission requires a roll to determine first turn, an Iron Hands army containing a Venerable Forge Lord may re-roll that roll once; the second result stands.</description>
        </rule>
        <rule id="r79-ih-rule-r41-unit-x-3-venerable-forge-lord-hard-to-kill" name="Hard to Kill" hidden="false">
          <description>Whenever the Venerable Forge Lord suffers a Glancing or Penetrating Hit and a Vehicle Damage result is rolled, the Iron Hands player may force the opponent to re-roll that result; the second result stands.</description>
        </rule>
        <rule id="r79-ih-rule-r41-unit-x-3-venerable-forge-lord-auto-repair-simulacra" name="Auto-Repair Simulacra" hidden="false">
          <description>Whenever a Vehicle Damage result would destroy the Venerable Forge Lord, roll a D6 after resolving Hard to Kill. On a 6, it is not destroyed; replace the result with Crew Shaken.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
