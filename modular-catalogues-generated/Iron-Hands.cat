    <selectionEntry type="unit" import="true" name="Venerable Forge Lord" hidden="false" id="r41-unit-x-3-venerable-forge-lord">
      <costs>
        <cost name="Points" typeId="pts" value="155" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-x-3-venerable-forge-lord-cat" name="Elites" hidden="false" targetId="cat-elites" primary="true" />
      </categoryLinks>
