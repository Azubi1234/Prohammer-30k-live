                <entryLink id="r79-ih-ferrus-termcommand-hq-praetor-ret-tc-champ" name="Terminator Champion" targetId="r41-universal-gear-ebbb1c58810cc6" type="selectionEntry" import="true" hidden="false"><constraints>
                    <constraint id="r79-ih-ferrus-termcommand-hq-praetor-ret-tc-champ-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  </entryLink><selectionEntry id="r79-ih-ferrus-termcommand-r73-nl-bj-11" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  <constraints>
                    <constraint id="r79-ih-ferrus-termcommand-r73-nl-bj-11-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r79-ih-ferrus-termcommand-r73-nl-bj-11-rule" name="Beyond Judgement" hidden="false">
                      <description>Under Horror Cult this unit purchases Beyond Judgement for +25 points. Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model; multiple Trophies penalties remain non-cumulative.

Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.</description>
                    </rule>
                  </rules>
                  <modifiers>
                    <modifier id="r79-ih-ferrus-termcommand-r73-nl-bj-11-show" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
