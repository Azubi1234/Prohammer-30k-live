      <categoryLink id="r62-limit-link-7b6eee1872d7" name="Shattered 0–1 — Ferrus Manus, the Gorgon" targetId="r62-shat-limit-a6e22b6610da" hidden="false" /></categoryLinks>
      <modifiers>
