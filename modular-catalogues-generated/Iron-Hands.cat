                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">1</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">2</characteristic>
                        <characteristic name="Ld" typeId="model-ld">10</characteristic>
