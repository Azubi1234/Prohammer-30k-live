r-scale-3" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r79-ih-ferrus-honour-hq-praetor-ret-honour-land-land-raider-proteus" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r79-ih-ferrus-honour-hq-praetor-ret-honour-scale-4" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r79-ih-ferrus-honour-hq-praetor-ret-honour-land-land-raider-achilles" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r79-ih-ferrus-honour-hq-praetor-ret-honour-hide" type="set" field="hidden" value="true"><conditions /></modifier></modifiers></entryLink></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r2-fulgrim-blessing-r79-ih-ferrus-honour-hq-praetor-ret-honour-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-r79-ih-ferrus-honour-hq-praetor-ret-honour" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="25" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-r79-ih-ferrus-honour-hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-r79-ih-ferrus-honour-hq-praetor-ret-honour-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-r79-ih-ferrus-honour-hq-praetor-ret-honour-hide" type="set" field="hidden" value="true"><conditions /></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
