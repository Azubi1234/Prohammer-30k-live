                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="60" />
                  </costs>
                  </entryLink><selectionEntry id="r71-nl-gen-21-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="0" />
                  </costs>
                  <constraints>
                    <constraint id="r71-nl-gen-21-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <modifiers>
                    <modifier id="r71-nl-gen-21-stealth-cost-0" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r52-ec-ful-honour-hq-praetor-ret-honour-champ" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
                    </modifier>
                    <modifier id="r71-nl-gen-21-stealth-cost-1" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r52-ec-ful-honour-hq-praetor-ret-honour-base" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
                    </modifier>
                    <modifier id="r71-nl-gen-21-stealth-show" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <rules>
                    <rule id="r71-nl-gen-21-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
                      <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.

Stealth: Adds +1 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 6+ Cover Save. Does not stack with Shrouded.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="r71-nl-bj-24" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  <constraints>
                    <constraint id="r71-nl-bj-24-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r71-nl-bj-24-rule" name="Beyond Judgement" hidden="false">
                      <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.

Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.</description>
                    </rule>
                  </rules>
                  <modifiers>
                    <modifier id="r71-nl-bj-24-show" type="set" value="false" field="hidden">
                      <conditionGroups>
