      </profiles>
      <selectionEntries>
        <selectionEntry id="r52-ec-ful-fixed-0" name="Gilded Panoply" type="upgrade" hidden="false" import="true" defaultAmount="1">
          <constraints>
            <constraint id="r52-ec-ful-fixed-0-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
            <constraint id="r52-ec-ful-fixed-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
        </selectionEntry>
        <selectionEntry id="r52-ec-ful-fixed-1" name="Firebrand" type="upgrade" hidden="false" import="true" defaultAmount="1">
          <constraints>
            <constraint id="r52-ec-ful-fixed-1-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
            <constraint id="r52-ec-ful-fixed-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule id="r52-ec-ful-rule-1" name="Legiones Astartes (Emperor's Children)" hidden="false">
          <description>Fulgrim has the Emperor's Children Legion rules.</description>
        </rule>
        <rule id="r52-ec-ful-rule-2" name="Gilded Panoply" hidden="false">
          <description>Counts as Primarch Armour, except Fulgrim has a 5+ Invulnerable Save against ranged attacks and a 3+ Invulnerable Save against close-combat attacks.</description>
        </rule>
        <rule id="r52-ec-ful-rule-3" name="Sublime Swordsman" hidden="false">
          <description>When Fulgrim directs close-combat attacks against an enemy model with Weapon Skill 6 or higher, he may re-roll To Hit rolls of 1.</description>
        </rule>
        <rule id="r52-ec-ful-rule-4" name="Perfect Execution" hidden="false">
          <description>During an Assault phase in which Fulgrim charged, increase his Initiative and Attacks by +1 for that Assault phase.</description>
        </rule>
        <rule id="r52-ec-ful-rule-5" name="Sire of Perfection" hidden="false">
          <description>Once during each player turn, when a friendly Emperor's Children unit within 12 inches is selected to shoot or fight, it may re-roll To Hit rolls of 1 for the remainder of that phase.</description>
        </rule>
        <rule id="r52-ec-ful-rule-6" name="Pride of the Phoenician" hidden="false">
          <description>When Fulgrim fights an enemy Independent Character or Primarch, he gains +1 Attack against that model for each point by which his WS exceeds its WS, to a maximum of +2 Attacks.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r52-ec-ful-weapons" name="Choose Melee Weapon" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r52-ec-ful-weapons-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="r52-ec-ful-fireblade" name="Fireblade" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-ful-fireblade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="0" />
              </costs>
              <rules>
                <rule id="r52-ec-ful-fireblade-rule" name="Fireblade" hidden="false">
                  <description>Master-crafted Power Weapon. Attacks are resolved at +1 Strength and have Shred.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r52-ec-ful-laer" name="Blade of the Laer" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-ful-laer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="0" />
              </costs>
              <rules>
                <rule id="r52-ec-ful-laer-rule" name="Blade of the Laer" hidden="false">
                  <description>Master-crafted, Two-Handed Power Weapon. Attacks are resolved at Fulgrim's normal Strength and have Fleshbane.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="r52-ec-ful-retinue" name="Primarch Retinue (does not occupy a separate FOC slot)" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r52-ec-ful-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Honour Guard Squad" id="r52-ec-ful-honour" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-ful-honour-hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="55" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r52-ec-ful-honour-hq-praetor-ret-honour-std" hidden="false">
                  <description>Every model wears Artificer Armour and carries a Refractor Field, Power Weapon, Bolt Pistol and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="r52-ec-ful-honour-hq-praetor-ret-honour-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Honour or Death" id="r52-ec-ful-honour-hq-praetor-ret-honour-hod" hidden="false">
                  <description>If the Legion Champion is in base contact with one or more enemy Independent Characters, he must direct all of his close-combat attacks against one of them. When attacking an enemy Independent Character in close combat, he may re-roll failed To Hit and To Wound rolls.</description>
                </rule>
                <rule name="Retinue" id="r52-ec-ful-honour-hq-praetor-ret-honour-ret" hidden="false">
                  <description>Selected for an eligible Praetor or Primarch. It occupies no separate Force Organisation slot; the commander and Honour Guard count as a single HQ selection but do not have to deploy together and operate as separate units after deployment.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Legion Champion" id="r52-ec-ful-honour-hq-praetor-ret-honour-champ" hidden="false" import="true" defaultAmount="1">
                  <constraints>
                    <constraint id="r52-ec-ful-honour-hq-praetor-ret-honour-champ-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r52-ec-ful-honour-hq-praetor-ret-honour-champ-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
