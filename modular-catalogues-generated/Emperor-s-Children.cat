                        <characteristic name="Ld" typeId="model-ld">10</characteristic>
                        <characteristic name="Sv" typeId="model-sv">2+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry type="model" name="Legion Honour Guard" id="r52-ec-eid-honour-hq-praetor-ret-honour-base" hidden="false" import="true" defaultAmount="2">
                  <constraints>
                    <constraint id="r52-ec-eid-honour-hq-praetor-ret-honour-base-min" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r52-ec-eid-honour-hq-praetor-ret-honour-base-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Honour Guard" id="r52-ec-eid-honour-hq-praetor-ret-honour-base-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">5</characteristic>
                        <characteristic name="BS" typeId="model-bs">5</characteristic>
