                      <constraints>
                        <constraint id="r52-ec-ful-phoenix-retinue-r52-ec-ph-harness-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="10" />
                      </costs>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
                <selectionEntryGroup id="r52-ec-ful-phoenix-retinue-r52-ec-ph-transport" name="Dedicated Transport" hidden="false" collective="false" import="true">
                  <constraints>
                    <constraint id="r52-ec-ful-phoenix-retinue-r52-ec-ph-transport-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </constraints>
                  <entryLinks>
                    <entryLink id="r52-ec-ful-phoenix-retinue-r52-ec-ph-transport-land-raider" name="Legion Land Raider Battle Squadron" type="selectionEntry" targetId="hs-land-raider" hidden="false" import="true">
                      <constraints>
                        <constraint id="r52-ec-ful-phoenix-retinue-r52-ec-ph-transport-land-raider-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
                    </entryLink>
                    <entryLink id="r52-ec-ful-phoenix-retinue-r52-ec-ph-transport-spartan" name="Legion Spartan Assault Tank" type="selectionEntry" targetId="hs-spartan" hidden="false" import="true">
                      <constraints>
                        <constraint id="r52-ec-ful-phoenix-retinue-r52-ec-ph-transport-spartan-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
