      <rules>
        <rule id="r52-ec-sun-rule-0" name="Exemplary Marksmen" hidden="false">
          <description>Once during each friendly Shooting phase, the Sun Killer Squad may re-roll one failed shooting To Hit roll. The second result must be accepted.</description>
        </rule>
      </rules>
