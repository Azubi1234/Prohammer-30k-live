          <rules>
            <rule id="r52-ec-luc-ret-rule" name="Command Retinue" hidden="false">
              <description>Lucius may select one Legion Command Squad. It occupies no separate Force Organisation slot; Lucius and the Command Squad count as one HQ selection but may deploy and operate separately.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
