                </selectionEntryGroup>
              <selectionEntryGroup id="live-r2-fulgrim-blessing-r52-ec-ful-phoenix-retinue-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-r52-ec-ful-phoenix-retinue" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="25" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-r52-ec-ful-phoenix-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-r52-ec-ful-phoenix-retinue-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-r52-ec-ful-phoenix-retinue-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-10-fulgrim-transfigured" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
              </selectionEntry>
          </selectionEntries>
          <rules>
            <rule id="r52-ec-ful-ret-rule" name="Primarch Retinue" hidden="false">
              <description>Fulgrim may select one Legion Honour Guard Squad, Legion Terminator Command Squad or Phoenix Terminator Squad. It does not occupy an additional Force Organisation selection.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Fulgrim Transfigured" hidden="false" id="r41-unit-iii-10-fulgrim-transfigured">
      <costs>
        <cost name="Points" typeId="pts" value="600" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-iii-10-fulgrim-transfigured-cat" name="Lords of War" hidden="false" targetId="cat-low" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-iii" shared="true" includeChildSelections="true" includeChildForces="false" />
          <condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
        </modifier>
      <modifier id="live-r2-fulgrim-transfigured-hide-mortal" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r41-unit-iii-9-fulgrim-the-phoenician" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier type="set" value="true" field="hidden" id="mod-r62-shat-c22a86fd73af">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-2275c2888fe8" shared="true" includeChildSelections="true" includeChildForces="false" />
          <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="r41-unit-iii-10-fulgrim-transfigured-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <profiles>
        <profile name="Fulgrim Transfigured" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-iii-10-fulgrim-transfigured-profile-0">
