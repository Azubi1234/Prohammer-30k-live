          </entryLinks>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Land Raider" id="r64-if-templar-transport-lr-hs-land-raider" hidden="false" import="true">
              <rules>
                <rule name="Squadron Composition" id="r64-if-templar-transport-lr-hs-lr-comp-rule" hidden="false">
                  <description>Select 1–3 Land Raiders. Any may be Phobos or Proteus patterns; no more than one may be an Achilles.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Land Raider Patterns" id="r64-if-templar-transport-lr-hs-lr-patterns" hidden="false">
                  <constraints>
                    <constraint id="r64-if-templar-transport-lr-hs-lr-patterns-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                    <constraint id="r64-if-templar-transport-lr-hs-lr-patterns-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="model" name="Land Raider Phobos" id="r64-if-templar-transport-lr-hs-lr-phobos" hidden="false" import="true" defaultAmount="1">
