assign-ad4501808477-info-75dd0ee7c4b0" name="Legiones Astartes (Raven Guard)" targetId="r43-rg-legiones-astartes-raven-guard" type="rule" hidden="false" /><infoLink id="r62-shat-assign-ad4501808477-info-9ab1bf1e85f1" name="Surgical Strike" targetId="r43-rg-surgical-strike" type="rule" hidden="false" /><infoLink id="r62-shat-assign-ad4501808477-info-047f7cf538c3" name="Rapid Reaction" targetId="r43-rg-rapid-reaction" type="rule" hidden="false" /><infoLink id="r62-shat-assign-ad4501808477-info-db41feea9956" name="Shadow Masters" targetId="r43-rg-shadow-masters" type="rule" hidden="false" /><infoLink id="r62-shat-assign-ad4501808477-info-c90b6dc986fe" name="Limited Vehicles" targetId="r43-rg-limited-vehicles" type="rule" hidden="false" /><infoLink id="r62-shat-assign-ad4501808477-info-cd49071cd572" name="Raven's Talons" targetId="r43-rg-raven-s-talons" type="rule" hidden="false" /><infoLink id="r62-shat-assign-ad4501808477-info-9c3d09934245" name="Infravisor" targetId="r43-rg-infravisor" type="rule" hidden="false" /><infoLink id="r62-shat-assign-ad4501808477-info-3ddc92495b50" name="Shroud Bombs" targetId="r43-rg-shroud-bombs" type="rule" hidden="false" /><infoLink id="r62-shat-assign-ad4501808477-info-ca5136e64e22" name="Cameleoline" targetId="r43-rg-cameleoline" type="rule" hidden="false" /><infoLink id="r62-shat-assign-ad4501808477-info-abb7821cf8bd" name="Teleportation Transponders" targetId="r43-rg-teleportation-transponders" type="rule" hidden="false" /></infoLinks><rules><rule id="r62-shat-assign-ad4501808477-identity" name="Legiones Astartes (Raven Guard)" hidden="false"><description>This unit is assigned to Raven Guard for the Shattered Legions Theme. It uses the normal Raven Guard Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-ad4501808477-hide-not-const" type