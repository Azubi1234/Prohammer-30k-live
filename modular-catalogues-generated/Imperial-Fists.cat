                <entryLink id="r64-if-garrius-term-hq-praetor-ret-tc-champ" name="Terminator Champion" targetId="r41-universal-gear-ebbb1c58810cc6" type="selectionEntry" import="true" hidden="false"><constraints>
                    <constraint id="r64-if-garrius-term-hq-praetor-ret-tc-champ-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
