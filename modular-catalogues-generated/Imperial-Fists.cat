                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  </entryLink><selectionEntry id="r73-nl-bj-45" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  <constraints>
                    <constraint id="r73-nl-bj-45-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r73-nl-bj-45-rule" name="Beyond Judgement" hidden="false">
                      <description>Under Horror Cult this unit purchases Beyond Judgement for +25 points. Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model; multiple Trophies penalties remain non-cumulative.

Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.</description>
                    </rule>
                  </rules>
                  <modifiers>
                    <modifier id="r73-nl-bj-45-show" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  <modifier id="r73-nl-bj-45-show-r62-shat-a34c25e46713" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-698747362a31" shared="true" includeChildSelections="true" includeChildForces="false" />
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
