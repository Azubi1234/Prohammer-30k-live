                      <entryLink id="r32-soh-maloghurst-link-7" name="Maloghurst the Twisted" hidden="false" type="selectionEntry" targetId="r32-soh-maloghurst-replacement" import="true"><constraints><constraint id="r32-soh-maloghurst-link-7-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><modifiers><modifier id="r32-soh-maloghurst-link-7-legion" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r32-soh-maloghurst-link-7-legion-r62-shat-a5682a8831fc" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-9be35cd03fd5" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></entryLink></entryLinks>
