        <categoryLink id="r64-if-r41-unit-vii-3-tarantula-sentry-gun-battery-r64-if-cat-tarantula-limit" name="Tarantula Batteries 0-2" hidden="true" targetId="r64-if-cat-tarantula-limit" primary="false" />
      <categoryLink id="r41-unit-vii-3-tarantula-sentry-gun-battery-r40-covsup" name="Covenant of Fire — Fast/Heavy choices" targetId="r40-sal-covenant-support" hidden="false" /></categoryLinks>
