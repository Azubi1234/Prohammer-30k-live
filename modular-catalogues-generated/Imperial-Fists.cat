      <modifier type="set" value="true" field="hidden" id="mod-r62-shat-101917d3bb9f">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-d4f463d37ce3" shared="true" includeChildSelections="true" includeChildForces="false" />
          <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
