      </constraints>
      <profiles>
        <profile name="Alexis Polux" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-vii-6-alexis-polux-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
            <characteristic name="BS" typeId="model-bs">5</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">3</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">4</characteristic>
            <characteristic name="Ld" typeId="model-ld">9</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+/3+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="pts" value="170" />
      </costs>
      <rules>
        <rule id="r64-if-polux-wargear" name="Wargear" hidden="false">
          <description>Power Armour, Vigil Pattern Storm Shield, Terminator Honours, Combi-meltagun, Master-crafted Power Fist, Frag grenades.</description>
        </rule>
        <rule id="r64-if-polux-special" name="Special Rules" hidden="false">
          <description>Legiones Astartes (Imperial Fists), Independent Character, Master of the Legion, Stubborn, Teleport Transponder, The Crimson Fist.</description>
        </rule>
        <rule id="r64-if-polux-shield" name="Vigil Pattern Storm Shield" hidden="false">
          <description>Grants a 3+ Invulnerable Save. Occupies one hand and prevents Polux from gaining the bonus Attack for fighting with two close-combat weapons.</description>
        </rule>
        <rule id="r64-if-polux-trans" name="Teleport Transponder" hidden="false">
          <description>Before deployment, Polux may be assigned to one Legion Terminator Squad, Legion Terminator Command Squad or Huscarl Terminator Retinue. Polux and the nominated unit gain Deep Strike and must enter play together if they use this rule.</description>
        </rule>
        <rule id="r64-if-polux-fist" name="The Crimson Fist" hidden="false">
          <description>At the beginning of an Assault phase in which Polux is engaged, he may make a single attack with his Master-crafted Power Fist instead of his normal attacks. It is resolved at Initiative 4 and Strength 8 and ignores Armour Saves. Polux makes exactly one attack that Assault phase regardless of bonuses.

Master-Crafted: Re-roll one failed To Hit roll per turn.</description>
        </rule>
        <rule id="r68-if-polux-wargear" name="ALEXIS POLUX — WARGEAR" hidden="false">
          <description>Power Armour; Vigil Pattern Storm Shield; Terminator Honours; Combi-meltagun; Master-crafted Power Fist; Frag grenades. Option: Krak grenades (+2).</description>
        </rule>
        <rule id="r68-if-polux-special" name="ALEXIS POLUX — SPECIAL RULES" hidden="false">
          <description>Legiones Astartes (Imperial Fists); Independent Character; Master of the Legion; Stubborn; Teleport Transponder; The Crimson Fist.</description>
        </rule>
      </rules>
      <selectionEntries>
        <entryLink id="r64-if-polux-krak" name="Krak grenades" targetId="gear-krak" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="r64-if-polux-krak-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
