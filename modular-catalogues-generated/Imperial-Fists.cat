                          <characteristics>
                            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                            <characteristic name="Front" typeId="vehicle-front">14</characteristic>
                            <characteristic name="Side" typeId="vehicle-side">14</characteristic>
                            <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="Twin-linked Lascannon" id="r64-if-warder-transport-lr-hs-lr-phobos-las" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
                            <characteristic name="S" typeId="ranged-s">9</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Heavy 1, Twin-linked</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="Twin-linked Heavy Bolter" id="r64-if-warder-transport-lr-hs-lr-phobos-hb" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                            <characteristic name="S" typeId="ranged-s">5</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Standard Wargear" id="r64-if-warder-transport-lr-hs-lr-phobos-wg" hidden="false">
                          <description>Two Twin-linked Lascannons, Twin-linked Heavy Bolter, Searchlight and Smoke Launchers. Power of the Machine Spirit; Assault Vehicle; Transport Capacity 10.</description>
                        </rule>
                        </rules>
                      <selectionEntries>
                        <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r64-if-warder-transport-lr-hs-lr-ph-up-hunter-killer-missile" hidden="false" import="true">
                          <constraints>
                            <constraint id="r64-if-warder-transport-lr-hs-lr-ph-up-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <modifiers>
                            <modifier type="set" value="2" field="r64-if-warder-transport-lr-hs-lr-ph-up-hunter-killer-missile-max">
                              <conditions>
