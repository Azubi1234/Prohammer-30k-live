    <selectionEntry type="unit" import="true" name="Xiaphas Jurr, Prophet of Fire" hidden="true" id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire">
      <rules><rule id="r40-jurr-wg" name="Wargear" hidden="false"><description>Artificer Armour, The Burning Halo, Dragonscale Storm Shield, Ignatus, Bolt Pistol, Frag Grenades.</description></rule><rule id="r40-jurr-halo" name="The Burning Halo" hidden="false"><description>Grants a 4+ Invulnerable Save. Each time Jurr passes this save against a close-combat attack of Strength 5 or greater, the attacking model suffers one Strength 4 hit.</description></rule><rule id="r40-jurr-ign-rule" name="Ignatus" hidden="false"><description>Master-crafted Power Weapon. During an Assault phase in which Jurr charges, attacks are resolved at +1 Strength.</description></rule><rule id="r40-jurr-chap" name="Chaplain-Lieutenant" hidden="false"><description>Counts as a Legion Chaplain Consul for army construction requirements and Rites of War.</description></rule><rule id="r40-jurr-prophet" name="Prophet of Fire" hidden="false"><description>Jurr is a Psyker (Mastery Level 1) and knows Fury of the Salamander. When taking a Psychic test he uses Leadership 7.</description></rule><rule id="r40-jurr-fury-rule" name="Fury of the Salamander" hidden="false"><description>Witchfire — Beam, Range 18", Strength 5, AP1, Assault 1. Elemental Horror: if an enemy unit suffers one or more unsaved Wounds, it immediately takes a Morale test with a Leadership penalty equal to the number of unsaved Wounds caused.</description></rule></rules><infoLinks><infoLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-sal-leg" name="Legiones Astartes (Salamanders)" targetId="r40-sal-legiones-astartes-salamanders" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-sal-promethean-cult" name="Promethean Cult" targetId="r40-sal-promethean-cult" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-sal-sturdy" name="Sturdy" targetId="r40-sal-sturdy" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-sal-never-give-up" name="Never Give Up" targetId="r40-sal-never-give-up" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-independent-character" name="Independent Character" targetId="r36-shared-independent-character-4fbd2ae" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-stubborn" name="Stubborn" targetId="r36-shared-stubborn-59f928d" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-dragonscale-storm-shield" name="Dragonscale Storm Shield" targetId="r40-sal-dragonscale-storm-shield" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-master-crafted" name="Master-Crafted" targetId="r36-shared-master-crafted-30feea6" type="rule" hidden="false" /><infoLink id="r40-jurr-ign" name="Ignatus" targetId="r40-sal-prof-ignatus" type="profile" hidden="false" /><infoLink id="r40-jurr-fury" name="Fury of the Salamander" targetId="r40-sal-prof-fury" type="profile" hidden="false" /></infoLinks><costs>
        <cost name="Points" typeId="pts" value="150" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      <categoryLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-r40-chap" name="Awakening Fire — Chaplain" targetId="r40-sal-awakening-chaplain" hidden="false" /><categoryLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-chapcat" name="Awakening Fire — Chaplain" targetId="r40-sal-awakening-chaplain" hidden="false" /><categoryLink id="r62-limit-link-05ab92cce15c" name="Shattered 0–1 — Xiaphas Jurr, Prophet of Fire" targetId="r62-shat-limit-babb1548e355" hidden="false" /></categoryLinks>
