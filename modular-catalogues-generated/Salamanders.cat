    <selectionEntry type="unit" import="true" name="Artellus Numeon" hidden="true" id="r41-unit-xviii-5-artellus-numeon">
      <rules><rule id="r40-num-wg" name="Wargear" hidden="false"><description>Artificer Armour, Iron Halo, Master-crafted Thunder Hammer, Bolt Pistol, Frag Grenades, Salamanders Mantle.</description></rule><rule id="r40-num-pyre" name="Captain of the Pyre Guard" hidden="false"><description>Numeon may select one Firedrake Terminator Squad as his personal retinue. One Firedrake in that unit may be upgraded to a Firedrake Master at no additional points cost. The squad occupies no separate Elites selection.</description></rule><rule id="r40-num-heir" name="Vulkan's Heir" hidden="false"><description>Numeon and any Salamanders unit he has joined may re-roll failed Morale tests.</description></rule><rule id="r40-num-command" name="Command Retinue" hidden="false"><description>Instead of Firedrakes, Numeon may select a Legion Command Squad or Legion Terminator Command Squad as his retinue.</description></rule></rules><infoLinks><infoLink id="r41-unit-xviii-5-artellus-numeon-sal-leg" name="Legiones Astartes (Salamanders)" targetId="r40-sal-legiones-astartes-salamanders" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-5-artellus-numeon-sal-promethean-cult" name="Promethean Cult" targetId="r40-sal-promethean-cult" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-5-artellus-numeon-sal-sturdy" name="Sturdy" targetId="r40-sal-sturdy" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-5-artellus-numeon-sal-never-give-up" name="Never Give Up" targetId="r40-sal-never-give-up" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-5-artellus-numeon-independent-character" name="Independent Character" targetId="r36-shared-independent-character-4fbd2ae" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-5-artellus-numeon-master-of-the-legion" name="Master of the Legion" targetId="r36-shared-master-of-the-legion-a3a88da" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-5-artellus-numeon-salamanders-mantle" name="Salamanders Mantle" targetId="r40-sal-salamanders-mantle" type="rule" hidden="false" /><infoLink id="r41-unit-xviii-5-artellus-numeon-master-crafted" name="Master-Crafted" targetId="r36-shared-master-crafted-30feea6" type="rule" hidden="false" /></infoLinks><costs>
