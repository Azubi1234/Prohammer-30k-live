    <selectionEntry type="unit" import="true" name="Kaedes Nex" hidden="true" id="r41-unit-xix-4-kaedes-nex">
      <rules><rule id="r43-nex-danger" name="Dangerous Weaponry" hidden="false"><description>The Raven Guard source lists Dangerous Weaponry for Kaedes Nex but does not define a Raven Guard effect for it. No additional rule effect is invented here.</description></rule><rule id="r43-nex-wg" name="Wargear" hidden="false"><description>Power Armour, Refractor Field, two Fulcrum Hand Cannons, Rending Weapon, Jump Pack, Frag Grenades and Krak Grenades.</description></rule><rule id="r43-nex-join" name="No Independent Character may join Kaedes Nex's squad." hidden="false"><description>No Independent Character may join Kaedes Nex's squad.</description></rule></rules><infoLinks><infoLink id="r41-unit-xix-4-kaedes-nex-rg-leg" name="Legiones Astartes (Raven Guard)" targetId="r43-rg-legiones-astartes-raven-guard" type="rule" hidden="false" /><infoLink id="r41-unit-xix-4-kaedes-nex-rg-surgical-strike" name="Surgical Strike" targetId="r43-rg-surgical-strike" type="rule" hidden="false" /><infoLink id="r41-unit-xix-4-kaedes-nex-rg-rapid-reaction" name="Rapid Reaction" targetId="r43-rg-rapid-reaction" type="rule" hidden="false" /><infoLink id="r41-unit-xix-4-kaedes-nex-rg-shadow-masters" name="Shadow Masters" targetId="r43-rg-shadow-masters" type="rule" hidden="false" /><infoLink id="r41-unit-xix-4-kaedes-nex-rg-limited-vehicles" name="Limited Vehicles" targetId="r43-rg-limited-vehicles" type="rule" hidden="false" /><infoLink id="r41-unit-xix-4-kaedes-nex-the-raven-s-due" name="The Raven's Due" targetId="r43-rg-the-raven-s-due" type="rule" hidden="false" /><infoLink id="r41-unit-xix-4-kaedes-nex-executioner-s-instinct" name="Executioner's Instinct" targetId="r43-rg-executioner-s-instinct" type="rule" hidden="false" /><infoLink id="r43-nex-fulcrum" name="Fulcrum Hand Cannon" targetId="r43-rg-prof-fulcrum" type="profile" hidden="false" /></infoLinks><costs>
