            <selectionEntry type="unit" name="Legion Terminator Command Squad" id="r43-corax-ret-1" hidden="false" import="true">
              <constraints>
                <constraint id="r43-corax-ret-1-hq-praetor-ret-termcommand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="215" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r43-corax-ret-1-hq-praetor-ret-tc-std" hidden="false">
                  <description>Five Terminator Veterans, each equipped with the selected Terminator Armour pattern, a Combi-Bolter and a Power Weapon.</description>
                </rule>
                <rule name="Legiones Astartes" id="r43-corax-ret-1-hq-praetor-ret-tc-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Retinue" id="r43-corax-ret-1-hq-praetor-ret-tc-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character equipped with Terminator, Tartaros or Cataphractii Terminator Armour. It occupies no separate Force Organisation slot; the character and squad count as one HQ selection but may deploy and operate separately.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Terminator Veterans" id="r43-corax-ret-1-hq-praetor-ret-tc-vets" hidden="false" import="true" defaultAmount="5">
                  <constraints>
                    <constraint id="r43-corax-ret-1-hq-praetor-ret-tc-vets-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r43-corax-ret-1-hq-praetor-ret-tc-vets-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Terminator Veteran" id="r43-corax-ret-1-hq-praetor-ret-tc-vets-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">4</characteristic>
                        <characteristic name="BS" typeId="model-bs">4</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">1</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">2</characteristic>
                        <characteristic name="Ld" typeId="model-ld">9</characteristic>
                        <characteristic name="Sv" typeId="model-sv">2+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <entryLink id="r43-corax-ret-1-hq-praetor-ret-tc-apoth" name="Terminator Apothecary" targetId="r41-universal-gear-6ef6e71c5c46ca" type="selectionEntry" import="true" hidden="false"><constraints>
                    <constraint id="r43-corax-ret-1-hq-praetor-ret-tc-apoth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  </entryLink><selectionEntry type="upgrade" name="Terminator Standard Bearer" id="r43-corax-ret-1-hq-praetor-ret-tc-standard" hidden="false" import="true">
                  <constraints>
                    <constraint id="r43-corax-ret-1-hq-praetor-ret-tc-standard-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <infoLinks><infoLink id="r43-corax-ret-1-r36-link-56d776596a2d" name="Terminator Standard Bearer" hidden="false" targetId="r36-exact-terminator-standard-bearer-7642801" type="rule" /></infoLinks><costs>
                    <cost name="Points" typeId="pts" value="0" />
