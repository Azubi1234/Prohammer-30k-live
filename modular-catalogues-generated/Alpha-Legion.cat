                        <characteristic name="Ld" typeId="model-ld">10</characteristic>
                        <characteristic name="Sv" typeId="model-sv">2+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry type="model" name="Legion Honour Guard" id="r45-alp-ret-0-hq-praetor-ret-honour-base" hidden="false" import="true" defaultAmount="2">
                  <constraints>
                    <constraint id="r45-alp-ret-0-hq-praetor-ret-honour-base-min" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r45-alp-ret-0-hq-praetor-ret-honour-base-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Honour Guard" id="r45-alp-ret-0-hq-praetor-ret-honour-base-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">5</characteristic>
                        <characteristic name="BS" typeId="model-bs">5</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">1</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">2</characteristic>
                        <characteristic name="Ld" typeId="model-ld">10</characteristic>
                        <characteristic name="Sv" typeId="model-sv">2+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Points" typeId="pts" value="40" />
                  </costs>
                </selectionEntry>
                <entryLink id="r45-alp-ret-0-hq-praetor-ret-honour-standard" name="Legion Standard Bearer" targetId="r41-universal-gear-98573737b15985" type="selectionEntry" import="true" hidden="false"><constraints>
                    <constraint id="r45-alp-ret-0-hq-praetor-ret-honour-standard-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="60" />
                  </costs>
                  </entryLink><selectionEntry id="r45-alp-ret-0-r71-nl-gen-9-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="0" />
                  </costs>
                  <constraints>
                    <constraint id="r45-alp-ret-0-r71-nl-gen-9-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <modifiers>
                    <modifier id="r45-alp-ret-0-r71-nl-gen-9-stealth-cost-0" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r45-alp-ret-0-hq-praetor-ret-honour-champ" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
                    </modifier>
                    <modifier id="r45-alp-ret-0-r71-nl-gen-9-stealth-cost-1" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r45-alp-ret-0-hq-praetor-ret-honour-base" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
                    </modifier>
                    <modifier id="r45-alp-ret-0-r71-nl-gen-9-stealth-show" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <rules>
                    <rule id="r45-alp-ret-0-r71-nl-gen-9-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
                      <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.

Stealth: Adds +1 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 6+ Cover Save. Does not stack with Shrouded.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="r45-alp-ret-0-r71-nl-bj-10" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  <constraints>
                    <constraint id="r45-alp-ret-0-r71-nl-bj-10-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r45-alp-ret-0-r71-nl-bj-10-rule" name="Beyond Judgement" hidden="false">
                      <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.

Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.</description>
                    </rule>
                  </rules>
                  <modifiers>
                    <modifier id="r45-alp-ret-0-r71-nl-bj-10-show" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                </selectionEntry>
              </selectionEntries>
              <entryLinks>
                <entryLink import="true" name="Bolt Pistol" id="r45-alp-ret-0-hq-praetor-ret-honour-bp" type="selectionEntry" targetId="gear-bolt-pistol" hidden="false" defaultAmount="1">
                  <constraints>
                    <constraint id="r45-alp-ret-0-hq-praetor-ret-honour-bp-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
