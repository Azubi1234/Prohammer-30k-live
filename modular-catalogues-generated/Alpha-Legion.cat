        <selectionEntryGroup id="r45-pech-ret-3-r57-fa-seeker-iw" name="Iron Warriors Armoury" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="r45-pech-ret-3-r57-fa-seeker-iw-shrapnel" name="Shrapnel Bolts" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-pech-ret-3-r57-fa-seeker-iw-shrapnel-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" id="r45-pech-ret-3-r57-fa-seeker-iw-shrapnel-pts" />
              </costs>
              <rules>
                <rule id="r45-pech-ret-3-r57-fa-seeker-iw-shrapnel-rule" name="Shrapnel Bolts" hidden="false">
                  <description>Bolt Pistols, Bolters, Combi-Bolters, Storm Bolters, Heavy Bolters, Twin-linked Bolters and bolter components of Combi-Weapons carried by models in this unit gain Pinning. May not be combined with Special Issue Ammunition, Hellfire Rounds or another special ammunition type.

Pinning: Unsaved Wounds caused by this weapon force the unit to take a Pinning Test.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-pech-ret-3-r57-fa-seeker-iw-servo" name="Servo-Arm" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-pech-ret-3-r57-fa-seeker-iw-servo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="30" id="r45-pech-ret-3-r57-fa-seeker-iw-servo-pts" />
              </costs>
              <rules>
                <rule id="r45-pech-ret-3-r57-fa-seeker-iw-servo-rule" name="Servo-Arm" hidden="false">
                  <description>Follows the normal Servo-Arm rules in the Legiones Astartes Army List. A model equipped with a Jump Pack may not purchase a Servo-Arm.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-pech-ret-3-r57-fa-seeker-iw-bionics" name="Bionics" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-pech-ret-3-r57-fa-seeker-iw-bionics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
