    <selectionEntry type="unit" import="true" name="Alpharius, the Hydra" hidden="true" id="r41-unit-xx-10-xx-alpharius-the-hydra">
      <rules><rule id="r45-alp-wg" name="Wargear" hidden="false"><description>Pythian Scales, Pale Spear, Hydra's Spite and Frag Grenades.</description></rule><rule id="r45-alp-scales" name="Pythian Scales" hidden="false"><description>Counts as Primarch Armour.</description></rule></rules><infoLinks><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-al-leg" name="Legiones Astartes (Alpha Legion)" targetId="r45-al-legiones-astartes-alpha-legion" type="rule" hidden="false" /><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-al-hubris" name="Martial Hubris" targetId="r45-al-martial-hubris" type="rule" hidden="false" /><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-0" name="Counter-Attack" targetId="r36-shared-counter-attack-478972a" type="rule" hidden="true"><modifiers><modifier id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-0-show" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r46-al-mutable-0" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></infoLink><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-1" name="Furious Charge" targetId="r36-shared-furious-charge-5750d05" type="rule" hidden="true"><modifiers><modifier id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-1-show" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r46-al-mutable-1" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></infoLink><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-2" name="Infiltrate" targetId="r36-shared-infiltrate-88c13dc" type="rule" hidden="true"><modifiers><modifier id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-2-show" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r46-al-mutable-2" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></infoLink><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-3" name="Move Through Cover" targetId="r36-shared-move-through-cover-b95132d" type="rule" hidden="true"><modifiers><modifier id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-3-show" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r46-al-mutable-3" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></infoLink><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-4" name="Siege Specialists" targetId="r45-al-siege-specialists" type="rule" hidden="true"><modifiers><modifier id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-4-show" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r46-al-mutable-4" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></infoLink><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-5" name="Tank Hunters" targetId="r36-shared-tank-hunters-f3b906a" type="rule" hidden="true"><modifiers><modifier id="r41-unit-xx-10-xx-alpharius-the-hydra-mutable-r46-al-mutable-5-show" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r46-al-mutable-5" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></infoLink><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-primarch" name="Primarch" targetId="r36-shared-primarch-842ed37" type="rule" hidden="false" /><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-master-of-lies" name="Master of Lies" targetId="r45-al-master-of-lies" type="rule" hidden="false" /><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-the-hydra" name="The Hydra" targetId="r45-al-the-hydra" type="rule" hidden="false" /><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-sire-of-the-alpha-legion" name="Sire of the Alpha Legion" targetId="r45-al-sire-of-the-alpha-legion" type="rule" hidden="false" /><infoLink id="r41-unit-xx-10-xx-alpharius-the-hydra-i-am-alpharius" name="I Am Alpharius" targetId="r45-al-i-am-alpharius" type="rule" hidden="false" /><infoLink id="r45-alp-pale" name="Pale Spear" targetId="r45-al-prof-pale-spear" type="profile" hidden="false" /><infoLink id="r45-alp-spite" name="Hydra's Spite" targetId="r45-al-prof-hydras-spite" type="profile" hidden="false" /></infoLinks><selectionEntryGroups><selectionEntryGroup id="r45-alp-ret" name="Retinue — choose up to one (no separate FOC slot)" hidden="false"><constraints><constraint id="r45-alp-ret-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r45-alp-ret-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="unit" name="Legion Honour Guard Squad" id="r45-alp-ret-0" hidden="false" import="true">
              <constraints>
                <constraint id="r45-alp-ret-0-hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="55" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r45-alp-ret-0-hq-praetor-ret-honour-std" hidden="false">
                  <description>Every model wears Artificer Armour and carries a Refractor Field, Power Weapon, Bolt Pistol and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="r45-alp-ret-0-hq-praetor-ret-honour-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Honour or Death" id="r45-alp-ret-0-hq-praetor-ret-honour-hod" hidden="false">
                  <description>If the Legion Champion is in base contact with one or more enemy Independent Characters, he must direct all of his close-combat attacks against one of them. When attacking an enemy Independent Character in close combat, he may re-roll failed To Hit and To Wound rolls.</description>
                </rule>
                <rule name="Retinue" id="r45-alp-ret-0-hq-praetor-ret-honour-ret" hidden="false">
                  <description>Selected for an eligible Praetor or Primarch. It occupies no separate Force Organisation slot; the commander and Honour Guard count as a single HQ selection but do not have to deploy together and operate as separate units after deployment.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Legion Champion" id="r45-alp-ret-0-hq-praetor-ret-honour-champ" hidden="false" import="true" defaultAmount="1">
                  <constraints>
                    <constraint id="r45-alp-ret-0-hq-praetor-ret-honour-champ-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r45-alp-ret-0-hq-praetor-ret-honour-champ-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Champion" id="r45-alp-ret-0-hq-praetor-ret-honour-champ-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">6</characteristic>
                        <characteristic name="BS" typeId="model-bs">5</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">2</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
