ad-r32-blessing-nurgle" name="Blessing of Nurgle" type="upgrade" hidden="false" import="true"><constraints><constraint id="r46-al-reward-48-donor-r41-unit-xvi-2-chieftain-squad-r32-blessing-nurgle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="r46-al-reward-48-donor-r41-unit-xvi-2-chieftain-squad-r32-blessing-nurgle-scale" type="increment" field="pts" value="7"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r46-al-reward-48-donor-r41-unit-xvi-2-chieftain-squad-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r46-al-reward-48-donor-r41-unit-xvi-2-chieftain-squad-r32-blessing-nurgle-rule" name="Blessing of Nurgle" hidden="false"><description>All models gain +1 Toughness and Slow and Purposeful. Not available to Bikes, Jetbikes or Jump Infantry.

