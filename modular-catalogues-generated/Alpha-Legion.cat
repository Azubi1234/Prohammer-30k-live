ons></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r45-dyn-ret-0-r16-dg-plague-group-hq-centurion-ret-command" name="Sons of the Plague Father" hidden="false"><selectionEntries><entryLink id="r45-dyn-ret-0-r16-dg-plague-hq-centurion-ret-command" name="Upgrade to Plague Marines (+7 pts/model)" targetId="r41-universal-gear-b7875a2d8d95ae" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r45-dyn-ret-0-r16-dg-plague-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="r45-dyn-ret-0-r16-dg-plague-hq-centurion-ret-command-mortarion" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-xiv-9-mortarion-prince-of-decay" shared="true" includeChildSelections="true" includeChildForces="true" /></conditions></modifier><modifier id="r45-dyn-ret-0-r16-dg-plague-hq-centurion-ret-command-disq-0" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r45-dyn-ret-0-r69-centurion-command-bikes" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r45-dyn-ret-0-r16-dg-plague-hq-centurion-ret-command-disq-1" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r45-dyn-ret-0-r69-centurion-command-jetbikes" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r45-dyn-ret-0-r16-dg-plague-hq-centurion-ret-command-disq-2" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r45-dyn-ret-0-hq-centurion-ret-command-jump" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r45-dyn-ret-0-r16-dg-plague-hq-centurion-ret-command-disq-3" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r45-dyn-ret-0-hq-centurion-ret-command-bike" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r45-dyn-ret-0-r16-dg-plague-hq-centurion-ret-command-disq-4" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r45-dyn-ret-0-hq-centurion-ret-command-jet" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r45-dyn-ret-0-r16-dg-plague-hq-centurion-ret-command-cost-0" type="increment" field="pts" value="7"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r45-dyn-ret-0-hq-centurion-ret-command-vets" repeats="1" roundUp="false" /></repeats></modifier></modifiers></entryLink></selectionEntries></selectionEntryGroup></selectionEntryGroups>
            </selectionEntry>
            <selectionEntry type="unit" name="Legion Terminator Command Squad" id="r45-dyn-ret-1" hidden="false" import="true">
              <constraints>
                <constraint id="r45-dyn-ret-1-hq-praetor-ret-termcommand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="215" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r45-dyn-ret-1-hq-praetor-ret-tc-std" hidden="false">
                  <description>Five Terminator Veterans, each equipped with the selected Terminator Armour pattern, a Combi-Bolter and a Power Weapon.</description>
                </rule>
                <rule name="Legiones Astartes" id="r45-dyn-ret-1-hq-praetor-ret-tc-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Retinue" id="r45-dyn-ret-1-hq-praetor-ret-tc-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character equipped with Terminator, Tartaros or Cataphractii Terminator Armour. It occupies no separate Force Organisation slot; the character and squad count as one HQ selection but may deploy and operate separately.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Terminator Veterans" id="r45-dyn-ret-1-hq-praetor-ret-tc-vets" hidden="false" import="true" defaultAmount="5">
                  <constraints>
                    <constraint id="r45-dyn-ret-1-hq-praetor-ret-tc-vets-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r45-dyn-ret-1-hq-praetor-ret-tc-vets-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Terminator Veteran" id="r45-dyn-ret-1-hq-praetor-ret-tc-vets-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">4</characteristic>
                        <characteristic name="BS" typeId="model-bs">4</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">1</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">2</characteristic>
                        <characteristic name="Ld" typeId="model-ld">9</characteristic>
                        <characteristic name="Sv" typeId="model-sv">2+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <entryLink id="r45-dyn-ret-1-hq-praetor-ret-tc-apoth" name="Terminator Apothecary" targetId="r41-universal-gear-6ef6e71c5c46ca" type="selectionEntry" import="true" hidden="false"><constraints>
                    <constraint id="r45-dyn-ret-1-hq-praetor-ret-tc-apoth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  </entryLink><selectionEntry type="upgrade" name="Terminator Standard Bearer" id="r45-dyn-ret-1-hq-praetor-ret-tc-standard" hidden="false" import="true">
                  <constraints>
                    <constraint id="r45-dyn-ret-1-hq-praetor-ret-tc-standard-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <infoLinks><infoLink id="r45-dyn-ret-1-r36-link-56d776596a2d" name="Terminator Standard Bearer" hidden="false" targetId="r36-exact-terminator-standard-bearer-7642801" type="rule" /></infoLinks><costs>
                    <cost name="Points" typeId="pts" value="0" />
