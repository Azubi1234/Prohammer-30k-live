                          </constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="20" />
                          </costs>
                        </entryLink>
                        <entryLink import="true" name="Legion Standard" id="r45-dyn-ret-1-hq-praetor-ret-tc-ls" type="selectionEntry" targetId="gear-hq-legion-standard" hidden="false">
                          <constraints>
                            <constraint id="r45-dyn-ret-1-hq-praetor-ret-tc-ls-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="60" />
                          </costs>
