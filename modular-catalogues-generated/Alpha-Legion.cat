                  <selectionEntryGroups>
                    <selectionEntryGroup name="Standard" id="r45-dyn-ret-1-hq-praetor-ret-tc-standards" hidden="false">
                      <constraints>
                        <constraint id="r45-dyn-ret-1-hq-praetor-ret-tc-standards-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                        <constraint id="r45-dyn-ret-1-hq-praetor-ret-tc-standards-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                      </constraints>
                      <entryLinks>
                        <entryLink import="true" name="Legion Vexilla" id="r45-dyn-ret-1-hq-praetor-ret-tc-vex" type="selectionEntry" targetId="gear-hq-vexilla" hidden="false">
                          <constraints>
                            <constraint id="r45-dyn-ret-1-hq-praetor-ret-tc-vex-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
