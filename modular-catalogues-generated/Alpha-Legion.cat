              <costs>
                <cost name="Points" typeId="pts" value="5" id="r45-pech-ret-3-r57-fa-seeker-iw-bionics-pts" />
              </costs>
              <rules>
                <rule id="r45-pech-ret-3-r57-fa-seeker-iw-bionics-rule" name="Bionics" hidden="false">
                  <description>Iron Warriors Armoury price; otherwise follows the normal Bionics rules.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
