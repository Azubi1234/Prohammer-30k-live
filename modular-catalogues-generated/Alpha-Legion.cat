      <selectionEntryGroups><selectionEntryGroup id="r45-dyn-ret" name="Retinue — choose up to one (no separate FOC slot)" hidden="false"><constraints><constraint id="r45-dyn-ret-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r45-dyn-ret-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="unit" name="Legion Command Squad" id="r45-dyn-ret-0" hidden="false" import="true">
              <constraints>
                <constraint id="r45-dyn-ret-0-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
