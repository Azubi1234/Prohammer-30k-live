        <entryLink id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-assault-dfa-veteran-unit" name="Death from Above (Legion Assault Company)" targetId="r41-universal-gear-4a923840fad5ad" type="selectionEntry" import="true" hidden="true"><constraints>
            <constraint id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-assault-dfa-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
