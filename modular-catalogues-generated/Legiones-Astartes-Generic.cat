      <rules>
        <rule id="r52-ec-third-kako-r52-ec-ka-traitor" name="Traitor Only" hidden="false">
          <description>Kakophoni may only be selected in a Traitor Emperor's Children army.</description>
        </rule>
        </rules>
      <categoryLinks>
        <categoryLink id="r52-ec-third-kakophoni-troops-cat" name="Troops" targetId="cat-troops" hidden="false" primary="true" />
      <categoryLink id="r36-long-comp-1b3f79de96" name="Long March — compulsory Troops" targetId="r36-soh-long-compulsory-troops" hidden="false" /><categoryLink id="r52-ec-third-kakophoni-troops-r40-covcomp" name="Covenant of Fire — compulsory Troops" targetId="r40-sal-covenant-compulsory" hidden="false" /><categoryLink id="r52-ec-third-kakophoni-troops-r42-sal-comp" name="Salamanders — compulsory-capable Troops" targetId="r42-sal-compulsory-troops" hidden="false" /><categoryLink id="r52-ec-third-kakophoni-troops-r43-rg-comp" name="Raven Guard — compulsory-capable Troops" targetId="r43-rg-compulsory-troops" hidden="false" /><categoryLink id="r52-ec-third-kakophoni-troops-r45-coils-comp" name="Coils — compulsory-capable Troops" targetId="r45-al-coils-compulsory" hidden="false" /></categoryLinks>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Terminator Squad — Terminator Attack" hidden="false" id="r57-iw-golg-term-troops">
      <infoLinks><infoLink id="r36-link-1eb1c6fcb2bb" name="Implacable Advance" hidden="false" targetId="r36-shared-implacable-advance-76d1b91" type="rule" /></infoLinks><rules>
        <rule name="Standard Wargear" id="r57-iw-golg-term-troops-terminator-standard" hidden="false">
          <description>Every model is equipped with the selected Terminator Armour pattern, a Combi-bolter and a Power Weapon unless replaced below.</description>
        </rule>
        <rule name="Legiones Astartes" id="r57-iw-golg-term-troops-terminator-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Dedicated Transport" id="r57-iw-golg-term-troops-terminator-transport-rule" hidden="false">
          <description>The squad may select a Land Raider, a Land Raider variant with sufficient Transport Capacity, a Dreadclaw Drop Pod or a Spartan Assault Tank where permitted. A Dreadclaw can carry only five models in Terminator Armour, so it is selectable here only for a five-model squad. Land Raider and Spartan choices will become selectable when their vehicle entries are added.</description>
        </rule>
        <rule id="r57-iw-golg-term-rule" name="Terminator Attack" hidden="false">
          <description>Available only while Erasmus Golg is the army's Warlord. This unit is a Troops choice but may not fulfil a compulsory Troops selection.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Terminators" hidden="false" id="r57-iw-golg-term-troops-terminator-included" defaultAmount="4">
          <constraints>
            <constraint id="r57-iw-golg-term-troops-terminator-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r57-iw-golg-term-troops-terminator-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminators (included)" id="r57-iw-golg-term-troops-terminator-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="pts" value="30" />
          </costs>
        <modifiers><modifier id="r19-axis-max-r57-iw-golg-term-troops-terminator-included" type="set" field="r57-iw-golg-term-troops-terminator-included-min" value="9"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xv-0-the-axis-of-dissolution" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Terminator Sergeant" hidden="false" id="r57-iw-golg-term-troops-terminator-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="r57-iw-golg-term-troops-terminator-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r57-iw-golg-term-troops-terminator-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminator Sergeant" id="r57-iw-golg-term-troops-terminator-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+</characteristic>
              </characteristics>
            </profile>
