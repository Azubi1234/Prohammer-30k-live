            <selectionEntry type="upgrade" name="Legion Delegatus Consul" id="hq-consul-delegatus" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-delegatus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <infoLinks><infoLink id="r36-link-4f2df5deabd8" name="Master of the Legion" hidden="false" targetId="r36-shared-master-of-the-legion-a3a88da" type="rule" /></infoLinks><costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule name="Legion Delegatus Consul" id="hq-consul-delegatus-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Delegatus Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Delegated Authority" id="r29-delegatus-authority" hidden="false">
                  <description>A Delegatus may possess Master of the Legion in an army of fewer than 1,000 points. Unless the army contains its Primarch, a Delegatus with Master of the Legion must be the Warlord. A Detachment containing a Delegatus may not also contain a Legion Praetor.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="r80-ih-consul-cat-119" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                <categoryLink id="r81-ih-consul-cat-3" name="Head of the Gorgon — non-Forge Consul" hidden="true" targetId="r81-ih-nonforge-consul" primary="false" />
              </categoryLinks>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Esoterist Consul" id="hq-consul-esoterist" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-esoterist-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <rules>
                <rule name="Legion Esoterist Consul" id="hq-consul-esoterist-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Esoterist Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Psyker (Mastery Level 1)" id="r29-eso-psyker" hidden="false">
                  <description>The Esoterist is a Psyker with Mastery Level 1 and follows the ProHammer Classic psychic rules.</description>
                </rule>
                <rule name="Legion Support Officer" id="r29-eso-support" hidden="false">
                  <description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</description>
                </rule>
                <rule name="Forbidden Lore" id="r29-eso-lore" hidden="false">
                  <description>Select powers from Sanctic Daemonology or Malefic Daemonology regardless of Legion or Allegiance. Possession is not selectable because ProHammer restricts it to Mastery Level 2 or greater.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Psychic Discipline(s)" id="r29-eso-discipline-group" hidden="false">
                  <constraints>
                    <constraint id="r29-eso-discipline-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
