                    <selectionEntry id="r61-librarian-power1-telekinesis-levitation" name="Telekinesis — Levitation" type="upgrade" hidden="false" import="true">
                      <constraints>
                        <constraint id="r61-librarian-power1-telekinesis-levitation-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
