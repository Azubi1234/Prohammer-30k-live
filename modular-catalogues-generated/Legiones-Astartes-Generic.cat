                      <rules>
                        <rule name="Mental Fortitude" id="r29-lib-power-30-rule" hidden="false">
                          <description>Blessing — friendly unit within 24”. If Falling Back, immediately Regroups; target gains Fearless.

Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier type="set" value="true" field="hidden">
                          <conditions>
                            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-4" shared="true" includeChildSelections="true" />
