                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <profiles>
                        <profile id="r61-librarian-power1-divination-forewarning-profile" name="Forewarning" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
