udeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><selectionEntries><selectionEntry id="r32-soh-first-company-terminators-r32-blessing-khorne" name="Blessing of Khorne" type="upgrade" hidden="false" import="true"><constraints><constraint id="r32-soh-first-company-terminators-r32-blessing-khorne-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="5" /></costs><modifiers><modifier id="r32-soh-first-company-terminators-r32-blessing-khorne-scale" type="increment" field="pts" value="5"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r32-soh-first-company-term-terminator-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r32-soh-first-company-terminators-r32-blessing-khorne-rule" name="Blessing of Khorne" hidden="false"><description>All models gain +1 Attack.</description></rule></rules></selectionEntry><selectionEntry id="r32-soh-first-company-terminators-r32-blessing-slaanesh" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><constraints><constraint id="r32-soh-first-company-terminators-r32-blessing-slaanesh-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="4" /></costs><modifiers><modifier id="r32-soh-first-company-terminators-r32-blessing-slaanesh-scale" type="increment" field="pts" value="4"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r32-soh-first-company-term-terminator-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r32-soh-first-company-termina