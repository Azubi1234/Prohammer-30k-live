                              <description>The Psyker gains +3 Initiative, +3 Attacks and Fleet.

Fleet: Unit may still charge into melee combat even if it advanced this turn.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-burning-powers-p-biomancy-warp-speed-r80-ih-consul-cat-7" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
