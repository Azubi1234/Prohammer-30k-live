                        <profile id="r61-librarian-power1-telekinesis-psychic-maelstrom-profile" name="Psychic Maelstrom" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
                            <characteristic name="S" typeId="ranged-s">10</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Assault 1, Witchfire, Barrage, Large Blast</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r61-librarian-power1-telekinesis-psychic-maelstrom-rule" name="Psychic Maelstrom" hidden="false">
