        </profile>
        <profile name="Tempest Rocket" id="r32-aero-fireraptor-weapon-tempest-rocket-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">60"</characteristic>
            <characteristic name="S" typeId="ranged-s">6</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</characteristic>
          </characteristics>
