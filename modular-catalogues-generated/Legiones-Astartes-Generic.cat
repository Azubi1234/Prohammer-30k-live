                      <constraints>
                        <constraint id="r29-lib-power-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Enfeeble" id="r29-lib-power-2-rule" hidden="false">
                          <description>Malediction — enemy unit within 24”. -1 Strength and Toughness; treats all movement as Difficult Terrain.</description>
                        </rule>
                      </rules>
