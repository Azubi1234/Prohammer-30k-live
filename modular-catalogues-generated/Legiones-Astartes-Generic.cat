70" name="Mutable Tactics" targetId="r45-al-mutable-tactics" type="rule" hidden="false" /><infoLink id="r62-shat-assign-27cfc84cfa13-info-072bb44b5ef9" name="Martial Hubris" targetId="r45-al-martial-hubris" type="rule" hidden="false" /><infoLink id="r62-shat-assign-27cfc84cfa13-info-2bb0015445ef" name="Infiltration Network" targetId="r45-al-infiltration-network" type="rule" hidden="false" /></infoLinks><rules><rule id="r62-shat-assign-27cfc84cfa13-identity" name="Legiones Astartes (Alpha Legion)" hidden="false"><description>This unit is assigned to Alpha Legion for the Shattered Legions Theme. It uses the normal Alpha Legion Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-27cfc84cfa13-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xx" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-27cfc84cfa13-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries><modifiers><modifier id="r62-shat-assign-group-fa9f93cc608d-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r62-shat-assign-group-fa9f93cc608d-min-on" type="set" field="r62-shat-assign-group-fa9f93cc608d-min" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-group-fa9f93cc608d-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r62-shat-assign-group-fa9f93cc608d-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntryGroup></selectionEntryGroups><costs>
        <cost name="Points" typeId="pts" value="400" />
      </costs>
      <profiles>
        <profile name="Thunderhawk Transporter" id="r32-low-transporter-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <modifiers>
            <modifier type="set" field="vehicle-rear" value="12" id="r32-low-transporter-rear">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r32-low-transporter-voidhull" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <characteristics>
            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
            <characteristic name="Front" typeId="vehicle-front">12</characteristic>
            <characteristic name="Side" typeId="vehicle-side">12</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">10</characteristic>
            <characteristic name="SP" typeId="vehicle-sp">3</characteristic>
          </characteristics>
        </profile>
        <profile name="Twin-linked Heavy Bolter" id="r32-low-transporter-weapon-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-low-transporter-type" hidden="false">
          <description>Vehicle (Super-heavy, Flyer, Hover, Transport)</description>
        </rule>
        <rule name="Wargear" id="r32-low-transporter-wargear" hidden="false">
          <description>Four Twin-linked Heavy Bolters; Armoured Ceramite.</description>
        </rule>
        <rule name="Loading Vehicles" id="r32-low-transporter-load" hidden="false">
          <description>While Hovering, an empty Transporter may move over a stationary friendly vehicle that has not moved that turn; that vehicle is embarked. The Transporter may move normally from its following turn.</description>
        </rule>
        <rule name="Unloading Vehicles" id="r32-low-transporter-unload" hidden="false">
          <description>If the Transporter remains stationary while Hovering, transported vehicles may disembark and move normally that turn.</description>
        </rule>
        <rule name="Transport Capacity" id="r32-low-transporter-cap" hidden="false">
          <description>15 models, plus either two Rhino-sized vehicles or one Land Raider-sized vehicle. Transported vehicles may contain passengers.</description>
        </rule>
        <rule name="Access Points" id="r32-low-transporter-access" hidden="false">
          <description>One access hatch on each side of the cockpit section.</description>
        </rule>
      </rules>
      <selectionEntries>
        <entryLink id="r32-low-transporter-chaff-launcher" name="Chaff Launcher" targetId="r41-universal-gear-ce9a292664f5eb" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="r32-low-transporter-chaff-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="10" />
          </costs>
          </entryLink><entryLink id="r32-low-transporter-armoured-cockpit" name="Armoured Cockpit" targetId="r41-universal-gear-a70ce6a2a8794d" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="r32-low-transporter-armoured-cockpit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          </entryLink><selectionEntry type="upgrade" import="true" name="Illum Flares" hidden="false" id="r32-low-transporter-illum-flares">
          <constraints>
            <constraint id="r32-low-transporter-illum-flares-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
          <rules>
            <rule name="Illum Flares" id="r32-low-transporter-illum-flares-effect" hidden="false">
              <description>May drop one flare in each friendly Movement phase in the same manner as a Bomb. After scatter, friendly units firing at an enemy with at least one model within 12 inches of the marker gain Night Vision for that Shooting phase.

Night Vision: Units containing at least one model with this effect ignore Night Fighting restrictions.</description>
            </rule>
          </rules>
        </selectionEntry>
        <entryLink id="r32-low-transporter-flare-shield" name="Flare Shield" targetId="r41-universal-gear-9201acbfa3614c" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="r32-low-transporter-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          </entryLink><selectionEntry type="upgrade" import="true" name="Ramjet Diffraction Grid" hidden="false" id="r32-low-transporter-ramjet-diffraction-grid">
          <constraints>
            <constraint id="r32-low-transporter-ramjet-diffraction-grid-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <rules>
            <rule name="Ramjet Diffraction Grid" id="r32-low-transporter-ramjet-diffraction-grid-effect" hidden="false">
              <description>Reduce the Strength of shooting attacks that strike Side or Rear Armour by 1, to a minimum of 1. The vehicle may not claim Cover Saves from Night Fighting.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Void-crafted Hull" hidden="false" id="r32-low-transporter-voidhull">
          <constraints>
            <constraint id="r32-low-transporter-voidhull-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="35" />
          </costs>
          <rules>
            <rule name="Void-crafted Hull" id="r32-low-transporter-voidhull-rule" hidden="false">
              <description>Increase the Thunderhawk Transporter's Rear Armour from 10 to 12.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hellstrike Missile" hidden="false" id="r32-low-transporter-hellstrike">
          <constraints>
            <constraint id="r32-low-transporter-hellstrike-max" type="max" value="6" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="10" />
          </costs>
          <profiles>
            <profile name="Hellstrike Missile" id="r32-low-transporter-hellstrike-hellstrike-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
              <characteristics>
                <characteristic name="Range" typeId="ranged-range">72"</characteristic>
                <characteristic name="S" typeId="ranged-s">8</characteristic>
                <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                <characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Sunder" id="r32-low-transporter-hellstrike-hellstrike-missile-wr-0-sunder" hidden="false">
              <description>May re-roll failed Armour Penetration rolls against Vehicles.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
      <categoryLinks>
        <categoryLink id="r32-low-transporter-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" />
      <categoryLink id="r32-low-transporter-r40-fly" name="Awakening Fire — Flyer" targetId="r40-sal-awakening-flyer" hidden="false" /></categoryLinks>
