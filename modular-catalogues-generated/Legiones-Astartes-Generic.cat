ned to Word Bearers for the Shattered Legions Theme. It uses the normal Word Bearers Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-239a2f1c2873-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xvii" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-239a2f1c2873-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-f9ee8058df74" name="Salamanders" type="upgrade" hidden="false"><infoLinks><infoLink id="r62-shat-assign-f9ee8058df74-info-64758efb94f3" name="Legiones Astartes (Salamanders)" targetId="r40-sal-legiones-astartes-salamanders" type="rule" hidden="false" /><infoLink id="r62-shat-assign-f9ee8058df74-info-5edff69c6afc" name="Promethean Cult" targetId="r40-sal-promethean-cult" type="rule" hidden="false" /><infoLink id="r62-shat-assign-f9ee8058df74-info-810d319475ea" name="Sturdy" targetId="r40-sal-sturdy" type="rule" hidden="false" /><infoLink id="r62-shat-assign-f9ee8058df74-info-1b886eb0c946" name="Never Give Up" targetId="r40-sal-never-give-up" type="rule" hidden="false" /><infoLink id="r62-shat-assign-f9ee8058df74-info-80590cfe0ecb" name="Salamanders Mantle" targetId="r40-sal-salamanders-mantle" type="rule" hidden="false" /><infoLink id="r62-shat-assign-f9ee8058df74-info-fed6f289559f" name="Fire-based Warfare" targetId="r40-sal-fire-based-warfare" type="rule" hidden="false" /><infoLink id="r62-shat-assign-f9ee8058df74-info-a0a6e629a860" name="Proscribed Munitions" targetId="r40-sal-proscribed-munitions" type="rule" hidden="false" /></infoLinks><rules><rule id="r62-shat-assign-f9ee8058df74-identity" name="Legiones Astartes (Salamanders)" hidden="false"><description>This unit is assigned to Salamanders for the Shattered Legions Theme. It uses the normal Salamanders Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-f9ee8058df74-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xviii" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-f9ee8058df74-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-4a39f79b2572" name="Raven Guard" type="upgrade" hidden="false"><infoLinks><infoLink id="r62-shat-assign-4a39f79b2572-info-75dd0ee7c4b0" name="Legiones Astartes (Raven Guard)" targetId="r43-rg-legiones-astartes-raven-guard" type="rule" hidden="false" /><infoLink id="r62-shat-assign-4a39f79b2572-info-9ab1bf1e85f1" name="Surgical Strike" targetId="r43-rg-surgical-strike" type="rule" hidden="false" /><infoLink id="r62-shat-assign-4a39f79b2572-info-047f7cf538c3" name="Rapid Reaction" targetId="r43-rg-rapid-reaction" type="rule" hidden="false" /><infoLink id="r62-shat-assign-4a39f79b2572-info-db41feea9956" name="Shadow Masters" targetId="r43-rg-shadow-masters" type="rule" hidden="false" /><infoLink id="r62-shat-assign-4a39f79b2572-info-c90b6dc986fe" name="Limited Vehicles" targetId="r43-rg-limited-vehicles" type="rule" hidden="false" /><infoLink id="r62-shat-assign-4a39f79b2572-info-cd49071cd572" name="Raven's Talons" targetId="r43-rg-raven-s-talons" type="rule" hidden="false" /><infoLink id="r62-shat-assign-4a39f79b2572-info-9c3d09934245" name="Infravisor" targetId="r43-rg-infravisor" type="rule" hidden="false" /><infoLink id="r62-shat-assign-4a39f79b2572-info-3ddc92495b50" name="Shroud Bombs" targetId="r43-rg-shroud-bombs" type="rule" hidden="false" /><infoLink id="r62-shat-assign-4a39f79b2572-info-ca5136e64e22" name="Cameleoline" targetId="r43-rg-cameleoline" type="rule" hidden="false" /><infoLink id="r62-shat-assign-4a39f79b2572-info-abb7821cf8bd" name="Teleportation Transponders" targetId="r43-rg-teleportation-transponders" type="rule" hidden="false" /></infoLinks><rules><rule id="r62-shat-assign-4a39f79b2572-identity" name="Legiones Astartes (Raven Guard)" hidden="false"><description>This unit is assigned to Raven Guard for the Shattered Legions Theme. It uses the normal Raven Guard Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-4a39f79b2572-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xix" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-4a39f79b2572-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-5968a96192e3" name="Alpha Legion" type="upgrade" hidden="false"><infoLinks><infoLink id="r62-shat-assign-5968a96192e3-info-95ff4019ee2d" name="Legiones Astartes (Alpha Legion)" targetId="r45-al-legiones-astartes-alpha-legion" type="rule" hidden="false" /><infoLink id="r62-shat-assign-5968a96192e3-info-91a8157a1170" name="Mutable Tactics" targetId="r45-al-mutable-tactics" type="rule" hidden="false" /><infoLink id="r62-shat-assign-5968a96192e3-info-072bb44b5ef9" name="Martial Hubris" targetId="r45-al-martial-hubris" type="rule" hidden="false" /><infoLink id="r62-shat-assign-5968a96192e3-info-2bb0015445ef" name="Infiltration Network" targetId="r45-al-infiltration-network" type="rule" hidden="false" /></infoLinks><rules><rule id="r62-shat-assign-5968a96192e3-identity" name="Legiones Astartes (Alpha Legion)" hidden="false"><description>This unit is assigned to Alpha Legion for the Shattered Legions Theme. It uses the normal Alpha Legion Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-5968a96192e3-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xx" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-5968a96192e3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries><modifiers><modifier id="r62-shat-assign-group-3b33dad501f8-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r62-shat-assign-group-3b33dad501f8-min-on" type="set" field="r62-shat-assign-group-3b33dad501f8-min" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-group-3b33dad501f8-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r62-shat-assign-group-3b33dad501f8-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntryGroup></selectionEntryGroups>
      <costs>
        <cost name="Points" typeId="pts" value="50" />
      </costs>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Reconnaissance Squad" hidden="false" id="recon-unit">
      <modifiers /><categoryLinks>
        <categoryLink targetId="cat-troops" id="recon-cat" primary="true" name="Troops" hidden="false" />
      <categoryLink id="recon-unit-r43-rg-comp" name="Raven Guard — compulsory-capable Troops" targetId="r43-rg-compulsory-troops" hidden="false" /></categoryLinks>
      <infoLinks><infoLink id="r36-link-d19f993a145d" name="Scout" hidden="false" targetId="r36-shared-scout-56be36a" type="rule" /><infoLink id="r36-link-7be51ed0df7d" name="Infiltrate" hidden="false" targetId="r36-shared-infiltrate-88c13dc" type="rule" /><infoLink id="r36-link-89fd18bd9131" name="Move Through Cover" hidden="false" targetId="r36-shared-move-through-cover-b95132d" type="rule" /><infoLink id="r36-link-e342d59271e5" name="Acute Senses" hidden="false" targetId="r36-shared-acute-senses-19bf158" type="rule" /></infoLinks><rules>
        <rule name="Standard Wargear" id="recon-standard-wargear" hidden="false">
          <description>Every model is equipped with Recon Armour, a Bolter, a Bolt Pistol and Frag Grenades.</description>
        </rule>
        <rule name="Legiones Astartes" id="recon-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Support Squad" id="recon-support-squad" hidden="false">
          <description>This unit may be selected as a Troops choice, but may not fulfil either of the army' two compulsory Troops selections unless a Legion-specific rule or Rite of War removes this restriction.</description>
        </rule>
        <rule name="Frag Grenades" id="recon-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink import="true" name="Recon Armour" hidden="false" id="recon-standard-armour" type="selectionEntry" targetId="gear-recon-armour" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-armour-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-armour-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Bolter" hidden="false" id="recon-standard-bolter" type="selectionEntry" targetId="gear-bolter" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bolter-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bolter-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Bolt Pistol" hidden="false" id="recon-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bp-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bp-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink id="r40-da-forward-recon-unit" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true">
          <constraints>
            <constraint id="r40-da-forward-recon-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" />
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-serpent" shared="true" includeChildSelections="true" />
                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="da-wing-recon-unit-4" shared="true" includeChildSelections="true" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          <modifier type="set" value="false" field="hidden" id="mod-r62-shat-d40393e7fc0b">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-0e76729ea658" shared="true" includeChildSelections="true" />
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-serpent" shared="true" includeChildSelections="true" />
                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="da-wing-recon-unit-4" shared="true" includeChildSelections="true" />
                  <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </entryLink>
        <entryLink id="r64-if-recon-unit-hammerfall-trans" name="Teleportation Transponders" type="selectionEntry" targetId="r64-if-gear-trans-unit" hidden="false" import="true">
          <constraints>
            <constraint id="r64-if-recon-unit-hammerfall-trans-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r64-if-recon-unit-hammerfall-trans-rite" type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-vii-1-hammerfall-strike-force" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
        </entryLink>
      </entryLinks>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Recon Marine" hidden="false" id="recon-marine" defaultAmount="4">
          <constraints>
            <constraint type="min" value="4" field="selections" scope="parent" shared="true" id="recon-marine-min" includeChildSelections="false" />
            <constraint type="max" value="9" field="selections" scope="parent" shared="true" id="recon-marine-max" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="14" />
          </costs>
          <profiles>
            <profile name="Legion Recon Marine" typeId="prof-model" typeName="Model" hidden="false" id="prof-recon-marine">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">8</characteristic>
                <characteristic name="Sv" typeId="model-sv">4+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        <modifiers><modifier id="r18-ts-axis-max-recon-marine" type="set" field="recon-marine-min" value="9"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xv-0-the-axis-of-dissolution" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r19-axis-max-recon-marine" type="set" field="recon-marine-min" value="9"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xv-0-the-axis-of-dissolution" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Recon Sergeant" hidden="false" id="recon-sergeant" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-sgt-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-sgt-max" includeChildSelections="false" automatic="true" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="14" />
          </costs>
          <profiles>
            <profile name="Legion Recon Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="prof-recon-sergeant">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sj" typeId="model-sv">4+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Sergeant Armoury" id="recon-rule-sgt-armoury" hidden="false">
              <description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. No item may be selected more than once unless a unit entry specifically permits otherwise. Unit-specific replacement options are not repeated in the additional Armoury. Any additional Armoury weapon replaces one of the Sergeant' existing weapons so that he never carries more than two weapons; a pair of Lightning Claws replaces both.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Sergeant Weapon Options" id="recon-sgt-weapons" hidden="false">
              <constraints>
                <constraint type="max" value="2" field="selections" scope="parent" shared="true" id="recon-sgt-weapons-max" includeChildSelections="true" />
              </constraints>
              <modifiers>
                <modifier type="set" value="1" field="recon-sgt-weapons-max">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="parent" childId="recon-sgt-pair-claws" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Pair of Lightning Claws (Armoury; replaces both weapons)" hidden="false" id="recon-sgt-pair-claws">
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-sgt-pair-claws-max" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="30" />
                  </costs>
                  <entryLinks>
                    <entryLink import="true" name="Pair of Lightning Claws" hidden="false" id="recon-sgt-pair-claws-link" type="selectionEntry" targetId="gear-pair-claws" defaultAmount="1" />
                  </entryLinks>
                </selectionEntry>
              </selectionEntries>
              <selectionEntryGroups>
                <selectionEntryGroup name="Replace Bolter" id="recon-sgt-bolter" hidden="false">
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-sgt-bolter-max" includeChildSelections="false" />
