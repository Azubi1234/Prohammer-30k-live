        <rule name="Divert Power" id="r32-low-typhon-weapon-dreadhammer-siege-cannon-wr-1-divert-power" hidden="false">
          <description>This profile may only be used if the firing vehicle did not move in its Movement phase.</description>
        </rule>
        <rule name="Crushing Weight" id="r32-low-typhon-crushing" hidden="false">
          <description>Enemy units taking a Tank Shock Test caused by the Typhon suffer an additional -1 Leadership. When the Typhon Rams, add +1 to its Armour Penetration roll.</description>
        </rule>
