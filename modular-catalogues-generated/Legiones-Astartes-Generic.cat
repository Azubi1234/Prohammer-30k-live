                  <modifier id="live-r2-r42-role-xv-crimson-magnus-hq-r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-retinue-0-r71-nl-gen-9-stealth-show-r62-shat-c89dcd8c751d" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-9339b74f1193" shared="true" includeChildSelections="true" includeChildForces="false" />
                          <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
                        </conditionGroup>
