                <selectionEntry type="upgrade" import="true" name="Iron Halo" hidden="false" id="r32-soh-long-march-terminator-sgt-halo">
                  <constraints>
                    <constraint id="r32-soh-long-march-terminator-sgt-halo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
