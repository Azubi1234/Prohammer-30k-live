    <selectionEntry type="unit" name="Legion Land Speeder Squadron" hidden="false" id="fa-land-speeder" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-fast" id="fa-land-speeder-cat" primary="true" name="Fast Attack" hidden="false" />
      <categoryLink id="fa-land-speeder-r40-covsup" name="Covenant of Fire — Fast/Heavy choices" targetId="r40-sal-covenant-support" hidden="false" /><categoryLink id="fa-land-speeder-r40-skim" name="Awakening Fire — Skimmer" targetId="r40-sal-awakening-skimmer" hidden="false" /></categoryLinks>
      <infoLinks><infoLink id="r36-link-a2183630b9fa" name="Deep Strike" hidden="false" targetId="r36-shared-deep-strike-54cfd20" type="rule" /></infoLinks><selectionEntries>
        <selectionEntry type="model" name="Legion Land Speeder" hidden="false" id="fa-land-speeder-model" import="true" defaultAmount="1">
          <constraints>
            <constraint id="fa-land-speeder-model-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="fa-land-speeder-model-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <profiles>
            <profile name="Legion Land Speeder" id="fa-land-speeder-model-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
              <characteristics>
                <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                <characteristic name="Front" typeId="vehicle-front">10</characteristic>
                <characteristic name="Side" typeId="vehicle-side">10</characteristic>
                <characteristic name="Rear" typeId="vehicle-rear">10</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule name="Standard Wargear" id="fa-land-speeder-std" hidden="false">
          <description>Heavy Bolter.</description>
        </rule>
        <rule name="Armoured Crew" id="fa-land-speeder-armoured" hidden="false">
          <description>The crew are protected by Power Armour and the enclosed fighting position. A Legion Land Speeder does not count as Open-topped.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Heavy Bolter Replacements" id="fa-land-speeder-primary" hidden="false">
          <constraints>
            <constraint id="fa-land-speeder-primary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier type="set" value="2" field="fa-land-speeder-primary-max">
              <conditions>
                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="fa-land-speeder-model" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
            <modifier type="set" value="3" field="fa-land-speeder-primary-max">
              <conditions>
                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="fa-land-speeder-model" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <entryLinks>
