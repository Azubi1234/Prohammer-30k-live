                            <characteristic name="Range" typeId="ranged-range">Self</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r61-librarian-power1-telekinesis-levitation-rule" name="Levitation" hidden="false">
                          <description>The Psyker and any joined unit may immediately move up to 12 inches. They cannot land on models or Impassable Terrain, cannot charge this turn and count as having moved.</description>
                        </rule>
                      </rules>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-103" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry id="r61-librarian-power1-telekinesis-telekine-dome" name="Telekinesis — Telekine Dome" type="upgrade" hidden="false" import="true">
                      <constraints>
                        <constraint id="r61-librarian-power1-telekinesis-telekine-dome-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
