                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-centurion-term" shared="true" includeChildSelections="true" />
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-centurion-tart" shared="true" includeChildSelections="true" />
