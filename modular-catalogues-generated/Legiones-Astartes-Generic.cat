          <selectionEntries>
            <selectionEntry id="r57-fa-seeker-iw-shrapnel" name="Shrapnel Bolts" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r57-fa-seeker-iw-shrapnel-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
