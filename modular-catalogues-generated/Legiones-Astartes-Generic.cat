          </constraints>
          <modifiers>
            <modifier id="r46-al-reward-17-donor-r64-if-warder-specialweps-inc-1" type="increment" value="1" field="r46-al-reward-17-donor-r64-if-warder-specialweps-max">
              <conditions>
                <condition type="atLeast" value="10" field="selections" scope="parent" childId="r46-al-reward-17-donor-r64-if-warder-models" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
