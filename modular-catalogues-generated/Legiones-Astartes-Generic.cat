    <selectionEntry id="r46-al-banestrike-character" name="Banestrike Ammunition" type="upgrade" hidden="false" import="true">
      <infoLinks><infoLink id="r46-al-banestrike-character-bane-rule" name="Banestrike" targetId="r45-al-banestrike" type="rule" hidden="false" /><infoLink id="r46-al-banestrike-character-profile" name="Banestrike Bolter" targetId="r45-al-prof-banestrike" type="profile" hidden="false" /></infoLinks><rules><rule id="r46-al-banestrike-character-rule" name="Banestrike Ammunition" hidden="false"><description>Use the Banestrike profile. With a Foeblaster Boltgun, Combi-Bolter or Bolter component of a Combi-Weapon, retain the normal number of shots and firing type, but reduce range to 18 inches, use AP4 and apply Banestrike. It may not be combined with another ammunition type.</description></rule></rules><costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        </constraints>
      </selectionEntry>
    <selectionEntry id="r46-al-banestrike-model" name="Banestrike Ammunition — eligible model" type="upgrade" hidden="false" import="true">
      <infoLinks><infoLink id="r46-al-banestrike-model-bane-rule" name="Banestrike" targetId="r45-al-banestrike" type="rule" hidden="false" /><infoLink id="r46-al-banestrike-model-profile" name="Banestrike Bolter" targetId="r45-al-prof-banestrike" type="profile" hidden="false" /></infoLinks><rules><rule id="r46-al-banestrike-model-rule" name="Banestrike Ammunition" hidden="false"><description>Use the Banestrike profile. With a Foeblaster Boltgun, Combi-Bolter or Bolter component of a Combi-Weapon, retain the normal number of shots and firing type, but reduce range to 18 inches, use AP4 and apply Banestrike. It may not be combined with another ammunition type.</description></rule></rules><costs>
