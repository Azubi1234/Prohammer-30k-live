            <characteristic name="Type" typeId="ranged-type">Ordnance 2, Concussive</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Leviathan Storm Cannon" hidden="false" id="hsgear-lev-storm" import="true">
      <profiles>
        <profile name="Leviathan Storm Cannon" id="hsgear-lev-storm-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">24"</characteristic>
            <characteristic name="S" typeId="ranged-s">7</characteristic>
            <characteristic name="AP" typeId="ranged-ap">3</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 6</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Cyclonic Melta Lance" hidden="false" id="hsgear-lev-melta" import="true">
      <profiles>
        <profile name="Cyclonic Melta Lance" id="hsgear-lev-melta-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">18"</characteristic>
            <characteristic name="S" typeId="ranged-s">9</characteristic>
            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 3, Melta</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Grav-flux Bombard" hidden="false" id="hsgear-gravflux" import="true">
      <profiles>
        <profile name="Grav-flux Bombard" id="hsgear-gravflux-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">18"</characteristic>
            <characteristic name="S" typeId="ranged-s">Special</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1, Large Blast, Concussive, Ignores Cover, Graviton Collapse</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Phosphex Discharger" hidden="false" id="hsgear-phosphex-dis" import="true">
      <modifiers><modifier id="hsgear-phosphex-dis-r40-sal-hide" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xviii" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><profiles>
        <profile name="Phosphex Discharger" id="hsgear-phosphex-dis-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">6–18"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 3, Barrage, Blast, Poisoned (3+), One Use</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Flamestorm Cannon" hidden="false" id="hsgear-flamestorm" import="true">
      <profiles>
        <profile name="Flamestorm Cannon" id="r29-prof-flamestorm" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">Template</characteristic>
            <characteristic name="S" typeId="ranged-s">6</characteristic>
            <characteristic name="AP" typeId="ranged-ap">3</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Flamestorm Cannon" id="hsgear-flamestorm-rule" hidden="false">
          <description>Use the weapon profile shown above.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Demolisher Cannon" hidden="false" id="hsgear-demolisher" import="true">
      <profiles>
        <profile name="Demolisher Cannon" id="r29-prof-demolisher" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">24”</characteristic>
            <characteristic name="S" typeId="ranged-s">10</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Demolisher Cannon" id="hsgear-demolisher-rule" hidden="false">
          <description>Use the weapon profile shown above.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Close Combat Weapon" hidden="false" id="gear-hq-ccw">
      <rules>
        <rule name="Close Combat Weapon" id="gear-hq-ccw-rule" hidden="false">
          <description>Close Combat Weapon. Uses the bearer's Strength and permits normal Armour Saves.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Chainaxe" hidden="false" id="gear-hq-chainaxe">
      <rules>
        <rule name="Chainaxe" id="gear-hq-chainaxe-rule" hidden="false">
          <description>An Armour Save better than 4+ is reduced to 4+ against wounds caused by a Chainaxe. Armour Saves of 4+ or worse and Invulnerable Saves are unaffected.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Force Weapon" hidden="false" id="gear-hq-force">
      <rules>
        <rule name="Force Weapon" id="gear-hq-force-rule" hidden="false">
          <description>Power Weapon, Force. After a Psyker inflicts one or more unsaved wounds, it may take a Psychic Test; if passed, each unsaved wound becomes a Massive Wound and inflicts D3 Wounds. No additional effect against vehicles.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Relic Blade" hidden="false" id="gear-hq-relic">
      <rules>
        <rule name="Relic Blade" id="gear-hq-relic-rule" hidden="false">
          <description>Strength 6; Power Weapon; Two-Handed. Independent Characters only.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Artificer Armour" hidden="false" id="gear-hq-artificer">
      <rules>
        <rule name="Artificer Armour" id="gear-hq-artificer-rule" hidden="false">
          <description>Artificer Armour grants a 2+ Armour Save and does not count as Terminator Armour.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Terminator Armour" hidden="false" id="gear-hq-terminator">
      <rules>
        <rule name="Terminator Armour" id="gear-hq-terminator-rule" hidden="false">
          <description>2+ Armour Save, 5+ Invulnerable Save, Relentless, Bulky and Deep Strike; may not make Pursuit moves and may not embark upon Rhinos or Drop Pods.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Tartaros Terminator Armour" hidden="false" id="gear-hq-tartaros">
      <rules>
        <rule name="Tartaros Terminator Armour" id="gear-hq-tartaros-rule" hidden="false">
          <description>2+ Armour Save, 5+ Invulnerable Save, Relentless, Bulky and Deep Strike; may make Pursuit moves; may not embark upon Rhinos or Drop Pods.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cataphractii Terminator Armour" hidden="false" id="gear-hq-cataphractii">
      <rules>
        <rule name="Cataphractii Terminator Armour" id="gear-hq-cataphractii-rule" hidden="false">
          <description>2+ Armour Save, 4+ Invulnerable Save, Relentless, Bulky and Deep Strike; may not Advance, make Pursuit moves or fire Overwatch; may not embark upon Rhinos or Drop Pods.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Refractor Field" hidden="false" id="gear-hq-refractor">
      <rules>
        <rule name="Refractor Field" id="gear-hq-refractor-rule" hidden="false">
          <description>A Refractor Field grants a 5+ Invulnerable Save. A Sergeant may only purchase a Refractor Field if his squad is purchased at its maximum starting strength. A model that already has a 5+ or better Invulnerable Save may not purchase a Refractor Field.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Iron Halo" hidden="false" id="gear-hq-iron-halo">
      <categoryLinks><categoryLink id="r41-iron-halo-gear-cat" name="Iron Halo — army-wide limit" targetId="r41-iron-halo-army-limit" hidden="false" /></categoryLinks><rules>
        <rule name="Iron Halo" id="gear-hq-iron-halo-rule" hidden="false">
          <description>Grants a 4+ Invulnerable Save. An army may normally contain no more than one Iron Halo unless specifically stated otherwise.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Boarding Shield" hidden="false" id="gear-hq-boarding">
      <rules>
        <rule name="Boarding Shield" id="gear-hq-boarding-rule" hidden="false">
          <description>Grants a 5+ Invulnerable Save, occupies one hand and prevents the bonus Attack for fighting with two weapons.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="r66-if-board-cat" name="Stone Gauntlet — Shield-bearing Independent Character" hidden="true" targetId="r66-if-cat-stone-shield-ic" primary="false" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combat Shield" hidden="false" id="gear-hq-combat-shield">
      <rules>
        <rule name="Combat Shield" id="gear-hq-combat-shield-rule" hidden="false">
          <description>Grants a 6+ Invulnerable Save; does not occupy a hand and does not prevent the two-weapon bonus Attack.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Jump Pack" hidden="false" id="gear-hq-jump">
      <categoryLinks><categoryLink id="gear-hq-jump-r40-jump" name="Awakening Fire — Jump Infantry" targetId="r40-sal-awakening-jump" hidden="false" /></categoryLinks><rules>
        <rule name="Jump Pack" id="gear-hq-jump-rule" hidden="false">
          <description>The bearer becomes Jump Infantry and follows the normal ProHammer Jump Infantry rules. It may not be combined with a Bike, Jetbike or Terminator Armour.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Space Marine Bike" hidden="false" id="gear-hq-bike">
      <rules>
        <rule name="Space Marine Bike" id="gear-hq-bike-rule" hidden="false">
          <description>The bearer becomes Bike unit type and follows the normal ProHammer Bike rules. The bike is armed with twin-linked bolters. It may not be combined with a Jump Pack, Jetbike or Terminator Armour.

Twin-Linked: Re-roll failed To Hit rolls with this weapon. Does not count as two weapons. Twin-linked Template weapons automatically hit all models fully or partially under the Template.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Auspex" hidden="false" id="gear-hq-auspex">
      <rules>
        <rule name="Auspex" id="gear-hq-auspex-rule" hidden="false">
          <description>Detects Infiltrators and permits the pre-game anti-Infiltrator fire described in the Space Marine Armoury.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Bionics" hidden="false" id="gear-hq-bionics">
      <rules>
        <rule name="Bionics" id="gear-hq-bionics-rule" hidden="false">
          <description>When the bearer loses its final Wound, it may recover as described by the Space Marine Armoury on a roll of 6.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Digital Weapons" hidden="false" id="gear-hq-digital">
      <rules>
        <rule name="Digital Weapons" id="gear-hq-digital-rule" hidden="false">
          <description>Independent Character only; re-roll one failed To Wound roll per Assault phase.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Master-crafted Weapon" hidden="false" id="gear-hq-mastercraft">
      <rules>
        <rule name="Master-crafted Weapon" id="gear-hq-mastercraft-rule" hidden="false">
          <description>Apply to one weapon; re-roll one failed To Hit roll per player turn with that weapon.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Nuncio Vox" hidden="false" id="gear-hq-nuncio">
      <rules>
        <rule name="Nuncio Vox" id="gear-hq-nuncio-rule" hidden="false">
          <description>Assists friendly Deep Striking units as described in the Space Marine Armoury.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Psychic Hood" hidden="false" id="gear-hq-hood">
      <rules>
        <rule name="Psychic Hood" id="gear-hq-hood-rule" hidden="false">
          <description>Psykers only. May attempt to nullify enemy psychic powers using the ProHammer Psychic Hood rules.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="hq-consul-librarian" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Purity Seals" hidden="false" id="gear-hq-purity">
      <rules>
        <rule name="Purity Seals" id="gear-hq-purity-rule" hidden="false">
          <description>Improves control of Fall Back distance as described in the Space Marine Armoury.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="gear-hq-signum">
      <rules>
        <rule name="Signum" id="gear-hq-signum-rule" hidden="false">
          <description>The bearer's unit may re-roll one failed shooting To Hit roll per Shooting phase.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Teleport Homer" hidden="false" id="gear-hq-homer">
      <rules>
        <rule name="Teleport Homer" id="gear-hq-homer-rule" hidden="false">
          <description>Friendly units arriving by teleportation do not scatter when deployed within the permitted range of the active Homer.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Terminator Honours" hidden="false" id="gear-hq-honours">
      <rules>
        <rule name="Terminator Honours" id="gear-hq-honours-rule" hidden="false">
          <description>The bearer gains +1 Attack.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Melta bombs" hidden="false" id="gear-hq-melta-bombs">
      <rules>
        <rule name="Melta Bombs" id="gear-hq-melta-bombs-rule" hidden="false">
          <description>Against a vehicle in close combat, the bearer may exchange normal attacks for one Melta Bomb attack at Strength 8 + 2D6 Armour Penetration.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Narthecium" hidden="false" id="gear-hq-narthecium">
      <rules>
        <rule name="Narthecium" id="gear-hq-narthecium-rule" hidden="false">
          <description>A unit containing an Apothecary with a Narthecium may ignore the first eligible failed saving throw it suffers during each player turn, subject to the restrictions in the army list.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Reductor" hidden="false" id="gear-hq-reductor">
      <rules>
        <rule name="Reductor" id="gear-hq-reductor-rule" hidden="false">
          <description>If Victory Points are used and the Apothecary survives, recover 1 Victory Point for each slain friendly Legiones Astartes model that belonged to his unit, including attached Independent Characters.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Legion Vexilla" hidden="false" id="gear-hq-vexilla">
      <rules>
        <rule name="Legion Vexilla" id="gear-hq-vexilla-rule" hidden="false">
          <description>The bearer's unit adds +1 to its combat-resolution score. This bonus is not cumulative.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sacred Standard" hidden="false" id="gear-hq-sacred">
      <rules>
        <rule name="Sacred Standard" id="gear-hq-sacred-rule" hidden="false">
          <description>Friendly Legiones Astartes units add +1 to combat-resolution in any close combat within 6". Not cumulative with another Sacred Standard or Legion Standard.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Legion Standard" hidden="false" id="gear-hq-legion-standard">
      <rules>
        <rule name="Legion Standard" id="gear-hq-legion-standard-rule" hidden="false">
          <description>Combines the effects of a Sacred Standard and a Crusade Relic. Only an army of 2,000 points or more may include one; it normally counts as the army's Crusade Relic.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Grenade Harness" hidden="false" id="gear-hq-grenade-harness">
      <rules>
        <rule name="Grenade Harness" id="gear-hq-grenade-harness-rule" hidden="false">
          <description>One-use 8" S3 AP– Assault 2, Blast grenade weapon; grants the Frag Grenade benefit where applicable.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Crozius Arcanum" hidden="false" id="r29-gear-crozius">
      <rules>
        <rule name="Crozius Arcanum" id="r29-gear-crozius-rule" hidden="false">
          <description>Counts as a Power Weapon and ignores Armour Saves.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rosarius" hidden="false" id="r29-gear-rosarius">
      <rules>
        <rule name="Rosarius" id="r29-gear-rosarius-rule" hidden="false">
          <description>Grants a 4+ Invulnerable Save.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Servo-Arm" hidden="false" id="r29-gear-servo-arm">
      <rules>
        <rule name="Servo-Arm" id="r29-gear-servo-arm-rule" hidden="false">
          <description>Grants one additional Power Fist-style close-combat attack, rolled separately, and +1 to Battlesmith repair rolls. A normal 5+ repair therefore succeeds on a 4+ while the Servo-Arm is retained.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cognis Signum" hidden="false" id="r29-gear-cognis-signum">
      <rules>
        <rule name="Cognis Signum" id="r29-gear-cognis-signum-rule" hidden="false">
          <description>The no-scatter deployment range of the bearer’s Nuncio Vox is increased from 6” to 12”. A Targeting Matrix also provides the normal Signum benefit to the bearer’s joined unit.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Aether-shock Maul" hidden="false" id="r29-gear-aether-shock-maul">
      <rules>
        <rule name="Aether-shock Maul" id="r29-gear-aether-shock-maul-rule" hidden="false">
          <description>Counts as a Power Weapon. Against Psykers and models with the Daemon special rule, it always wounds on a 2+.

Daemon: Model gains a 5+ Invulnerable Save and causes Fear.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cortex Controller" hidden="false" id="r29-gear-cortex-controller">
      <rules>
        <rule name="Cortex Controller" id="r29-gear-cortex-controller-rule" hidden="false">
          <description>Friendly Battle-Automata within 6” automatically pass Command Uplink or equivalent control tests. The Praevian’s accompanying Maniple is controlled normally by this item.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cortex Designator" hidden="false" id="r29-gear-cortex-designator">
      <rules>
        <rule name="Cortex Designator" id="r29-gear-cortex-designator-rule" hidden="false">
          <description>When the Praevian scores one or more successful To Hit rolls with a shooting weapon against an enemy unit, his attached Battle-Automata Maniple gains Preferred Enemy against that unit until the end of the current player turn. No unsaved Wound is required.

Preferred Enemy: The unit can re-roll failed hits in close combat against the indicated Preferred Enemy.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Special Issue Ammunition" hidden="false" id="r29-gear-special-issue-ammunition">
      <profiles>
        <profile name="Dragonfire Bolts" id="r29-sia-dragon" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">24”</characteristic>
            <characteristic name="S" typeId="ranged-s">4</characteristic>
            <characteristic name="AP" typeId="ranged-ap">5</characteristic>
            <characteristic name="Type" typeId="ranged-type">Rapid Fire, Ignores Cover</characteristic>
          </characteristics>
        </profile>
        <profile name="Hellfire Bolts" id="r29-sia-hellfire" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">24”</characteristic>
            <characteristic name="S" typeId="ranged-s">X</characteristic>
            <characteristic name="AP" typeId="ranged-ap">5</characteristic>
            <characteristic name="Type" typeId="ranged-type">Rapid Fire, Poison (2+)</characteristic>
          </characteristics>
        </profile>
        <profile name="Kraken Bolts" id="r29-sia-kraken" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">30”</characteristic>
            <characteristic name="S" typeId="ranged-s">4</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic>
          </characteristics>
        </profile>
        <profile name="Vengeance Rounds" id="r29-sia-vengeance" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">18”</characteristic>
            <characteristic name="S" typeId="ranged-s">4</characteristic>
            <characteristic name="AP" typeId="ranged-ap">3</characteristic>
            <characteristic name="Type" typeId="ranged-type">Rapid Fire, Gets Hot</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Special Issue Ammunition" id="r29-sia-rule" hidden="false">
          <description>Each time the bearer fires an eligible bolt weapon, select one ammunition profile. Only one ammunition type may be used for that shooting attack.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r37-gear-grenade-launcher" name="Grenade Launcher" type="upgrade" hidden="false" import="true">
      <profiles>
        <profile id="r37-gl-frag" name="Grenade Launcher – Frag" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">24"</characteristic>
            <characteristic name="S" typeId="ranged-s">3</characteristic>
            <characteristic name="AP" typeId="ranged-ap">6</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 1, Blast</characteristic>
          </characteristics>
        </profile>
        <profile id="r37-gl-krak" name="Grenade Launcher – Krak" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">24"</characteristic>
            <characteristic name="S" typeId="ranged-s">6</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry id="r43-ec-phoenix-spear" name="Phoenix Spear" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="20" />
      </costs>
      <constraints>
        <constraint id="r43-ec-phoenix-spear-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-phoenix-spear-rule" name="Phoenix Spear" hidden="false">
          <description>Power Weapon, Two-Handed, Phoenix Strike. During the first round of each close combat attacks are resolved at +1 Strength; thereafter at normal Strength. Characters already equipped with a Power Weapon as basic wargear exchange it for +5 points instead; use the source restriction when applying this entry.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-ec-digital-lasers" name="Digital Lasers" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="15" />
      </costs>
      <constraints>
        <constraint id="r43-ec-digital-lasers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-digital-lasers-rule" name="Digital Lasers" hidden="false">
          <description>Emperor’s Children Independent Character only. Adds +1 to the bearer’s Attacks characteristic. May not be combined with Terminator Honours.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-ec-sonic-shrieker" name="Sonic Shrieker" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r43-ec-sonic-shrieker-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-sonic-shrieker-rule" name="Sonic Shrieker" hidden="false">
          <description>TRAITOR ONLY. During the first round of close combat an enemy model in base contact suffers -1 Weapon Skill. If every model in the unit is equipped, every enemy model engaged with it suffers -1 WS. Not cumulative; Fearless models are unaffected.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-ec-line-apothecary" name="Sergeant upgraded to Apothecary" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="25" />
      </costs>
      <constraints>
        <constraint id="r43-ec-line-apothecary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="r43-ec-line-apothecary-roster-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-line-apothecary-rule" name="Sergeant upgraded to Apothecary" hidden="false">
          <description>PURITY ABOVE ALL: Upgrade the Legion Sergeant to an Apothecary. The model retains its weapons and wargear and gains a Narthecium. It counts as an Apothecary and may purchase a Reductor for +5 points. Across the army, only one Tactical Squad OR Assault Squad may take this upgrade.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-ec-vet-apothecary" name="Veteran Sergeant upgraded to Apothecary" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="25" />
      </costs>
      <constraints>
        <constraint id="r43-ec-vet-apothecary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-vet-apothecary-rule" name="Veteran Sergeant upgraded to Apothecary" hidden="false">
          <description>PURITY ABOVE ALL: Upgrade the Legion Veteran Sergeant to an Apothecary. The model retains its weapons and wargear and gains a Narthecium. It counts as an Apothecary and may purchase a Reductor for +5 points.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-ec-reductor" name="Reductor" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r43-ec-reductor-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-reductor-rule" name="Reductor" hidden="false">
          <description>May only be selected for a Sergeant upgraded to an Apothecary by Purity Above All.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-ec-sonic-package" name="Sonic Weaponry Package" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="0" />
      </costs>
      <constraints>
        <constraint id="r43-ec-sonic-package-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="r43-ec-sonic-package-roster-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-sonic-package-rule" name="Sonic Weaponry Package" hidden="false">
          <description>TRAITOR ONLY. One Legion Heavy Support Squad may select up to four Sonic Weapons instead of normal Heavy Weapon options. The 3rd Company Elite Rite increases this allowance to two squads.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-ec-sonic-sonic-blaster" name="Sonic Blaster" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="15" />
      </costs>
      <constraints>
        <constraint id="r43-ec-sonic-sonic-blaster-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-sonic-sonic-blaster-rule" name="Sonic Blaster" hidden="false">
          <description>24”, S4 AP5, Assault 2 or Heavy 3.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-ec-sonic-doom-siren" name="Doom Siren" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="20" />
      </costs>
      <constraints>
        <constraint id="r43-ec-sonic-doom-siren-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-sonic-doom-siren-rule" name="Doom Siren" hidden="false">
          <description>Template, S5 AP4, Assault 1.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-ec-sonic-blastmaster" name="Blastmaster" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="35" />
      </costs>
      <constraints>
        <constraint id="r43-ec-sonic-blastmaster-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-sonic-blastmaster-rule" name="Blastmaster" hidden="false">
          <description>48”, S8 AP3, Heavy 1, Blast.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-ec-perfect-cacophony" name="Perfect Cacophony — Fearless" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="20" />
      </costs>
      <constraints>
        <constraint id="r43-ec-perfect-cacophony-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-ec-perfect-cacophony-rule" name="Perfect Cacophony — Fearless" hidden="false">
          <description>A Legion Heavy Support Squad in which the majority of surviving models are equipped with Sonic Weapons gains Fearless.

Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-iw-shrapnel-bolts" name="Shrapnel Bolts" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r43-iw-shrapnel-bolts-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-iw-shrapnel-bolts-rule" name="Shrapnel Bolts" hidden="false">
          <description>The unit’s Bolt Pistols, Bolters, Combi-Bolters, Storm Bolters, Heavy Bolters, Twin-linked Bolters and bolter components of Combi-Weapons gain Pinning. May not be combined with Special Issue Ammunition, Hellfire Rounds or another special ammunition type.

Pinning: Unsaved Wounds caused by this weapon force the unit to take a Pinning Test.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-iw-servo-arm" name="Servo-Arm" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="30" />
      </costs>
      <constraints>
        <constraint id="r43-iw-servo-arm-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-iw-servo-arm-rule" name="Servo-Arm" hidden="false">
          <description>Any Iron Warriors model with Space Marine Armoury access may purchase this even without normal Techmarine access. A Jump Pack model may not purchase it. Use the normal Servo-Arm rules from the Legiones Astartes Army List.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r43-iw-bionics" name="Bionics" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r43-iw-bionics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r43-iw-bionics-rule" name="Bionics" hidden="false">
          <description>Iron Warriors Armoury price. Follows the normal Bionics rules from the Legiones Astartes Army List.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r44-nl-chainglaive" name="Nostraman Chainglaive" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r44-nl-chainglaive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-nl-chainglaive-rule" name="Nostraman Chainglaive" hidden="false">
          <description>Night Lords Independent Character or squad Sergeant with Space Marine Armoury access. Strength: User +1. Rending, Two-Handed. The Nostraman Chainglaive does not count as a Power Weapon.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r44-nl-chainglaive-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r44-nl-trophies" name="Trophies of Judgement" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r44-nl-trophies-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-nl-trophies-rule" name="Trophies of Judgement" hidden="false">
          <description>Enemy units with one or more models within 8 inches of one or more models equipped with Trophies of Judgement suffer -1 Leadership. Multiple Trophies are not cumulative. Friendly models are unaffected. If an entire squad is equipped, measure from any model in that squad; the squad counts as one source.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r44-nl-trophies-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r44-nl-stealth-ic" name="Stealth Adept" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r44-nl-stealth-ic-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-nl-stealth-ic-rule" name="Stealth Adept" hidden="false">
          <description>Night Lords Independent Character only. Grants Stealth. A model mounted on a Bike or Jetbike or wearing any form of Terminator Armour may not purchase this upgrade. An Independent Character joining a unit with Stealth Adept must also possess Stealth Adept or the unit cannot benefit while that character remains attached.

Stealth: Adds +1 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 6+ Cover Save. Does not stack with Shrouded.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r44-nl-stealth-ic-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r44-nl-stealth-unit" name="Stealth Adept — legacy shared marker" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="0" />
      </costs>
      <constraints>
        <constraint id="r44-nl-stealth-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-nl-stealth-unit-rule" name="Stealth Adept — legacy shared marker" hidden="false">
          <description>Do not select this marker directly. Live Night Lords Infantry and Jump Infantry squads use a unit-local +1 point per model option so the cost scales correctly.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r44-nl-stealth-unit-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r44-nl-kraken-bolts" name="Kraken Light Bolts" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r44-nl-kraken-bolts-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-nl-kraken-bolts-rule" name="Kraken Light Bolts" hidden="false">
          <description>Legion Tactical Squad or Legion Veteran Squad. Bolters, Combi-Bolters, Twin-linked Bolters and the bolter component of Combi-Weapons are AP4 while firing Kraken Light Bolts. May not be combined with Special Issue Ammunition or any other ammunition upgrade. A Tactical Squad may not use Fury of the Legion in a Shooting phase in which it fires Kraken Light Bolts.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r44-nl-kraken-bolts-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r44-nl-transponder-character" name="Teleportation Transponders" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r44-nl-transponder-character-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-nl-transponder-character-rule" name="Teleportation Transponders" hidden="false">
          <description>Night Lords Independent Character wearing any form of Terminator Armour. Grants Deep Strike even if the mission would not normally permit it. An Independent Character intending to Deep Strike as part of another unit must purchase Transponders separately.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r44-nl-transponder-character-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r44-nl-transponder-unit" name="Teleportation Transponders" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="15" />
      </costs>
      <constraints>
        <constraint id="r44-nl-transponder-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-nl-transponder-unit-rule" name="Teleportation Transponders" hidden="false">
          <description>Night Lords unit composed entirely of models wearing any form of Terminator Armour. Grants Deep Strike even if the mission would not normally permit it.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r44-nl-transponder-unit-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r44-ba-death-mask" name="Death Mask" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r44-ba-death-mask-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ba-death-mask-rule" name="Death Mask" hidden="false">
          <description>Blood Angels Independent Character only. If an enemy unit loses a close combat in which at least one enemy model was in base contact with the bearer, that unit suffers an additional -1 Leadership when taking the resulting Morale test. Multiple Death Masks are not cumulative.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r44-ba-inferno-pistol" name="Inferno Pistol" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="15" />
      </costs>
      <constraints>
        <constraint id="r44-ba-inferno-pistol-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ba-inferno-pistol-rule" name="Inferno Pistol" hidden="false">
          <description>Any Blood Angels model with access to the Space Marine Armoury may purchase an Inferno Pistol. A Legion Moritat may instead replace both Bolt Pistols with two Inferno Pistols for +20 points.</description>
        </rule>
      </rules>
      <profiles>
        <profile id="r74-ba-inferno-profile" name="Inferno Pistol" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">6"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
            <characteristic name="Type" typeId="ranged-type">Pistol, Melta</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry id="r44-ba-blade-perdition" name="Blade of Perdition" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="25" />
      </costs>
      <constraints>
        <constraint id="r44-ba-blade-perdition-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ba-blade-perdition-rule" name="Blade of Perdition" hidden="false">
          <description>Blood Angels Character with access to the Space Marine Armoury. Power Weapon, Two-Handed, Perdition. A natural To Wound roll of 6 causes a Massive Wound instead of a normal Wound. Counts as a sword-like weapon.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r44-ba-overcharged-engines" name="Over-charged Engines" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="15" />
      </costs>
      <constraints>
        <constraint id="r44-ba-overcharged-engines-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ba-overcharged-engines-rule" name="Over-charged Engines" hidden="false">
          <description>Blood Angels Rhino only. Before moving, roll D6: 1 — the Rhino may not move; 2-3 — move normally; 4-6 — it may move as a Fast Vehicle that turn, to a maximum of 18 inches. Passengers follow normal ProHammer transport rules.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r44-ba-furioso-jump-pack" name="Furioso-pattern Jump Pack" type="upgrade" hidden="false" import="true">
      <categoryLinks><categoryLink id="r44-ba-furioso-jump-pack-r40-jump" name="Awakening Fire — Jump Infantry" targetId="r40-sal-awakening-jump" hidden="false" /></categoryLinks><costs>
        <cost name="Points" typeId="pts" value="55" />
      </costs>
      <constraints>
        <constraint id="r44-ba-furioso-jump-pack-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="r44-ba-furioso-jump-pack-roster" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ba-furioso-jump-pack-rule" name="Furioso-pattern Jump Pack" hidden="false">
          <description>0-1 per army. A Blood Angels Legion Contemptor equipped with two Dreadnought Close Combat Weapons may purchase this. It may move up to 12 inches and pass over models and terrain like Jump Infantry, remains a Walker, may charge normally, may not Deep Strike, and suffers a Glancing Hit on a D6 roll of 1 if it ends the move in Difficult or Dangerous Terrain.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r44-ih-servo-arm" name="Servo-Arm" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="30" />
      </costs>
      <constraints>
        <constraint id="r44-ih-servo-arm-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ih-servo-arm-rule" name="Servo-Arm" hidden="false">
          <description>Any Iron Hands model with Space Marine Armoury access may purchase this even without Techmarine access. A Jump Pack model may not purchase it.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r44-ih-mechadendrites" name="Mechadendrites" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="15" />
      </costs>
      <constraints>
        <constraint id="r44-ih-mechadendrites-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ih-mechadendrites-rule" name="Mechadendrites" hidden="false">
          <description>Iron Hands Independent Character or Sergeant. Once during each phase the bearer may re-roll one failed Armour Save; not an Invulnerable or Cover Save. The second result must be accepted.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r44-ih-gladius" name="Albian Power Gladius" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r44-ih-gladius-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ih-gladius-rule" name="Albian Power Gladius" hidden="false">
          <description>Iron Hands Character with Armoury access. User Strength, Rending (5+). Against Vehicles, Rending still triggers only on a natural Armour Penetration roll of 6.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r44-ih-bionics-character" name="Bionics" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r44-ih-bionics-character-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ih-bionics-character-rule" name="Bionics" hidden="false">
          <description>Iron Hands Character/Veteran Sergeant price. Iron Hands Bionics recover on 5+ rather than 6+.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r44-ih-graviton-substitution" name="Graviton Gun instead of Flamer" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="15" />
      </costs>
      <constraints>
        <constraint id="r44-ih-graviton-substitution-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ih-graviton-substitution-rule" name="Graviton Gun instead of Flamer" hidden="false">
          <description>Whenever an Iron Hands model may purchase a Flamer, it may instead purchase a Graviton Gun for +15 points. Use the normal Graviton Gun profile/rules from the project armoury.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r44-ih-autosimulacra" name="Blessed Autosimulacra" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r44-ih-autosimulacra-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r44-ih-autosimulacra-rule" name="Blessed Autosimulacra" hidden="false">
          <description>Iron Hands Vehicle. At the beginning of the Movement phase choose one Weapon Destroyed or Immobilised result and roll D6; on a 6 it is repaired. One attempt per Vehicle per turn.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r45-we-chainaxe" name="Chainaxe" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="4" />
      </costs>
      <constraints>
        <constraint id="r45-we-chainaxe-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-we-chainaxe-rule" name="Chainaxe" hidden="false">
          <description>Replace an eligible Close Combat Weapon. User Strength, Chainaxe: Armour Saves better than 4+ are reduced to 4+; 4+ or worse and Invulnerable Saves are unaffected.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r45-we-caedere" name="Caedere Weapon" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="15" />
      </costs>
      <constraints>
        <constraint id="r45-we-caedere-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-we-caedere-rule" name="Caedere Weapon" hidden="false">
          <description>World Eaters Independent Character or squad Sergeant. User +1 Strength, Rending, one-handed; does not count as a Power Weapon.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r45-we-chainaxe-berserker" name="Chainaxe — Berserker Assault price" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="2" />
      </costs>
      <constraints>
        <constraint id="r45-we-chainaxe-berserker-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-we-chainaxe-berserker-rule" name="Chainaxe — Berserker Assault price" hidden="false">
          <description>Berserker Assault only. Legion Assault Squad and Rampager models may purchase Chainaxes for +2 points per model instead of +4.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r45-um-legatine-axe" name="Legatine Axe" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="20" />
      </costs>
      <constraints>
        <constraint id="r45-um-legatine-axe-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-um-legatine-axe-rule" name="Legatine Axe" hidden="false">
          <description>Ultramarines Independent Character with Armoury access. User +1 Strength, Power Weapon, Two-Handed.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r45-um-mantle" name="Mantle of Ultramar" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="20" />
      </costs>
      <constraints>
        <constraint id="r45-um-mantle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-um-mantle-rule" name="Mantle of Ultramar" hidden="false">
          <description>Ultramarines Praetor with Artificer Armour only. Exchanges it for a 2+ Armour Save, Feel No Pain (5+) and immunity to Blind for the bearer.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r45-dg-manreaper" name="Manreaper" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="20" />
      </costs>
      <constraints>
        <constraint id="r45-dg-manreaper-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-dg-manreaper-rule" name="Manreaper" hidden="false">
          <description>Death Guard Sergeant or Character with Armoury access. Two-Handed Power Weapon. At the start of each Assault phase roll D3 and gain that many Attacks; if all attacks target one separately targetable Independent Character/model, gain only +1. No bonus for a second close-combat weapon.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r45-dg-alchem-flamer" name="Alchem Flamer replacement" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="0" />
      </costs>
      <constraints>
        <constraint id="r45-dg-alchem-flamer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-dg-alchem-flamer-rule" name="Alchem Flamer replacement" hidden="false">
          <description>A Death Guard model with a Flamer or Heavy Flamer may replace it for free. Template, S2 AP5, Assault 1, Poisoned (3+). Combi-flamers may become Combi-Alchem Flamers for +4 points in addition to their normal cost.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r45-ts-force-weapon" name="Prosperine Force Weapon upgrade" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r45-ts-force-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-ts-force-weapon-rule" name="Prosperine Force Weapon upgrade" hidden="false">
          <description>Upgrade a Power Weapon to a Force Weapon. Follows normal Force Weapon rules; a Psychic Brotherhood may attempt only one Force Weapon activation per Assault phase and only wounds caused by the nominated model become Massive Wounds/D3 Wounds.</description>
        </rule>
      </rules>
    <modifiers><modifier id="r18-r45-ts-force-weapon-xv-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-force-needs-powerweapon" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="gear-power-weapon" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-final-ahriman-cabal-hide-generic-force" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r18-final-ahriman-cabal-upgrade" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
    <selectionEntry id="r45-ts-arcane-litanies" name="Arcane Litanies" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r45-ts-arcane-litanies-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-ts-arcane-litanies-rule" name="Arcane Litanies" hidden="false">
          <description>Thousand Sons Independent Character with Mastery Level 1+. Once per battle, ignore one Wound suffered from Perils of the Warp; the test and power are otherwise resolved normally.</description>
        </rule>
      </rules>
    <modifiers><modifier id="r18-r45-ts-arcane-litanies-xv-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
    <selectionEntry id="r45-ts-asphyx-ic" name="Asphyx Shells" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r45-ts-asphyx-ic-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-ts-asphyx-ic-rule" name="Asphyx Shells" hidden="false">
          <description>Thousand Sons Independent Character. Bolt Pistols, Bolters, Combi-Bolters and bolter components of Combi-Weapons gain Shred. Cannot combine with Special Issue Ammunition or another ammunition upgrade.

Shred: Re-roll failed To Wound rolls.</description>
        </rule>
      </rules>
    <modifiers><modifier id="r18-r45-ts-asphyx-ic-xv-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
    <selectionEntry id="r45-ts-asphyx-unit" name="Asphyx Shells" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="20" />
      </costs>
      <constraints>
        <constraint id="r45-ts-asphyx-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-ts-asphyx-unit-rule" name="Asphyx Shells" hidden="false">
          <description>Thousand Sons Veteran or Terminator Squad. Bolt Pistols, Bolters, Combi-Bolters and bolter components of Combi-Weapons gain Shred. Cannot combine with Special Issue Ammunition or another ammunition upgrade.

Shred: Re-roll failed To Wound rolls.</description>
        </rule>
      </rules>
    <modifiers><modifier id="r18-r45-ts-asphyx-unit-xv-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
    <selectionEntry id="r45-ts-trans-ic" name="Teleportation Transponders" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r45-ts-trans-ic-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-ts-trans-ic-rule" name="Teleportation Transponders" hidden="false">
          <description>Thousand Sons Independent Character in Terminator Armour. Gains Deep Strike even if the mission would not normally allow it.

Deep Strike: Units that enter play from Reserves by Deepstriking are placed directly on the board and do not have to move onto the table from a table edge.

1. Determine Target Location: when the unit is available to enter play, place one model (the centre model) anywhere on the table more than 2" from enemy models.
2. Roll for Deepstrike Scattering: roll 2D6 and a Scatter die. On a Hit, proceed to placement. On an arrow, determine an adjusted location 2D6" in that direction. If that location would be on a friendly model, stop 2" short. If it falls in impassable terrain, off the table, or on top of or within 2" of an enemy model, a Deepstrike Mishap occurs.
Deepstrike Mishap: the opposing player instead places the centre model within 12" of the target location. The chosen location may not be in impassable terrain, off the table, within 2" of an enemy model, or within 2" of its original position. If no viable position exists, the unit returns to Reserves to redeploy next turn. The unit must also pass a Pinning Test or become Pinned for the remainder of the turn.
3. Place Remaining Models: place all other models within 2" of the centre model. Models may not be placed in impassable terrain or within 2" of enemy models. Models that cannot fit within 2" may be placed in base contact with another model and as close to the centre as possible; any model that still cannot be placed is destroyed.

Using Deepstriking Units: models arriving by Deepstrike or disembarking from Deepstriking Vehicles may not make a normal move after arriving, but may shoot, Advance D6", or assault. Units charging in the turn they arrived by Deepstrike gain no bonus Attacks for charging and no benefit from assault grenades. Deepstriking Vehicles count as having moved at Cruising Speed on the turn they arrive.</description>
        </rule>
      </rules>
    <modifiers><modifier id="r18-r45-ts-trans-ic-xv-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
    <selectionEntry id="r45-ts-trans-unit" name="Teleportation Transponders" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="15" />
      </costs>
      <constraints>
        <constraint id="r45-ts-trans-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-ts-trans-unit-rule" name="Teleportation Transponders" hidden="false">
          <description>Thousand Sons unit composed entirely of models wearing Terminator Armour. Normally +15 points per unit; free while using The Guard of the Crimson King. Grants Deep Strike even if the mission would not normally permit it.</description>
        </rule>
      </rules>
    <modifiers><modifier id="r18-r45-ts-trans-unit-xv-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-guard-free-trans-unit" type="set" field="pts" value="0"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xv-1-the-guard-of-the-crimson-king" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
    <selectionEntry id="r45-ts-aether-fire" name="Æther-fire Cannon upgrade" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="0" />
      </costs>
      <constraints>
        <constraint id="r45-ts-aether-fire-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r45-ts-aether-fire-rule" name="Æther-fire Cannon upgrade" hidden="false">
          <description>Any Plasma Cannon may be upgraded for free; if a unit has multiple Plasma Cannons all or none must upgrade. 36”, S7 AP2, Heavy 1, Blast, Gets Hot, Soul Blaze.</description>
        </rule>
      </rules>
    <modifiers><modifier id="r18-r45-ts-aether-fire-xv-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-aether-needs-plasma" type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="and"><conditions><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r79-ih-ferrus-morlocks-r41-unit-x-2-morlock-terminator-squad-opt-11-plasma-cannon" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r35-fury-dread-dreadnought-p-pc" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="gear-plasma-cannon" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r41-unit-x-3-venerable-forge-lord-opt-4-plasma-cannon" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r35-fury-contemptor-contemptor-p-pc-prof-0" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="dreadnought-s-pc-prof-0" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r35-fury-contemptor-contemptor-s-pc-prof-0" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r35-fury-contemptor-contemptor-p-pc" shared="true" includeChildSelections="t