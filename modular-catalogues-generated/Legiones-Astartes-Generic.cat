                      <selectionEntry id="r40-sal-fury-ce8eda14d2" name="Pyromancy — Fury of the Salamander" type="upgrade" hidden="true"><modifiers><modifier id="r40-sal-fury-ce8eda14d2-show" type="set" field="hidden" value="false"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xviii" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xviii-1-the-awakening-fire" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier><modifier id="r40-sal-fury-ce8eda14d2-show-r62-shat-7f11f2976b11" type="set" field="hidden" value="false"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-4fa298eaa178" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xviii-1-the-awakening-fire" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier></modifiers><rules><rule id="r40-sal-fury-ce8eda14d2-rule" name="Elemental Horror" hidden="false"><description>If the target unit suffers one or more unsaved Wounds, it immediately takes a Morale test with a Leadership penalty equal to the number of unsaved Wounds caused.</description></rule><rule id="r40-sal-fury-ce8eda14d2-disc" name="Pyromancy restriction" hidden="false"><description>May only be selected as a Pyromancy power.</description></rule></rules><infoLinks><infoLink id="r40-sal-fury-ce8eda14d2-prof" name="Fury of the Salamander" targetId="r40-sal-prof-fury" type="profile" hidden="false" /></infoLinks><constraints><constraint id="r40-sal-fury-ce8eda14d2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry></selectionEntries>
