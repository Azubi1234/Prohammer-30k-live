              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" id="r32-soh-first-company-term-r57-terminator-unit-iw-bionics-pts" />
              </costs>
              <rules>
                <rule id="r32-soh-first-company-term-r57-terminator-unit-iw-bionics-rule" name="Bionics" hidden="false">
                  <description>Iron Warriors Armoury price; otherwise follows the normal Bionics rules.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
