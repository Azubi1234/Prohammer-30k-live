      <infoLinks><infoLink id="r36-link-d4622609e4f0" name="Sniper" hidden="false" targetId="r36-shared-sniper-2081d06" type="rule" /></infoLinks><profiles>
        <profile name="Sniper Rifle" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-sniper-rifle">
