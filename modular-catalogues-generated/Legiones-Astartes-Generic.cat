      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" />
          </conditions>
        </modifier>
      </modifiers>
      <entryLinks>
        <entryLink id="r74-ba-contemptor-jump" name="Furioso-pattern Jump Pack" type="selectionEntry" targetId="r44-ba-furioso-jump-pack" hidden="true" import="true">
          <constraints>
            <constraint id="r74-ba-contemptor-jump-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r75-ba-furioso-show" type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-ix" shared="true" includeChildSelections="true" includeChildForces="false" />
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="contemptor-p-dccw" shared="true" includeChildSelections="true" includeChildForces="false" />
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="contemptor-s-dccw" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
