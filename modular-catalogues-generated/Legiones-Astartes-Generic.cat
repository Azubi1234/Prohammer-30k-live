    <selectionEntry id="r47-ws-horsetail-talisman" name="Horsetail Talisman" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="25" />
      </costs>
      <constraints>
        <constraint id="r47-ws-horsetail-talisman-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="r47-ws-horsetail-talisman-rmax" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r47-ws-horsetail-talisman-rule" name="Horsetail Talisman" hidden="false">
          <description>One White Scars Independent Character only; 0–1 per army. Once per battle, at the beginning of the White Scars Shooting phase, reveal the Talisman. The bearer and every friendly White Scars non-vehicle unit with at least one model within 6” may choose to move D6” instead of shooting. Bike and Jetbike units may also make this movement. A unit making this move may not move within 1” of an enemy, must maintain coherency and may not charge that turn. Falling Back, embarked or locked units may not benefit.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r47-ih-bionics-model" name="Bionics — unit model" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="3" />
      </costs>
      <constraints>
        <constraint id="r47-ih-bionics-model-max" type="max" value="20" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r47-ih-bionics-model-rule" name="Bionics — unit model" hidden="false">
          <description>Iron Hands Infantry unit upgrade. Every model in the unit must receive Bionics. Select this +3-point entry once for each non-Veteran-Sergeant model in the unit. A Veteran Sergeant instead pays +5 points using the separate Sergeant entry. Models already equipped with Bionics receive no additional benefit. Iron Hands Bionics recover on 5+ rather than 6+.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r47-ih-bionics-veteran-sergeant" name="Bionics — Veteran Sergeant" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r47-ih-bionics-veteran-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r47-ih-bionics-veteran-sergeant-rule" name="Bionics — Veteran Sergeant" hidden="false">
          <description>Veteran Sergeant price when the whole Iron Hands Infantry unit purchases Bionics. The entire unit must be upgraded; models already equipped with Bionics receive no additional benefit. Iron Hands Bionics recover on 5+ rather than 6+.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r47-ih-splinter-bolts" name="Splinter Bolts" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r47-ih-splinter-bolts-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r47-ih-splinter-bolts-rule" name="Splinter Bolts" hidden="false">
          <description>Iron Hands Infantry unit equipped with Bolters. Wounds caused by the unit’s Bolters ignore Feel No Pain. Bolters means Bolters, Combi-Bolters, Twin-linked Bolters and the Bolter component of Combi-Weapons. Splinter Bolts may not combine with Special Issue Ammunition or another ammunition upgrade. A Legion Tactical Squad may not use Fury of the Legion in a Shooting phase in which it fires Splinter Bolts.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r47-ts-prosperine-aether-disc" name="Prosperine Æther-Disc" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="30" />
      </costs>
      <constraints>
        <constraint id="r47-ts-prosperine-aether-disc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r47-ts-prosperine-aether-disc-rule" name="Prosperine Æther-Disc" hidden="false">
          <description>Thousand Sons Independent Character wearing Power Armour or Artificer Armour only. The bearer becomes Jump Infantry and gains Turbo-Boosters and Hammer of Wrath. Ætheric Evasion: if the bearer moved at least 6” in its preceding Movement phase, enemy models suffer -1 To Hit the bearer in close combat, to a maximum required roll of 6+. Lost while Falling Back. May not be combined with a Jump Pack, Bike, Jetbike or any form of Terminator Armour.</description>
        </rule>
      </rules>
    <modifiers><modifier id="r18-r47-ts-prosperine-aether-disc-xv-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-0" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-praetor-jump" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-1" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-praetor-bike" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-2" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r37-praetor-jetbike" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-3" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-praetor-term" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-4" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-praetor-tart" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-5" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-praetor-cat" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-6" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-centurion-jump" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-7" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-centurion-bike" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-8" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r37-centurion-jetbike" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-9" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-centurion-term" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-10" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-centurion-tart" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-11" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-centurion-cat" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r18-ts-disc-incompat-12" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-consul-vigilator-scoutarmour" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
    <selectionEntry id="r52-ec-sonic-character" name="Sonic Weaponry (one Praetor or Centurion per army)" type="upgrade" hidden="false" import="true">
      <constraints>
        <constraint id="r52-ec-sonic-character-parent" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="r52-ec-sonic-character-roster" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <selectionEntryGroups>
        <selectionEntryGroup id="r52-ec-sonic-character-choice" name="Choose one Sonic Weapon" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r52-ec-sonic-character-choice-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="r52-ec-sonic-character-blaster" name="Sonic Blaster" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-sonic-character-blaster-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
            </selectionEntry>
            <selectionEntry id="r52-ec-sonic-character-siren" name="Doom Siren" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-sonic-character-siren-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <rules>
        <rule id="r52-ec-sonic-character-rule" name="Restriction" hidden="false">
          <description>TRAITOR ONLY. One Emperor's Children Praetor or Centurion in the army may carry one Sonic Weapon.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-frost" name="Frost Weapon" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="20" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-frost-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-frost-rule" name="Frost Weapon" hidden="false">
          <description>Strength: User +1. Power Weapon. May be represented by a sword, axe, claw or similar Fenrisian weapon; appearance has no additional rules effect.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-frost-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-frost-exchange" name="Frost Weapon — exchange an existing Power Weapon" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-frost-exchange-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-frost-exchange-rule" name="Frost Weapon — exchange an existing Power Weapon" hidden="false">
          <description>Only a model already equipped with a Power Weapon may select this +5 point exchange. The Power Weapon is replaced by a Frost Weapon: Strength User +1, Power Weapon.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-frost-exchange-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-great-frost" name="Great Frost Blade" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="35" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-great-frost-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-great-frost-rule" name="Great Frost Blade" hidden="false">
          <description>Strength: User +2. Power Weapon, Two-Handed, Master-crafted. A model using it suffers -1 Initiative during that Assault phase.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-great-frost-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-pelt" name="Wolf Pelt" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-pelt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-pelt-rule" name="Wolf Pelt" hidden="false">
          <description>When the bearer's unit successfully uses Counter-Attack, the bearer receives +2 Attacks instead of the normal +1 Attack granted by Counter-Attack.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-pelt-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-necklace" name="Wolf Tooth Necklace" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-necklace-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-necklace-rule" name="Wolf Tooth Necklace" hidden="false">
          <description>The bearer always hits enemy models on a 3+ in close combat, unless the bearer would normally hit on a better result.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-necklace-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-talisman" name="Wolf Tail Talisman" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-talisman-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-talisman-rule" name="Wolf Tail Talisman" hidden="false">
          <description>Whenever an enemy psychic power directly affects the bearer or a unit he has joined, after the power is successfully invoked and any normal Deny the Witch attempt is resolved, roll a D6. On a 6, the bearer is unaffected. If joined to a unit, the remainder of the unit is affected normally.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-talisman-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-runic-armour" name="Runic Armour" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="25" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-runic-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-runic-armour-rule" name="Runic Armour" hidden="false">
          <description>Only a Space Wolves Independent Character wearing Power Armour may select this option. Replace Power Armour with Runic Armour. It grants a 2+ Armour Save and Adamantium Will, and counts as Artificer Armour for all other rules and restrictions.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-runic-armour-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r64-if-gear-solarite" name="Solarite Power Gauntlet" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="30" />
      </costs>
      <constraints>
        <constraint id="r64-if-gear-solarite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r64-if-gear-solarite-rule" name="Solarite Power Gauntlet" hidden="false">
          <description>Imperial Fists Character with Space Marine Armoury access. Strength 10; Power Weapon, Unwieldy, Specialist Weapon. Unlike a normal Power Fist it always strikes at Strength 10 regardless of the bearer's Strength.</description>
        </rule>
        <rule id="r67-if-r64-if-gear-solarite-visible" name="Rules" hidden="false">
          <description>Strength 10. Power Weapon, Unwieldy, Specialist Weapon. Always strikes at Strength 10 regardless of the bearer’s Strength.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r64-if-gear-solarite-hide-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r64-if-gear-solarite-exchange" name="Solarite Power Gauntlet — exchange Power Fist" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r64-if-gear-solarite-exchange-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r64-if-gear-solarite-exchange-rule" name="Solarite Power Gauntlet — exchange Power Fist" hidden="false">
          <description>Only a model already equipped with a Power Fist may select this exchange. Replace that Power Fist with a Solarite Power Gauntlet.</description>
        </rule>
        <rule id="r67-if-r64-if-gear-solarite-exchange-visible" name="Rules" hidden="false">
          <description>Replace an already-equipped Power Fist with a Solarite Power Gauntlet for +5 points.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r64-if-gear-solarite-exchange-hide-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r64-if-gear-vigil" name="Vigil Pattern Storm Shield" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="25" />
      </costs>
      <constraints>
        <constraint id="r64-if-gear-vigil-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r64-if-gear-vigil-rule" name="Vigil Pattern Storm Shield" hidden="false">
          <description>Imperial Fists Independent Character only. Grants a 3+ Invulnerable Save. The bearer may carry no more than one weapon in addition to the shield; the shield occupies one hand and the bearer never receives the bonus Attack for fighting with two close-combat weapons.</description>
        </rule>
        <rule id="r67-if-r64-if-gear-vigil-visible" name="Rules" hidden="false">
          <description>3+ Invulnerable Save. The bearer may carry no more than one other weapon; the shield occupies one hand and prevents the bonus Attack for fighting with two close-combat weapons.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r64-if-gear-vigil-hide-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <categoryLinks>
        <categoryLink id="r66-if-vigil-cat" name="Stone Gauntlet — Shield-bearing Independent Character" hidden="true" targetId="r66-if-cat-stone-shield-ic" primary="false" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry id="r64-if-gear-trans-ic" name="Teleportation Transponders" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r64-if-gear-trans-ic-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r64-if-gear-trans-ic-rule" name="Teleportation Transponders" hidden="false">
          <description>Imperial Fists Independent Character. Normally only available while wearing Terminator Armour; Hammerfall Strike Force removes this restriction. Grants Deep Strike even if the mission would not normally permit it. An Independent Character joining another Deep Striking unit must purchase Transponders separately.</description>
        </rule>
        <rule id="r67-if-r64-if-gear-trans-ic-visible" name="Rules" hidden="false">
          <description>Grants Deep Strike even if the mission would not normally permit it. An Independent Character joining another Deep Striking unit must purchase Transponders separately.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r64-if-gear-trans-ic-hide-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <categoryLinks>
        </categoryLinks>
    </selectionEntry>
    <selectionEntry id="r64-if-gear-trans-unit" name="Teleportation Transponders" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="15" />
      </costs>
      <constraints>
        <constraint id="r64-if-gear-trans-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r64-if-gear-trans-unit-rule" name="Teleportation Transponders" hidden="false">
          <description>Imperial Fists unit. Normally available only when every model wears Terminator Armour; Hammerfall Strike Force allows any Imperial Fists Infantry unit to purchase it. Grants Deep Strike even if the mission would not normally permit it.</description>
        </rule>
        <rule id="r67-if-r64-if-gear-trans-unit-visible" name="Rules" hidden="false">
          <description>Grants Deep Strike even if the mission would not normally permit it.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r64-if-gear-trans-unit-hide-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r74-ba-blade-exchange" name="Blade of Perdition — exchange existing Power Weapon" type="upgrade" hidden="false" import="true">
      <constraints>
        <constraint id="r74-ba-blade-exchange-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <rules>
        <rule id="r74-ba-blade-exchange-rule" name="Blade of Perdition — exchange existing Power Weapon" hidden="false">
          <description>Only a Blood Angels Character already equipped with a Power Weapon may use this exchange. The Power Weapon is replaced by a Blade of Perdition.</description>
        </rule>
      </rules>
    </selectionEntry>
  <selectionEntry type="unit" import="true" name="Legion Terminator Squad — Long March (non-compulsory Troops)" hidden="true" id="r32-soh-long-march-terminator-troops">
      <categoryLinks>
        <categoryLink id="r32-soh-long-march-terminator-troops-cat" name="Troops" hidden="false" targetId="cat-troops" primary="true" /></categoryLinks>
      <infoLinks><infoLink id="r36-link-bf2955d6aa2a" name="Implacable Advance" hidden="false" targetId="r36-shared-implacable-advance-76d1b91" type="rule" /></infoLinks><rules>
        <rule name="Standard Wargear" id="r32-soh-long-march-terminator-standard" hidden="false">
          <description>Every model is equipped with the selected Terminator Armour pattern, a Combi-bolter and a Power Weapon unless replaced below.</description>
        </rule>
        <rule name="Legiones Astartes" id="r32-soh-long-march-terminator-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Dedicated Transport" id="r32-soh-long-march-terminator-transport-rule" hidden="false">
          <description>The squad may select a Land Raider, a Land Raider variant with sufficient Transport Capacity, a Dreadclaw Drop Pod or a Spartan Assault Tank where permitted. A Dreadclaw can carry only five models in Terminator Armour, so it is selectable here only for a five-model squad. Land Raider and Spartan choices will become selectable when their vehicle entries are added.</description>
        </rule>
      <rule id="r32-soh-longmarch-role" name="The Warmaster’s Portion" hidden="false"><description>Selected as a non-compulsory Troops choice under The Long March. This unit may not fulfil a compulsory Troops selection.</description></rule></rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Terminators" hidden="false" id="r32-soh-long-march-terminator-included" defaultAmount="4">
          <constraints>
            <constraint id="r32-soh-long-march-terminator-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r32-soh-long-march-terminator-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminators (included)" id="r32-soh-long-march-terminator-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="pts" value="30" />
          </costs>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Terminator Sergeant" hidden="false" id="r32-soh-long-march-terminator-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="r32-soh-long-march-terminator-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r32-soh-long-march-terminator-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminator Sergeant" id="r32-soh-long-march-terminator-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <entryLink id="r32-soh-long-march-r37-orbital-teleport-terminator-unit" name="Teleport Assault (Orbital Assault)" targetId="r41-universal-gear-78f70cd43f9732" type="selectionEntry" import="true" hidden="true"><constraints>
            <constraint id="r32-soh-long-march-r37-orbital-teleport-terminator-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-orbital" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </entryLink><selectionEntry id="r32-soh-long-march-r71-nl-bj-5" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r32-soh-long-march-r71-nl-bj-5-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r32-soh-long-march-r71-nl-bj-5-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.

Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r32-soh-long-march-r71-nl-bj-5-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="Points" typeId="pts" value="55" />
      </costs>
      <selectionEntryGroups>
        <selectionEntryGroup name="Terminator Armour Pattern (entire squad)" id="r32-soh-long-march-terminator-armour-pattern" hidden="false">
          <constraints>
            <constraint id="r32-soh-long-march-terminator-armour-pattern-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="r32-soh-long-march-terminator-armour-pattern-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Terminator Armour" hidden="false" id="r32-soh-long-march-terminator-armour-normal" defaultAmount="1">
              <constraints>
                <constraint id="r32-soh-long-march-terminator-armour-normal-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Terminator Armour" id="r32-soh-long-march-terminator-armour-normal-rule" hidden="false">
                  <description>2+ Armour Save, 5+ Invulnerable Save; Relentless, Bulky, Deep Strike; may not Pursue. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tartaros Terminator Armour" hidden="false" id="r32-soh-long-march-terminator-armour-tartaros">
              <constraints>
                <constraint id="r32-soh-long-march-terminator-armour-tartaros-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Tartaros Terminator Armour" id="r32-soh-long-march-terminator-armour-tartaros-rule" hidden="false">
                  <description>2+ Armour Save, 5+ Invulnerable Save; Relentless, Bulky, Deep Strike; may Pursue. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Cataphractii Terminator Armour" hidden="false" id="r32-soh-long-march-terminator-armour-cataphractii">
              <constraints>
                <constraint id="r32-soh-long-march-terminator-armour-cataphractii-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Cataphractii Terminator Armour" id="r32-soh-long-march-terminator-armour-cataphractii-rule" hidden="false">
                  <description>2+ Armour Save, 4+ Invulnerable Save; Relentless, Bulky, Deep Strike; may not Advance, Pursue or fire Overwatch. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Ranged Weapon Replacements" id="r32-soh-long-march-terminator-ranged" hidden="false">
          <constraints>
            <constraint id="r32-soh-long-march-terminator-ranged-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier type="increment" value="1" field="r32-soh-long-march-terminator-ranged-max">
              <repeats>
                <repeat value="5" repeats="1" field="selections" scope="root-entry" childId="r32-soh-long-march-terminator-included" shared="true" roundUp="false" includeChildSelections="false" />
              </repeats>
            </modifier>
            <modifier type="increment" value="-1" field="r32-soh-long-march-terminator-ranged-max">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r32-soh-long-march-terminator-pair-claws" shared="true" roundUp="false" includeChildSelections="true" />
              </repeats>
            </modifier>
