      <rules>
        <rule name="Standard Wargear" id="hs-scorpius-wg" hidden="false">
          <description>Scorpius Multi-launcher, Twin-linked Bolter, Searchlight and Smoke Launchers.</description>
        </rule>
        <rule name="Rocket Barrage" id="hs-scorpius-barrage" hidden="false">
          <description>If the Whirlwind Scorpius remained stationary during its Movement phase, the Scorpius Multi-launcher becomes Heavy 1+D3 for that Shooting phase.</description>
        </rule>
      </rules>
