dSelections="true" includeChildForces="false" childId="hq-centurion-ret-command-land-land-raider-achilles" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-hq-centurion-ret-command-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-7-fabius-bile" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></entryLink></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r2-fulgrim-blessing-hq-centurion-ret-command-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-hq-centurion-ret-command" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="25" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-hq-centurion-ret-command-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-hq-centurion-ret-command-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-10-fulgrim-transfigured" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r16-dg-plague-group-hq-centurion-ret-command" name="Sons of the Plague Father" hidden="false"><selectionEntries><entryLink id="r