    <selectionEntry type="unit" name="Legion Sicaran Battle Tank" id="hs-sicaran" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-sicaran-cat" primary="true" name="Heavy Support" hidden="false" />
