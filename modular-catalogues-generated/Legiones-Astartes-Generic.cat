                            <characteristic name="Type" typeId="ranged-type">Assault 4, Witchfire</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-c7f84ee6a7d024-c6ba408ad1b6" name="Smite" hidden="false">
                          <description>Witchfire. Resolve as a normal psychic shooting attack.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-b59d45b990ac38" name="Iron Arm" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-b59d45b990ac38-13780aa3fd9f" name="Iron Arm" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Self</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-b59d45b990ac38-9a450a1290db" name="Iron Arm" hidden="false">
                          <description>The Psyker gains +2 Strength and +1 Toughness.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-b765cfb494dc1c" name="Enfeeble" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-b765cfb494dc1c-8a3c64bca5fd" name="Enfeeble" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Malediction</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-b765cfb494dc1c-7d2ff98c5b23" name="Enfeeble" hidden="false">
                          <description>Target enemy unit suffers -1 Strength and -1 Toughness and treats all movement as Difficult Terrain.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-0b06f466951744" name="Life Leech" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-0b06f466951744-af608ceb9de5" name="Life Leech" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">18"</characteristic>
                            <characteristic name="S" typeId="ranged-s">6</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Assault 2, Witchfire</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-0b06f466951744-60ff0ed5deb8" name="Life Leech" hidden="false">
                          <description>If this power causes at least one unsaved Wound, one model within 6 inches of the Psyker regains one Wound.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-dc8a8cecf6f01e" name="Warp Speed" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-dc8a8cecf6f01e-b03f70ad3d98" name="Warp Speed" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Self</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-dc8a8cecf6f01e-19bbef220763" name="Warp Speed" hidden="false">
                          <description>The Psyker gains +3 Initiative, +3 Attacks and Fleet.

Fleet: Unit may still charge into melee combat even if it advanced this turn.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-7ec5bb87ee4e51" name="Endurance" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-7ec5bb87ee4e51-81d63484a006" name="Endurance" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-7ec5bb87ee4e51-e67fe80444ef" name="Endurance" hidden="false">
                          <description>Target friendly unit gains Eternal Warrior, Feel No Pain (5+) and Relentless.

Relentless: Model may move and fire Heavy, Ordnance, Salvo or Rapid Fire weapons as if it remained stationary. It may still charge even after firing such weapons.
Eternal Warrior: Immune to Instant Death / Massive Wounds. The model suffers 1 Wound instead of D3 Wounds.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-e8d90ff67879ac" name="Haemorrhage" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-e8d90ff67879ac-bd247841bd36" name="Haemorrhage" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">18"</characteristic>
                            <characteristic name="S" typeId="ranged-s">Special</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">Special</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Focused Witchfire</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-e8d90ff67879ac-59179dcd93a6" name="Haemorrhage" hidden="false">
                          <description>Target model must pass two Toughness tests or suffer a Wound with no Armour or Cover save. If slain, select another model within 2 inches; it takes one Toughness test or suffers a Wound. Continue until a test is passed.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-1e798d8e0a2f2a" name="Prescience" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-1e798d8e0a2f2a-c2f38bd613b7" name="Prescience" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-1e798d8e0a2f2a-33eb1b9bd55d" name="Prescience" hidden="false">
                          <description>Target friendly unit may re-roll all failed To Hit rolls.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-9b7e1e9ae42a20" name="Foreboding" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-9b7e1e9ae42a20-c80f9e381a67" name="Foreboding" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Self</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-9b7e1e9ae42a20-e83b1c2eb82c" name="Foreboding" hidden="false">
                          <description>The Psyker and any joined unit gain Counter-Attack and may make Reaction Fire using the full number of allowed shots.

Counter-Attack: If this unit is not engaged with any enemy models and an enemy unit successfully completes a charge move against it, the unit may take a Leadership test. If passed, this unit gains +1 Attack during the Assault phase.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-2a4d9749d9dbbe" name="Forewarning" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-2a4d9749d9dbbe-674c0cc285b4" name="Forewarning" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-2a4d9749d9dbbe-2bd126ed42e1" name="Forewarning" hidden="false">
                          <description>Target friendly unit gains a 4+ Invulnerable Save.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-601cda563181d4" name="Perfect Timing" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-601cda563181d4-cfa8cd72c141" name="Perfect Timing" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Self</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-601cda563181d4-69d9a0a79d56" name="Perfect Timing" hidden="false">
                          <description>The Psyker and any joined unit ignore Cover when shooting an enemy unit.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-0bbf15817bfa9f" name="Precognition" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-0bbf15817bfa9f-0ed09a74b7c9" name="Precognition" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Self</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-0bbf15817bfa9f-a5cfd81cbf3c" name="Precognition" hidden="false">
                          <description>The Psyker re-rolls failed To Hit and To Wound rolls and failed saving throws.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-89ed2a6b7d11a3" name="Misfortune" type="upgrade" hidden="false"><profiles>
                        <profile id="r41-universal-gear-89ed2a6b7d11a3-8e0a7896384c" name="Misfortune" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                            <characteristic name="S" typeId="ranged-s">—</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Malediction</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r41-universal-gear-89ed2a6b7d11a3-61ad376dbd3b" name="Misfortune" hidden="false">
                          <description>All attacks against the target enemy unit count as Rending.</description>
                        </rule>
                      </rules>
                      </selectionEntry><selectionEntry id="r41-universal-gear-8db8b795cbc9c3" name="Scrier's Gaze" type="upgrade" hidden="false"><infoLinks><infoLink id="r41-universal-gear-8db8b795cbc9c3-dc3a8360a92a" name="Scrier's Gaze" hidden="false" targetId="r36-exact-scrier-s-gaze-db52b69" type="rule" /></infoLinks><profiles>
                        <profile id="r41-universal-gear-8db8b795cbc9c3-9bf4eed29a92" name="Scrier's Gaze" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
