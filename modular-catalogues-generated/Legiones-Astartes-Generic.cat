                  </entryLink><selectionEntry id="r69-centurion-command-jetbikes" name="Jetbikes (entire squad)" type="upgrade" hidden="true" import="true">
                  <categoryLinks><categoryLink id="r69-centurion-command-jetbikes-r40-jet" name="Awakening Fire — Jetbike" targetId="r40-sal-awakening-jetbike" hidden="false" /></categoryLinks><constraints>
