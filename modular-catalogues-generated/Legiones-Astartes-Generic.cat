                    <selectionEntry type="upgrade" name="Foreboding" id="r29-lib-power-8" hidden="false" import="true">
                      <constraints>
                        <constraint id="r29-lib-power-8-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Foreboding" id="r29-lib-power-8-rule" hidden="false">
                          <description>Blessing — targets Psyker. Psyker and joined unit gain Counter-Attack and may fire reaction fire using the full number of allowed shots.

Counter-Attack: If this unit is not engaged with any enemy models and an enemy unit successfully completes a charge move against it, the unit may take a Leadership test. If passed, this unit gains +1 Attack during the Assault phase.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier type="set" value="true" field="hidden">
                          <conditions>
                            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-1" shared="true" includeChildSelections="true" />
                          </conditions>
