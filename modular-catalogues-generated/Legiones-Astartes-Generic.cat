      <selectionEntryGroup id="live-r2-fulgrim-blessing-hq-centurion-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-hq-centurion" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="20" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-hq-centurion-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-hq-centurion-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-hq-centurion-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-10-fulgrim-transfigured" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r13-dg-reaping-upgrades" name="The Reaping — Character Upgrades" hidden="false"><modifiers><modifier id="r13-dg-reaping-upgrades-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-xiv-0-the-reaping" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><selectionEntries><selectionEntry id="r13-hq-centurion-rad" name="Rad Grenades" type="upgrade" hidden="false" import="true"><constraints><constraint id="r13-hq-centurion-rad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs