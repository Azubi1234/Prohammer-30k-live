      <selectionEntries>
        <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hs-venator-hunter-killer-missile" hidden="false" import="true">
          <constraints>
            <constraint id="hs-venator-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
          <rules>
            <rule name="Hunter-Killer Missile" id="hs-venator-hunter-killer-missile-rule" hidden="false">
              <description>Unlimited range, S8 AP3, Heavy 1, One Use.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" name="Dozer Blade" id="hs-venator-dozer-blade" hidden="false" import="true">
          <constraints>
            <constraint id="hs-venator-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
          <rules>
            <rule name="Dozer Blade" id="hs-venator-dozer-blade-rule" hidden="false">
              <description>Use the normal ProHammer Dozer Blade rule.</description>
            </rule>
          </rules>
        </selectionEntry>
        <entryLink id="hs-venator-auxiliary-drive" name="Auxiliary Drive" targetId="r41-universal-gear-9513f2d8de2ed1" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="hs-venator-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
