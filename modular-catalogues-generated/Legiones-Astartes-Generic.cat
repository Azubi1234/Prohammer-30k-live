            </entryLink><selectionEntry id="r6-tactical-unit-aeonid-thiel" name="Replace Sergeant with Aeonid Thiel" type="upgrade" hidden="false" import="true"><infoLinks><infoLink id="r36-link-af47245fe9c2" name="Sergeant Replacement" hidden="false" targetId="r36-exact-sergeant-replacement-9a2bb74" type="rule" /><infoLink id="r36-link-650e35569f67" name="Aeonid Thiel — Sergeant Replacement" hidden="false" targetId="r36-exact-aeonid-thiel-sergeant-replacement-24b0799" type="rule" /></infoLinks><costs><cost name="Points" typeId="pts" value="80" /></costs><constraints><constraint id="r6-tactical-unit-aeonid-thiel-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /><constraint id="r6-tactical-unit-aeonid-thiel-uniq" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><modifiers><modifier id="r6-tactical-unit-aeonid-thiel-um-only" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xiii" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r6-tactical-unit-aeonid-thiel-r8-other-thiel" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r6-veteran-unit-aeonid-thiel" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r6-tactical-unit-aeonid-thiel-um-only-r62-shat-190604906a70" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-0dee9d5efcdc" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><profiles>
        <profile name="Aeonid Thiel" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xiii-6-aeonid-thiel-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
            <characteristic name="BS" typeId="model-bs">5</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">2</characteristic>
            <characteristic name="I" typeId="model-i">5</characteristic>
            <characteristic name="A" typeId="model-a">3</characteristic>
            <characteristic name="Ld" typeId="model-ld">10</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+/5+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Source Entry" id="r41-unit-xiii-6-aeonid-thiel-source" hidden="false">
          <description>Aeonid Thiel | 5 | 5 | 4 | 4 | 2 | 5 | 3 | 10 | 3+/5+
One Legion Tactical Squad or Legion Veteran Squad may replace its Sergeant with Aeonid Thiel for +80 points. Thiel remains part of the squad for the entire battle. He is a Character but is not an Independent Character.
UNORTHODOX TACTICS After deployment but before the first turn begins, choose one of the following special rules: • Counter-Attack • Move Through Cover • Night Vision • Tank Hunters Thiel and every model in his squad gain the selected special rule for the duration of the battle. The unit retains the selected rule even if Thiel is subsequently slain.
Wargear:
• Power Armour
• Refractor Field
• Power weapon
• Bolt pistol
• Purity Seals
• Frag grenades
Special Rules:
• Legiones Astartes (Ultramarines)
• Unorthodox Tactics
If the squad purchases Krak grenades or Melta bombs,
Thiel receives the same upgrade at the normal squad cost.</description>
        </rule>
      </rules>
    <selectionEntryGroups><selectionEntryGroup id="r8-tactical-unit-thiel-tactic" name="Unorthodox Tactics — choose one" hidden="false"><constraints><constraint id="r8-tactical-unit-thiel-tactic-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /><constraint id="r8-tactical-unit-thiel-tactic-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><entryLink id="r8-tactical-unit-thiel-tactic-0" name="Counter-Attack" targetId="r41-universal-gear-c578d663f46366" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r8-tactical-unit-thiel-tactic-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink><entryLink id="r8-tactical-unit-thiel-tactic-1" name="Move Through Cover" targetId="r41-universal-gear-16d0a79c77d44e" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r8-tactical-unit-thiel-tactic-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink><selectionEntry id="r8-tactical-unit-thiel-tactic-2" name="Night Vision" type="upgrade" hidden="false" import="true"><constraints><constraint id="r8-tactical-unit-thiel-tactic-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><infoLinks><infoLink id="r36-link-d8e41ae28bff" name="Night Vision" hidden="false" targetId="r36-shared-night-vision-1c9da55" type="rule" /></infoLinks></selectionEntry><entryLink id="r8-tactical-unit-thiel-tactic-3" name="Tank Hunters" targetId="r41-universal-gear-48ba9b91eaa8ed" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r8-tactical-unit-thiel-tactic-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="r6-um-combat-squads" name="Combat Squads — split 10 models into two squads of 5" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r6-um-combat-squads-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><modifiers><modifier id="r6-um-combat-squads-um-only" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xiii" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r6-um-combat-squads-lessThan" type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="or"><conditions><condition type="lessThan" value="9" field="selections" scope="parent" childId="tac-marine" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier><modifier id="r6-um-combat-squads-atLeast" type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="or"><conditions><condition type="atLeast" value="10" field="selections" scope="parent" childId="tac-marine" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier><modifier id="r6-um-combat-squads-um-only-r62-shat-7f650a965925" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-0dee9d5efcdc" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><rules><rule id="r6-um-combat-squads-rule" name="Codex Astartes — Combat Squads" hidden="false"><description>A Legion Tactical Squad consisting of exactly ten models may be divided into two Combat Squads of five models each before deployment. After division, each Combat Squad is treated as a separate unit for all game purposes. If the original squad has a Dedicated Transport, assign it to one Combat Squad; only that squad may begin embarked.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup>
