            <modifier id="r71-nl-gen-37-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r57-iw-hammer-tactical-tac-marine" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
