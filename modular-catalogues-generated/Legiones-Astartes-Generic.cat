p-4d44b4a300f0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntryGroup></selectionEntryGroups><costs>
        <cost name="Points" typeId="pts" value="305" />
