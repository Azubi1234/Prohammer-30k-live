                          <description>Malediction — enemy unit within 24”. Target must pass a Leadership test whenever it attempts to move, Advance, shoot, charge or use a psychic power.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier type="set" value="true" field="hidden">
                          <conditions>
                            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-4" shared="true" includeChildSelections="true" />
                          </conditions>
                        </modifier>
