                      <constraints>
                        <constraint id="r29-lib-power-9-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Forewarning" id="r29-lib-power-9-rule" hidden="false">
                          <description>Blessing — friendly unit within 12”. Unit gains a 4+ Invulnerable Save.</description>
