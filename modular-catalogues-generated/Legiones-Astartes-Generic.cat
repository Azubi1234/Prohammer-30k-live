                            <rule id="r37-burning-powers-p-telepathy-invisibility-r61-librarian-power2-telepathy-invisibility-rule" name="Invisibility" hidden="false">
                              <description>Opposing units suffer -1 To Hit with ranged and melee attacks against the target friendly unit.</description>
