    <constraints><constraint id="r32-soh-longmarch-noncomp" type="max" value="99" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Terminator Squad — Horus’ First Company" hidden="true" id="r32-soh-first-company-terminators">
      <categoryLinks>
        <categoryLink id="r32-soh-first-company-terminators-cat" name="Troops" hidden="false" targetId="cat-troops" primary="true" /><categoryLink id="r36-long-comp-88ee5ee1a1" name="Long March — compulsory Troops" targetId="r36-soh-long-compulsory-troops" hidden="false" /></categoryLinks>
      <infoLinks><infoLink id="r36-link-ae42e79d34cd" name="Implacable Advance" hidden="false" targetId="r36-shared-implacable-advance-76d1b91" type="rule" /></infoLinks><rules>
        <rule name="Standard Wargear" id="r32-soh-first-company-term-terminator-standard" hidden="false">
          <description>Every model is equipped with the selected Terminator Armour pattern, a Combi-bolter and a Power Weapon unless replaced below.</description>
        </rule>
        <rule name="Legiones Astartes" id="r32-soh-first-company-term-terminator-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Dedicated Transport" id="r32-soh-first-company-term-terminator-transport-rule" hidden="false">
          <description>The squad may select a Land Raider, a Land Raider variant with sufficient Transport Capacity, a Dreadclaw Drop Pod or a Spartan Assault Tank where permitted. A Dreadclaw can carry only five models in Terminator Armour, so it is selectable here only for a five-model squad. Land Raider and Spartan choices will become selectable when their vehicle entries are added.</description>
        </rule>
      <rule id="r32-soh-first-term-rule" name="The First Company" hidden="false"><description>Troops choice granted by Horus. May fulfil a compulsory Troops selection. A maximum of two First Company Troops selections may be made in total, and at most one may be Justaerin.</description></rule></rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Terminators" hidden="false" id="r32-soh-first-company-term-terminator-included" defaultAmount="4">
          <constraints>
            <constraint id="r32-soh-first-company-term-terminator-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r32-soh-first-company-term-terminator-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminators (included)" id="r32-soh-first-company-term-terminator-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="pts" value="30" />
          </costs>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Terminator Sergeant" hidden="false" id="r32-soh-first-company-term-terminator-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="r32-soh-first-company-term-terminator-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r32-soh-first-company-term-terminator-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminator Sergeant" id="r32-soh-first-company-term-terminator-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <entryLink id="r32-soh-first-company-term-r37-orbital-teleport-terminator-unit" name="Teleport Assault (Orbital Assault)" targetId="r41-universal-gear-78f70cd43f9732" type="selectionEntry" import="true" hidden="true"><constraints>
            <constraint id="r32-soh-first-company-term-r37-orbital-teleport-terminator-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-orbital" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </entryLink><selectionEntry id="r32-soh-first-company-term-r71-nl-bj-5" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r32-soh-first-company-term-r71-nl-bj-5-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r32-soh-first-company-term-r71-nl-bj-5-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.

Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r32-soh-first-company-term-r71-nl-bj-5-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="Points" typeId="pts" value="55" />
      </costs>
      <selectionEntryGroups>
        <selectionEntryGroup name="Terminator Armour Pattern (entire squad)" id="r32-soh-first-company-term-terminator-armour-pattern" hidden="false">
          <constraints>
            <constraint id="r32-soh-first-company-term-terminator-armour-pattern-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="r32-soh-first-company-term-terminator-armour-pattern-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Terminator Armour" hidden="false" id="r32-soh-first-company-term-terminator-armour-normal" defaultAmount="1">
              <constraints>
                <constraint id="r32-soh-first-company-term-terminator-armour-normal-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Terminator Armour" id="r32-soh-first-company-term-terminator-armour-normal-rule" hidden="false">
                  <description>2+ Armour Save, 5+ Invulnerable Save; Relentless, Bulky, Deep Strike; may not Pursue. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tartaros Terminator Armour" hidden="false" id="r32-soh-first-company-term-terminator-armour-tartaros">
              <constraints>
                <constraint id="r32-soh-first-company-term-terminator-armour-tartaros-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Tartaros Terminator Armour" id="r32-soh-first-company-term-terminator-armour-tartaros-rule" hidden="false">
                  <description>2+ Armour Save, 5+ Invulnerable Save; Relentless, Bulky, Deep Strike; may Pursue. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Cataphractii Terminator Armour" hidden="false" id="r32-soh-first-company-term-terminator-armour-cataphractii">
              <constraints>
                <constraint id="r32-soh-first-company-term-terminator-armour-cataphractii-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Cataphractii Terminator Armour" id="r32-soh-first-company-term-terminator-armour-cataphractii-rule" hidden="false">
                  <description>2+ Armour Save, 4+ Invulnerable Save; Relentless, Bulky, Deep Strike; may not Advance, Pursue or fire Overwatch. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
