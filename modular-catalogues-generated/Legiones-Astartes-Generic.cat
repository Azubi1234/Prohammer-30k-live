            <selectionEntry type="upgrade" import="true" name="Cataphractii Terminator Armour" hidden="false" id="terminator-armour-cataphractii">
              <constraints>
                <constraint id="terminator-armour-cataphractii-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Cataphractii Terminator Armour" id="terminator-armour-cataphractii-rule" hidden="false">
                  <description>2+ Armour Save, 4+ Invulnerable Save; Relentless, Bulky, Deep Strike; may not Advance, Pursue or fire Overwatch. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
