          <costs>
            <cost name="Points" typeId="pts" value="10" />
          </costs>
          <rules>
            <rule name="Frag Assault Launchers" id="hs-spartan-frag-assault-launchers-rule" hidden="false">
              <description>Passengers charging during the same turn they disembark count as equipped with Frag Grenades for that Assault phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <entryLink id="hs-spartan-armoured-ceramite" name="Armoured Ceramite" targetId="r41-universal-gear-e7ea745a2d0324" type="selectionEntry" import="true" hidden="false"><constraints>
