                            <rule id="r37-burning-powers-p-telepathy-dominate-r61-librarian-power2-telepathy-dominate-rule" name="Dominate" hidden="false">
                              <description>The target enemy unit must pass a Leadership test each time it attempts to move, Advance, shoot, charge or use a psychic power.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-burning-powers-p-telepathy-dominate-r80-ih-consul-cat-32" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
