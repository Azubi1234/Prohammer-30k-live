    <selectionEntry type="unit" name="Legion Whirlwind Scorpius" id="hs-scorpius" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-scorpius-cat" primary="true" name="Heavy Support" hidden="false" />
      <categoryLink id="hs-scorpius-r40-covsup" name="Covenant of Fire — Fast/Heavy choices" targetId="r40-sal-covenant-support" hidden="false" /><categoryLink id="hs-scorpius-r43-rg-heavy" name="Raven Guard — Heavy Support count" targetId="r43-rg-heavy-count" hidden="false" /><categoryLink id="hs-scorpius-r43-rg-decap-heavy" name="Decapitation Strike — Heavy Support" targetId="r43-rg-decap-heavy" hidden="false" /></categoryLinks>
      <costs>
