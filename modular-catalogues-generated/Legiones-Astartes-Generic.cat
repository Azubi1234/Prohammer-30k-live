                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Prescience" id="r29-lib-power-7" hidden="false" import="true">
                      <constraints>
                        <constraint id="r29-lib-power-7-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Prescience" id="r29-lib-power-7-rule" hidden="false">
                          <description>Blessing — friendly unit within 12”. Re-roll all failed To Hit rolls.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier type="set" value="true" field="hidden">
                          <conditions>
