                          </costs>
                          <profiles>
                            <profile id="r37-burning-powers-p-telepathy-terrify-r61-librarian-power2-telepathy-terrify-profile" name="Terrify" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                              <characteristics>
