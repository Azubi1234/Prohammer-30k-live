                      </profiles>
                      <rules>
                        <rule id="r61-librarian-power1-telekinesis-telekine-dome-rule" name="Telekine Dome" hidden="false">
                          <description>The Psyker and all friendly models within 12 inches gain a 5+ Invulnerable Save against shooting attacks.</description>
                        </rule>
                      </rules>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-104" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry id="r61-librarian-power1-telekinesis-psychic-maelstrom" name="Telekinesis — Psychic Maelstrom" type="upgrade" hidden="false" import="true">
                      <constraints>
                        <constraint id="r61-librarian-power1-telekinesis-psychic-maelstrom-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
