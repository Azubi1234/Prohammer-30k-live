              <infoLinks><infoLink id="r36-link-33c4a426c1a9" name="Whole-squad Melta Bombs" hidden="false" targetId="r36-exact-whole-squad-melta-bombs-9e41e7a" type="rule" /></infoLinks><costs>
                <cost name="Points" typeId="pts" value="0" />
