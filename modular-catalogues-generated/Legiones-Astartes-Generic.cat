            <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
          </characteristics>
        </profile>
        <profile name="Dreadstrike Missile" id="r32-low-stormbird-weapon-dreadstrike-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">120"</characteristic>
            <characteristic name="S" typeId="ranged-s">10</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Blast, One Use</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-low-stormbird-type" hidden="false">
          <description>Vehicle (Super-heavy, Flyer, Hover, Transport)</description>
        </rule>
        <rule name="Wargear" id="r32-low-stormbird-wargear" hidden="false">
          <description>Four Twin-linked Lascannon Turrets; Three Twin-linked Heavy Bolters; Six Dreadstrike Missiles; Armoured Ceramite; Power of the Machine Spirit; Dual Void Shield Generator.</description>
        </rule>
        <rule name="Dual Void Shield Generator" id="r32-low-stormbird-dualvoid" hidden="false">
          <description>The Stormbird is protected by two independent AV12 Void Shields. Hits are resolved against active shields first; a Glancing or Penetrating Hit collapses one shield. At the end of each controlling player's turn each collapsed shield is restored on a 5+.</description>
        </rule>
        <rule name="Shield Projection" id="r32-low-stormbird-proj" hidden="false">
          <description>If Hovering and stationary, the Stormbird may project its active Void Shields at the beginning of its turn. Until the beginning of its next turn, friendly units wholly or partially within 12 inches of its hull or wings are protected by those shields.</description>
        </rule>
        <rule name="Reinforced Structure" id="r32-low-stormbird-reinf" hidden="false">
          <description>The Stormbird has a 5+ Invulnerable Save against attacks which penetrate its Void Shields.</description>
        </rule>
        <rule name="Transport Capacity" id="r32-low-stormbird-cap" hidden="false">
          <description>50 models. May transport Dreadnoughts (10 models each), Jump Infantry, Rapier Batteries, Bikes, Jetbikes, and one Rhino including its passengers (counting as 25 models). A transported Rhino is an exception to the normal single-unit Transport rule.</description>
        </rule>
        <rule name="Access Points" id="r32-low-stormbird-access" hidden="false">
          <description>One side access point on each side and one rear assault ramp. Dreadnoughts and a transported Rhino may only use the rear ramp.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Replace six Dreadstrike Missiles with Macro-bomb Cluster Payload" hidden="false" id="r32-low-stormbird-macro">
          <constraints>
            <constraint id="r32-low-stormbird-macro-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
