his unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-b4a69c0ad23b-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-b4a69c0ad23b-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-e2fadcf8a85b" name="Word Bearers" type="upgrade" hidden="false"><infoLinks><infoLink id="r62-shat-assign-e2fadcf8a85b-info-7b34de5e3857" name="Legiones Astartes (Word Bearers)" targetId="r37-wb-rule-legiones-astartes-word-bearers" type="rule" hidden="false" /><infoLink id="r62-shat-assign-e2fadcf8a85b-info-b38798b65544" name="And They Shall Know No Fear" targetId="r36-shared-and-they-shall-know-no-fear-c9d3c20" type="rule" hidden="false" /><infoLink id="r62-shat-assign-e2fadcf8a85b-info-a7919070e2c7" name="Fanatical Devotion" targetId="r37-wb-rule-fanatical-devotion" type="rule" hidden="false" /><infoLink id="r62-shat-assign-e2fadcf8a85b-info-b8ae6a82ee7b" name="The Dark Shepherds" targetId="r37-wb-rule-the-dark-shepherds" type="rule" hidden="false" /><infoLink id="r62-shat-assign-e2fadcf8a85b-info-ac2dd2da0a3d" name="Ritual of Consecration" targetId="r37-wb-rule-ritual-of-consecration" type="rule" hidden="false" /><infoLink id="r62-shat-assign-e2fadcf8a85b-info-2c0bc35fbce4" name="Daemonic Covenant" targetId="r37-wb-rule-daemonic-covenant" type="rule" hidden="false" /><infoLink id="r62-shat-assign-e2fadcf8a85b-info-e6e2b19f2c66" name="Daemonic Summoning" targetId="r37-wb-rule-daemonic-summoning" type="rule" hidden="false" /></infoLinks><rules><rule id="r62-shat-assign-e2fadcf8a