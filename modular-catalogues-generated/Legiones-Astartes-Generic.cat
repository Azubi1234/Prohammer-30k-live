            <characteristic name="Front" typeId="vehicle-front">12</characteristic>
            <characteristic name="Side" typeId="vehicle-side">12</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">12</characteristic>
          </characteristics>
        </profile>
        <profile name="Avenger Bolt Cannon" id="r32-aero-fireraptor-weapon-avenger-bolt-cannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
            <characteristic name="S" typeId="ranged-s">6</characteristic>
            <characteristic name="AP" typeId="ranged-ap">3</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 7</characteristic>
          </characteristics>
        </profile>
        <profile name="Quad Heavy Bolter" id="r32-aero-fireraptor-weapon-quad-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
