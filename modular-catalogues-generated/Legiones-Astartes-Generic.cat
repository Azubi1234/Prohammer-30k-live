                      <constraints>
                        <constraint id="r61-librarian-power1-biomancy-haemorrhage-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <profiles>
                        <profile id="r61-librarian-power1-biomancy-haemorrhage-profile" name="Haemorrhage" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">18"</characteristic>
                            <characteristic name="S" typeId="ranged-s">Special</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">Special</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Focused Witchfire</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule id="r61-librarian-power1-biomancy-haemorrhage-rule" name="Haemorrhage" hidden="false">
                          <description>Target model must pass two Toughness tests or suffer a Wound with no Armour or Cover save. If slain, select another model within 2 inches; it takes one Toughness test or suffers a Wound. Continue until a test is passed.</description>
                        </rule>
                      </rules>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-84" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
