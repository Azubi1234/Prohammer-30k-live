      </modifiers>
      <rules>
        <rule id="r79-ih-castrmen-orth-upgrade" name="Vehicle Commander" hidden="false">
          <description>Castrmen Orth is purchased as a +50 point upgrade for one Iron Hands Vehicle (Tank). Orth and that Vehicle together occupy the Vehicle’s normal Force Organisation selection and one HQ selection. He may not command a Walker, a Vehicle without a Ballistic Skill characteristic, or a Vehicle already commanded by another named character. Select the commanded Vehicle in your roster and apply these rules to it.</description>
        </rule>
        <rule id="r79-ih-castrmen-orth-spear" name="Spearhead Centurion" hidden="false">
          <description>The Vehicle commanded by Castrmen Orth has Ballistic Skill 5, replacing its normal Ballistic Skill.</description>
        </rule>
        </rules>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Dreadnought — Keeper of the Keys" hidden="true" id="r40-sal-nomus-dread-hq">
