    <selectionEntry type="unit" import="true" name="Legion Contemptor Dreadnought" hidden="true" id="r35-fury-contemptor-contemptor-unit">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="r35-fury-contemptor-cat" primary="true" name="Troops" hidden="false" />
      <categoryLink id="r36-long-comp-45ae796ffb" name="Long March — compulsory Troops" targetId="r36-soh-long-compulsory-troops" hidden="false" /><categoryLink id="r35-fury-contemptor-contemptor-unit-r40-covcomp" name="Covenant of Fire — compulsory Troops" targetId="r40-sal-covenant-compulsory" hidden="false" /><categoryLink id="r35-fury-contemptor-contemptor-unit-r42-sal-comp" name="Salamanders — compulsory-capable Troops" targetId="r42-sal-compulsory-troops" hidden="false" /><categoryLink id="r35-fury-contemptor-contemptor-unit-r43-rg-comp" name="Raven Guard — compulsory-capable Troops" targetId="r43-rg-compulsory-troops" hidden="false" /><categoryLink id="r35-fury-contemptor-contemptor-unit-r45-coils-comp" name="Coils — compulsory-capable Troops" targetId="r45-al-coils-compulsory" hidden="false" /></categoryLinks>
