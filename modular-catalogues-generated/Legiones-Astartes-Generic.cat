          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Jetbike (Sky Hunter Phalanx)" hidden="true" id="r37-centurion-jetbike">
              <categoryLinks><categoryLink id="r37-centurion-jetbike-r40-jet" name="Awakening Fire — Jetbike" targetId="r40-sal-awakening-jetbike" hidden="false" /></categoryLinks><constraints>
                <constraint id="r37-centurion-jetbike-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <infoLinks><infoLink id="r36-link-0f48b4fb4be7" name="Jetbike Command" hidden="false" targetId="r36-exact-jetbike-command-fe352e1" type="rule" /></infoLinks><costs>
                <cost name="Points" typeId="pts" value="40" />
              </costs>
              <rules>
                <rule name="Space Marine Bike" id="r37-centurion-jetbike-gear-gear-hq-bike-rule" hidden="false">
                  <description>The bearer becomes Bike unit type and follows the normal ProHammer Bike rules. The bike is armed with twin-linked bolters. It may not be combined with a Jump Pack, Jetbike or Terminator Armour.

Twin-Linked: Re-roll failed To Hit rolls with this weapon. Does not count as two weapons. Twin-linked Template weapons automatically hit all models fully or partially under the Template.</description>
                </rule>
                </rules>
              <modifiers>
                <modifier type="set" value="false" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
          </selectionEntries>
