                          <rules>
                            <rule id="r61-librarian-power2-telepathy-mental-fortitude-rule" name="Mental Fortitude" hidden="false">
                              <description>If the target friendly unit is Falling Back it immediately Regroups; it also gains Fearless.

Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r80-ih-consul-cat-33" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
