lections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r62-shat-assign-group-8ea26da3abd8-min-on" type="set" field="r62-shat-assign-group-8ea26da3abd8-min" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-group-8ea26da3abd8-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r62-shat-assign-group-8ea26da3abd8-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntryGroup></selectionEntryGroups><costs>
        <cost name="Points" typeId="pts" value="685" />
      </costs>
      <profiles>
        <profile name="Thunderhawk Gunship" id="r32-low-thunderhawk-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <modifiers>
            <modifier type="set" field="vehicle-rear" value="12" id="r32-low-thunderhawk-rear">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r32-low-thunderhawk-voidhull" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <characteristics>
            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
            <characteristic name="Front" typeId="vehicle-front">12</characteristic>
            <characteristic name="Side" typeId="vehicle-side">12</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">10</characteristic>
            <characteristic name="SP" typeId="vehicle-sp">3</characteristic>
          </characteristics>
        </profile>
        <profile name="Thunderhawk Cannon" id="r32-low-thunderhawk-weapon-thunderhawk-cannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">72"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">3</characteristic>
            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Massive Blast</characteristic>
          </characteristics>
        </profile>
        <profile name="Twin-linked Heavy Bolter" id="r32-low-thunderhawk-weapon-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
          </characteristics>
        </profile>
        <profile name="Hellstrike Missile" id="r32-low-thunderhawk-weapon-hellstrike-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">72"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</characteristic>
          </characteristics>
        </profile>
        <profile name="Lascannon" id="r32-low-thunderhawk-weapon-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">9</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-low-thunderhawk-type" hidden="false">
          <description>Vehicle (Super-heavy, Flyer, Hover, Transport)</description>
        </rule>
        <rule name="Wargear" id="r32-low-thunderhawk-wargear" hidden="false">
          <description>Thunderhawk Cannon; Four Twin-linked Heavy Bolters; Six Hellstrike Missiles; Two Lascannons; Armoured Ceramite; Power of the Machine Spirit.</description>
        </rule>
        <rule name="Sunder" id="r32-low-thunderhawk-weapon-hellstrike-missile-wr-0-sunder" hidden="false">
          <description>May re-roll failed Armour Penetration rolls against Vehicles.</description>
        </rule>
        <rule name="Transport Capacity" id="r32-low-thunderhawk-cap" hidden="false">
          <description>30 models. May transport Dreadnoughts, each counting as 10 models, as well as Jump Infantry and Bikes. Dreadnoughts may only embark or disembark through the forward ramp.</description>
        </rule>
        <rule name="Access Points" id="r32-low-thunderhawk-access" hidden="false">
          <description>One access hatch on each side and one forward assault ramp.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Replace Thunderhawk Cannon with Turbo-laser Destructor" hidden="false" id="r32-low-thunderhawk-turbo">
          <constraints>
            <constraint id="r32-low-thunderhawk-turbo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <infoLinks><infoLink id="r36-link-ca84dfea283e" name="Titan Killer" hidden="false" targetId="r36-exact-titan-killer-77633b0" type="rule" /></infoLinks><costs>
            <cost name="Points" typeId="pts" value="90" />
          </costs>
          <profiles>
            <profile name="Turbo-laser Destructor" id="r32-low-thunderhawk-turbo-turbo-laser-destructor-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
              <characteristics>
                <characteristic name="Range" typeId="ranged-range">96"</characteristic>
                <characteristic name="S" typeId="ranged-s">10</characteristic>
                <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                <characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast, Titan Killer</characteristic>
              </characteristics>
            </profile>
          </profiles>
          </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Replace six Hellstrike Missiles with six Thunderhawk Cluster Bombs" hidden="false" id="r32-low-thunderhawk-bombs">
          <constraints>
            <constraint id="r32-low-thunderhawk-bombs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="60" />
          </costs>
          <profiles>
            <profile name="Thunderhawk Cluster Bomb" id="r32-low-thunderhawk-bombs-thunderhawk-cluster-bomb-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
              <characteristics>
                <characteristic name="Range" typeId="ranged-range">—</characteristic>
                <characteristic name="S" typeId="ranged-s">6</characteristic>
                <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                <characteristic name="Type" typeId="ranged-type">Bomb 6, Barrage, Large Blast, One Use</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <entryLink id="r32-low-thunderhawk-chaff-launcher" name="Chaff Launcher" targetId="r41-universal-gear-ce9a292664f5eb" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="r32-low-thunderhawk-chaff-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="10" />
          </costs>
          </entryLink><entryLink id="r32-low-thunderhawk-armoured-cockpit" name="Armoured Cockpit" targetId="r41-universal-gear-a70ce6a2a8794d" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="r32-low-thunderhawk-armoured-cockpit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          </entryLink><entryLink id="r32-low-thunderhawk-flare-shield" name="Flare Shield" targetId="r41-universal-gear-9201acbfa3614c" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="r32-low-thunderhawk-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          </entryLink><selectionEntry type="upgrade" import="true" name="Ramjet Diffraction Grid" hidden="false" id="r32-low-thunderhawk-ramjet-diffraction-grid">
          <constraints>
            <constraint id="r32-low-thunderhawk-ramjet-diffraction-grid-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <rules>
            <rule name="Ramjet Diffraction Grid" id="r32-low-thunderhawk-ramjet-diffraction-grid-effect" hidden="false">
              <description>Reduce the Strength of shooting attacks that strike Side or Rear Armour by 1, to a minimum of 1. The vehicle may not claim Cover Saves from Night Fighting.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Void-crafted Hull" hidden="false" id="r32-low-thunderhawk-voidhull">
          <constraints>
            <constraint id="r32-low-thunderhawk-voidhull-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="35" />
          </costs>
          <rules>
            <rule name="Void-crafted Hull" id="r32-low-thunderhawk-voidhull-rule" hidden="false">
              <description>Increase the Thunderhawk's Rear Armour from 10 to 12.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
      <categoryLinks>
        <categoryLink id="r32-low-thunderhawk-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" />
      <categoryLink id="r32-low-thunderhawk-r40-fly" name="Awakening Fire — Flyer" targetId="r40-sal-awakening-flyer" hidden="false" /></categoryLinks>
    </selectionEntry>
