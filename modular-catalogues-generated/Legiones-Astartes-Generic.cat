      <modifier id="r40-sal-nomus-contemptor-hq-r40-show" type="set" field="hidden" value="false"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xviii" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier><modifier id="r40-sal-nomus-contemptor-hq-r40-show-r62-shat-5f8bda0a495c" type="set" field="hidden" value="false"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-098f0b80655e" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier></modifiers>
      <entryLinks>
        <entryLink id="r40-sal-nomus-contemptor-hq-copy-r74-ba-contemptor-jump" name="Furioso-pattern Jump Pack" type="selectionEntry" targetId="r44-ba-furioso-jump-pack" hidden="true" import="true">
          <constraints>
            <constraint id="r40-sal-nomus-contemptor-hq-copy-r74-ba-contemptor-jump-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r40-sal-nomus-contemptor-hq-copy-r75-ba-furioso-show" type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-ix" shared="true" includeChildSelections="true" includeChildForces="false" />
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-sal-nomus-contemptor-hq-copy-contemptor-p-dccw" shared="true" includeChildSelections="true" includeChildForces="false" />
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-sal-nomus-contemptor-hq-copy-contemptor-s-dccw" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          <modifier id="r40-sal-nomus-contemptor-hq-copy-r75-ba-furioso-show-r62-shat-65150c34b884" type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-170bd5c389a2" shared="true" includeChildSelections="true" includeChildForces="false" />
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-sal-nomus-contemptor-hq-copy-contemptor-p-dccw" shared="true" includeChildSelections="true" includeChildForces="false" />
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-sal-nomus-contemptor-hq-copy-contemptor-s-dccw" shared="true" includeChildSelections="true" includeChildForces="false" />
              <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
            </modifier>
          </modifiers>
        </entryLink>
      </entryLinks>
    </selectionEntry>
    </selectionEntries>
<sharedRules><rule id="r36-shared-acute-senses-19bf158" name="Acute Senses" hidden="false"><description>Unit can re-roll which random table edge it arrives on from reserves.</description></rule><rule id="r36-shared-assault-vehicle-72eb9a3" name="Assault Vehicle" hidden="false"><description>Passengers disembarking from an Assault Vehicle do not lose their extra Attack charge bonuses when disembarking and charging from an Assault Vehicle. All Open-topped Vehicles count as Assault Vehicles.</description></rule><rule id="r36-shared-crusader-de7431d" name="Crusader" hidden="false"><description>Roll extra dice when advancing and use the highest. Adds D3" to pursuit rolls.</description></rule><rule id="r36-shared-fleet-e199151" name="Fleet" hidden="false"><description>Unit may still charge into melee combat even if it advanced this turn.</description></rule><rule id="r36-shared-hit-run-14e1669" name="Hit &amp; Run" hidden="false"><description>Unit may choose to leave combat at the end of the Assault phase after taking break tests. Take an Initiative test. If passed, the unit moves 3D6" in a chosen direction. The unit does not count as having broken or fallen back, and any now unengaged enemy units it moved away from may only consolidate 3".</description></rule><rule id="r36-shared-infiltrate-88c13dc" name="Infiltrate" hidden="false"><description>During deployment, may be set up after normal deployment. The unit must be set up 12" or more away from enemy units that do not have line of sight and 18" or more away from enemy units with line of sight. The unit also gains Outflank.</description></rule><rule id="r36-shared-jink-8458eea" name="Jink" hidden="false"><description>Units that moved in the prior turn can activate Jink as a reaction to being shot and gain a 5+ Cover Save until the start of their next turn. If a model with this rule used Turbo-boosters or moved at Flat Out speed, it gains a 4+ Cover Save instead. Models that use Jink only shoot with Snap Fire on their next turn.</description></rule><rule id="r36-shared-move-through-cover-b95132d" name="Move Through Cover" hidden="false"><description>Roll 3D6 for Difficult Terrain tests instead of 2D6 and choose the highest.</description></rule><rule id="r36-shared-outflank-3be9c13" name="Outflank" hidden="false"><description>When units with this ability enter from Reserve, roll a D6: on 1-2 enter from the player's left table edge; on 3-4 enter from the player's right; on 5-6 the player chooses the side edge. The unit may alternatively enter from Reserve normally from the player's normal table edge(s).</description></rule><rule id="r36-shared-power-of-the-machine-spirit-cbed146" name="Power of the Machine Spirit" hidden="false"><description>A Vehicle moving less than Flat Out speed and not using Smoke Launchers can fire one additional main weapon at full Ballistic Skill.</description></rule><rule id="r36-shared-relentless-93eeddf" name="Relentless" hidden="false"><description>Model may move and fire Heavy, Ordnance, Salvo or Rapid Fire weapons as if it remained stationary. It may still charge even after firing such weapons.</description></rule><rule id="r36-shared-scouts-acbb689" name="Scouts" hidden="false"><description>May always be deployed. Before rolling to see who goes first, may take a bonus normal move. Confers Scout ability to a Dedicated Transport it is mounted in. If both players have Scouts, roll-off and alternate moving Scouts starting with the winner. The unit also gains Outflank.</description></rule><rule id="r36-shared-skilled-rider-854bc10" name="Skilled Rider" hidden="false"><description>Re-roll failed Dangerous Terrain tests. Gains +1 to any Jink saves.</description></rule><rule id="r36-shared-slow-and-purposeful-06d4828" name="Slow and Purposeful" hidden="false"><description>Relentless and always moves as if in Difficult Terrain.</description></rule><rule id="r36-shared-swift-112ab02" name="Swift" hidden="false"><description>Units composed entirely of Swift models fall back 3D6" instead of 2D6". During pursuit and retreat moves, they move their Initiative value + 2D6".</description></rule><rule id="r36-shared-turbo-boosters-a0b56db" name="Turbo-Boosters" hidden="false"><description>Instead of a normal move, the unit may Turbo-boost up to 24". Turbo-boosting units may not shoot in the Shooting phase or charge in the Assault phase. Units that also have Jink gain a 4+ Cover Save if they used a Turbo-boost move in their last Movement phase.</description></rule><rule id="r36-shared-adamantium-will-b9d0569" name="Adamantium Will" hidden="false"><description>+1 bonus to Deny the Witch, and the unit may attempt to Deny the Witch even if it is not a Psyker.</description></rule><rule id="r36-shared-and-they-shall-know-no-fear-c9d3c20" name="And They Shall Know No Fear" hidden="false"><description>Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.</description></rule><rule id="r36-shared-brotherhood-of-psykers-0c2f807" name="Brotherhood of Psykers" hidden="false"><description>Unit counts as a Mastery Level 1 Psyker. Uses the unit's highest Leadership value for Psychic Power tests.</description></rule><rule id="r36-shared-bulky-73510e7" name="Bulky" hidden="false"><description>Counts as two models for Transport Capacity. Very Bulky counts as three models. Extremely Bulky counts as five.</description></rule><rule id="r36-shared-counter-attack-478972a" name="Counter-Attack" hidden="false"><description>If this unit is not engaged with any enemy models and an enemy unit successfully completes a charge move against it, the unit may take a Leadership test. If passed, this unit gains +1 Attack during the Assault phase.</description></rule><rule id="r36-shared-daemon-48e6659" name="Daemon" hidden="false"><description>Model gains a 5+ Invulnerable Save and causes Fear.</description></rule><rule id="r36-shared-eternal-warrior-b45eccc" name="Eternal Warrior" hidden="false"><description>Immune to Instant Death / Massive Wounds. The model suffers 1 Wound instead of D3 Wounds.</description></rule><rule id="r36-shared-fear-689e027" name="Fear" hidden="false"><description>Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.</description></rule><rule id="r36-shared-fearless-8699dbc" name="Fearless" hidden="false"><description>Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description></rule><rule id="r36-shared-furious-charge-5750d05" name="Furious Charge" hidden="false"><description>Models gain +1 Strength and +1 Initiative in assault on the turn they charged.</description></rule><rule id="r36-shared-hammer-of-wrath-571781e" name="Hammer of Wrath" hidden="false"><description>On the turn this unit charges, models may perform one of their normally allowed Attacks at Initiative 10 instead of during their normal Initiative step.</description></rule><rule id="r36-shared-hatred-63d35cd" name="Hatred" hidden="false"><description>If a unit with Hatred is engaged in melee combat against a hated enemy type, and was not engaged in melee combat with that enemy type during the prior turn, the unit may re-roll all failed close combat To Hit rolls against the hated target.</description></rule><rule id="r36-shared-it-will-not-die-422c865" name="It Will Not Die" hidden="false"><description>Roll a D6 at the start of its turn for each model with fewer than its starting Wounds but which is not destroyed. On a 5+ it regains one lost Wound. A Vehicle with It Will Not Die may, on a 5+, repair an Engine Damaged, Weapon Destroyed or Immobilized damage result.</description></rule><rule id="r36-shared-night-vision-1c9da55" name="Night Vision" hidden="false"><description>Units containing at least one model with this effect ignore Night Fighting restrictions.</description></rule><rule id="r36-shared-preferred-enemy-23a2462" name="Preferred Enemy" hidden="false"><description>The unit can re-roll failed hits in close combat against the indicated Preferred Enemy.</description></rule><rule id="r36-shared-shrouded-dad3a22" name="Shrouded" hidden="false"><description>Adds +2 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 5+ Cover Save. Does not stack with Stealth.</description></rule><rule id="r36-shared-stealth-723e8dc" name="Stealth" hidden="false"><description>Adds +1 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 6+ Cover Save. Does not stack with Shrouded.</description></rule><rule id="r36-shared-stubborn-59f928d" name="Stubborn" hidden="false"><description>Ignore negative Leadership modifiers on Morale and Pinning tests.</description></rule><rule id="r36-shared-swarms-7539893" name="Swarms" hidden="false"><description>Have Stealth and Vulnerable to Blasts/Templates.</description></rule><rule id="r36-shared-tank-hunters-f3b906a" name="Tank Hunters" hidden="false"><description>+1 to Armour Penetration rolls. Automatically passes Tank Shock Morale tests.</description></rule><rule id="r36-shared-vulnerable-to-blasts-templates-3339f89" name="Vulnerable to Blasts/Templates" hidden="false"><description>Each hit counts as two hits from Blast/Template weapons.</description></rule><rule id="r36-shared-zealot-18abf21" name="Zealot" hidden="false"><description>A unit with at least one model with this effect gains Fearless and Hatred.</description></rule><rule id="r36-shared-armourbane-ad0cb72" name="Armourbane" hidden="false"><description>Attack rolls 2D6 for Armour Penetration.</description></rule><rule id="r36-shared-blind-dff70db" name="Blind" hidden="false"><description>A unit hit by a weapon with Blind must take an Initiative test. If failed, all models are reduced to BS1 and WS1 until the end of their next turn.</description></rule><rule id="r36-shared-concussive-a164bfd" name="Concussive" hidden="false"><description>A model suffering an unsaved Wound is reduced to Initiative 1 until the end of the following Assault phase. Against units with no Initiative, such as Vehicles, it inflicts Crew Shaken if hit.</description></rule><rule id="r36-shared-fleshbane-648a6e6" name="Fleshbane" hidden="false"><description>Always wounds on a 2+. No effect versus Vehicles.</description></rule><rule id="r36-shared-gets-hot-e403485" name="Gets Hot" hidden="false"><description>If a model shooting this weapon rolls a 1 To Hit, it causes an automatic Wound on that model and it must take an Armour or Invulnerable Save. If the save fails, the shooting model suffers a Wound. Vehicles are not affected by Gets Hot.</description></rule><rule id="r36-shared-haywire-15e7bc7" name="Haywire" hidden="false"><description>Instead of normal Armour Penetration, roll a D6: 1 = no effect; 2-5 = Glancing Hit; 6 = Penetrating Hit.</description></rule><rule id="r36-shared-ignores-cover-1da6909" name="Ignores Cover" hidden="false"><description>Weapon negates any Cover Saves.</description></rule><rule id="r36-shared-interceptor-25e9733" name="Interceptor" hidden="false"><description>A weapon with this rule may be fired at an enemy unit immediately after that enemy unit enters from Reserves and ends the Movement phase within line of sight and range of the weapon. If used this way, the firing model may not shoot in the Shooting phase of its following turn.</description></rule><rule id="r36-shared-lance-1dae8a0" name="Lance" hidden="false"><description>Treat Vehicle Armour Values greater than 12 as 12.</description></rule><rule id="r36-shared-master-crafted-30feea6" name="Master-Crafted" hidden="false"><description>Re-roll one failed To Hit roll per turn.</description></rule><rule id="r36-shared-melta-bd49f41" name="Melta" hidden="false"><description>When making Armour Penetration rolls, roll 2D6 instead of D6 if the target is at half range or less.</description></rule><rule id="r36-shared-monster-hunter-aeded09" name="Monster Hunter" hidden="false"><description>Units containing at least one model with this effect re-roll failed To Wound rolls against Monstrous Creatures.</description></rule><rule id="r36-shared-pinning-e5b0674" name="Pinning" hidden="false"><description>Unsaved Wounds caused by this weapon force the unit to take a Pinning Test.</description></rule><rule id="r36-shared-poison-6de0b0c" name="Poison" hidden="false"><description>Wounds on a fixed number regardless of Strength. If the attacker's Strength is higher than the defender's Toughness, re-roll failed Wounds. Poison weapons have no effect against Vehicles. Default value is 4+.</description></rule><rule id="r36-shared-rampage-a3efb7d" name="Rampage" hidden="false"><description>Models gain +D3 Attacks if the enemy units contain more models than friendly models that are locked in close combat.</description></rule><rule id="r36-shared-rending-9a78738" name="Rending" hidden="false"><description>On a To Wound roll of 6, causes an automatic Wound and the weapon is treated as AP2 for ranged attacks and a Power Weapon attack for melee attacks. Against Vehicles, an Armour Penetration roll of 6 adds an additional D3 to the penetration result.</description></rule><rule id="r36-shared-shred-598a34d" name="Shred" hidden="false"><description>Re-roll failed To Wound rolls.</description></rule><rule id="r36-shared-soul-blaze-f1f5c33" name="Soul Blaze" hidden="false"><description>Units wounded by this attack are set ablaze. Roll a D6 at the end of each turn. On a 4+, the unit takes D3 Strength 4 AP5 hits with no Cover Saves. On less than 4, the blaze goes out and the effect is removed.</description></rule><rule id="r36-shared-split-fire-f4e76b7" name="Split Fire" hidden="false"><description>A unit with this rule automatically passes any Split Fire test and may split its fire between up to three different targets instead of two.</description></rule><rule id="r36-shared-sniper-2081d06" name="Sniper" hidden="false"><description>Hits on a 2+, wounds on a 4+, and gains Rending and Pinning.</description></rule><rule id="r36-shared-strikedown-ea03c9b" name="Strikedown" hidden="false"><description>Models suffering one or more Wounds from this weapon, even if saved, move as if in Difficult Terrain on their next turn.</description></rule><rule id="r36-shared-torrent-4d15a5d" name="Torrent" hidden="false"><description>Place the Flame Template in any orientation so long as the Template is entirely within 12" range and the tip of the narrower end is closer to the firing model than the tip of the wider end.</description></rule><rule id="r36-shared-twin-linked-815809b" name="Twin-Linked" hidden="false"><description>Re-roll failed To Hit rolls with this weapon. Does not count as two weapons. Twin-linked Template weapons automatically hit all models fully or partially under the Template.</description></rule><rule id="r36-shared-two-handed-6cfe89f" name="Two-Handed" hidden="false"><description>A model attacking with this weapon does not receive a bonus Attack for having additional close combat weapons.</description></rule><rule id="r36-shared-unwieldy-77ac1c7" name="Unwieldy" hidden="false"><description>A model attacking with this weapon is Initiative 1 unless it is a Monstrous Creature or Vehicle Walker.</description></rule><rule id="r36-shared-scout-56be36a" name="Scout" hidden="false"><description>May always be deployed. Before rolling to see who goes first, may take a bonus normal move. Confers Scout ability to a Dedicated Transport it is mounted in. If both players have Scouts, roll-off and alternate moving Scouts starting with the winner. The unit also gains Outflank.</description></rule><rule id="r36-shared-deep-strike-54cfd20" name="Deep Strike" hidden="false"><description>Units that enter play from Reserves by Deepstriking are placed directly on the board and do not have to move onto the table from a table edge.

1. Determine Target Location: when the unit is available to enter play, place one model (the centre model) anywhere on the table more than 2" from enemy models.
2. Roll for Deepstrike Scattering: roll 2D6 and a Scatter die. On a Hit, proceed to placement. On an arrow, determine an adjusted location 2D6" in that direction. If that location would be on a friendly model, stop 2" short. If it falls in impassable terrain, off the table, or on top of or within 2" of an enemy model, a Deepstrike Mishap occurs.
Deepstrike Mishap: the opposing player instead places the centre model within 12" of the target location. The chosen location may not be in impassable terrain, off the table, within 2" of an enemy model, or within 2" of its original position. If no viable position exists, the unit returns to Reserves to redeploy next turn. The unit must also pass a Pinning Test or become Pinned for the remainder of the turn.
3. Place Remaining Models: place all other models within 2" of the centre model. Models may not be placed in impassable terrain or within 2" of enemy models. Models that cannot fit within 2" may be placed in base contact with another model and as close to the centre as possible; any model that still cannot be placed is destroyed.

Using Deepstriking Units: models arriving by Deepstrike or disembarking from Deepstriking Vehicles may not make a normal move after arriving, but may shoot, Advance D6", or assault. Units charging in the turn they arrived by Deepstrike gain no bonus Attacks for charging and no benefit from assault grenades. Deepstriking Vehicles count as having moved at Cruising Speed on the turn they arrive.</description></rule><rule id="r36-shared-independent-character-4fbd2ae" name="Independent Character" hidden="false"><description>Models with the Independent Character type may join other units.
• Joining Units: an Independent Character functions as part of the joined unit for movement, coherency, shooting, Leadership, assaulting and other purposes. It may not join units that include Vehicle models or Monstrous Creatures.
• Joining During Deployment: an Independent Character may join a unit before deployment. If the joined units are in Reserve, they count as one unit when rolling to enter play. If either has a special deployment rule such as Infiltrate or Deep Strike, both must have the same ability to use it.
• Joining and Leaving: during the Movement phase an Independent Character may join a unit by moving within coherency and declaring the join after its move, or leave by declaring this before moving. It may not join and leave, or leave and join, in the same turn, and may not leave a unit that is engaged in melee, Broken or Pinned.
• Shooting: an Independent Character joined to a unit may declare and resolve shooting against a different target from the joined unit.
• Assault: if joined, it must charge with the unit and enter base contact if possible. In melee it is treated as part of the unit. It may make pile-in moves first to remain engaged.
• Allocating Wounds: unsaved Wounds suffered by a joined unit do not have to be allocated to an already wounded Independent Character.
• Shooting Independent Characters: an unjoined Independent Character may only be selected as a shooting target if it is within 18" and the closest figurine model; or more than 18" away and more than 6" from a friendly figurine unit; or is a Monstrous Creature/Flying Monstrous Creature.</description></rule><rule id="r36-shared-master-of-the-legion-a3a88da" name="Master of the Legion" hidden="false"><description>A model with Master of the Legion permits its Detachment to use one Rite of War for which it qualifies. A Detachment may never benefit from more than one Rite of War unless specifically stated otherwise. A Legiones Astartes army may include no more than one model with Master of the Legion for every full 1,000 points in the army. Where permitted by its army list entry, a Master of the Legion may select a Legion Command Squad as a retinue; if equipped with Terminator Armour, an appropriate Terminator Command Squad may be selected instead. The Master of the Legion and its Command Squad occupy a single HQ selection.</description></rule><rule id="r36-shared-primarch-842ed37" name="Primarch" hidden="false"><description>A model with this special rule has Independent Character, Eternal Warrior, Fear, Fearless, Adamantium Will, Fleet, It Will Not Die and Master of the Legion. A Primarch automatically passes Fear tests caused by another Primarch. A Primarch also possesses the named Legiones Astartes special rule corresponding to his own Legion.</description></rule><rule id="r36-shared-armoured-ceramite-4988a13" name="Armoured Ceramite" hidden="false"><description>A vehicle equipped with Armoured Ceramite does not suffer the additional Armour Penetration die normally granted by the Melta special rule. Melta weapons therefore roll only one D6 for Armour Penetration against this vehicle, regardless of range.</description></rule><rule id="r36-shared-armoured-cockpit-497e63f" name="Armoured Cockpit" hidden="false"><description>Whenever a vehicle with an Armoured Cockpit suffers a Crew Shaken or Crew Stunned result, roll a D6. On a 4+, that result is ignored.</description></rule><rule id="r36-shared-auxiliary-drive-e109f48" name="Auxiliary Drive" hidden="false"><description>At the start of the controlling player's Movement phase, if a vehicle equipped with an Auxiliary Drive is Immobilised, roll a D6. On a 4+, remove one Immobilised result. The vehicle may move normally during that Movement phase.</description></rule><rule id="r36-shared-flare-shield-569af7c" name="Flare Shield" hidden="false"><description>Against shooting attacks which strike the vehicle's Front Armour, reduce the Strength of Blast and Template weapons by 2 and all other ranged attacks by 1. A Flare Shield has no effect in close combat.</description></rule><rule id="r36-shared-implacable-advance-76d1b91" name="Implacable Advance" hidden="false"><description>In any mission which distinguishes between Scoring and non-Scoring units, a Legion Terminator Squad counts as a Scoring Unit whenever Troops choices normally count as Scoring Units.</description></rule><rule id="r36-exact-power-weapon-a52227e" name="Power Weapon" hidden="false"><description>Ignores Armour Saves.</description></rule><rule id="r36-exact-lingering-death-99f0850" name="Lingering Death" hidden="false"><description>After resolving the attack, leave the Blast marker in place. For the remainder of the battle, the area beneath the marker counts as Dangerous Terrain for non-vehicle models and Open-topped vehicles.</description></rule><rule id="r36-exact-broken-body-865c3e9" name="Broken Body" hidden="false"><description>Reduce the following movement made by Maloghurst's unit by 1", to a minimum of 1": Normal Movement, Advance movement, Charge movement, Fall Back movement and Consolidation movement. In addition, Maloghurst's unit may not Pursue a retreating enemy.</description></rule><rule id="r36-exact-justaerin-primus-608cb10" name="Justaerin Primus" hidden="false"><description>While Falkus Kibre remains alive, his Justaerin Terminator Squad has Fearless. In addition, the squad may purchase the Furious Charge Veteran Skill for +4 points per model. Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test. Furious Charge: Models gain +1 Strength and +1 Initiative in assault on the turn they charged.</description></rule><rule id="r36-exact-terminator-armoury-restrictions-7b98b2d" name="Terminator Armoury Restrictions" hidden="false"><description>Only equipment permitted for a model wearing Terminator Armour is shown. Unit-specific weapon replacements and the Grenade Harness are not duplicated here. No item may be selected more than once unless specifically permitted.</description></rule><rule id="r36-exact-stormwing-2ce2a9c" name="Stormwing" hidden="false"><description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn. Stubborn: Ignore negative Leadership modifiers on Morale and Pinning tests.</description></rule><rule id="r36-exact-deathwing-d3a4efd" name="Deathwing" hidden="false"><description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</description></rule><rule id="r36-exact-dreadwing-070e9f9" name="Dreadwing" hidden="false"><description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests. Move Through Cover: Roll 3D6 for Difficult Terrain tests instead of 2D6 and choose the highest.</description></rule><rule id="r36-exact-ironwing-d05ae6b" name="Ironwing" hidden="false"><description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</description></rule><rule id="r36-exact-firewing-766dc98" name="Firewing" hidden="false"><description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</description></rule><rule id="r36-exact-ravenwing-2423e23" name="Ravenwing" hidden="false"><description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn. Hit &amp; Run: Unit may choose to leave combat at the end of the Assault phase after taking break tests. Take an Initiative test. If passed, the unit moves 3D6" in a chosen direction. The unit does not count as having broken or fallen back, and any now unengaged enemy units it moved away from may only consolidate 3". Jink: Units that moved in the prior turn can activate Jink as a reaction to being shot and gain a 5+ Cover Save until the start of their next turn. If a model with this rule used Turbo-boosters or moved at Flat Out speed, it gains a 4+ Cover Save instead. Models that use Jink only shoot with Snap Fire on their next turn. Outflank: When units with this ability enter from Reserve, roll a D6: on 1-2 enter from the player's left table edge; on 3-4 enter from the player's right; on 5-6 the player chooses the side edge. The unit may alternatively enter from Reserve normally from the player's normal table edge(s). Skilled Rider: Re-roll failed Dangerous Terrain tests. Gains +1 to any Jink saves.</description></rule><rule id="r36-exact-armoured-assault-f55622b" name="Armoured Assault" hidden="false"><description>Select Phobos/Proteus only for an Ironwing Infantry unit of 10 models or fewer; select the Spartan only for an Ironwing Infantry unit of 11–20 models. Normal Transport Capacity restrictions apply.</description></rule><rule id="r36-exact-cult-arcana-quickblood-fe56b53" name="Cult Arcana — Quickblood" hidden="false"><description>This unit gains Fleet. Fleet: Unit may still charge into melee combat even if it advanced this turn.</description></rule><rule id="r36-exact-cult-mastery-quickblood-3c00118" name="Cult Mastery — Quickblood" hidden="false"><description>If this unit has the Psyker or Brotherhood of Psykers special rule, it also gains Crusader. Crusader: Roll extra dice when advancing and use the highest. Adds D3" to pursuit rolls. Brotherhood of Psykers: Unit counts as a Mastery Level 1 Psyker. Uses the unit's highest Leadership value for Psychic Power tests.</description></rule><rule id="r36-exact-cult-arcana-kine-shields-8796029" name="Cult Arcana — Kine Shields" hidden="false"><description>Models in this unit gain a 6+ Invulnerable Save against shooting attacks. This does not improve an existing Invulnerable Save.</description></rule><rule id="r36-exact-cult-mastery-kine-shields-782eaf4" name="Cult Mastery — Kine Shields" hidden="false"><description>If this unit has the Psyker or Brotherhood of Psykers special rule, models instead gain a 5+ Invulnerable Save against shooting; an existing Invulnerable Save improves by 1 against shooting to a maximum of 4+, and Cover Saves against shooting improve by 1 to a maximum of 3+. These benefits do not apply in close combat. Brotherhood of Psykers: Unit counts as a Mastery Level 1 Psyker. Uses the unit's highest Leadership value for Psychic Power tests.</description></rule><rule id="r36-exact-cult-arcana-precognitive-strike-f527710" name="Cult Arcana — Precognitive Strike" hidden="false"><description>When this unit resolves a First Fire shooting attack, it may re-roll To Hit rolls of 1 with all ranged weapons fired as part of that attack.</description></rule><rule id="r36-exact-cult-mastery-precognitive-strike-9e2023b" name="Cult Mastery — Precognitive Strike" hidden="false"><description>If this unit has the Psyker or Brotherhood of Psykers special rule, it may also re-roll To Hit rolls of 1 when making Overwatch, Return Fire and Stand &amp; Shoot attacks. Brotherhood of Psykers: Unit counts as a Mastery Level 1 Psyker. Uses the unit's highest Leadership value for Psychic Power tests.</description></rule><rule id="r36-exact-cult-arcana-discipline-of-the-mind-884cb81" name="Cult Arcana — Discipline of the Mind" hidden="false"><description>This unit gains Stubborn and may re-roll failed Pinning tests. Stubborn: Ignore negative Leadership modifiers on Morale and Pinning tests. Pinning: Unsaved Wounds caused by this weapon force the unit to take a Pinning Test.</description></rule><rule id="r36-exact-cult-mastery-discipline-of-the-mind-b906dda" name="Cult Mastery — Discipline of the Mind" hidden="false"><description>If this unit has the Psyker or Brotherhood of Psykers special rule, it additionally gains Adamantium Will. Adamantium Will: +1 bonus to Deny the Witch, and the unit may attempt to Deny the Witch even if it is not a Psyker. Brotherhood of Psykers: Unit counts as a Mastery Level 1 Psyker. Uses the unit's highest Leadership value for Psychic Power tests.</description></rule><rule id="r36-exact-cult-arcana-ashen-blow-887d335" name="Cult Arcana — Ashen Blow" hidden="false"><description>This unit gains Hammer of Wrath. Hammer of Wrath: On the turn this unit charges, models may perform one of their normally allowed Attacks at Initiative 10 instead of during their normal Initiative step.</description></rule><rule id="r36-exact-cult-mastery-ashen-blow-a469105" name="Cult Mastery — Ashen Blow" hidden="false"><description>If this unit has the Psyker or Brotherhood of Psykers special rule, close-combat attacks and Flame weapons used by models in the unit gain Soul Blaze. Brotherhood of Psykers: Unit counts as a Mastery Level 1 Psyker. Uses the unit's highest Leadership value for Psychic Power tests. Soul Blaze: Units wounded by this attack are set ablaze. Roll a D6 at the end of each turn. On a 4+, the unit takes D3 Strength 4 AP5 hits with no Cover Saves. On less than 4, the blaze goes out and the effect is removed.</description></rule><rule id="r36-exact-scrier-s-gaze-db52b69" name="Scrier's Gaze" hidden="false"><description>While active, one Reserve each turn may automatically pass its Reserve roll; other Reserve and Outflank rolls may be re-rolled, as may Mysterious Objective rolls.</description></rule><rule id="r36-exact-chosen-of-the-warmaster-42c596b" name="Chosen of the Warmaster" hidden="false"><description>A Sons of Horus Praetor, Ezekyle Abaddon or Horus Lupercal may select one Justaerin Terminator Squad as a retinue. If selected as a retinue, the squad does not occupy a separate Elites choice.</description></rule><rule id="r36-exact-fury-of-the-legion-91eb932" name="Fury of the Legion" hidden="false"><description>The squad may declare Fury of the Legion in its Shooting phase if it did not move in the preceding Movement phase, did not arrive from Reserves or Deep Strike or disembark that turn, and at least five models remain armed with Bolters or Bolt Pistols. Models armed with Bolters or Bolt Pistols may fire those weapons twice: a Bolter fires 2 shots up to 24" or 4 shots up to 12", and a Bolt Pistol fires 2 shots. All Fury attacks are directed at the same target unless another rule permits otherwise. After using Fury, the squad may not enter Overwatch, make Return Fire or Stand &amp; Shoot reactions, or fire during its next friendly Shooting phase.</description></rule><rule id="r36-exact-automatic-basic-wargear-8fe4c9d" name="Automatic Basic Wargear" hidden="false"><description>A Legion Tactical Squad begins with its listed basic wargear automatically. Squad-wide Chainsword purchases, Bolter-for-Chainsword exchanges and Krak Grenade purchases are selected once for the squad and their points scale with squad size; they are not selected model-by-model.</description></rule><rule id="r36-exact-fury-of-the-legion-legion-tactical-company-81e339d" name="Fury of the Legion (Legion Tactical Company)" hidden="false"><description>Once per battle, when this Legion Tactical Squad remained stationary and is selected to shoot, every bolter fired by the squad fires one additional shot that Shooting phase. Weapons other than bolters receive no extra shots. A unit which uses this rule may not charge during the same turn.</description></rule><rule id="r36-exact-whole-squad-chainswords-c4be64f" name="Whole-squad Chainswords" hidden="false"><description>The entire squad retains its Bolters and Bolt pistols and also takes Chainswords for +2 points per model. New Recruit calculates the total from the selected squad size.</description></rule><rule id="r36-exact-exchange-bolters-for-chainswords-cec229c" name="Exchange Bolters for Chainswords" hidden="false"><description>The entire squad exchanges its Bolters for Chainswords at no additional cost. Because the squad no longer has Bolters to replace, Special Weapon and Heavy Weapon selections are unavailable while this option is selected.</description></rule><rule id="r36-exact-whole-squad-krak-grenades-d9ab905" name="Whole-squad Krak Grenades" hidden="false"><description>The entire squad takes Krak Grenades for +2 points per model. New Recruit calculates the total from the selected squad size.</description></rule><rule id="r36-exact-land-raider-dedicated-transport-c4ecfc6" name="Land Raider Dedicated Transport" hidden="false"><description>Select a pattern with sufficient Transport Capacity. These entries use the profiles and standard wargear/rules of the corresponding Legion Land Raider Battle Squadron entry; use that entry for full vehicle upgrade options.</description></rule><rule id="r36-exact-sergeant-replacement-9a2bb74" name="Sergeant Replacement" hidden="false"><description>Aeonid Thiel replaces this squad’s Sergeant for +80 points. Thiel remains part of the squad for the entire battle, is a Character but not an Independent Character, and does not occupy a separate Force Organisation slot.</description></rule><rule id="r36-exact-aeonid-thiel-sergeant-replacement-24b0799" name="Aeonid Thiel — Sergeant Replacement" hidden="false"><description>Aeonid Thiel replaces this squad’s Sergeant for +80 points. He remains part of the squad for the entire battle, is a Character but not an Independent Character, and may not purchase the replaced Sergeant’s personal Armoury options.</description></rule><rule id="r36-exact-sonic-shrieker-select-once-per-model-in-the-unit-2482570" name="Sonic Shrieker — select once per model in the unit" hidden="false"><description>Every eligible model in the unit must purchase this upgrade. This option is available only while using 3rd Company Elite and follows the normal Sonic Shrieker rules.</description></rule><rule id="r36-exact-plague-marines-37f20e9" name="Plague Marines" hidden="false"><description>Every model in this unit is upgraded for +7 points per model. Models gain +1 Toughness, Feel No Pain (5+) and Slow and Purposeful. They may not benefit from Move Through Cover, their normal maximum charge distance is 5 inches, and they may not benefit from rules that increase their Movement or charge distance. The Relentless component of Slow and Purposeful applies normally. Slow and Purposeful: Relentless and always moves as if in Difficult Terrain.</description></rule><rule id="r36-exact-death-from-above-legion-assault-company-bececed" name="Death from Above (Legion Assault Company)" hidden="false"><description>Any unit composed entirely of models equipped with Jump Packs may deploy using Deep Strike even if the mission would not normally permit Deep Strike. Resolve arrival using the normal ProHammer Deep Strike rules.</description></rule><rule id="r36-exact-shield-wall-legion-breacher-company-b32cde0" name="Shield Wall (Legion Breacher Company)" hidden="false"><description>Models equipped with Boarding Shields may re-roll results of 1 when making an Invulnerable Save granted by their Boarding Shield.</description></rule><rule id="r36-exact-breacher-power-weapons-e78cb58" name="Breacher Power Weapons" hidden="false"><description>Any model in an Ultramarines Breacher Siege Squad may replace its Bolter with a Power Weapon for +5 points. A model doing so may not also select another option which replaces its Bolter.</description></rule><rule id="r36-exact-veteran-tactics-f7215db" name="Veteran Tactics" hidden="false"><description>When constructing the army, select one Veteran Tactic for this squad. The chosen ability applies to every model in the squad for the duration of the battle.</description></rule><rule id="r36-exact-resolve-ac7f958" name="Resolve" hidden="false"><description>The squad gains the Stubborn special rule. Stubborn: Ignore negative Leadership modifiers on Morale and Pinning tests.</description></rule><rule id="r36-exact-assault-veterans-e7de20b" name="Assault Veterans" hidden="false"><description>The squad gains the Furious Charge special rule. Furious Charge: Models gain +1 Strength and +1 Initiative in assault on the turn they charged.</description></rule><rule id="r36-exact-counter-assault-b971205" name="Counter-Assault" hidden="false"><description>The squad gains the Counter-Attack special rule. Counter-Attack: If this unit is not engaged with any enemy models and an enemy unit successfully completes a charge move against it, the unit may take a Leadership test. If passed, this unit gains +1 Attack during the Assault phase.</description></rule><rule id="r36-exact-machine-killers-21b8827" name="Machine Killers" hidden="false"><description>The squad gains the Tank Hunters special rule. Tank Hunters: +1 to Armour Penetration rolls. Automatically passes Tank Shock Morale tests.</description></rule><rule id="r36-exact-recon-veterans-bd28893" name="Recon Veterans" hidden="false"><description>The squad gains the Infiltrate special rule. Infiltrate: During deployment, may be set up after normal deployment. The unit must be set up 12" or more away from enemy units that do not have line of sight and 18" or more away from enemy units with line of sight. The unit also gains Outflank.</description></rule><rule id="r36-exact-marksmen-99c95a0" name="Marksmen" hidden="false"><description>Normal Bolters fired by models in the squad have Twin-linked. This does not apply to Combi-weapons, Foeblaster Boltguns or other bolt weapon variants.</description></rule><rule id="r36-exact-bolster-defences-c252a32" name="Bolster Defences" hidden="false"><description>Before deployment, nominate one ruin or similar defensive terrain feature wholly or partly in the army's deployment zone. Improve its Cover Save by 1 to a maximum of 3+. A terrain feature may only be Bolstered once.</description></rule><rule id="r36-exact-field-team-4162de9" name="Field Team" hidden="false"><description>If accompanied by one or more Servo-automata, the Techmarine and his Servo-automata form one Field Team. The Techmarine may not voluntarily leave while any Servo-automata remain alive. The whole Field Team may join and leave friendly units as though the Techmarine were an Independent Character. If he is slain, surviving Servo-automata form a unit and become subject to Cybernetica.</description></rule><rule id="r36-exact-servo-arm-replacement-118d0ed" name="Servo-Arm Replacement" hidden="false"><description>Replacing the Servo-Arm removes both the additional close-combat attack and the +1 bonus to Battlesmith normally provided by the Servo-Arm.</description></rule><rule id="r36-exact-cybernetica-fcf88b4" name="Cybernetica" hidden="false"><description>At the beginning of each friendly Movement phase, Servo-automata not accompanied by a Legion Techmarine must take a Pinning test. If already engaged in close combat, they do not take this test and fight normally.</description></rule><rule id="r36-exact-rad-missiles-724468f" name="Rad Missiles" hidden="false"><description>Legal only if this Servo-automata has a Missile Launcher and its Legion Techmarine is equipped with Rad Grenades. Replace the Missile Launcher's Frag and Krak Missiles with Rad Missiles: 48", S4, AP3, Heavy 1, Blast, Fleshbane, Rad-phage. A surviving model that suffers an unsaved Wound from Rad-phage loses 1 Toughness for the rest of the battle, minimum 1; cumulative. Fleshbane: Always wounds on a 2+. No effect versus Vehicles.</description></rule><rule id="r36-exact-dreadnought-close-combat-weapon-46aedbb" name="Dreadnought Close Combat Weapon" hidden="false"><description>Strength x2; Power Weapon; attacks at normal Initiative. Includes a built-in Twin-linked Bolter unless replaced.</description></rule><rule id="r36-exact-armoured-sarcophagus-26369d5" name="Armoured Sarcophagus" hidden="false"><description>Increase Front Armour from 12 to 13. Side and Rear Armour are unaffected.</description></rule><rule id="r36-exact-veteran-pilot-156c46c" name="Veteran Pilot" hidden="false"><description>Increase Weapon Skill and Ballistic Skill by +1. This Dreadnought therefore has WS5 and BS5.</description></rule><rule id="r36-exact-infiltrate-move-through-cover-32e000b" name="Infiltrate &amp; Move Through Cover" hidden="false"><description>The squad has Infiltrate and Move Through Cover as defined in ProHammer Classic. Infiltrate: During deployment, may be set up after normal deployment. The unit must be set up 12" or more away from enemy units that do not have line of sight and 18" or more away from enemy units with line of sight. The unit also gains Outflank. Move Through Cover: Roll 3D6 for Difficult Terrain tests instead of 2D6 and choose the highest.</description></rule><rule id="r36-exact-marked-for-death-44456f7" name="Marked for Death" hidden="false"><description>After deployment, nominate one enemy unit for each Legion Seeker Squad. Against its nominated target, the squad re-rolls To Hit rolls of 1 and To Wound rolls of 1; against vehicles it re-rolls Armour Penetration rolls of 1 instead of To Wound rolls. If the target is destroyed, no new target is selected.</description></rule><rule id="r36-exact-chogorian-warlance-b2fb377" name="Chogorian Warlance" hidden="false"><description>Power Weapon, Cavalry Lance. +1 Initiative in the first round when charging; -1 Initiative in rounds in which the bearer did not charge. One-handed.</description></rule><rule id="r36-exact-rapid-encirclement-f28ea51" name="Rapid Encirclement" hidden="false"><description>Once per battle, during its Movement phase, if every model in this unit can move completely off a table edge, remove the unit and place it into Ongoing Reserves. It returns during the controlling player’s following turn using the normal Outflank rules.</description></rule><rule id="r36-exact-legiones-astartes-deep-strike-14ad105" name="Legiones Astartes &amp; Deep Strike" hidden="false"><description>Legiones Astartes and Deep Strike. The unit also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless. And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear. Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement. Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description></rule><rule id="r36-exact-strafing-run-429f705" name="Strafing Run" hidden="false"><description>When shooting Assault, Heavy, Rapid Fire or Salvo weapons at ground units that are not Flyers or Skimmers, the vehicle gains +1 Ballistic Skill and all such shots count as Pinning, as defined in ProHammer Classic. Pinning: Unsaved Wounds caused by this weapon force the unit to take a Pinning Test.</description></rule><rule id="r36-exact-hardened-armour-entire-squad-284b2e5" name="Hardened Armour (entire squad)" hidden="false"><description>Failed Armour Saves caused by Blast or Template weapons may be re-rolled. Reduce Advance additional distance, Charge distance and Pursuit distance by 1". Counts as Void Hardened where applicable.</description></rule><rule id="r36-exact-armistos-711ddfb" name="Armistos" hidden="false"><description>Fire Control: When this Heavy Support Squad enters Overwatch, its models may declare Overwatch targets out to the normal maximum range of their weapons rather than being restricted to 24". All other Overwatch rules and restrictions apply normally.</description></rule><rule id="r36-exact-siege-breaker-adaa7fd" name="Siege Breaker" hidden="false"><description>Art of Destruction: Heavy weapons fired by this unit receive +1 to Armour Penetration rolls against vehicles and fortifications. This does not apply to pistols, grenades or close-combat attacks.</description></rule><rule id="r36-exact-explorator-augury-web-24da159" name="Explorator Augury Web" hidden="false"><description>The Proteus gains Scout. At the start of the controlling player’s turn before Reserve rolls, choose Disruption Mode (opponent suffers -1 to all Reserve rolls) or Relay Mode (controlling player may re-roll failed Reserve rolls) until the next controlling turn. Multiple webs give no additional benefit and only one mode may be active for the army. A Proteus with the Web has Transport Capacity 8. Scout: May always be deployed. Before rolling to see who goes first, may take a bonus normal move. Confers Scout ability to a Dedicated Transport it is mounted in. If both players have Scouts, roll-off and alternate moving Scouts starting with the winner. The unit also gains Outflank.</description></rule><rule id="r36-exact-ferromantic-invulnerability-cf44f00" name="Ferromantic Invulnerability" hidden="false"><description>Weapons with Melta do not roll an additional Armour Penetration die against the Achilles. Weapons with Lance do not reduce its Armour Value. Lance: Treat Vehicle Armour Values greater than 12 as 12. Melta: When making Armour Penetration rolls, roll 2D6 instead of D6 if the target is at half range or less.</description></rule><rule id="r36-exact-new-recruit-note-03c4142" name="New Recruit note" hidden="false"><description>For a two- or three-vehicle squadron, select the appropriate number of Additional vehicles. Vehicle upgrades and pintle weapons may be selected in matching quantities up to the number of vehicles in the squadron; do not assign more than one copy of a given upgrade to the same vehicle.</description></rule><rule id="r36-exact-jetbike-command-fe352e1" name="Jetbike Command" hidden="false"><description>Replaces the model’s Space Marine Bike. This option includes the normal +35 point Space Marine Bike and the +5 point Sky Hunter Phalanx Jetbike upgrade. The model follows the normal rules for Jetbikes.</description></rule><rule id="r36-exact-armoury-weapon-restrictions-a42b020" name="Armoury Weapon Restrictions" hidden="false"><description>These selections replace the model's Bolt Pistol and/or Chainsword. A model may carry no more than two weapons, only one of which may be two-handed. A Pair of Lightning Claws counts as both weapon choices. No item may be selected more than once unless specifically permitted. Equipment included in the unit entry does not count against the Armoury allowance.</description></rule><rule id="r36-exact-terminator-apothecary-4682517" name="Terminator Apothecary" hidden="false"><description>The Narthecium and Reductor may be used while wearing any Terminator Armour pattern, overriding normal Armoury restrictions. The Apothecary may select up to 50 points of permitted Armoury equipment.</description></rule><rule id="r36-exact-terminator-standard-bearer-7642801" name="Terminator Standard Bearer" hidden="false"><description>The selected standard may be carried in any Terminator Armour pattern, overriding normal Armoury restrictions. The Standard Bearer may select up to 50 points of permitted Armoury equipment.</description></rule><rule id="r36-exact-terminator-champion-3460859" name="Terminator Champion" hidden="false"><description>The Champion's Power Weapon is Master-crafted at no additional cost. The Champion may select up to 50 points of permitted Space Marine Armoury equipment.</description></rule><rule id="r36-exact-perdition-weapon-dd10e4b" name="Perdition Weapon" hidden="false"><description>Counts as a Power Weapon. A natural To Wound roll of 6 inflicts a Massive Wound (D3) instead of a normal Wound.</description></rule><rule id="r36-exact-master-of-the-seraphim-1c31788" name="Master of the Seraphim" hidden="false"><description>A Sanguinary Guard Squad containing Azkaellon may deploy using Deep Strike even if the mission does not normally permit it. If selected as a character’s retinue, that character must also be capable of Deep Striking or the unit deploys normally.</description></rule><rule id="r36-exact-angelus-boltgun-db0a1b4" name="Angelus Boltgun" hidden="false"><description>Fixed Azkaellon wargear.</description></rule><rule id="r36-exact-servants-of-the-great-angel-2f75d8a" name="Servants of the Great Angel" hidden="false"><description>A Sanguinary Guard Squad may only be selected as the retinue of a Blood Angels Praetor, Raldoron or Sanguinius. It occupies no separate Force Organisation slot. The character must begin the battle joined to the Sanguinary Guard but may leave normally later.</description></rule><rule id="r36-exact-honour-guard-a16e5ff" name="Honour Guard" hidden="false"><description>One Invictarus Suzerain Squad may be selected as the retinue of an Ultramarines Praetor or named Ultramarines Independent Character who is permitted to select a Command Squad. It does not occupy a separate Force Organisation slot; the character and Suzerains count as a single HQ selection.</description></rule><rule id="r36-exact-whole-squad-melta-bombs-9e41e7a" name="Whole-squad Melta Bombs" hidden="false"><description>Every Deathshroud Terminator takes Melta Bombs for +5 points per model. The cost scales with the selected squad size.</description></rule><rule id="r36-exact-cataphractii-armour-exchange-da22963" name="Cataphractii Armour Exchange" hidden="false"><description>The entire squad exchanges its Terminator Armour for Cataphractii Terminator Armour at no additional cost. The squad instead has a 2+/4+ Save and follows all normal Cataphractii Terminator Armour rules and restrictions.</description></rule><rule id="r36-exact-power-glaive-16177ab" name="Power Glaive" hidden="false"><description>Character able to select a Power Weapon. One-handed: User Strength, Power Weapon. Two-handed: User +1 Strength, Power Weapon, Two-Handed. If replacing a basic Power Weapon, use the source exchange price of +10 instead.</description></rule><rule id="r36-exact-combi-plasma-gun-56db0b5" name="Combi-plasma gun" hidden="false"><description>Replaces that Huscarl’s Combi-bolter.</description></rule><rule id="r36-exact-scrier-s-gaze-97fc9df" name="Scrier’s Gaze" hidden="false"><description>Blessing — targets Psyker. Apply the ProHammer Reserve, Outflank and mystery-objective re-roll benefits.</description></rule><rule id="r36-exact-sanctic-daemonology-6ca90af" name="Sanctic Daemonology" hidden="false"><description>This Psyker may select powers from the Sanctic Daemonology discipline as permitted by its Consul entry and ProHammer Classic.</description></rule><rule id="r36-exact-banishment-7ba56ef" name="Banishment" hidden="false"><description>Malediction — enemy Daemon unit within 24”. All models in target unit suffer -1 to their Invulnerable Saves.</description></rule><rule id="r36-exact-gate-of-infinity-d9c4809" name="Gate of Infinity" hidden="false"><description>Blessing — targets Psyker. Remove Psyker and joined unit and immediately redeploy using Deep Strike.</description></rule><rule id="r36-exact-hammerhand-729e952" name="Hammerhand" hidden="false"><description>Blessing — targets Psyker. Psyker and joined unit gain +2 Strength.</description></rule><rule id="r36-exact-sanctuary-826239c" name="Sanctuary" hidden="false"><description>Blessing — targets Psyker. Psyker and joined unit receive +1 to Invulnerable Saves, or gain a 6+ Invulnerable Save; Daemons treat all terrain within 12” as Dangerous Terrain.</description></rule><rule id="r36-exact-purge-soul-994a88b" name="Purge Soul" hidden="false"><description>Focused Witchfire — range 24”. Psyker and target roll D6 + Leadership; if Psyker is equal or higher, target suffers one automatic Wound with no Armour or Cover Save.</description></rule><rule id="r36-exact-cleansing-flame-60fb1ab" name="Cleansing Flame" hidden="false"><description>Nova. Range 9”, S5 AP4 Assault 2D6, Ignores Cover, Soul Blaze.</description></rule><rule id="r36-exact-vortex-of-doom-3d483a6" name="Vortex of Doom" hidden="false"><description>Witchfire. Range 12”, S10 AP1 Assault 1, Blast, Vortex.</description></rule><rule id="r36-exact-standard-wargear-transport-9082ecb" name="Standard Wargear &amp; Transport" hidden="false"><description>Vehicle (Tank). Twin-linked Bolter, Searchlight and Smoke Launchers. Transport Capacity 6. No Fire Points. One Access Point on each side and one at the rear.</description></rule><rule id="r36-exact-geo-locator-beacon-7b4ff91" name="Geo-Locator Beacon" hidden="false"><description>Friendly units arriving by Deep Strike do not scatter if their first model is placed within 24" of the Damocles and otherwise has a legal deployment position.</description></rule><rule id="r36-exact-command-vehicle-e6f43fb" name="Command Vehicle" hidden="false"><description>0–1 Damocles Command Rhino may be selected as a non-compulsory HQ choice in an army of at least 1,000 points. Alternatively, a Master of Signals may select one as a Dedicated Transport.</description></rule><rule id="r36-exact-focused-bombardment-13226b6" name="Focused Bombardment" hidden="false"><description>Once per battle, provided the Damocles did not move that turn, it may fire the Focused Bombardment profile.</description></rule><rule id="r36-exact-twin-linked-bolter-5cdb6a5" name="Twin-linked Bolter" hidden="false"><description>Uses the corresponding Legion vehicle-mounted weapon profile and rules.</description></rule><rule id="r36-exact-heavy-bolter-9ea55af" name="Heavy Bolter" hidden="false"><description>Uses the corresponding Legion vehicle-mounted weapon profile and rules.</description></rule><rule id="r36-exact-apothecary-armoury-6175282" name="Apothecary Armoury" hidden="false"><description>The Apothecary may select up to 50 points of permitted Space Marine Armoury weapons and wargear in addition to the Narthecium. The Reductor is optional at +5 points.</description></rule><rule id="r36-exact-standard-bearer-armoury-7b03aca" name="Standard Bearer Armoury" hidden="false"><description>The Standard Bearer may select up to 50 points of permitted Space Marine Armoury weapons and wargear.</description></rule><rule id="r36-exact-champion-armoury-c8775ab" name="Champion Armoury" hidden="false"><description>The Legion Champion may select up to 50 points of permitted Space Marine Armoury weapons and wargear.</description></rule><rule id="r36-exact-mobility-restrictions-c790199" name="Mobility Restrictions" hidden="false"><description>Every model must take the same mobility upgrade. It may only be selected if the character for whom the squad was selected has the corresponding Jump Pack, Bike or Jetbike. If any mobility option is selected, the squad may not take a Dedicated Transport.</description></rule><rule id="r36-exact-death-sworn-companions-273def1" name="Death-sworn Companions" hidden="false"><description>While an eligible Dark Angels Independent Character is joined, once per phase when that Character suffers an unsaved Wound, remove one Companion within 2" instead and ignore the Wound. Use before rolling D3 for a Massive Wound.</description></rule><rule id="r36-exact-cytheron-aegis-c5a90cc" name="Cytheron Aegis" hidden="false"><description>Bearer has 4+ Invulnerable Save against shooting and 5+ in close combat; occupies one hand and prevents two-weapon bonus. If at least two Aegis bearers are present, at start of Assault phase the unit may deploy them until next Movement phase: whole unit gains 4++ shooting/5++ melee and engaged enemies suffer -1 Initiative; Aegis bearers make no close-combat attacks. Ends if fewer than two remain.</description></rule><rule id="r36-exact-structure-points-bdaf4a4" name="Structure Points" hidden="false"><description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</description></rule><rule id="r36-exact-massive-firepower-ca38600" name="Massive Firepower" hidden="false"><description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</description></rule><rule id="r36-exact-lumbering-war-engine-d6d008b" name="Lumbering War Engine" hidden="false"><description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</description></rule><rule id="r36-exact-super-heavy-tank-shock-5de7bbc" name="Super-heavy Tank Shock" hidden="false"><description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</description></rule><rule id="r36-exact-crushing-advance-d33dc05" name="Crushing Advance" hidden="false"><description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</description></rule><rule id="r36-exact-immense-machine-d938f52" name="Immense Machine" hidden="false"><description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</description></rule><rule id="r36-exact-catastrophic-destruction-38e2f78" name="Catastrophic Destruction" hidden="false"><description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</description></rule><rule id="r36-exact-massive-blast-a7579f3" name="Massive Blast" hidden="false"><description>Uses the 7 inch Blast marker.</description></rule><rule id="r36-exact-titan-killer-77633b0" name="Titan Killer" hidden="false"><description>When a Titan Killer weapon scores a Penetrating Hit against a Super-heavy Vehicle, resolve the hit normally and then the target loses D3 Structure Points. Against a non-Vehicle model an unsaved Wound inflicts D3 Wounds instead of 1.</description></rule><rule id="r36-exact-space-marine-legion-crew-e3e96a6" name="Space Marine Legion Crew" hidden="false"><description>The vehicle has Ballistic Skill 4.</description></rule><rule id="r36-exact-super-heavy-command-tank-e7a7769" name="Super-heavy Command Tank" hidden="false"><description>Friendly Infantry units within 24 inches may re-roll failed Morale Tests.</description></rule><rule id="r36-exact-chaff-launcher-09ce668" name="Chaff Launcher" hidden="false"><description>Once per battle, when the vehicle suffers a Glancing or Penetrating Hit caused by a Missile weapon, roll a D6. On a 4+ the hit is ignored.</description></rule><rule id="r36-exact-flyer-8945909" name="Flyer" hidden="false"><description>Uses the normal ProHammer Vehicle and Flyer rules, including deployment from Reserves, Zooming/Hovering where applicable, movement, turning, leaving the battlefield, Hard to Hit, Evasion and Flyer damage.</description></rule><rule id="r36-exact-air-to-air-targeting-9041800" name="Air-to-Air Targeting" hidden="false"><description>When a Zooming Flyer fires at another Flyer or Flying Monster, it may use its normal Ballistic Skill when rolling To Hit.</description></rule><rule id="r36-exact-agile-2160091" name="Agile" hidden="false"><description>When this Flyer enters Evasion, improve the Cover Save granted by Evasion by +1, to a maximum of 3+.</description></rule><rule id="r36-exact-supersonic-e19b530" name="Supersonic" hidden="false"><description>Uses the normal ProHammer special rule.</description></rule><rule id="r36-exact-ground-tracking-auguries-b7d2fb9" name="Ground-tracking Auguries" hidden="false"><description>The vehicle gains Strafing Run.</description></rule><rule id="r36-exact-deep-striike-8d74325" name="Deep Striike" hidden="false"><description>Uses the normal ProHammer special rule.</description></rule><rule id="r36-exact-masters-of-the-storm-of-war-5d02d51" name="Masters of the Storm of War" hidden="false"><description>Purchased at its normal points cost as part of this 20-model squad. It occupies no HQ slot, is part of the squad and may not voluntarily leave, may not take a Consul upgrade, may not be the Warlord and must belong to the Stormwing.</description></rule><rule id="r36-exact-the-hammer-of-caliban-5ecfd6b" name="The Hammer of Caliban" hidden="false"><description>Selected as a Troops choice by The Unbroken Vow. This Rite-specific copy is fixed to the Deathwing.</description></rule><rule id="r36-exact-ravenwing-host-8e2128f" name="Ravenwing Host" hidden="false"><description>Selected as a Troops choice by The Seeker’s Arrow. This Rite-specific copy is fixed to the Ravenwing. It gains Outflank and Hit &amp; Run while the Rite is active. Hit &amp; Run: Unit may choose to leave combat at the end of the Assault phase after taking break tests. Take an Initiative test. If passed, the unit moves 3D6" in a chosen direction. The unit does not count as having broken or fallen back, and any now unengaged enemy units it moved away from may only consolidate 3". Outflank: When units with this ability enter from Reserve, roll a D6: on 1-2 enter from the player's left table edge; on 3-4 enter from the player's right; on 5-6 the player chooses the side edge. The unit may alternatively enter from Reserve normally from the player's normal table edge(s).</description></rule><rule id="r36-exact-krak-grenades-select-once-per-squad-model-4aa3bc2" name="Krak grenades — select once per squad model" hidden="false"><description>The entire squad must take this upgrade; select one for every model currently in the squad.</description></rule><rule id="r36-exact-blastmaster-replace-one-kakophoni-sonic-blaster-27e3130" name="Blastmaster — replace one Kakophoni Sonic Blaster" hidden="false"><description>One Kakophoni per full three models in the squad may take this option. A 6-model squad may take 2; 9 models may take 3; 12 models may take 4.</description></rule><rule id="r36-exact-cacophony-f1ed045" name="Cacophony" hidden="false"><description>If an enemy unit suffers one or more casualties from shooting attacks made by this squad, it must take a Pinning test after the squad has finished firing.</description></rule><rule id="r36-exact-coordinated-bombardment-aa3d575" name="Coordinated Bombardment" hidden="false"><description>When the squad fires its Cyclone Missile Launchers, it may re-roll one failed To Hit roll made with a Cyclone Missile Launcher during that Shooting phase. A model equipped with a Cyclone Missile Launcher may fire it in addition to its Storm bolter or Foeblaster boltgun in the same Shooting phase; both weapons must target the same enemy unit.</description></rule><rule id="r36-exact-hatred-battle-automata-2fac22d" name="Hatred (Battle-Automata)" hidden="false"><description>Use the normal ProHammer Hatred special rule when fighting enemy Battle-Automata. Hatred: If a unit with Hatred is engaged in melee combat against a hated enemy type, and was not engaged in melee combat with that enemy type during the prior turn, the unit may re-roll all failed close combat To Hit rolls against the hated target.</description></rule><rule id="r36-exact-those-once-honoured-625548c" name="Those Once Honoured" hidden="false"><description>One Dominator Cohort may be selected as Perturabo's personal retinue. If selected in this manner, the squad does not occupy an Elites choice.</description></rule><rule id="r36-exact-jetbike-weapons-cd7fa97" name="Jetbike Weapons" hidden="false"><description>For every three models in the squadron, one Golden Keshig may replace the Heavy Bolter with Hellfire Rounds. At 3–5 models this allows one replacement.</description></rule><rule id="r36-exact-dragon-dao-086ccb6" name="Dragon Dao" hidden="false"><description>Power Weapon. At the beginning of each Assault phase the bearer may wield it with both hands, gaining +2 Strength but suffering -2 Initiative and receiving no bonus Attack for two close-combat weapons.</description></rule><rule id="r36-exact-jetbike-e0c15d0" name="Jetbike" hidden="false"><description>May only be selected if the character has purchased a Space Marine Bike. For a further +5 points the Bike is upgraded to a Jetbike; the character follows the normal ProHammer Jetbike rules.</description></rule><rule id="r36-exact-upgrade-one-varagyr-to-a-thegn-f7927ee" name="Upgrade one Varagyr to a Thegn" hidden="false"><description>The Thegn uses the Thegn profile in this entry.</description></rule><rule id="r36-exact-glory-seekers-a2b2ac2" name="Glory Seekers" hidden="false"><description>At the start of an Assault phase, if the unit is engaged with one or more enemy Independent Characters, nominate one. Every Varagyr able to attack the nominated character must do so, and each Varagyr may re-roll one failed To Hit roll against that character in that Assault phase.</description></rule><rule id="r36-exact-chosen-of-jarl-c023767" name="Chosen of Jarl" hidden="false"><description>A Space Wolves Praetor wearing Terminator Armour may take one Varagyr Wolf Guard Terminator Pack instead of a Legion Terminator Command Squad. The pack occupies no separate Force Organisation slot and the Praetor and pack count as a single HQ choice.</description></rule><rule id="r36-exact-combi-plasma-7db6fe6" name="Combi-plasma" hidden="false"><description>Replaces that model’s Combi-bolter.</description></rule><rule id="r36-exact-reaper-autocannon-28a99a7" name="Reaper Autocannon" hidden="false"><description>Replaces one Varagyr’s Combi-bolter.</description></rule><rule id="r36-exact-assault-cannon-6ccc621" name="Assault Cannon" hidden="false"><description>Replaces one Varagyr’s Combi-bolter.</description></rule><rule id="r36-exact-righteous-zeal-9d1abdc" name="Righteous Zeal" hidden="false"><description>Whenever the squad would normally take a Morale test for suffering 25% or more casualties from enemy shooting, it may instead move D6 inches directly towards the nearest visible enemy unit. This movement may not bring a model within 1 inch of an enemy and does not count as charging or Falling Back. If no enemy is visible, take the Morale test normally.</description></rule><rule id="r36-exact-spartan-condition-5250496" name="Spartan condition" hidden="false"><description>The Rite permits a Spartan only for a Templar Brethren Squad too large for both a Land Raider Phobos and a Land Raider Proteus. The current Templar Brethren unit size is 5–10, so a Spartan is not a legal Rite transport at present.</description></rule><rule id="r36-exact-preferred-enemy-infantry-9a4bf8e" name="Preferred Enemy (Infantry)" hidden="false"><description>Preferred Enemy (Infantry): the unit may re-roll failed hits in close combat against Infantry.</description></rule><rule id="r36-exact-headtaker-430c18f" name="Headtaker" hidden="false"><description>The Raptor Sergeant becomes a Headtaker and has Weapon Skill 5. The Headtaker may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury and Night Lords Armoury.</description></rule><rule id="r36-exact-nostraman-chainblade-a3b0d93" name="Nostraman Chainblade" hidden="false"><description>A Nostraman Chainblade is a Two-Handed Rending Weapon which grants +1 Strength.</description></rule><rule id="r36-exact-escaton-power-claw-c955405" name="Escaton Power Claw" hidden="false"><description>An Escaton Power Claw counts as a Power Fist. In addition, the wielder may re-roll failed To Wound rolls made with it.</description></rule><rule id="r36-exact-gorgon-field-0a671f5" name="Gorgon Field" hidden="false"><description>If one or more models in this unit pass an Invulnerable Save against shooting from an enemy unit, resolve all attacks from that enemy unit, then the attacking unit takes one Initiative test. If failed, it is affected by the normal ProHammer Blind rule until the end of its next turn. A unit takes at most one Gorgon Field test per phase. Blind: A unit hit by a weapon with Blind must take an Initiative test. If failed, all models are reduced to BS1 and WS1 until the end of their next turn.</description></rule><rule id="r36-exact-the-gorgon-474fc9e" name="The Gorgon" hidden="false"><description>Ferrus Manus has Feel No Pain (5+).</description></rule><rule id="r36-exact-master-of-the-forge-6ad54a1" name="Master of the Forge" hidden="false"><description>Ferrus Manus has Battlesmith and succeeds on a 3+. He may repair friendly Vehicles, Dreadnoughts and Battle-Automata as appropriate.</description></rule><rule id="r36-exact-devourers-e6bc705" name="Devourers" hidden="false"><description>Angron may select one Devourer Terminator Squad as his retinue.</description></rule><rule id="r36-exact-breachers-6165ad8" name="Breachers" hidden="false"><description>Uses the normal Breachers special rule.</description></rule><rule id="r36-exact-caedere-weapons-entire-squad-4c3587b" name="Caedere Weapons — entire squad" hidden="false"><description>This is a whole-squad upgrade and costs +5 points for every model in the squad. New Recruit calculates the total automatically from the selected squad size.</description></rule><rule id="r36-exact-power-weapons-entire-squad-30006b5" name="Power Weapons — entire squad" hidden="false"><description>This is a whole-squad upgrade and costs +10 points for every model in the squad. New Recruit calculates the total automatically from the selected squad size.</description></rule><rule id="r36-exact-frag-grenades-entire-squad-74097fd" name="Frag grenades — entire squad" hidden="false"><description>This is a whole-squad upgrade and costs +1 points for every model in the squad. New Recruit calculates the total automatically from the selected squad size.</description></rule><rule id="r36-exact-krak-grenades-entire-squad-e8d7e8e" name="Krak grenades — entire squad" hidden="false"><description>This is a whole-squad upgrade and costs +2 points for every model in the squad. New Recruit calculates the total automatically from the selected squad size.</description></rule><rule id="r36-exact-melta-bombs-404bfc7" name="Melta bombs" hidden="false"><description>Uses the normal Melta bomb rules.</description></rule><rule id="r36-exact-bolt-pistol-b5f8436" name="Bolt pistol" hidden="false"><description>Uses the normal Bolt pistol profile.</description></rule><rule id="r36-exact-apothecary-3edecdc" name="Apothecary" hidden="false"><description>Uses the normal Apothecary rules.</description></rule><rule id="r36-exact-destroyer-officer-cfb42ee" name="Destroyer Officer" hidden="false"><description>Morturg may join a Legion Destroyer Squad or Mortus Poisoner Squad despite the normal restrictions imposed by Destroyer Cadre.</description></rule><rule id="r36-exact-barbaran-plate-f671ea2" name="Barbaran Plate" hidden="false"><description>Barbaran Plate counts as Primarch Armour.</description></rule><rule id="r36-exact-barbaran-endurance-bf69330" name="Barbaran Endurance" hidden="false"><description>Mortarion has Feel No Pain (5+).</description></rule><rule id="r36-exact-scarab-occult-34f5547" name="Scarab Occult" hidden="false"><description>This unit is a Psychic Brotherhood. Assign it to one Prosperine Cult; it receives that Cult’s Arcana and Cult Mastery. It selects one power from the normal Thousand Sons disciplines and takes Psychic Tests on Leadership 9. While the Sekhmet Inceptor is alive, the Cabal is Mastery Level 2, knows one additional power and tests on Leadership 10; if he is slain it returns to Mastery Level 1 and loses the second power.</description></rule><rule id="r36-exact-prosperine-force-weapons-7d772a4" name="Prosperine Force Weapons" hidden="false"><description>The Cabal uses the normal Prosperine Force Weapon rules. It may attempt only one Force Weapon activation in each Assault phase, and that activation counts as using one psychic power.</description></rule><rule id="r36-exact-the-crimson-king-s-guard-0804d94" name="The Crimson King's Guard" hidden="false"><description>Magnus' Legion Honour Guard or Legion Terminator Command retinue may be upgraded to Brotherhood of Psykers (Mastery Level 1) for +25 points. It selects one Prosperine Cult and one psychic power from any normal Thousand Sons discipline.</description></rule><rule id="r36-exact-jump-assault-6479381" name="Jump Assault" hidden="false"><description>The entire squad is equipped with Jump Packs and becomes Jump Infantry. A squad equipped with Jump Packs may not select a Dedicated Transport.</description></rule><rule id="r36-exact-cthonian-retinue-30f5f4e" name="Cthonian Retinue" hidden="false"><description>One Chieftain Squad may be selected as the retinue of a Sons of Horus Praetor or appropriate named Sons of Horus Independent Character. The squad does not occupy a separate Elites choice. The Character and Chieftain Squad count as a single HQ selection.</description></rule><rule id="r36-exact-the-rewards-of-treachery-f8167f5" name="The Rewards of Treachery" hidden="false"><description>One eligible Legion-specific unit from another Legion may be selected as an Elites choice. It retains its profile, equipment, options and unit-specific special rules, but replaces its original Legion-specific Legiones Astartes rules with Legiones Astartes (Alpha Legion) and benefits from Alpha Legion rules including Mutable Tactics.</description></rule><rule id="r36-exact-compulsory-troops-6f5a610" name="Compulsory Troops" hidden="false"><description>Use this version for one of the army’s compulsory Troops selections under The Hammer of Olympia.</description></rule><rule id="r36-exact-shrapnel-bolts-free-for-compulsory-troops-9d9186e" name="Shrapnel Bolts — free for compulsory Troops" hidden="false"><description>This free option represents The Iron Line and is only for a compulsory Troops selection.</description></rule><rule id="r37-wb-rule-fanatical-devotion" name="Fanatical Devotion" hidden="false"><description>Non-Daemon units with Legiones Astartes (Word Bearers) may re-roll failed Morale and Pinning tests.</description></rule><rule id="r37-wb-rule-the-dark-shepherds" name="The Dark Shepherds" hidden="false"><description>A Word Bearers Detachment must include at least one Legion Chaplain Consul or Legion-specific Dark Apostle as an HQ selection. A character specifically stated to count as a Dark Apostle also fulfils this requirement.</description></rule><rule id="r37-wb-rule-ritual-of-consecration" name="Ritual of Consecration" hidden="false"><description>Traitor Word Bearers only. When a non-Daemon Word Bearers unit completely destroys an enemy unit during the Assault phase, it may forgo its Consolidation move. If it does, nominate one friendly Daemonic Covenant unit currently in Reserve; that unit may re-roll its next Reserve roll. Only one Covenant unit may receive this benefit each turn.</description></rule><rule id="r37-wb-rule-daemonic-covenant" name="Daemonic Covenant" hidden="false"><description>A Traitor Word Bearers army may include one Daemons of the Ruinstorm Covenant Detachment as its Allied Detachment.
Covenant Force Organisation: HQ 0–1; Troops 1–3; Elites 0–1; Fast Attack 0–1; Heavy Support 0–1. At least one Troops choice is compulsory. The Covenant may cost no more than 25% of the army's total points limit and has no minimum points requirement.
Units use their normal profiles, options, Aetheric Dominions and rules from Daemons of the Ruinstorm. Covenant units cannot fulfil compulsory selections in the primary Detachment or provide the Warlord. Word Bearers and Covenant units are Fellow Warriors. Independent Characters may not join units across these Detachments.</description></rule><rule id="r37-wb-rule-daemonic-summoning" name="Daemonic Summoning" hidden="false"><description>All units in a Daemonic Covenant Detachment begin in Reserve and may not deploy normally, Infiltrate or Outflank. When a Covenant unit becomes available, nominate a friendly Summoning Point already on the battlefield: Personal Icons, Icons of Chaos Undivided, Accursed Crozii, or another rule explicitly identified as a Summoning Point. Place the centre model within 6" of the Summoning Point and more than 2" from enemies, then enter using the normal Deep Strike rules. If no legal Summoning Point/position exists, the unit remains in Reserve. Summoning Points may be used while engaged, are not consumed, and may summon multiple units. Deep Strike Mishaps and normal Deep Strike restrictions apply.</description></rule><rule id="r37-wb-rule-hardened-armour" name="Hardened Armour" hidden="false"><description>Failed Armour Saves caused by Blast or Template weapons may be re-rolled. Reduce Advance distance by 1", and reduce Charge or Pursuit distance by 1". In missions using Void Hardened armour, models with Hardened Armour count as Void Hardened. These movement penalties also apply to an Artificer Armour model that is part of a Breacher-style Hardened Armour unit.</description></rule><rule id="r37-wb-rule-bitter-duty" name="Bitter Duty" hidden="false"><description>Only an Independent Character specifically permitted to join Bitter Duty units may join an Ashen Circle Squad.</description></rule><rule id="r37-wb-rule-primarch-armour" name="Primarch Armour" hidden="false"><description>Confers a 1+ Armour Save and a 4+ Invulnerable Save. A natural roll of 1 always fails.</description></rule><rule id="r37-wb-rule-feel-no-pain-6" name="Feel No Pain (6+)" hidden="false"><description>After a model fails an eligible saving throw, roll a D6; on a 6 the Wound is ignored, subject to the normal ProHammer Feel No Pain restrictions.</description></rule><rule id="r37-wb-rule-preferred-enemy-loyalists" name="Preferred Enemy (Loyalists)" hidden="false"><description>The model/unit may re-roll failed hits in close combat against models belonging to the Loyalist faction.</description></rule><rule id="r37-wb-rule-narthecium" name="Narthecium" hidden="false"><description>A unit containing an Apothecary equipped with a Narthecium may ignore the first failed saving throw it suffers during each player turn. It cannot be used against Instant Death, an attack allowing no saving throw of any kind, if the Apothecary is slain, or while the Apothecary is in base contact with an enemy model. The controlling player chooses the eligible failed save ignored.</description></rule><rule id="r37-wb-rule-reductor" name="Reductor" hidden="false"><description>In missions using Victory Points, an Apothecary equipped with a Reductor recovers 1 Victory Point for each slain friendly Legiones Astartes model that belonged to his unit, including attached Independent Characters, provided the Apothecary survives the battle.</description></rule><rule id="r37-wb-rule-driven-to-slaughter" name="Driven to Slaughter" hidden="false"><description>While the Legion Overseer lives, the Covenant Zealot Mob is Fearless and ignores Leadership penalties. If able to charge in the Assault phase it must do so. In a turn it charges, Covenant Zealots (not the Overseer) gain +1 Attack and +1 Initiative. If the Overseer is slain, the unit loses Fearless and this rule; if not locked it immediately becomes Pinned, otherwise it becomes Pinned when that combat ends.</description></rule><rule id="r37-wb-rule-expendable" name="Expendable" hidden="false"><description>Casualties suffered by a Covenant Zealot Mob, or the destruction of the unit, never cause friendly units to take Morale, Leadership or Pinning tests.</description></rule><rule id="r37-wb-rule-daemonic-engine" name="Daemonic Engine" hidden="false"><description>Each time the Mhara Gal suffers a Glancing or Penetrating Hit, roll a D6 before the Vehicle Damage roll. On a 5+, the hit is ignored.</description></rule><rule id="r37-wb-rule-shroud-of-dark-fire" name="Shroud of Dark Fire" hidden="false"><description>When resolving a shooting attack against the Mhara Gal made with a Flame, Melta, Plasma or Volkite weapon, reduce that attack's Strength by 1, to a minimum of 1.</description></rule><rule id="r37-wb-rule-accursed" name="Accursed" hidden="false"><description>Successful Invulnerable Saves made against the Mhara Gal's close-combat attacks must be re-rolled. Enemy units taking a Fear test caused by the Mhara Gal suffer -2 Leadership. The Mhara Gal never counts as a Scoring Unit.</description></rule><rule id="r37-wb-rule-flesh-harvesters" name="Flesh Harvesters" hidden="false"><description>When a Procurator Squad uses Ritual of Consecration, the nominated Daemon unit receives +1 to its next Reserve roll in addition to the normal re-roll. This modifier is not cumulative.</description></rule><rule id="r37-wb-rule-daemonkin" name="Daemonkin" hidden="false"><description>After deployment but before the first turn, roll a D6 for the squad. 1: Scout — make the normal pre-game Scout move and gain Outflank. 2: Furious Charge — +1 Strength and +1 Initiative in assault on the turn the unit charges. 3: Fleet — may charge even if it Advanced. 4: close-combat attacks gain Rending — a To Wound roll of 6 is AP2; against vehicles an Armour Penetration roll of 6 adds D3. 5: Feel No Pain (5+) — after an eligible failed saving throw, ignore the Wound on a 5+. 6: Counter-Attack — when charged while unengaged, pass a Leadership test to gain +1 Attack for that Assault phase.</description></rule><rule id="r38-wb-shared-accursed-crozius" name="Accursed Crozius" hidden="false"><description>User Strength Power Weapon. The bearer receives a 4+ Invulnerable Save, counts as a Personal Icon/Summoning Point for Daemonic Covenant, and counts as a Dark Apostle for The Dark Shepherds. A model may never possess more than one Accursed Crozius.</description></rule><rule id="r38-wb-shared-tainted-weapon" name="Tainted Weapon" hidden="false"><description>Selected instead of a Power Weapon at the same points cost. User Strength, Specialist Weapon. Any unsaved Wound inflicted becomes a Massive Wound and inflicts D3 Wounds instead of 1. It is not a Power Weapon and does not ignore Armour Saves.</description></rule><rule id="r38-wb-shared-burning-lore" name="Burning Lore" hidden="false"><description>A Word Bearers Praetor, Centurion, Chaplain or Diabolist that is not already a Psyker may purchase Burning Lore. The model becomes a Psyker with Mastery Level 1 and selects exactly one power from Biomancy or Telepathy.</description></rule><rule id="r38-wb-shared-hex-bolts" name="Hex-Bolts" hidden="false"><description>Bolt Pistols, Bolters, Combi-Bolters, Storm Bolters and the bolter component of Combi-Weapons carried by the upgraded unit gain Soul Blaze. Soul Blaze: at the end of each turn, a unit wounded by such an attack suffers D3 Strength 4 AP5 hits with no Cover Saves on a 4+; otherwise the blaze ends. Hex-Bolts cannot be combined with Special Issue Ammunition or another ammunition upgrade.</description></rule><rule id="r38-wb-shared-icon-of-chaos-undivided" name="Icon of Chaos Undivided" hidden="false"><description>The bearer is a Summoning Point. Friendly non-Daemon Word Bearers units with at least one model within 6" automatically pass Morale and Pinning tests and may not voluntarily fail a break test while within the aura.</description></rule><rule id="r38-wb-shared-dark-channelling" name="Dark Channelling" hidden="false"><description>Requires a Diabolist in the Detachment. After deployment but before the first turn, roll D6 for each upgraded squad. 1–3: Zealot — the unit automatically passes Morale/Pinning, may not voluntarily fail a break test, and in the first round of a melee may re-roll failed To Hit rolls against enemies it was not engaged with in the prior turn. 4–5: models gain +1 Strength. 6: the unit gains Daemon — a 5+ Invulnerable Save and Fear — ceases to be Scoring, and in VP missions counts as destroyed at battle end even if it survives. Effects apply only to the upgraded squad.</description></rule><rule id="r38-wb-shared-diabolist" name="Diabolist" hidden="false"><description>Gains Daemon and Preferred Enemy (Loyalists). May not select a Bike, Jetbike, Terminator Armour, Power Fist or Thunder Hammer. Enables eligible squads to purchase Dark Channelling. A Diabolist remains a Centurion for Accursed Crozius access and counts as a Dark Apostle if it purchases one.</description></rule><rule id="r40-sal-promethean-cult" name="Promethean Cult" hidden="false"><description>Salamanders models may re-roll To Hit rolls of 1 with Thunder Hammers, Melta Bombs, Meltaguns, Multi-Meltas and other weapons with the Melta special rule. They may re-roll To Wound rolls of 1 when firing Flame weapons.</description></rule><rule id="r40-sal-sturdy" name="Sturdy" hidden="false"><description>All Salamanders models with an Initiative characteristic, except Dreadnoughts, suffer -1 Initiative after all other modifiers. Salamanders units also subtract 1" from Fall Back distance, to a minimum of 1". The Initiative penalty applies normally during Pursuit.</description></rule><rule id="r40-sal-never-give-up" name="Never Give Up" hidden="false"><description>At the end of the final scheduled game turn, the Salamanders player may choose to play one additional complete game turn. Both players take one additional turn, then the battle ends automatically. This may be used only once and cannot extend a mission already ended by a specific objective/action.</description></rule><rule id="r40-sal-salamanders-mantle" name="Salamanders Mantle" hidden="false"><description>If an unsaved Wound would become a Massive Wound solely because attack Strength is at least double the bearer's Toughness, it instead inflicts only one Wound. It provides no protection against weapons or rules that explicitly inflict Massive Wounds by another method. Only one Salamanders Mantle may be included in the army.</description></rule><rule id="r40-sal-inferno-pistol" name="Inferno Pistol" hidden="false"><description>Range 6", Strength 8, AP1, Pistol, Melta.</description></rule><rule id="r40-sal-fire-based-warfare" name="Fire-based Warfare" hidden="false"><description>Flamers used by Salamanders are Strength 5 AP5 Assault 1 Flame weapons. Heavy Flamers used by Salamanders are Strength 6 AP4 Assault 1 Flame weapons. Where a Legion Tactical or Veteran Squad may purchase a Flamer, it may instead purchase a Heavy Flamer for +10 points. Legion Heavy Support Squads may select Heavy Flamers as a Heavy Weapon option for +10 points per model.</description></rule><rule id="r40-sal-proscribed-munitions" name="Proscribed Munitions" hidden="false"><description>A Salamanders Detachment may not select Phosphex weapons or Phosphex ammunition unless a specific Salamanders unit or Character entry explicitly states otherwise.</description></rule><rule id="r40-sal-dragonscale-storm-shield" name="Dragonscale Storm Shield" hidden="false"><description>The bearer has a 4+ Invulnerable Save in close combat and against shooting attacks made with Flame or Melta weapons. Against all other shooting attacks, it provides a 5+ Invulnerable Save.</description></rule><rule id="r40-sal-firedrake-retinue" name="Firedrake Retinue" hidden="false"><description>A Firedrake Terminator Squad may be selected as the retinue of a Salamanders Praetor wearing Terminator Armour, Artellus Numeon, Vulkan, or another Character specifically permitted to take it. It occupies no separate Elites selection.</description></rule><rule id="r40-sal-pyroclast-flame-projector" name="Pyroclast Flame Projector" hidden="false"><description>Each time this weapon fires, choose either Salamanders Heavy Flamer mode or Meltagun mode. It counts as the chosen weapon for Promethean Cult and Fire-based Warfare.</description></rule><rule id="r40-sal-dual-pistols" name="Dual Pistols" hidden="false"><description>A model with this rule may fire both of its Pistol weapons in the Shooting phase at the same target. If it does so, it may not fire another weapon that phase.</description></rule><rule id="r40-sal-destroyer-cadre" name="Destroyer Cadre" hidden="false"><description>An Infernus Destroyer Squad may only be joined by a Legion Moritat or another Character specifically stated to be permitted to join Destroyer units.</description></rule><rule id="r40-sal-guided-by-prophecy" name="Guided by Prophecy" hidden="false"><description>At the beginning of an Assault phase, the squad may take a Leadership test using Leadership 7 regardless of the Leadership of models in the unit. If passed, until the end of the phase the squad has Weapon Skill 5 and Feel No Pain (6+). If failed, there is no effect.</description></rule><rule id="r40-sal-close-quarters-arsenal" name="Close-Quarters Arsenal" hidden="false"><description>A Sanctifier equipped with two Pistol weapons has Dual Pistols. Both Pistols must fire at the same target.</description></rule><rule id="r40-sal-battlesmith" name="Battlesmith" hidden="false"><description>During the Shooting phase, instead of firing, the model may attempt to repair one eligible friendly model in base contact. Roll D6; on 5+ repair one Engine Damaged, Weapon Destroyed or Immobilised result from a Vehicle, or restore one lost Wound to an eligible non-Vehicle model. Only one attempt per turn; a model may benefit from only one successful repair per turn. Battlesmith cannot return destroyed models. Equipment modifiers to the roll apply unless stated otherwise.</description></rule><rule id="r40-sal-reinforced-ceramite" name="Reinforced Ceramite" hidden="false"><description>Uses the normal Armoured Ceramite rules: Melta weapons do not receive their additional Armour Penetration die against this vehicle, regardless of range.</description></rule><rule id="r40-standard-support-squad" name="Support Squad" hidden="false"><description>May be selected as Troops but may not fulfil either compulsory Troops selection unless a Legion rule or Rite removes the restriction.</description></rule><rule id="r43-rg-surgical-strike" name="Surgical Strike" hidden="false"><description>Whenever a Raven Guard unit deploys using Deep Strike, the Raven Guard player may re-roll the Scatter die and all dice rolled for scatter distance. The entire result must be re-rolled and the second result accepted.</description></rule><rule id="r43-rg-rapid-reaction" name="Rapid Reaction" hidden="false"><description>At the beginning of each Raven Guard turn, if at least one friendly Legion Reconnaissance Squad or Mor Deythan Squad has a surviving model on the battlefield and is not Falling Back, add +1 to all Raven Guard Reserve rolls that turn. This bonus is not cumulative.</description></rule><rule id="r43-rg-shadow-masters" name="Shadow Masters" hidden="false"><description>Raven Guard Legion Reconnaissance Squads lose Support Squad and may fulfil compulsory Troops selections normally. Raven Guard Legion Reconnaissance Squads and Independent Characters purchase Sniper Rifles for 2 points instead of 5 points or another normally applicable price.</description></rule><rule id="r43-rg-limited-vehicles" name="Limited Vehicles" hidden="false"><description>A Raven Guard Detachment may never include more Heavy Support selections than Fast Attack selections. Dedicated Transports are ignored.</description></rule><rule id="r43-rg-raven-s-talons" name="Raven's Talons" hidden="false"><description>A pair of Raven's Talons counts as a pair of Rending Weapons. The bearer receives the normal +1 Attack bonus for fighting with two close-combat weapons.</description></rule><rule id="r43-rg-infravisor" name="Infravisor" hidden="false"><description>The bearer gains Night Vision and +1 Ballistic Skill, to a maximum of BS6. When taking an Initiative test caused by Blind, the bearer and any unit joined by the bearer count as Initiative 1.</description></rule><rule id="r43-rg-shroud-bombs" name="Shroud Bombs" hidden="false"><description>Shroud Bombs count as Defensive Grenades. An enemy unit attempting to charge the equipped unit must first pass a Leadership test. If it fails, it may not attempt that charge and may not declare another charge that turn. Vehicles, Daemons and units containing a model with Night Vision are unaffected.</description></rule><rule id="r43-rg-cameleoline" name="Cameleoline" hidden="false"><description>The bearer gains the Stealth special rule.</description></rule><rule id="r43-rg-teleportation-transponders" name="Teleportation Transponders" hidden="false"><description>The equipped model or unit gains Deep Strike and may deploy using Deep Strike even if the mission would not normally permit it. An Independent Character intending to Deep Strike with another unit must purchase Transponders separately.</description></rule><rule id="r43-rg-fatal-strike" name="Fatal Strike" hidden="false"><description>Once per battle, at the beginning of a Raven Guard Shooting phase, nominate one enemy unit within 18 inches and line of sight of the Mor Deythan Squad. Until the end of that Shooting phase, models in the squad re-roll To Hit rolls of 1 and To Wound rolls of 1 against it; against Vehicles, re-roll Armour Penetration rolls of 1 instead.</description></rule><rule id="r43-rg-swooping-killers" name="Swooping Killers" hidden="false"><description>During an Assault phase in which the Dark Furies charge, models in the squad may re-roll To Hit rolls of 1 until the end of that Assault phase.</description></rule><rule id="r43-rg-terran-veterans" name="Terran Veterans" hidden="false"><description>Deliverers do not benefit from Infiltrate if it is granted by another Raven Guard rule or Rite of War. They may always deploy using Teleportation Transponders if purchased normally.</description></rule><rule id="r43-rg-unstable-creation" name="Unstable Creation" hidden="false"><description>Raptors may never fulfil compulsory Troops selections and may not be joined by an Independent Character other than Corvus Corax or Branne Nev.</description></rule><rule id="r43-rg-the-raven-s-due" name="The Raven's Due" hidden="false"><description>At the beginning of the battle, nominate one enemy Independent Character or unit-upgrade Character. Kaedes Nex may re-roll failed To Hit rolls against that model in close combat and when shooting his Fulcrum Hand Cannons at a unit containing it. Unsaved Wounds caused by Nex's shooting may be allocated to the nominated model first if it is within range and line of sight.</description></rule><rule id="r43-rg-executioner-s-instinct" name="Executioner's Instinct" hidden="false"><description>If Kaedes Nex causes one or more unsaved Wounds upon his nominated target, that model's unit must immediately take a Pinning test.</description></rule><rule id="r43-rg-master-of-descent" name="Master of Descent" hidden="false"><description>If Alvarex Maun begins the battle in Reserve embarked aboard a Drop Pod, Dreadclaw or Flyer Transport, Maun and that Transport arrive automatically during the first Raven Guard turn. No Reserve roll is required.</description></rule><rule id="r43-rg-commander-of-the-talons" name="Commander of the Talons" hidden="false"><description>An army containing Agapito Nev may include up to two Dark Fury Assault Squads rather than the normal 0–1. Agapito's squad may re-roll failed Morale tests caused by shooting casualties.</description></rule><rule id="r43-rg-first-into-the-fray" name="First Into the Fray" hidden="false"><description>During an Assault phase in which Agapito and his squad charge, that squad may re-roll all failed To Hit rolls during the first round of that close combat.</description></rule><rule id="r43-rg-commander-of-the-survivors" name="Commander of the Survivors" hidden="false"><description>If the army includes Branne Nev, one Raptor Squad may be selected without occupying an Elites choice. It still counts as Elites for all other purposes and may not fulfil a compulsory selection. Branne may join a Raptor Squad despite Unstable Creation.</description></rule><rule id="r43-rg-hold-fast" name="Hold Fast" hidden="false"><description>Branne Nev and any Raven Guard unit he has joined may re-roll failed Morale and Pinning tests.</description></rule><rule id="r43-rg-ghost-in-the-dark" name="Ghost in the Dark" hidden="false"><description>While Sharrowkyn's unit is in cover, improve its Cover Save by 1, to a maximum of 3+.</description></rule><rule id="r43-rg-perfect-ambusher" name="Perfect Ambusher" hidden="false"><description>When Sharrowkyn shoots at an enemy unit within 12 inches, he may re-roll failed To Hit rolls.</description></rule><rule id="r43-rg-the-shadowed-lord" name="The Shadowed Lord" hidden="false"><description>Corvus Corax has Stealth and Hit &amp; Run. If the Avenging Shadow variant is selected, Stealth is replaced by Shrouded; Hit &amp; Run is retained.</description></rule><rule id="r43-rg-sire-of-the-raven-guard" name="Sire of the Raven Guard" hidden="false"><description>Friendly Raven Guard Infantry units with at least one model within 12 inches of Corvus Corax improve any Cover Save they receive by 1, to a maximum of 3+.</description></rule><rule id="r43-rg-secret-deployment" name="Secret Deployment" hidden="false"><description>Instead of deploying normally, secretly record one terrain feature outside the enemy deployment zone and hold Corax off the battlefield. From the second Raven Guard turn onwards, at the beginning of a Movement phase, reveal it and place Corax wholly within or in contact with it and more than 6 inches from enemy models. Corax may Move, Shoot and charge normally that turn. No Reserve roll is required. If he cannot be placed legally, he may try again later. A Primarch Retinue deploys normally and does not accompany him.</description></rule><rule id="r45-al-mutable-tactics" name="Mutable Tactics" hidden="false"><description>An Alpha Legion army must select exactly one Mutable Tactic: Counter-Attack, Furious Charge, Infiltrate, Move Through Cover, Siege Specialists or Tank Hunters. The selected Veteran Skill applies for the battle to all qualifying non-Vehicle units in the Detachment with Legiones Astartes (Alpha Legion). It does not count towards a unit's normal Veteran Skill allowance and all normal restrictions of the selected skill continue to apply.</description></rule><rule id="r45-al-siege-specialists" name="Siege Specialists" hidden="false"><description>Add +1 to Armour Penetration rolls made against Fortifications, Buildings, Bunkers and other immobile structures with an Armour Value.</description></rule><rule id="r45-al-martial-hubris" name="Martial Hubris" hidden="false"><description>In a mission using Victory Points, compare completely destroyed units at the end of the battle. If more Alpha Legion units have been completely destroyed than enemy units, the opponent receives an additional D3 × 50 Victory Points. If both players lost the same number of units, this rule has no effect.</description></rule><rule id="r45-al-infiltration-network" name="Infiltration Network" hidden="false"><description>Legion Operatives may be selected as Troops. Up to two additional Legion Operative units may be selected without occupying a Troops selection; they are still paid for normally and count as units for Martial Hubris.</description></rule><rule id="r45-al-banestrike" name="Banestrike" hidden="false"><description>A natural To Wound roll of 6 made with Banestrike Ammunition is resolved at AP3.</description></rule><rule id="r45-al-power-dagger" name="Power Dagger" hidden="false"><description>Counts as a Power Weapon with Rending and Specialist Weapon. Attacks are resolved at -1 Strength.</description></rule><rule id="r45-al-venom-spheres" name="Venom Spheres" hidden="false"><description>The bearer gains Hammer of Wrath.</description></rule><rule id="r45-al-pre-emptive-strike" name="Pre-emptive Strike" hidden="false"><description>After both armies have deployed but before the first turn begins, nominate one enemy unit. A non-Vehicle unit suffers D6 Strength 4 hits; Armour Saves are allowed, and if at least one casualty is caused it immediately takes a Pinning test at -1 Leadership. Against a Vehicle, roll D6: 1–3 no effect, 4–5 one Glancing Hit, 6 one Penetrating Hit. No range or line of sight is required.</description></rule><rule id="r45-al-teleportation-transponders" name="Teleportation Transponders" hidden="false"><description>The equipped model or unit gains Deep Strike and may deploy by Deep Strike even if the mission would not normally permit it. An Independent Character intending to Deep Strike with another unit must purchase Transponders separately.</description></rule><rule id="r45-al-operative-cell" name="Operative Cell" hidden="false"><description>Before deployment, choose exactly one Operative Cell skill set: Scouts (Infiltrate and Move Through Cover), Assassins (Infiltrate and Furious Charge), or Saboteurs (Infiltrate and Siege Specialists).</description></rule><rule id="r45-al-human-agents" name="Human Agents" hidden="false"><description>Legion Operatives do not possess Legiones Astartes and do not benefit from Mutable Tactics or other rules which specifically affect Alpha Legion Space Marines.</description></rule><rule id="r45-al-all-as-planned" name="All as Planned" hidden="false"><description>After both armies have deployed but before the first turn begins, this Headhunter Kill Team may make one Pre-emptive Strike.</description></rule><rule id="r45-al-hydra-s-wail" name="Hydra's Wail" hidden="false"><description>Enemy units with at least one model within 12 inches of an Effrit Disruption Cadre suffer -1 Leadership on Pinning tests. Enemy Nuncio Voxes and Teleport Homers may not be used while their bearer is within 12 inches of an Effrit model.</description></rule><rule id="r45-al-the-harrowing" name="The Harrowing" hidden="false"><description>Armillus Dynat and any unit he has joined gain Counter-Attack. Models in that unit add +1 to Armour Penetration rolls made against Vehicles in close combat.</description></rule><rule id="r45-al-weapon-mastery" name="Weapon Mastery" hidden="false"><description>Armillus Dynat may divide his close-combat attacks between his Power Weapon and Thunder Hammer in any combination, including bonus Attacks.</description></rule><rule id="r45-al-lone-killer" name="Lone Killer" hidden="false"><description>Exodus may never join another unit and no Independent Character may join him. He may not fulfil a compulsory HQ selection and may never be the army's Warlord.</description></rule><rule id="r45-al-deadshot" name="Deadshot" hidden="false"><description>Before battle, nominate one enemy Independent Character or unit-upgrade Character. When Exodus fires at a unit containing that model, successful Wounds caused by Exodus may be allocated to the nominated model first if it is in range and line of sight. All Attacks are made at AP2.</description></rule><rule id="r45-al-execute-the-mandate" name="Execute the Mandate" hidden="false"><description>If the enemy Warlord is slain by an attack made by Exodus, the Alpha Legion player receives an additional 50 Victory Points.</description></rule><rule id="r45-al-delegatus" name="Delegatus" hidden="false"><description>Autilon Skorr counts as a Legion Delegatus Consul for all rules and restrictions.</description></rule><rule id="r45-al-desperate-for-glory" name="Desperate for Glory" hidden="false"><description>Once per battle, at the beginning of an Alpha Legion turn, Autilon Skorr may invoke this rule. Until the beginning of the next Alpha Legion turn, Skorr and any unit he has joined gain Fearless and Feel No Pain (5+).</description></rule><rule id="r45-al-master-of-deceit" name="Master of Deceit" hidden="false"><description>An army containing Ingo Pech may use The Rewards of Treachery rule from The Coils of the Hydra even if it is not using that Rite. If the army is already using The Coils, Pech does not permit a second Rewards unit.</description></rule><rule id="r45-al-false-disposition" name="False Disposition" hidden="false"><description>After both armies have deployed but before determining the first player, nominate Mathias Herzog and one other friendly non-Vehicle Alpha Legion unit. Both may immediately redeploy wholly within the Alpha Legion deployment zone. Units in Reserve or using Infiltrate are not eligible.</description></rule><rule id="r45-al-headhunter-commander" name="Headhunter Commander" hidden="false"><description>One Headhunter Kill Team may be selected without occupying an Elites choice in an army containing Mathias Herzog. It remains an Elites unit for all other purposes.</description></rule><rule id="r45-al-hydra-s-resilience" name="Hydra's Resilience" hidden="false"><description>While Sheed Ranko remains alive, his Lernaean Terminator Squad has Stubborn.</description></rule><rule id="r45-al-master-of-lies" name="Master of Lies" hidden="false"><description>After both armies have deployed but before the first turn begins, nominate one friendly Alpha Legion unit. It may redeploy anywhere it could legally have deployed at the beginning of battle, obeying normal deployment restrictions. It may not be placed into Reserve unless already eligible to begin in Reserve.</description></rule><rule id="r45-al-the-hydra" name="The Hydra" hidden="false"><description>Before either army deploys, secretly record one enemy unit as the Priority Target. Reveal it the first time an Alpha Legion unit attacks it. Once revealed, friendly units with Legiones Astartes (Alpha Legion) re-roll To Hit rolls of 1 against that target in shooting and close combat.</description></rule><rule id="r45-al-sire-of-the-alpha-legion" name="Sire of the Alpha Legion" hidden="false"><description>Friendly units with Legiones Astartes (Alpha Legion) with at least one model within 12 inches of Alpharius may use his Leadership for Morale and Pinning tests.</description></rule><rule id="r45-al-i-am-alpharius" name="I Am Alpharius" hidden="false"><description>Alpharius is not deployed normally and does not begin in Reserve. At the beginning of any Alpha Legion turn, replace one friendly Infantry model on the battlefield with Legiones Astartes (Alpha Legion) with Alpharius, as close as possible to its previous position. The replaced model is a casualty. Alpharius enters at full Wounds, joins the unit if applicable, remains in the same close combat if applicable, and may Move, Shoot and charge normally that turn. No Reserve roll is required. If unrevealed when the battle ends, he counts as slain for relevant Victory Point purposes.</description></rule><rule id="r64-ts-psyker-ml1" name="Psyker (Mastery Level 1)" hidden="false"><description>A Thousand Sons Centurion and its Consul variants are Psykers (Mastery Level 1) unless another rule grants a higher Mastery Level. The model selects powers only from the Psychic Discipline associated with its chosen Prosperine Cult. A Librarian Consul follows its normal Librarian Mastery Level rules.</description></rule><rule id="r64-ts-psyker-ml2" name="Psyker (Mastery Level 2)" hidden="false"><description>A Thousand Sons Praetor is a Psyker (Mastery Level 2). It selects its psychic powers only from the Psychic Discipline associated with its chosen Prosperine Cult. If upgraded to Mastery Level 3 by an applicable Rite of War, it instead knows and may select three powers from that same Cult-correlated Discipline.</description></rule></sharedRules><sharedProfiles><profile id="r37-wb-prof-axe-rake" name="Axe-rake" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">+1</characteristic><characteristic name="AP" typeId="weapon-ap">—</characteristic><characteristic name="Type" typeId="weapon-type">Melee</characteristic></characteristics></profile><profile id="r37-wb-prof-custodian-spear" name="Custodian Spear" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">+1</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, Two-Handed, Master-crafted</characteristic></characteristics></profile><profile id="r37-wb-prof-custodian-gun" name="Custodian Spear — Foeblaster Boltgun" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">18"</characteristic><characteristic name="S" typeId="weapon-s">5</characteristic><characteristic name="AP" typeId="weapon-ap">4</characteristic><characteristic name="Type" typeId="weapon-type">Rapid Fire, Twin-linked</characteristic></characteristics></profile><profile id="r37-wb-prof-illuminarum" name="Illuminarum" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">+2</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, Master-crafted, Concussive</characteristic></characteristics></profile><profile id="r37-wb-prof-crozius" name="Accursed Crozius" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">User</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee</characteristic></characteristics></profile><profile id="r37-wb-prof-anathame" name="Anathame Dagger" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">User</characteristic><characteristic name="AP" typeId="weapon-ap">—</characteristic><characteristic name="Type" typeId="weapon-type">Melee, special attack</characteristic></characteristics></profile><profile id="r40-sal-prof-flamer" name="Salamanders Flamer" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">Template</characteristic><characteristic name="S" typeId="weapon-s">5</characteristic><characteristic name="AP" typeId="weapon-ap">5</characteristic><characteristic name="Type" typeId="weapon-type">Assault 1, Flame</characteristic></characteristics></profile><profile id="r40-sal-prof-heavy-flamer" name="Salamanders Heavy Flamer" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">Template</characteristic><characteristic name="S" typeId="weapon-s">6</characteristic><characteristic name="AP" typeId="weapon-ap">4</characteristic><characteristic name="Type" typeId="weapon-type">Assault 1, Flame</characteristic></characteristics></profile><profile id="r40-sal-prof-inferno" name="Inferno Pistol" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">6"</characteristic><characteristic name="S" typeId="weapon-s">8</characteristic><characteristic name="AP" typeId="weapon-ap">1</characteristic><characteristic name="Type" typeId="weapon-type">Pistol, Melta</characteristic></characteristics></profile><profile id="r40-sal-prof-pyro-flame" name="Pyroclast Flame Projector — Flame" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">Template</characteristic><characteristic name="S" typeId="weapon-s">6</characteristic><characteristic name="AP" typeId="weapon-ap">4</characteristic><characteristic name="Type" typeId="weapon-type">Assault 1, Flame</characteristic></characteristics></profile><profile id="r40-sal-prof-pyro-melta" name="Pyroclast Flame Projector — Melta" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">12"</characteristic><characteristic name="S" typeId="weapon-s">8</characteristic><characteristic name="AP" typeId="weapon-ap">1</characteristic><characteristic name="Type" typeId="weapon-type">Assault 1, Melta</characteristic></characteristics></profile><profile id="r40-sal-prof-fury" name="Fury of the Salamander" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">18"</characteristic><characteristic name="S" typeId="weapon-s">5</characteristic><characteristic name="AP" typeId="weapon-ap">1</characteristic><characteristic name="Type" typeId="weapon-type">Witchfire — Beam, Assault 1, Elemental Horror</characteristic></characteristics></profile><profile id="r40-sal-prof-ignatus" name="Ignatus" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">+1 on charge</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, Master-crafted</characteristic></characteristics></profile><profile id="r40-sal-prof-darkstar" name="Darkstar Falling" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">+2</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, Two-Handed, Master-crafted, Concussive, Armourbane vs Vehicles</characteristic></characteristics></profile><profile id="r40-sal-prof-dreadfire" name="Dreadfire Cannon" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">Template</characteristic><characteristic name="S" typeId="weapon-s">6</characteristic><characteristic name="AP" typeId="weapon-ap">4</characteristic><characteristic name="Type" typeId="weapon-type">Assault 1, Flame, Twin-linked</characteristic></characteristics></profile><profile id="r40-sal-prof-dawnbringer" name="Dawnbringer" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">10</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, Two-Handed, Master-crafted, Armourbane, Concussive</characteristic></characteristics></profile><profile id="r40-sal-prof-furnace" name="Furnace's Heart" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">18"</characteristic><characteristic name="S" typeId="weapon-s">6</characteristic><characteristic name="AP" typeId="weapon-ap">2</characteristic><characteristic name="Type" typeId="weapon-type">Assault 1, Rending, Master-crafted</characteristic></characteristics></profile><profile id="r40-sal-prof-gauntlet" name="Gauntlet of the Forge" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">Template</characteristic><characteristic name="S" typeId="weapon-s">6</characteristic><characteristic name="AP" typeId="weapon-ap">4</characteristic><characteristic name="Type" typeId="weapon-type">Assault 1, Flame, Master-crafted</characteristic></characteristics></profile><profile id="r43-rg-prof-fulcrum" name="Fulcrum Hand Cannon" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">18"</characteristic><characteristic name="S" typeId="weapon-s">4</characteristic><characteristic name="AP" typeId="weapon-ap">4</characteristic><characteristic name="Type" typeId="weapon-type">Pistol, Rending, Concussive</characteristic></characteristics></profile><profile id="r43-rg-prof-wrath" name="Wrath &amp; Justice" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">12"</characteristic><characteristic name="S" typeId="weapon-s">6</characteristic><characteristic name="AP" typeId="weapon-ap">4</characteristic><characteristic name="Type" typeId="weapon-type">Assault 2, Rending, Master-crafted</characteristic></characteristics></profile><profile id="r43-rg-prof-corvidine" name="Corvidine Talons" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">+1</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, paired, Shred, Rending</characteristic></characteristics></profile><profile id="r43-rg-prof-tolaedus" name="Tolaedus" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">User</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, Master-crafted</characteristic></characteristics></profile><profile id="r43-rg-prof-sudden" name="Sudden Blade" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">User</characteristic><characteristic name="AP" typeId="weapon-ap">Rending Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, Master-crafted, Rending</characteristic></characteristics></profile><profile id="r45-al-prof-banestrike" name="Banestrike Bolter" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">18"</characteristic><characteristic name="S" typeId="weapon-s">4</characteristic><characteristic name="AP" typeId="weapon-ap">4</characteristic><characteristic name="Type" typeId="weapon-type">Rapid Fire, Banestrike</characteristic></characteristics></profile><profile id="r45-al-prof-power-dagger" name="Power Dagger" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">User -1</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, Rending, Specialist Weapon</characteristic></characteristics></profile><profile id="r45-al-prof-rime-shard" name="Rime-shard" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">User +2</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, Two-Handed, Master-crafted</characteristic></characteristics></profile><profile id="r45-al-prof-pale-spear" name="Pale Spear" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">—</characteristic><characteristic name="S" typeId="weapon-s">User</characteristic><characteristic name="AP" typeId="weapon-ap">Power Weapon</characteristic><characteristic name="Type" typeId="weapon-type">Melee, Two-Handed, Armourbane, Massive Wound (D3) vs non-Primarchs</characteristic></characteristics></profile><profile id="r45-al-prof-hydras-spite" name="Hydra's Spite" typeId="prof-weapon" hidden="false"><characteristics><characteristic name="Range" typeId="weapon-range">18"</characteristic><characteristic name="S" typeId="weapon-s">7</characteristic><characteristic name="AP" typeId="weapon-ap">2</characteristic><characteristic name="Type" typeId="weapon-type">Assault 2, Gets Hot</characteristic></characteristics></profile></sharedProfiles></catalogue>