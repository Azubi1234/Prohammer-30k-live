      <rules>
        <rule id="r46-al-reward-11-donor-r63-sw-scout-comp" name="Unit Composition" hidden="false">
          <description>4 Wolf Scouts and 1 Wolf Scout Huscarl; may include up to 5 additional Wolf Scouts (maximum 10 models). The Huscarl is a Character.</description>
        </rule>
        <rule id="r46-al-reward-11-donor-r63-sw-scout-wg" name="Wargear" hidden="false">
          <description>Scout Armour, Bolt pistol and Close-combat weapon.</description>
        </rule>
        <rule id="r46-al-reward-11-donor-r63-sw-scout-special" name="Special Rules" hidden="false">
          <description>Legiones Astartes (Space Wolves), Infiltrate, Move Through Cover, Behind Enemy Lines.</description>
        </rule>
        <rule id="r46-al-reward-11-donor-r63-sw-scout-bel" name="Behind Enemy Lines" hidden="false">
          <description>The squad may be placed in Reserve. When it arrives, determine the table edge using the rule in the army list. It may shoot in the turn it arrives but may not charge that turn.</description>
        </rule>
      </rules>
