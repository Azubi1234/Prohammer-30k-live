      <profiles>
        <profile name="Caestus Assault Ram" id="r32-aero-caestus-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <characteristics>
            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
            <characteristic name="Front" typeId="vehicle-front">13</characteristic>
            <characteristic name="Side" typeId="vehicle-side">13</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">11</characteristic>
          </characteristics>
        </profile>
        <profile name="Magna-Melta" id="r32-aero-caestus-weapon-magna-melta-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">18"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1, Large Blast, Melta</characteristic>
          </characteristics>
        </profile>
        <profile name="Havoc Launcher" id="r32-aero-caestus-weapon-havoc-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">5</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Twin-linked</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-aero-caestus-type" hidden="false">
          <description>Vehicle (Flyer, Hover, Transport)</description>
        </rule>
        <rule name="Wargear" id="r32-aero-caestus-wargear" hidden="false">
          <description>Twin-linked Magna-Melta; Two Havoc Launchers; Armoured Ceramite; Extra Armour.</description>
        </rule>
        <rule name="Caestus Ram" id="r32-aero-caestus-ram" hidden="false">
          <description>May declare a Ram against an enemy vehicle despite lacking the Tank type. The Ram inflicts S10; roll two dice for Armour Penetration and use the higher, and add +1 to the Vehicle Damage roll. The Caestus has a 5+ Invulnerable Save against Glancing or Penetrating Hits striking its Front Armour, including from Ramming.</description>
        </rule>
        <rule name="Misericord" id="r32-aero-caestus-misericord" hidden="false">
          <description>May only transport models wearing Power Armour, Artificer Armour or Terminator Armour. Terminators count as one model each.</description>
        </rule>
        <rule name="Transport Capacity" id="r32-aero-caestus-cap" hidden="false">
          <description>10 models.</description>
        </rule>
        <rule name="Access Points" id="r32-aero-caestus-access" hidden="false">
          <description>Two front access points.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Frag Assault Launchers" hidden="false" id="r32-aero-caestus-frag">
          <constraints>
            <constraint id="r32-aero-caestus-frag-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="10" />
          </costs>
          <rules>
            <rule name="Frag Assault Launchers" id="r32-aero-caestus-frag-rule" hidden="false">
              <description>A unit that charges in the same turn it disembarks from a Caestus with Frag Assault Launchers counts as equipped with Frag Grenades for that Assault phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <entryLink id="r32-aero-caestus-aux" name="Auxiliary Drive" targetId="r41-universal-gear-9513f2d8de2ed1" type="selectionEntry" import="true" hidden="false"><constraints>
