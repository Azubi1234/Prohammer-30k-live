            </selectionEntry>
            <entryLink id="rhino-hk" name="Hunter-Killer Missile" targetId="gear-hk" type="selectionEntry" import="true" hidden="false"><constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-hk-max" includeChildSelections="false" />
              </constraints>
              <costs>
