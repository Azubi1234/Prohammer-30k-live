      <selectionEntries>
        <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hs-spartan-hunter-killer-missile" hidden="false" import="true">
          <constraints>
            <constraint id="hs-spartan-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
          <rules>
            <rule name="Hunter-Killer Missile" id="hs-spartan-hunter-killer-missile-rule" hidden="false">
              <description>Unlimited range, S8 AP3, Heavy 1, One Use.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" name="Dozer Blade" id="hs-spartan-dozer-blade" hidden="false" import="true">
          <constraints>
            <constraint id="hs-spartan-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
          <rules>
            <rule name="Dozer Blade" id="hs-spartan-dozer-blade-rule" hidden="false">
              <description>Use the normal ProHammer Dozer Blade rule.</description>
            </rule>
          </rules>
