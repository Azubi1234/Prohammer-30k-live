      <constraints>
        <constraint id="r79-ih-castrmen-orth-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <categoryLinks>
        <categoryLink id="r79-ih-castrmen-orth-hq" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier id="r79-ih-castrmen-orth-show" type="set" value="false" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      <modifier id="r79-ih-castrmen-orth-show-r62-shat-53cb3781cf71" type="set" value="false" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-620313fde93a" shared="true" includeChildSelections="true" includeChildForces="false" />
          <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
