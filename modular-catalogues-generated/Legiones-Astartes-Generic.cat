                  </costs>
                  <rules>
                    <rule name="Master-crafted Weapon" id="r57-iw-golg-term-troops-terminator-sgt-mastercraft-rule" hidden="false">
                      <description>Apply to one specific weapon; re-roll one failed To Hit roll with that weapon per player turn. Grenades and expendable equipment may not be Master-crafted.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="r57-iw-golg-term-troops-terminator-sgt-signum">
