      <selectionEntries>
        <selectionEntry type="upgrade" name="Twin-linked Volkite Caliver (replaces one Heavy Flamer)" id="hs-lev-vcal" hidden="false" import="true">
          <constraints>
            <constraint id="hs-lev-vcal-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
          <profiles>
            <profile name="Twin-linked Volkite Caliver" id="hs-lev-vcal-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
              <characteristics>
                <characteristic name="Range" typeId="ranged-range">30"</characteristic>
                <characteristic name="S" typeId="ranged-s">6</characteristic>
                <characteristic name="AP" typeId="ranged-ap">5</characteristic>
                <characteristic name="Type" typeId="ranged-type">Heavy 2, Rending, Twin-linked</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <entryLink id="hs-lev-ceramite" name="Armoured Ceramite" targetId="r41-universal-gear-e7ea745a2d0324" type="selectionEntry" import="true" hidden="false"><modifiers><modifier id="hs-lev-ceramite-r42-sal-hide" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xviii" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="hs-lev-ceramite-r42-sal-hide-r62-shat-4667c2ab0a1d" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-3255684d4755" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints>
            <constraint id="hs-lev-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
