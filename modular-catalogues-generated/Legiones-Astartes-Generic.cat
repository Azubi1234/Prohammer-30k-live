eld="pts" value="4"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="terminator-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="terminator-unit-r32-blessing-slaanesh-rule" name="Blessing of Slaanesh" hidden="false"><description>All models gain +1 Initiative.</description></rule></rules></selectionEntry><selectionEntry id="terminator-unit-r32-blessing-nurgle" name="Blessing of Nurgle" type="upgrade" hidden="false" import="true"><constraints><constraint id="terminator-unit-r32-blessing-nurgle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="7" /></costs><modifiers><modifier id="terminator-unit-r32-blessing-nurgle-scale" type="increment" field="pts" value="7"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="terminator-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="terminator-unit-r32-blessing-nurgle-rule" name="Blessing of Nurgle" hidden="false"><description>All models gain +1 Toughness and Slow and Purposeful. Not available to Bikes, Jetbikes or Jump Infantry.

Slow and Purposeful: Relentless and always moves as if in Difficult Terrain.</description></rule></rules></selectionEntry><selectionEntry id="terminator-unit-r32-blessing-tzeentch" name="Blessing of Tzeentch" type="upgrade" hidden="false" import="true"><constraints><constraint id="terminator-unit-r32-blessing-tzeentch-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="8" /></costs><modifiers><modifier id="terminator-unit-r32-blessing-tzeentch-scale" type="increment" field="pts" value="8"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="terminator-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="terminator-unit-r32-blessing-tzeentch-rule" name="Blessing of Tzeentch" hidden="false"><description>All models gain a 5+ Invulnerable Save, or improve an existing Invulnerable Save by one step to a maximum of 4+.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r45-al-term-gear" name="Alpha Legion Wargear" hidden="false" /><selectionEntryGroup id="r62-shat-assign-group-b26955fad243" name="Shattered Legions — Assigned Legion" hidden="false"><selectionEntries><selectionEntry id="r62-shat-assign-236e1f3997b2" name="Dark Angels" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-236e1f3997b2-identity" name="Legiones Astartes (Dark Angels)" hidden="false"><description>This unit is assigned to Dark Angels for the Shattered Legions Theme. It uses the normal Dark Angels Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-236e1f3997b2-hide-no