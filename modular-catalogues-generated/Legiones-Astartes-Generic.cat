      <rules>
        <rule id="r64-if-stone-warders-r64-if-warder-comp" name="Unit Composition" hidden="false">
          <description>4 Phalanx Warders and 1 Warder Sergeant; may include up to five additional Phalanx Warders. The Warder Sergeant is a Character.</description>
