mp Infantry. This may not be combined with a Jump Pack, Bike, Jetbike or any form of Terminator Armour.</description></rule></rules><constraints><constraint id="r37-wb-favour-hq-centurion-wings-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="20" /></costs></selectionEntry><selectionEntry id="r37-wb-favour-hq-centurion-visage" name="Daemonic Visage" type="upgrade" hidden="false"><categoryLinks><categoryLink id="r37-wb-favour-hq-centurion-visage-cat" name="Word Bearers — Favour of the Pantheon" targetId="r37-wb-favour-limit" hidden="false" /></categoryLinks><rules><rule id="r37-wb-favour-hq-centurion-visage-rule" name="Daemonic Visage" hidden="false"><description>An enemy unit which loses a close combat involving the bearer suffers an additional -1 Leadership when taking the resulting Morale test.</description></rule></rules><constraints><constraint id="r37-wb-favour-hq-centurion-visage-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="5" /></costs></selectionEntry></selectionEntries><modifiers><modifier id="r37-wb-favour-hq-centurion-show" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xvii" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r37-wb-favour-hq-centurion-show-r62-shat-b4d4529b2768" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-e7efdbb4cb06" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" share