                        <selectionEntry id="r63-sw-rp-r61-librarian-power2-pyromancy-fiery-form" name="Pyromancy — Fiery Form" type="upgrade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r63-sw-rp-r61-librarian-power2-pyromancy-fiery-form-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
