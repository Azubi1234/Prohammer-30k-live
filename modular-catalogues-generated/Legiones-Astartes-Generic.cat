ludeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r16-dg-plague-group-hq-praetor-ret-honour" name="Sons of the Plague Father" hidden="false"><selectionEntries><entryLink id="r16-dg-plague-hq-praetor-ret-honour" name="Upgrade to Plague Marines (+7 pts/model)" targetId="r41-universal-gear-b7875a2d8d95ae" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r16-dg-plague-hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="r16-dg-plague-hq-praetor-ret-honour-mortarion" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-xiv-9-mortarion-prince-of-decay" shared="true" includeChildSelections="true" includeChildForces="true" /></conditions></modifier><modifier id="r16-dg-plague-hq-praetor-ret-honour-cost-0" type="increment" field="pts" value="7"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="hq-praetor-ret-honour-champ" repeats="1" roundUp="false" /></repeats></modifier><modifier id="r16-dg-plague-hq-praetor-ret-honour-cost-1" type="increment" field="pts" value="7"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="hq-praetor-ret-honour-base" repeats="1" roundUp="false" /></repeats></modifier></modifiers></entryLink></selectionEntries></selectionEntryGroup></selectionEntryGroups>
