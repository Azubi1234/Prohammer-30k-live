        <entryLink id="r32-soh-long-march-r64-if-terminator-unit-trans" name="Teleportation Transponders" type="selectionEntry" targetId="r64-if-gear-trans-unit" hidden="false" import="true">
          <constraints>
            <constraint id="r32-soh-long-march-r64-if-terminator-unit-trans-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
