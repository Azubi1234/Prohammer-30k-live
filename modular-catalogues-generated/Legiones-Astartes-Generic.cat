="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xix" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-73009c086d71-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-2d79a2ed9bbf" name="Alpha Legion" type="upgrade" hidden="false"><infoLinks><infoLink id="r62-shat-assign-2d79a2ed9bbf-info-95ff4019ee2d" name="Legiones Astartes (Alpha Legion)" targetId="r45-al-legiones-astartes-alpha-legion" type="rule" hidden="false" /><infoLink id="r62-shat-assign-2d79a2ed9bbf-info-91a8157a1170" name="Mutable Tactics" targetId="r45-al-mutable-tactics" type="rule" hidden="false" /><infoLink id="r62-shat-assign-2d79a2ed9bbf-info-072bb44b5ef9" name="Martial Hubris" targetId="r45-al-martial-hubris" type="rule" hidden="false" /><infoLink id="r62-shat-assign-2d79a2ed9bbf-info-2bb0015445ef" name="Infiltration Network" targetId="r45-al-infiltration-network" type="rule" hidden="false" /></infoLinks><rules><rule id="r62-shat-assign-2d79a2ed9bbf-identity" name="Legiones Astartes (Alpha Legion)" hidden="false"><description>This unit is assigned to Alpha Legion for the Shattered Legions Theme. It uses the normal Alpha Legion Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-2d79a2ed9bbf-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xx" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-2d79a2ed9bbf-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries><modifiers><modifier id="r62-shat-assign-group-bc81072ab02a-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r62-shat-assign-group-bc81072ab02a-min-on" type="set" field="r62-shat-assign-group-bc81072ab02a-min" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-group-bc81072ab02a-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r62-shat-assign-group-bc81072ab02a-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntryGroup></selectionEntryGroups>
      <entryLinks />
    </selectionEntry>
    <selectionEntry type="unit" name="Legion Vindicator Siege Tank Squadron" id="hs-vindicator" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-vindicator-cat" primary="true" name="Heavy Support" hidden="false" />
      <categoryLink id="hs-vindicator-r40-covsup" name="Covenant of Fire — Fast/Heavy choices" targetId="r40-sal-covenant-support" hidden="false" /><categoryLink id="hs-vindicator-r43-rg-heavy" name="Raven Guard — Heavy Support count" targetId="r43-rg-heavy-count" hidden="false" /><categoryLink id="hs-vindicator-r43-rg-decap-heavy" name="Decapitation Strike — Heavy Support" targetId="r43-rg-decap-heavy" hidden="false" /></categoryLinks>
      <selectionEntries>
        <selectionEntry type="model" name="Legion Vindicator" id="hs-vindicator-model" hidden="false" defaultAmount="1" import="true">
          <constraints>
            <constraint id="hs-vindicator-model-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="hs-vindicator-model-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="120" />
          </costs>
          <profiles>
            <profile name="Legion Vindicator" id="hs-vindicator-model-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
              <characteristics>
                <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                <characteristic name="Front" typeId="vehicle-front">13</characteristic>
                <characteristic name="Side" typeId="vehicle-side">11</characteristic>
                <characteristic name="Rear" typeId="vehicle-rear">10</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Standard Wargear" id="hs-vind-wg" hidden="false">
              <description>Demolisher Cannon, Combi-bolter, Searchlight and Smoke Launchers.</description>
            </rule>
            <rule name="Power Capacitor" id="hs-vind-cap" hidden="false">
              <description>If a Vindicator armed with a Laser Destroyer Array remained stationary in its Movement phase, it may fire the weapon as Ordnance 2, Twin-linked. Alternatively it may fire an Overcharged Volley as Ordnance 3, Twin-linked; after firing an Overcharged Volley, on a D6 roll of 1 the Vindicator suffers an automatic Glancing Hit.

Twin-Linked: Re-roll failed To Hit rolls with this weapon. Does not count as two weapons. Twin-linked Template weapons automatically hit all models fully or partially under the Template.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry type="upgrade" name="Laser Destroyer Array (replaces Demolisher Cannon)" id="hs-vind-laser" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-laser-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-laser-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-laser-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <profiles>
                <profile name="Laser Destroyer Array" id="hs-vind-laser-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                    <characteristic name="S" typeId="ranged-s">9</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">1</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Ordnance 1, Twin-linked</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hs-vind-up-hunter-killer-missile" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-up-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-up-hunter-killer-missile-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-up-hunter-killer-missile-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <rules>
                <rule name="Hunter-Killer Missile" id="hs-vind-up-hunter-killer-missile-rule" hidden="false">
                  <description>Unlimited range, S8 AP3, Heavy 1, One Use.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Dozer Blade" id="hs-vind-up-dozer-blade" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-up-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-up-dozer-blade-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-up-dozer-blade-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <rules>
                <rule name="Dozer Blade" id="hs-vind-up-dozer-blade-rule" hidden="false">
                  <description>Use the normal ProHammer Dozer Blade rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Extra Armour" id="hs-vind-up-extra-armour" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-up-extra-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-up-extra-armour-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-up-extra-armour-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <rules>
                <rule name="Extra Armour" id="hs-vind-up-extra-armour-rule" hidden="false">
                  <description>Use the normal ProHammer Extra Armour rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <entryLink id="hs-vind-up-auxiliary-drive" name="Auxiliary Drive" targetId="r41-universal-gear-9513f2d8de2ed1" type="selectionEntry" import="true" hidden="false"><constraints>
                <constraint id="hs-vind-up-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-up-auxiliary-drive-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-up-auxiliary-drive-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              </entryLink><entryLink id="hs-vind-up-armoured-ceramite" name="Armoured Ceramite" targetId="r41-universal-gear-e7ea745a2d0324" type="selectionEntry" import="true" hidden="false"><constraints>
                <constraint id="hs-vind-up-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
