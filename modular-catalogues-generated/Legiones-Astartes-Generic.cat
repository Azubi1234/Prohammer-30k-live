    <selectionEntry type="unit" import="true" name="Legion Contemptor Dreadnought" hidden="false" id="contemptor-unit">
      <categoryLinks>
        <categoryLink targetId="cat-elites" id="contemptor-unit-cat" primary="true" name="Elites" hidden="false" />
      </categoryLinks>
      <infoLinks><infoLink id="r36-link-091a90ada260" name="Fleet" hidden="false" targetId="r36-shared-fleet-e199151" type="rule" /></infoLinks><costs>
        <cost name="Points" typeId="pts" value="155" />
      </costs>
      <profiles>
        <profile name="Legion Contemptor Dreadnought" id="contemptor-prof" typeId="prof-walker" typeName="Walker" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="walker-ws">5</characteristic>
            <characteristic name="BS" typeId="walker-bs">5</characteristic>
            <characteristic name="S" typeId="walker-s">7</characteristic>
            <characteristic name="Front" typeId="walker-front">13</characteristic>
            <characteristic name="Side" typeId="walker-side">12</characteristic>
            <characteristic name="Rear" typeId="walker-rear">10</characteristic>
            <characteristic name="I" typeId="walker-i">4</characteristic>
            <characteristic name="A" typeId="walker-a">2</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="contemptor-standard" hidden="false">
          <description>Twin-linked Heavy Bolter; Dreadnought Close Combat Weapon with built-in Twin-linked Bolter; Smoke Launchers; Searchlight.

Twin-Linked: Re-roll failed To Hit rolls with this weapon. Does not count as two weapons. Twin-linked Template weapons automatically hit all models fully or partially under the Template.</description>
        </rule>
        <rule name="Atomantic Shielding" id="contemptor-atomantic" hidden="false">
          <description>Each time the vehicle suffers a Glancing or Penetrating Hit from shooting, roll a D6; on a 5+ the hit is ignored. Against a Glancing or Penetrating Hit in close combat, the hit is ignored on a 6+. Make this roll before the Vehicle Damage table. If the vehicle suffers an Explodes! result, add +1" to the explosion radius.</description>
        </rule>
        <rule name="Paired Close-Combat Arms" id="contemptor-paired" hidden="false">
          <description>If equipped with two Dreadnought Close Combat Weapons, the Contemptor gains +1 Attack. This bonus is not included in the profile.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Primary Arm" id="contemptor-primary" hidden="false">
          <constraints>
            <constraint id="contemptor-primary-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="contemptor-primary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Twin-linked Heavy Bolter" hidden="false" id="contemptor-p-tlhb" defaultAmount="1">
              <constraints>
                <constraint id="contemptor-p-tlhb-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <profiles>
                <profile name="Twin-linked Heavy Bolter" id="contemptor-p-tlhb-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                    <characteristic name="S" typeId="ranged-s">5</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="contemptor-p-mm">
              <constraints>
                <constraint id="contemptor-p-mm-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <profiles>
                <profile name="Multi-Melta" id="contemptor-p-mm-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                    <characteristic name="S" typeId="ranged-s">8</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">1</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 1, Melta</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Twin-linked Autocannon" hidden="false" id="contemptor-p-tlac">
              <constraints>
                <constraint id="contemptor-p-tlac-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <profiles>
                <profile name="Twin-linked Autocannon" id="contemptor-p-tlac-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">48"</characteristic>
                    <characteristic name="S" typeId="ranged-s">7</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 2, Twin-linked</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <entryLink id="contemptor-p-pc" name="Plasma Cannon" targetId="gear-plasma-cannon" type="selectionEntry" import="true" hidden="false"><constraints>
                <constraint id="contemptor-p-pc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
