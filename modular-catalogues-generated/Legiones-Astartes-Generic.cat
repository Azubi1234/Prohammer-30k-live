ons" scope="root-entry" childId="r62-shat-assign-931dbd2a5515" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><selectionEntries><selectionEntry id="fa-seeker-r32-blessing-khorne" name="Blessing of Khorne" type="upgrade" hidden="false" import="true"><constraints><constraint id="fa-seeker-r32-blessing-khorne-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="5" /></costs><modifiers><modifier id="fa-seeker-r32-blessing-khorne-scale" type="increment" field="pts" value="5"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="fa-seeker-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="fa-seeker-r32-blessing-khorne-rule" name="Blessing of Khorne" hidden="false"><description>All models gain +1 Attack.</description></rule></rules></selectionEntry><selectionEntry id="fa-seeker-r32-blessing-slaanesh" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><constraints><constraint id="fa-seeker-r32-blessing-slaanesh-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="4" /></costs><modifiers><modifier id="fa-seeker-r32-blessing-slaanesh-scale" type="increment" field="pts" value="4"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="fa-seeker-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="fa-seeker-r32-blessing-slaanesh-rule" name="Blessing of Slaanesh" hidden="false"><description>All models gain +1 Initiative.</description></rule></rules></selectionEntry><selectionEntry id="fa-seeker-r32-blessing-nurgle" name="Blessing of Nurgle" type="upgrade" hidden="false" import="true"><constraints><constraint id="fa-seeker-r32-blessing-nurgle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="7" /></costs><modifiers><modifier id="fa-seeker-r32-blessing-nurgle-scale" type="increment" field="pts" value="7"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="fa-seeker-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="fa-seeker-r32-blessing-nurgle-rule" name="Blessing of Nurgle" hidden="false"><description>All models gain +1 Toughness and Slow and Purposeful. Not available to Bikes, Jetbikes or Jump Infantry.

Slow and Purposeful: Relentless and always moves as if in Difficult Terrain.</description></rule></rules></selectionEntry><selectionEntry id="fa-seeker-r32-blessing-tzeentch" name="Blessing of Tzeentch" type="upgrade" hidden="false" import="true"><constraints><constraint id="fa-seeker-r32-blessing-tzeentch-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="8" /></costs><modifiers><modifier id="fa-seeker-r32-blessing-tzeentch-scale" type="increment" field="pts" value="8"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="fa-seeker-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="fa-seeker-r32-blessing-tzeentch-rule" name="Blessing of Tzeentch" hidden="false"><description>All models gain a 5+ Invulnerable Save, or improve an existing Invulnerable Save by one step to a maximum of 4+.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r43-rg-shar-seeker-group" name="Raven Guard Character Replacement" hidden="false"><constraints><constraint id="r43-rg-shar-seeker-group-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r43-rg-shar-seeker-group-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="model" import="true" name="Nykona Sharrowkyn — replaces Seeker Sergeant" hidden="true" id="r43-rg-sharrowkyn-seeker">
