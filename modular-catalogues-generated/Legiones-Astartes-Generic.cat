                    <selectionEntry type="upgrade" name="Life Leech" id="r29-lib-power-3" hidden="false" import="true">
                      <constraints>
                        <constraint id="r29-lib-power-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <profiles>
                        <profile name="Life Leech" id="r29-lib-power-3-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">18”</characteristic>
                            <characteristic name="S" typeId="ranged-s">6</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Assault 2</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Life Leech" id="r29-lib-power-3-rule" hidden="false">
                          <description>Witchfire. Range 18”, S6 AP2 Assault 2. If it causes at least one unsaved Wound, a model within 6” of the Psyker regains a Wound.</description>
                        </rule>
                      </rules>
