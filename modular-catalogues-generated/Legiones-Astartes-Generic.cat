                      <modifier type="set" value="true" field="hidden" id="mod-r62-shat-6c44354754c1">
                          <conditions>
                            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-8ab970381c7b" shared="true" includeChildSelections="true" />
