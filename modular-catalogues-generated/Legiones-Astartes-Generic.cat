        <entryLink id="r40-da-forward-r35-sky-troops-fa-sky-hunter" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true">
          <constraints>
            <constraint id="r40-da-forward-r35-sky-troops-fa-sky-hunter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
