      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-aero-fireraptor-type" hidden="false">
          <description>Vehicle (Flyer, Hover)</description>
        </rule>
        <rule name="Wargear" id="r32-aero-fireraptor-wargear" hidden="false">
          <description>Twin-linked Avenger Bolt Cannon; Two Quad Heavy Bolter Turrets; Four Tempest Rockets; Extra Armour.</description>
        </rule>
        <rule name="Sunder" id="r32-aero-fireraptor-weapon-tempest-rocket-wr-0-sunder" hidden="false">
          <description>May re-roll failed Armour Penetration rolls against Vehicles.</description>
        </rule>
        <rule name="Independent Turret Fire" id="r32-aero-fireraptor-turrets" hidden="false">
          <description>The two waist-mounted turrets operate independently. Each may fire at a different target from the gunship's other weapons and from the other turret. Weapons fired by these turrets do not count towards the number of weapons normally permitted by movement speed.</description>
        </rule>
      </rules>
