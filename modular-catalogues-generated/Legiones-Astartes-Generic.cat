                      </constraints>
                      <rules>
                        <rule name="Haemorrhage" id="r29-lib-power-6-rule" hidden="false">
                          <description>Focused Witchfire — range 18”. Resolve the ProHammer Haemorrhage Toughness-test chain effect.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier type="set" value="true" field="hidden">
                          <conditions>
                            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-0" shared="true" includeChildSelections="true" />
                          </conditions>
                        </modifier>
