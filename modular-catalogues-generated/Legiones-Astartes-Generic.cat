          <modifier id="r75-ba-furioso-show-r62-shat-e2b193343437" type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-45e5eac5fd8d" shared="true" includeChildSelections="true" includeChildForces="false" />
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="contemptor-p-dccw" shared="true" includeChildSelections="true" includeChildForces="false" />
