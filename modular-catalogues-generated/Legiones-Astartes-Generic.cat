                          </categoryLinks>
                        </selectionEntry>
                        <selectionEntry id="r61-librarian-power2-telepathy-shrouding" name="Telepathy — Shrouding" type="upgrade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r61-librarian-power2-telepathy-shrouding-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                          </constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="0" />
