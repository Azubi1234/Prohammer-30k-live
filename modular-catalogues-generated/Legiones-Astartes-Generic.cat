        <cost name="Points" typeId="pts" value="700" />
      </costs>
      <profiles>
        <profile name="Mastodon Heavy Assault Transport" id="r32-low-mastodon-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <characteristics>
            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
            <characteristic name="Front" typeId="vehicle-front">14</characteristic>
            <characteristic name="Side" typeId="vehicle-side">14</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
            <characteristic name="SP" typeId="vehicle-sp">4</characteristic>
          </characteristics>
        </profile>
        <profile name="Siege Melta Array" id="r32-low-mastodon-weapon-siege-melta-array-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
            <characteristic name="S" typeId="ranged-s">9</characteristic>
            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 4, Blast, Melta, Stone Burner</characteristic>
          </characteristics>
        </profile>
        <profile name="Heavy Flamer" id="r32-low-mastodon-weapon-heavy-flamer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">Template</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 1</characteristic>
          </characteristics>
        </profile>
        <profile name="Lascannon" id="r32-low-mastodon-weapon-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">9</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1</characteristic>
          </characteristics>
        </profile>
        <profile name="Skyreaper Battery" id="r32-low-mastodon-weapon-skyreaper-battery-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">7</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 5, Twin-linked, Skyfire, Interceptor</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-low-mastodon-type" hidden="false">
          <description>Vehicle (Tank, Super-heavy)</description>
        </rule>
        <rule name="Wargear" id="r32-low-mastodon-wargear" hidden="false">
          <description>Siege Melta Array; Two Heavy Flamers; Two Lascannons; Skyreaper Battery; Smoke Launchers; Searchlight; Armoured Ceramite; Two Void Shields.</description>
        </rule>
        <rule name="Stone Burner" id="r32-low-mastodon-weapon-siege-melta-array-wr-0-stone-burner" hidden="false">
          <description>A Penetrating Hit against a Building or Fortification becomes D3 Penetrating Hits.</description>
        </rule>
        <rule name="Two Void Shields" id="r32-low-mastodon-void" hidden="false">
          <description>The Mastodon is protected by two Void Shields. A Void Shield has Armour Value 12. Shooting hits are resolved against active shields before the vehicle. A Glancing or Penetrating Hit collapses one shield. At the end of each controlling player's turn each collapsed shield is restored on a 5+.</description>
        </rule>
        <rule name="Enhanced Defensive Fire" id="r32-low-mastodon-defensive" hidden="false">
          <description>If at least one friendly unit is embarked, the Mastodon may make a Stand &amp; Shoot reaction when charged. Only its sponson weapons may fire; Lascannons fire at BS2 and Heavy Flamers inflict D3+1 automatic hits against an eligible charging unit in arc.</description>
        </rule>
        <rule name="Reinforced Shell" id="r32-low-mastodon-shell" hidden="false">
          <description>Subtract 2 from Catastrophic Destruction rolls. If the modified result is 0 or less, the Mastodon is destroyed without exploding and its hull becomes a Ruin. Embarked models suffer an S4 hit; transported vehicles are struck against their lowest Armour Value.</description>
        </rule>
        <rule name="Transport Capacity" id="r32-low-mastodon-cap" hidden="false">
          <description>40 models. Up to two Dreadnoughts may be transported, each counting as 10 models.</description>
        </rule>
        <rule name="Access Points" id="r32-low-mastodon-access" hidden="false">
          <description>One front access point and one rear access point. No Fire Points.</description>
        </rule>
      </rules>
      <selectionEntries>
        <entryLink id="r32-low-mastodon-command" name="Super-heavy Command Tank" targetId="r41-universal-gear-81a35a204be6f4" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="r32-low-mastodon-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="20" />
          </costs>
          </entryLink><entryLink id="r32-low-mastodon-hk" name="Hunter-Killer Missile" targetId="gear-hk" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="r32-low-mastodon-hk-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
        </entryLink><selectionEntry type="upgrade" import="true" name="Command Vox Relay" hidden="false" id="r32-low-mastodon-vox">
          <constraints>
            <constraint id="r32-low-mastodon-vox-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <rules>
            <rule name="Command Vox Relay" id="r32-low-mastodon-vox-rule" hidden="false">
              <description>Replaces the Skyreaper Battery. While on the battlefield, add +1 or subtract -1 from friendly Reserve rolls. When an enemy suffers a Deep Strike Mishap, the controlling player may reposition it up to 18 inches from its intended target instead of 12 inches.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
      <categoryLinks>
        <categoryLink id="r32-low-mastodon-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Thunderhawk Transporter" hidden="false" id="r32-low-transporter">
      <infoLinks><infoLink id="r36-link-0c6e38729dcb" name="Armoured Ceramite" hidden="false" targetId="r36-shared-armoured-ceramite-4988a13" type="rule" /><infoLink id="r36-link-9560fc1dc9e1" name="Structure Points" hidden="false" targetId="r36-exact-structure-points-bdaf4a4" type="rule" /><infoLink id="r36-link-59d914cc118f" name="Massive Firepower" hidden="false" targetId="r36-exact-massive-firepower-ca38600" type="rule" /><infoLink id="r36-link-df816f87eff2" name="Lumbering War Engine" hidden="false" targetId="r36-exact-lumbering-war-engine-d6d008b" type="rule" /><infoLink id="r36-link-bf20c7347363" name="Super-heavy Tank Shock" hidden="false" targetId="r36-exact-super-heavy-tank-shock-5de7bbc" type="rule" /><infoLink id="r36-link-b2ad27e3722d" name="Crushing Advance" hidden="false" targetId="r36-exact-crushing-advance-d33dc05" type="rule" /><infoLink id="r36-link-296577b3ff00" name="Immense Machine" hidden="false" targetId="r36-exact-immense-machine-d938f52" type="rule" /><infoLink id="r36-link-5c11f5a50513" name="Catastrophic Destruction" hidden="false" targetId="r36-exact-catastrophic-destruction-38e2f78" type="rule" /></infoLinks><selectionEntryGroups><selectionEntryGroup id="r62-shat-assign-group-fa9f93cc608d" name="Shattered Legions — Assigned Legion" hidden="false"><selectionEntries><selectionEntry id="r62-shat-assign-dbff9917e9d2" name="Dark Angels" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-dbff9917e9d2-identity" name="Legiones Astartes (Dark Angels)" hidden="false"><description>This unit is assigned to Dark Angels for the Shattered Legions Theme. It uses the normal Dark Angels Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-dbff9917e9d2-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value