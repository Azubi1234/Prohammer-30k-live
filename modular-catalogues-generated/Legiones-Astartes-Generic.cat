            <characteristic name="Type" typeId="ranged-type">Heavy 1, Sniper</characteristic>
          </characteristics>
        </profile>
      </profiles>
      </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combat Blade" hidden="false" id="gear-combat-blade">
      <rules>
        <rule name="Combat Blade" id="rule-combat-blade" hidden="false">
          <description>Close Combat Weapon. Uses the bearer' Strength and permits normal Armour Saves.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cameleoline" hidden="false" id="gear-cameleoline">
      <rules>
        <rule name="Cameleoline" id="rule-cameleoline" hidden="false">
          <description>A model equipped with Cameleoline gains the Stealth special rule.

Stealth: Adds +1 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 6+ Cover Save. Does not stack with Shrouded.</description>
        </rule>
      </rules>
    </selectionEntry>
