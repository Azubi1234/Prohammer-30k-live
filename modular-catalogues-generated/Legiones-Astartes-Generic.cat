er id="r45-al-arm-18a3b75dd570-show-r62-shat-3e34cd6a2bb2" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-d2c7dcd60005" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r45-al-arm-18a3b75dd570-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></entryLink></entryLinks>
