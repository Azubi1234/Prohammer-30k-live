              <rules>
                <rule id="r63-sw-wp-replace" name="Wargear" hidden="false">
                  <description>Replace the Centurion’s Chainsword with a Fang of Morkai. The Wolf Priest also has a Rosarius.</description>
                </rule>
                <rule id="r63-sw-wp-fang" name="Fang of Morkai" hidden="false">
                  <description>Counts as a Power Weapon.</description>
                </rule>
                <rule id="r63-sw-wp-rites" name="Rites of Battle" hidden="false">
                  <description>The Wolf Priest and any Space Wolves unit he has joined may re-roll failed Morale checks.</description>
                </rule>
                <rule id="r63-sw-wp-oath" name="Oath of the Slayer" hidden="false">
                  <description>Before deployment, nominate one enemy unit. The Wolf Priest and any Space Wolves unit he has joined may re-roll failed To Hit rolls in close combat against that nominated unit for the duration of the battle.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="r80-ih-consul-cat-194" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
