in" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r62-shat-assign-group-3f5108dd8b9b-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntryGroup></selectionEntryGroups><costs>
        <cost name="Points" typeId="pts" value="625" />
      </costs>
      <profiles>
        <profile name="Glaive Super-heavy Special Weapons Tank" id="r32-low-glaive-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <characteristics>
            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
            <characteristic name="Front" typeId="vehicle-front">14</characteristic>
            <characteristic name="Side" typeId="vehicle-side">13</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">12</characteristic>
            <characteristic name="SP" typeId="vehicle-sp">3</characteristic>
          </characteristics>
        </profile>
        <profile name="Volkite Carronade" id="r32-low-glaive-weapon-volkite-carronade-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Heavy Beam, Deflagrate, Haywire, Ignores Cover</characteristic>
          </characteristics>
        </profile>
        <profile name="Quad Lascannon" id="r32-low-glaive-weapon-quad-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">9</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 2, Twin-linked</characteristic>
          </characteristics>
        </profile>
        <profile name="Twin-linked Heavy Bolter" id="r32-low-glaive-weapon-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-low-glaive-type" hidden="false">
          <description>Vehicle (Tank, Super-heavy)</description>
        </rule>
        <rule name="Wargear" id="r32-low-glaive-wargear" hidden="false">
          <description>Volkite Carronade; Two Quad Lascannon Sponsons; Twin-linked Heavy Bolter; Searchlight; Smoke Launchers.</description>
        </rule>
        <rule name="Heavy Beam" id="r32-low-glaive-weapon-volkite-carronade-wr-0-heavy-beam" hidden="false">
          <description>Draw a 1 inch wide line from the barrel to maximum range. The first touched model must be an enemy. Every model under the beam suffers one automatic hit; vehicles are struck against the facing from which the beam entered.</description>
        </rule>
        <rule name="Deflagrate" id="r32-low-glaive-weapon-volkite-carronade-wr-0-deflagrate" hidden="false">
          <description>After resolving attacks, immediately resolve one additional automatic hit against the same unit for each unsaved Wound caused. These extra hits cannot generate further hits.</description>
        </rule>
        </rules>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Replace Quad Lascannon Sponsons with Laser Destroyer Sponsons" hidden="false" id="r32-low-glaive-laser">
          <constraints>
