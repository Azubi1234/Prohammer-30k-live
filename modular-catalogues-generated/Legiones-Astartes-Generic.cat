              </costs>
              </selectionEntry>
            <selectionEntry type="upgrade" name="XVIII Legion — Salamanders" id="legion-xviii" hidden="false" import="true">
              <infoLinks><infoLink id="legion-xviii-sal-leg" name="Legiones Astartes (Salamanders)" targetId="r40-sal-legiones-astartes-salamanders" type="rule" hidden="false" /><infoLink id="legion-xviii-sal-promethean-cult" name="Promethean Cult" targetId="r40-sal-promethean-cult" type="rule" hidden="false" /><infoLink id="legion-xviii-sal-sturdy" name="Sturdy" targetId="r40-sal-sturdy" type="rule" hidden="false" /><infoLink id="legion-xviii-sal-never-give-up" name="Never Give Up" targetId="r40-sal-never-give-up" type="rule" hidden="false" /><infoLink id="legion-xviii-leg-salamanders-mantle" name="Salamanders Mantle" targetId="r40-sal-salamanders-mantle" type="rule" hidden="false" /><infoLink id="legion-xviii-leg-fire-based-warfare" name="Fire-based Warfare" targetId="r40-sal-fire-based-warfare" type="rule" hidden="false" /><infoLink id="legion-xviii-leg-proscribed-munitions" name="Proscribed Munitions" targetId="r40-sal-proscribed-munitions" type="rule" hidden="false" /><infoLink id="r40-leg-r40-sal-prof-flamer" name="Salamanders Flamer" targetId="r40-sal-prof-flamer" type="profile" hidden="false" /><infoLink id="r40-leg-r40-sal-prof-heavy-flamer" name="Salamanders Heavy Flamer" targetId="r40-sal-prof-heavy-flamer" type="profile" hidden="false" /><infoLink id="r40-leg-r40-sal-prof-inferno" name="Inferno Pistol" targetId="r40-sal-prof-inferno" type="profile" hidden="false" /></infoLinks><constraints>
                <constraint id="legion-xviii-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="0" />
              </costs>
              </selectionEntry>
            <selectionEntry type="upgrade" name="XIX Legion — Raven Guard" id="legion-xix" hidden="false" import="true">
              <infoLinks><infoLink id="legion-xix-rg-leg" name="Legiones Astartes (Raven Guard)" targetId="r43-rg-legiones-astartes-raven-guard" type="rule" hidden="false" /><infoLink id="legion-xix-rg-surgical-strike" name="Surgical Strike" targetId="r43-rg-surgical-strike" type="rule" hidden="false" /><infoLink id="legion-xix-rg-rapid-reaction" name="Rapid Reaction" targetId="r43-rg-rapid-reaction" type="rule" hidden="false" /><infoLink id="legion-xix-rg-shadow-masters" name="Shadow Masters" targetId="r43-rg-shadow-masters" type="rule" hidden="false" /><infoLink id="legion-xix-rg-limited-vehicles" name="Limited Vehicles" targetId="r43-rg-limited-vehicles" type="rule" hidden="false" /><infoLink id="legion-xix-arm-raven-s-talons" name="Raven's Talons" targetId="r43-rg-raven-s-talons" type="rule" hidden="false" /><infoLink id="legion-xix-arm-infravisor" name="Infravisor" targetId="r43-rg-infravisor" type="rule" hidden="false" /><infoLink id="legion-xix-arm-shroud-bombs" name="Shroud Bombs" targetId="r43-rg-shroud-bombs" type="rule" hidden="false" /><infoLink id="legion-xix-arm-cameleoline" name="Cameleoline" targetId="r43-rg-cameleoline" type="rule" hidden="false" /><infoLink id="legion-xix-arm-teleportation-transponders" name="Teleportation Transponders" targetId="r43-rg-teleportation-transponders" type="rule" hidden="false" /><infoLink id="r43-rg-fulcrum-prof" name="Fulcrum Hand Cannon" targetId="r43-rg-prof-fulcrum" type="profile" hidden="false" /></infoLinks><constraints>
                <constraint id="legion-xix-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
