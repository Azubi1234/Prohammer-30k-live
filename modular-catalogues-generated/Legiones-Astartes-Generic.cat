        <selectionEntryGroup id="r57-assault-unit-iw" name="Iron Warriors Armoury" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="r57-assault-unit-iw-shrapnel" name="Shrapnel Bolts" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r57-assault-unit-iw-shrapnel-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" id="r57-assault-unit-iw-shrapnel-pts" />
              </costs>
              <rules>
                <rule id="r57-assault-unit-iw-shrapnel-rule" name="Shrapnel Bolts" hidden="false">
                  <description>Bolt Pistols, Bolters, Combi-Bolters, Storm Bolters, Heavy Bolters, Twin-linked Bolters and bolter components of Combi-Weapons carried by models in this unit gain Pinning. May not be combined with Special Issue Ammunition, Hellfire Rounds or another special ammunition type.

Pinning: Unsaved Wounds caused by this weapon force the unit to take a Pinning Test.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r57-assault-unit-iw-bionics" name="Bionics" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r57-assault-unit-iw-bionics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" id="r57-assault-unit-iw-bionics-pts" />
              </costs>
              <rules>
                <rule id="r57-assault-unit-iw-bionics-rule" name="Bionics" hidden="false">
                  <description>Iron Warriors Armoury price; otherwise follows the normal Bionics rules.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <modifiers>
            <modifier id="r57-assault-unit-iw-hide-missing-legion-iv" type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" />
              <condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
            </modifier>
          <modifier id="r57-assault-unit-iw-hide-missing-legion-iv-r62-shat-5a3cac594e9b" type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-fa41152dfd80" shared="true" includeChildSelections="true" includeChildForces="false" />
              <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
            </modifier>
          </modifiers>
          <entryLinks>
            </entryLinks>
        </selectionEntryGroup>
      <selectionEntryGroup id="live-r2-fabius-enhanced-assault-unit-group" name="Fabius Bile" hidden="false" collective="false" import="true"><selectionEntries><entryLink id="live-r2-fabius-enhanced-assault-unit" name="Enhanced Warriors" targetId="r41-universal-gear-fee9d22f000bad" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="live-r2-fabius-enhanced-assault-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="live-r2-fabius-enhanced-assault-unit-scale-0" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="assault-marine" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-assault-unit-scale-1" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="assault-sergeant" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-assault-unit-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-7-fabius-bile" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></entryLink></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r2-fulgrim-blessing-assault-unit-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-assault-unit" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="25" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-assault-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-assault-unit-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-assault-unit-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-10-fulgrim-transfigured" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r16-dg-plague-group-assault-unit" name="Sons of the Plague Father" hidden="false"><selectionEntries><entryLink id="r16-dg-plague-assault-unit" name="Upgrade to Plague Marines (+7 pts/model)" targetId="r41-universal-gear-b7875a2d8d95ae" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r16-dg-plague-assault-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="r16-dg-plague-assault-unit-mortarion" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-xiv-9-mortarion-prince-of-decay" shared="true" includeChildSelections="true" includeChildForces="true" /></conditions></modifier><modifier id="r16-dg-plague-assault-unit-disq-0" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="assault-jump-packs" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r16-dg-plague-assault-unit-cost-0" type="increment" field="pts" value="7"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="assault-marine" repeats="1" roundUp="false" /></repeats></modifier><modifier id="r16-dg-plague-assault-unit-cost-1" type="increment" field="pts" value="7"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="assault-sergeant" repeats="1" roundUp="false" /></repeats></modifier></modifiers></entryLink></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r20-ih-assault-group" name="Iron Hands Wargear" hidden="false"><modifiers><modifier id="r20-ih-assault-group-legion" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r20-ih-assault-group-legion-r62-shat-b12e59f60cfb" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-665a954e1e9c" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><selectionEntries><entryLink id="r20-ih-assault-whole" name="Bionics — entire squad" targetId="r41-universal-gear-366c5f361cb4f4" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r20-ih-assault-whole-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="5" /></costs><modifiers><modifier id="r20-ih-assault-whole-scale" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="assault-marine" repeats="1" roundUp="false" /></repeats></modifier><modifier id="r20-ih-assault-whole-hide-sgt" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r20-ih-assault-sgt" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></entryLink><selectionEntry id="r20-ih-assault-sgt" name="Bionics — Sergeant only" type="upgrade" hidden="false" import="true"><constraints><constraint id="r20-ih-assault-sgt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="5" /></costs><rules><rule id="r20-ih-assault-sgt-rule" name="Bionics" hidden="false"><description>The squad Sergeant purchases Bionics for +5 points. Iron Hands models with Bionics recover on a 5+ rather than 6+.</description></rule></rules><modifiers><modifier id="r20-ih-assault-sgt-hide-whole" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r20-ih-assault-whole" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r62-shat-assign-group-8eaf89cbe4cc" name="Shattered Legions — Assigned Legion" hidden="false"><selectionEntries><selectionEntry id="r62-shat-assign-aa53828e2440" name="Dark Angels" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-aa53828e2440-identity" name="Legiones Astartes (Dark Angels)" hidden="false"><description>This unit is assigned to Dark Angels for the Shattered Legions Theme. It uses the normal Dark Angels Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-aa53828e2440-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-i" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-aa53828e2440-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-5f669dd8f8de" name="Emperor's Children" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-5f669dd8f8de-identity" name="Legiones Astartes (Emperor's Children)" hidden="false"><description>This unit is assigned to Emperor's Children for the Shattered Legions Theme. It uses the normal Emperor's Children Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-5f669dd8f8de-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-iii" shared="true" includeChildSelections="true" includeChild