ectionEntries><selectionEntry id="r32-soh-long-march-terminator-troops-r32-blessing-khorne" name="Blessing of Khorne" type="upgrade" hidden="false" import="true"><constraints><constraint id="r32-soh-long-march-terminator-troops-r32-blessing-khorne-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="5" /></costs><modifiers><modifier id="r32-soh-long-march-terminator-troops-r32-blessing-khorne-scale" type="increment" field="pts" value="5"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r32-soh-long-march-terminator-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r32-soh-long-march-terminator-troops-r32-blessing-khorne-rule" name="Blessing of Khorne" hidden="false"><description>All models gain +1 Attack.</description></rule></rules></selectionEntry><selectionEntry id="r32-soh-long-march-terminator-troops-r32-blessing-slaanesh" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><constraints><constraint id="r32-soh-long-march-terminator-troops-r32-blessing-slaanesh-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="4" /></costs><modifiers><modifier id="r32-soh-long-march-terminator-troops-r32-blessing-slaanesh-scale" type="increment" field="pts" value="4"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r32-soh-long-march-terminator-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r32-soh-long-march-terminator-troops-r32-blessing-slaanesh-rule" name="Blessing of Slaanesh" hidden="false"><description>All models gain +1 Initiative.</description></rule></rules></selectionEntry><selectionEntry id="r32-soh-long-march-terminator-troops-r32-blessing-nurgle" name="Blessing of Nurgle" type="upgrade" hidden="false" import="true"><constraints><constraint id="r32-soh-long-march-terminator-troops-r32-blessing-nurgle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="7" /></costs><modifiers><modifier id="r32-soh-long-march-terminator-troops-r32-blessing-nurgle-scale" type="increment" field="pts" value="7"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r32-soh-long-march-terminator-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r32-soh-long-march-terminator-troops-r32-blessing-nurgle-rule" name="Blessing of Nurgle" hidden="false"><description>All models gain +1 Toughness and Slow and Purposeful. Not available to Bikes, Jetbikes or Jump Infantry.

Slow and Purposeful: Relentless and always moves as if in Difficult Terrain.</description></rule></rules></selectionEntry><selectionEntry id="r32-soh-long-march-terminator-troops-r32-blessing-tzeentch" name="Blessing of Tzeentch" type="upgrade" hidden="false" import="true"><constraints><constraint id="r32-soh-long-march-terminator-troops-r32-blessing-tzeentch-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="8" /></costs><modifiers><modifier id="r32-soh-long-march-terminator-troops-r32-blessing-tzeentch-scale" type="increment" field="pts" value="8"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r32-soh-long-march-terminator-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r32-soh-long-march-terminator-troops-r32-blessing-tzeentch-rule" name="Blessing of Tzeentch" hidden="false"><description>All models gain a 5+ Invulnerable Save, or improve an existing Invulnerable Save by one step to a maximum of 4+.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
          </conditions>
        </modifier>
      <modifier id="r32-soh-longmarch-show-0" type="set" field="hidden" value="false"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xvi-0-the-long-march" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r36-longcopy-show" type="set" field="hidden" value="false"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xvi-0-the-long-march" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier></modifiers>
      <entryLinks>
