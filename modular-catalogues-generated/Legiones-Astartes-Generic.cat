    <selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="true" id="r35-pride-veteran-veteran-unit">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="r35-pride-veteran-cat" primary="true" name="Troops" hidden="false" />
      <categoryLink id="r36-long-comp-7114864ade" name="Long March — compulsory Troops" targetId="r36-soh-long-compulsory-troops" hidden="false" /><categoryLink id="r35-pride-veteran-veteran-unit-r40-covcomp" name="Covenant of Fire — compulsory Troops" targetId="r40-sal-covenant-compulsory" hidden="false" /><categoryLink id="r35-pride-veteran-veteran-unit-r42-sal-comp" name="Salamanders — compulsory-capable Troops" targetId="r42-sal-compulsory-troops" hidden="false" /><categoryLink id="r35-pride-veteran-veteran-unit-r43-rg-comp" name="Raven Guard — compulsory-capable Troops" targetId="r43-rg-compulsory-troops" hidden="false" /><categoryLink id="r35-pride-veteran-veteran-unit-r45-coils-comp" name="Coils — compulsory-capable Troops" targetId="r45-al-coils-compulsory" hidden="false" /></categoryLinks>
      <infoLinks><infoLink id="r58-pride-sync-b587360f862f8bc7" name="Veteran Tactics" hidden="false" targetId="r36-exact-veteran-tactics-f7215db" type="rule" /></infoLinks><rules>
        <rule name="Standard Wargear" id="r58-pride-sync-e1cb09c9f95f04a4" hidden="false">
          <description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</description>
        </rule>
        <rule name="Legiones Astartes" id="r58-pride-sync-a16ebeb9e31b3964" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Dedicated Transport" id="r58-pride-sync-afb67433fe49ef64" hidden="false">
          <description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</description>
        </rule>
      </rules>
