Slow and Purposeful: Relentless and always moves as if in Difficult Terrain.</description></rule></rules></selectionEntry><selectionEntry id="hs-heavy-support-squad-r32-blessing-tzeentch" name="Blessing of Tzeentch" type="upgrade" hidden="false" import="true"><constraints><constraint id="hs-heavy-support-squad-r32-blessing-tzeentch-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="8" /></costs><modifiers><modifier id="hs-heavy-support-squad-r32-blessing-tzeentch-scale" type="increment" field="pts" value="8"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="hs-hss-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="hs-heavy-support-squad-r32-blessing-tzeentch-rule" name="Blessing of Tzeentch" hidden="false"><description>All models gain a 5+ Invulnerable Save, or improve an existing Invulnerable Save by one step to a maximum of 4+.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r43-dec-hss-trans" name="Decapitation Strike — required Dedicated Transport" hidden="true"><entryLinks><entryLink id="r43-dec-hss-pod" name="Legion Drop Pod" targetId="transport-drop-pod" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r43-dec-hss-pod-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><modifiers><modifier id="r43-dec-hss-pod-r44-lib-hide" type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xix" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLe