            <selectionEntry type="upgrade" name="Legion Primus Nullificator Consul" id="hq-consul-null" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-null-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <infoLinks><infoLink id="r36-link-32d47cfc33b2" name="Adamantium Will" hidden="false" targetId="r36-shared-adamantium-will-b9d0569" type="rule" /></infoLinks><costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <rules>
                <rule name="Legion Primus Nullificator Consul" id="hq-consul-null-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Primus Nullificator Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Psyker (Mastery Level 1)" id="r29-null-psyker" hidden="false">
                  <description>The Nullificator is a Psyker with Mastery Level 1 and follows the ProHammer Classic psychic rules.</description>
                </rule>
                <rule name="Legion Support Officer" id="r29-null-support" hidden="false">
                  <description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</description>
                </rule>
                <rule name="Hexagrammic Wards" id="r29-null-wards" hidden="false">
                  <description>An enemy Psyker using a psychic power which directly targets the Nullificator or a unit he has joined suffers -1 Leadership for that Psychic Test.</description>
                </rule>
                <rule name="Credo Annihilato" id="r29-null-credo" hidden="false">
                  <description>The Nullificator and any unit he has joined have Preferred Enemy (Daemons).

Preferred Enemy: The unit can re-roll failed hits in close combat against the indicated Preferred Enemy.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Psychic Discipline(s)" id="r29-null-discipline-group" hidden="false">
