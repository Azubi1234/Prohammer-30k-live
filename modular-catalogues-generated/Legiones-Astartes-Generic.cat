                        <selectionEntry id="r37-burning-powers-p-telepathy-hallucination" name="Telepathy — Hallucination" type="upgrade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r37-burning-powers-p-telepathy-hallucination-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="0" />
                          </costs>
                          <profiles>
                            <profile id="r37-burning-powers-p-telepathy-hallucination-r61-librarian-power2-telepathy-hallucination-profile" name="Hallucination" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                                <characteristic name="S" typeId="ranged-s">—</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Malediction</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-burning-powers-p-telepathy-hallucination-r61-librarian-power2-telepathy-hallucination-rule" name="Hallucination" hidden="false">
                              <description>Roll D6: 1-2 the unit takes a Pinning test; 3-4 it suffers -1 WS, BS, Initiative and Attacks; 5-6 randomly select a model, which takes one hit for every other model in the unit at Strength equal to the unit's majority Strength.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-burning-powers-p-telepathy-hallucination-r80-ih-consul-cat-35" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                          </categoryLinks>
                        </selectionEntry>
