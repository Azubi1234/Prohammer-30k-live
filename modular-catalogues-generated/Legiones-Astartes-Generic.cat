              </costs>
              </entryLink><entryLink id="rhino-aux" name="Auxiliary Drive" targetId="r41-universal-gear-9513f2d8de2ed1" type="selectionEntry" import="true" hidden="false"><constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-aux-max" includeChildSelections="false" />
