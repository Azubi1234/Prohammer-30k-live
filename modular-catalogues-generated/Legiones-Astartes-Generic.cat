              </entryLinks>
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="techmarine-I-signum">
                  <constraints>
                    <constraint id="techmarine-I-signum-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <rules>
                    <rule name="Signum" id="techmarine-I-signum-rule" hidden="false">
                      <description>Once during each friendly Shooting phase, a unit containing a Signum may re-roll one failed To Hit roll made with a shooting weapon. A unit may benefit from only one Signum each Shooting phase.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Space Marine Bike" hidden="false" id="techmarine-I-bike">
                  <constraints>
                    <constraint id="techmarine-I-bike-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="35" />
                  </costs>
                  <rules>
                    <rule name="Space Marine Bike" id="techmarine-I-bike-rule" hidden="false">
                      <description>The model becomes Bike and the bike is armed with twin-linked bolters.

Twin-Linked: Re-roll failed To Hit rolls with this weapon. Does not count as two weapons. Twin-linked Template weapons automatically hit all models fully or partially under the Template.</description>
                    </rule>
                  </rules>
                </selectionEntry>
