    <selectionEntry type="unit" import="true" name="Legion Destroyer Squad" hidden="true" id="r35-destroyer-troops-destroyer-unit">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="r35-destroyer-troops-cat" primary="true" name="Troops" hidden="false" />
      <categoryLink id="r36-long-comp-40d7927eef" name="Long March — compulsory Troops" targetId="r36-soh-long-compulsory-troops" hidden="false" /><categoryLink id="r35-destroyer-troops-destroyer-unit-r40-covcomp" name="Covenant of Fire — compulsory Troops" targetId="r40-sal-covenant-compulsory" hidden="false" /><categoryLink id="r35-destroyer-troops-destroyer-unit-r42-sal-comp" name="Salamanders — compulsory-capable Troops" targetId="r42-sal-compulsory-troops" hidden="false" /><categoryLink id="r35-destroyer-troops-destroyer-unit-r43-rg-comp" name="Raven Guard — compulsory-capable Troops" targetId="r43-rg-compulsory-troops" hidden="false" /><categoryLink id="r35-destroyer-troops-destroyer-unit-r45-coils-comp" name="Coils — compulsory-capable Troops" targetId="r45-al-coils-compulsory" hidden="false" /></categoryLinks>
      <infoLinks><infoLink id="r36-link-a8da21f74c17" name="Counter-Attack" hidden="false" targetId="r36-shared-counter-attack-478972a" type="rule" /></infoLinks><rules>
        <rule name="Standard Wargear" id="r35-destroyer-troops-destroyer-standard" hidden="false">
          <description>Every model is equipped with Power Armour, two Bolt Pistols, a Chainsword, Frag Grenades and Rad Grenades unless replaced by an option below.</description>
        </rule>
        <rule name="Legiones Astartes" id="r35-destroyer-troops-destroyer-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Dual Pistols" id="r35-destroyer-troops-destroyer-dual" hidden="false">
          <description>A model with this rule may fire both of its Pistol weapons during the Shooting phase. Both pistols must be fired at the same target. If it fires both pistols, it may not fire another weapon during that Shooting phase.</description>
        </rule>
        <rule name="Destroyer Cadre" id="r35-destroyer-troops-destroyer-cadre" hidden="false">
          <description>A Legion Destroyer Squad may only be joined by an Independent Character with the Legion Moritat Consul upgrade. No other Independent Character may join the squad.</description>
        </rule>
        <rule name="Rad Grenades" id="r35-destroyer-troops-destroyer-rad" hidden="false">
          <description>During any player turn in which the unit charges or is itself charged, enemy non-vehicle models engaged with it suffer -1 Toughness until the end of the Assault phase. This affects Instant Death and is not cumulative.</description>
        </rule>
        <rule name="Dedicated Transport" id="r35-destroyer-troops-destroyer-transport-rule" hidden="false">
          <description>Without Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added.</description>
        </rule>
        <rule name="Rite of War Selection" id="r35-destroyer-troops-note" hidden="false">
          <description>This Troops entry is available while Legion Destroyer Company is selected.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Destroyers" hidden="false" id="r35-destroyer-troops-destroyer-included" defaultAmount="4">
          <constraints>
            <constraint id="r35-destroyer-troops-destroyer-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r35-destroyer-troops-destroyer-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Destroyers (included)" id="r35-destroyer-troops-destroyer-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="pts" value="20" />
          </costs>
        <modifiers><modifier id="r19-axis-max-r35-destroyer-troops-destroyer-included" type="set" field="r35-destroyer-troops-destroyer-included-min" value="9"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xv-0-the-axis-of-dissolution" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Destroyer Sergeant" hidden="false" id="r35-destroyer-troops-destroyer-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="r35-destroyer-troops-destroyer-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r35-destroyer-troops-destroyer-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Destroyer Sergeant" id="r35-destroyer-troops-destroyer-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="r71-nl-gen-12-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r71-nl-gen-12-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r71-nl-gen-12-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r35-destroyer-troops-destroyer-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
