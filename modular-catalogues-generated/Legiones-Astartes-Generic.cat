                  </costs>
                  <rules>
                    <rule name="Iron Halo" id="r32-soh-long-march-terminator-sgt-halo-rule" hidden="false">
                      <description>4+ Invulnerable Save; normally no more than one Iron Halo may be selected in an army.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Master-crafted Weapon" hidden="false" id="r32-soh-long-march-terminator-sgt-mastercraft">
                  <constraints>
                    <constraint id="r32-soh-long-march-terminator-sgt-mastercraft-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <rules>
                    <rule name="Master-crafted Weapon" id="r32-soh-long-march-terminator-sgt-mastercraft-rule" hidden="false">
                      <description>Apply to one specific weapon; re-roll one failed To Hit roll with that weapon per player turn. Grenades and expendable equipment may not be Master-crafted.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="r32-soh-long-march-terminator-sgt-signum">
                  <constraints>
                    <constraint id="r32-soh-long-march-terminator-sgt-signum-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
