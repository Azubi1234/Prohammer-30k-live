                                <characteristic name="Type" typeId="ranged-type">Focused Witchfire</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r61-librarian-power2-telekinesis-crush-rule" name="Crush" hidden="false">
