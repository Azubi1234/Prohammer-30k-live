                <cost name="Points" typeId="pts" value="0" />
              </costs>
              </selectionEntry>
            <selectionEntry type="upgrade" name="XX Legion — Alpha Legion" id="legion-xx" hidden="false" import="true">
              <infoLinks><infoLink id="legion-xx-named" name="Legiones Astartes (Alpha Legion)" targetId="r45-al-legiones-astartes-alpha-legion" type="rule" hidden="false" /><infoLink id="legion-xx-mutable-rule" name="Mutable Tactics" targetId="r45-al-mutable-tactics" type="rule" hidden="false" /><infoLink id="legion-xx-hubris" name="Martial Hubris" targetId="r45-al-martial-hubris" type="rule" hidden="false" /><infoLink id="legion-xx-network" name="Infiltration Network" targetId="r45-al-infiltration-network" type="rule" hidden="false" /></infoLinks><modifiers /><constraints>
                <constraint id="legion-xx-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="0" />
              </costs>
              <selectionEntryGroups>
                <selectionEntryGroup id="r46-al-mutable-tactics" name="Mutable Tactics — choose exactly one" hidden="false" collective="false" import="true">
                  <constraints>
                    <constraint id="r46-al-mutable-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r46-al-mutable-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
                  <selectionEntries><selectionEntry id="r46-al-mutable-0" name="Counter-Attack" type="upgrade" hidden="false"><infoLinks><infoLink id="r46-al-mutable-0-effect" name="Counter-Attack" targetId="r36-shared-counter-attack-478972a" type="rule" hidden="false" /></infoLinks><constraints><constraint id="r46-al-mutable-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry><selectionEntry id="r46-al-mutable-1" name="Furious Charge" type="upgrade" hidden="false"><infoLinks><infoLink id="r46-al-mutable-1-effect" name="Furious Charge" targetId="r36-shared-furious-charge-5750d05" type="rule" hidden="false" /></infoLinks><constraints><constraint id="r46-al-mutable-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry><selectionEntry id="r46-al-mutable-2" name="Infiltrate" type="upgrade" hidden="false"><infoLinks><infoLink id="r46-al-mutable-2-effect" name="Infiltrate" targetId="r36-shared-infiltrate-88c13dc" type="rule" hidden="false" /></infoLinks><constraints><constraint id="r46-al-mutable-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry><selectionEntry id="r46-al-mutable-3" name="Move Through Cover" type="upgrade" hidden="false"><infoLinks><infoLink id="r46-al-mutable-3-effect" name="Move Through Cover" targetId="r36-shared-move-through-cover-b95132d" type="rule" hidden="false" /></infoLinks><constraints><constraint id="r46-al-mutable-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeC