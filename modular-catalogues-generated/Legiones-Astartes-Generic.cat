                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Malediction</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-burning-powers-p-telepathy-terrify-r61-librarian-power2-telepathy-terrify-rule" name="Terrify" hidden="false">
                              <description>The target enemy unit suffers -1 Leadership, treats all opposing units as causing Fear and must take a Casualty test at the end of the turn.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-burning-powers-p-telepathy-terrify-r80-ih-consul-cat-34" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                          </categoryLinks>
                        </selectionEntry>
                        </selectionEntries><constraints><constraint id="r37-burning-powers-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r37-burning-powers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntryGroup></selectionEntryGroups><costs>
        <cost name="Points" typeId="pts" value="30" />
