                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Perfect Timing" id="r29-lib-power-10" hidden="false" import="true">
                      <constraints>
                        <constraint id="r29-lib-power-10-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Perfect Timing" id="r29-lib-power-10-rule" hidden="false">
                          <description>Blessing — targets Psyker. Psyker and joined unit ignore Cover when shooting.</description>
