          <rules>
            <rule name="Command Retinue" id="hq-centurion-ret-rule" hidden="false">
              <description>A Centurion may select one Legion Command Squad. If equipped with any form of Terminator Armour, he may instead select one Legion Terminator Command Squad. The character and squad count as a single HQ selection but may deploy and operate separately.</description>
