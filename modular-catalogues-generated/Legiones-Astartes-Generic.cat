                    <constraint id="r46-al-reward-14-donor-r63-sw-varagyr-transport-lr-hs-lr-patterns-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="model" name="Land Raider Phobos" id="r46-al-reward-14-donor-r63-sw-varagyr-transport-lr-hs-lr-phobos" hidden="false" import="true" defaultAmount="1">
                      <constraints>
                        <constraint id="r46-al-reward-14-donor-r63-sw-varagyr-transport-lr-hs-lr-phobos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <infoLinks><infoLink id="r46-al-reward-14-donor-r36-link-91cf763b98ab" name="Assault Vehicle" hidden="false" targetId="r36-shared-assault-vehicle-72eb9a3" type="rule" /></infoLinks><costs>
                        <cost name="Points" typeId="pts" value="250" />
                      </costs>
                      <profiles>
                        <profile name="Land Raider Phobos" id="r46-al-reward-14-donor-r63-sw-varagyr-transport-lr-hs-lr-phobos-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                          <characteristics>
                            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                            <characteristic name="Front" typeId="vehicle-front">14</characteristic>
                            <characteristic name="Side" typeId="vehicle-side">14</characteristic>
                            <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="Twin-linked Lascannon" id="r46-al-reward-14-donor-r63-sw-varagyr-transport-lr-hs-lr-phobos-las" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
                            <characteristic name="S" typeId="ranged-s">9</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Heavy 1, Twin-linked</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="Twin-linked Heavy Bolter" id="r46-al-reward-14-donor-r63-sw-varagyr-transport-lr-hs-lr-phobos-hb" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                            <characteristic name="S" typeId="ranged-s">5</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
