        </selectionEntryGroup>
      <selectionEntryGroup id="r32-soh-long-march-r19-ts-terminator-unit-brotherhood-disciplines" name="Psychic Brotherhood — Psychic Discipline(s)" hidden="true"><constraints><constraint id="r32-soh-long-march-r19-ts-terminator-unit-brotherhood-disc-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /><constraint id="r32-soh-long-march-r19-ts-terminator-unit-brotherhood-disc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><entryLink id="r32-soh-long-march-r19-ts-terminator-unit-brotherhood-disc-biomancy" name="Biomancy" targetId="r41-universal-gear-706f9080995c1b" type="selectionEntry" import="true" hidden="true"><constraints><constraint id="r32-soh-long-march-r19-ts-terminator-unit-brotherhood-disc-biomancy-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink><entryLink id="r32-soh-long-march-r19-ts-terminator-unit-brotherhood-disc-divination" name="Divination" targetId="r41-universal-gear-bfc6aadae625e5" type="selectionEntry" import="true" hidden="true"><constraints><constraint id="r32-soh-long-march-r19-ts-terminator-unit-brotherhood-disc-divination-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink><entryLink id="r32-soh-long-march-r19-ts-terminator-unit-brotherhood-disc-pyromancy" name="Pyromancy" targetId="r41-universal-gear-60848d7505639d" type="selectionEntry" import="true" hidden="true"><constraints><constraint id="r32-soh-long-march-r19-ts-terminator-unit-brotherhood-disc-pyromancy-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink><entryLink id=