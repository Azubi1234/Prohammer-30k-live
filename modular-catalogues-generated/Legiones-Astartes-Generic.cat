    </selectionEntry>
    <selectionEntry type="unit" name="Legion Heavy Support Squad" id="hs-heavy-support-squad" hidden="false" import="true">
      <modifiers /><categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-heavy-support-squad-cat" primary="true" name="Heavy Support" hidden="false" />
      <categoryLink id="hs-heavy-support-squad-r40-covsup" name="Covenant of Fire — Fast/Heavy choices" targetId="r40-sal-covenant-support" hidden="false" /><categoryLink id="hs-heavy-support-squad-r43-rg-heavy" name="Raven Guard — Heavy Support count" targetId="r43-rg-heavy-count" hidden="false" /><categoryLink id="hs-heavy-support-squad-r43-rg-decap-heavy" name="Decapitation Strike — Heavy Support" targetId="r43-rg-decap-heavy" hidden="false" /></categoryLinks>
      <costs>
        <cost name="Points" typeId="pts" value="0" />
      </costs>
      <profiles>
        <profile name="Legion Space Marine" id="hs-hss-marine-prof" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">1</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">1</characteristic>
            <characteristic name="Ld" typeId="model-ld">8</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Legion Sergeant" id="hs-hss-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">1</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">2</characteristic>
            <characteristic name="Ld" typeId="model-ld">9</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="hs-hss-wargear" hidden="false">
          <description>4 Legion Space Marines and 1 Legion Sergeant. Power Armour, Bolter, Bolt pistol and Frag grenades. The unit has Legiones Astartes; the Sergeant is a Character.</description>
        </rule>
        <rule name="Sergeant Armoury" id="hs-hss-armoury-rule" hidden="false">
          <description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Normal Sergeant weapon limits apply. Unit-specific replacements take precedence over duplicate Armoury purchases.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" name="Squad Models" id="hs-hss-additional" hidden="false" import="true" defaultAmount="5">
          <constraints>
            <constraint id="hs-hss-additional-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" />
            <constraint id="hs-hss-additional-r56-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
        </selectionEntry>
        <entryLink id="hs-hss-hardened" name="Hardened Armour (entire squad)" targetId="r41-universal-gear-1a82881a741192" type="selectionEntry" import="true" hidden="false"><constraints>
            <constraint id="hs-hss-hardened-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          </entryLink><selectionEntry id="r71-nl-gen-8-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r71-nl-gen-8-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r71-nl-gen-8-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="hs-hss-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-8-stealth-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          <modifier id="r71-nl-gen-8-stealth-show-r62-shat-b3754fd424cf" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-fbbd1624e48b" shared="true" includeChildSelections="true" includeChildForces="false" />
                  <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule id="r71-nl-gen-8-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.

Stealth: Adds +1 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 6+ Cover Save. Does not stack with Shrouded.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-9" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-9-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-9-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.

Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-9-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          <modifier id="r71-nl-bj-9-show-r62-shat-973a86636baf" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-fbbd1624e48b" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
