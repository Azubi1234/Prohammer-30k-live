                          <rules>
                            <rule id="r37-burning-powers-p-telepathy-psychic-shriek-r61-librarian-power2-telepathy-psychic-shriek-rule" name="Psychic Shriek" hidden="false">
                              <description>Roll 3D6 and subtract the target unit's Leadership. The unit suffers a number of Wounds equal to the result, with no Armour or Cover saves.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-burning-powers-p-telepathy-psychic-shriek-r80-ih-consul-cat-31" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
