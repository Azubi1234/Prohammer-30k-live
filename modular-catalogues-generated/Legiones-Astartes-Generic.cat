    <selectionEntry id="r46-wb-burning-lore" name="Burning Lore" type="upgrade" hidden="false" import="true">
      <infoLinks><infoLink id="r38-r46-wb-burning-lore-canonical" name="Burning Lore" targetId="r38-wb-shared-burning-lore" type="rule" hidden="false" /></infoLinks><rules /><selectionEntryGroups><selectionEntryGroup id="r37-burning-powers" name="Burning Lore — select 1 power" hidden="false"><selectionEntries><selectionEntry id="r37-burning-powers-p-biomancy-endurance" name="Biomancy — Endurance" type="upgrade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r37-burning-powers-p-biomancy-endurance-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="0" />
                          </costs>
                          <profiles>
                            <profile id="r37-burning-powers-p-biomancy-endurance-r61-librarian-power2-biomancy-endurance-profile" name="Endurance" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                                <characteristic name="S" typeId="ranged-s">—</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-burning-powers-p-biomancy-endurance-r61-librarian-power2-biomancy-endurance-rule" name="Endurance" hidden="false">
                              <description>Target friendly unit gains Eternal Warrior, Feel No Pain (5+) and Relentless.

Relentless: Model may move and fire Heavy, Ordnance, Salvo or Rapid Fire weapons as if it remained stationary. It may still charge even after firing such weapons.
Eternal Warrior: Immune to Instant Death / Massive Wounds. The model suffers 1 Wound instead of D3 Wounds.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-burning-powers-p-biomancy-endurance-r80-ih-consul-cat-8" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                          </categoryLinks>
                        </selectionEntry>
                        <selectionEntry id="r37-burning-powers-p-biomancy-enfeeble" name="Biomancy — Enfeeble" type="upgrade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r37-burning-powers-p-biomancy-enfeeble-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="0" />
                          </costs>
                          <profiles>
                            <profile id="r37-burning-powers-p-biomancy-enfeeble-r61-librarian-power2-biomancy-enfeeble-profile" name="Enfeeble" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">24"</characteristic>
                                <characteristic name="S" typeId="ranged-s">—</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Malediction</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-burning-powers-p-biomancy-enfeeble-r61-librarian-power2-biomancy-enfeeble-rule" name="Enfeeble" hidden="false">
                              <description>Target enemy unit suffers -1 Strength and -1 Toughness and treats all movement as Difficult Terrain.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-burning-powers-p-biomancy-enfeeble-r80-ih-consul-cat-5" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                          </categoryLinks>
                        </selectionEntry>
                        <selectionEntry id="r37-burning-powers-p-biomancy-haemorrhage" name="Biomancy — Haemorrhage" type="upgrade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r37-burning-powers-p-biomancy-haemorrhage-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="0" />
                          </costs>
                          <profiles>
                            <profile id="r37-burning-powers-p-biomancy-haemorrhage-r61-librarian-power2-biomancy-haemorrhage-profile" name="Haemorrhage" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">18"</characteristic>
                                <characteristic name="S" typeId="ranged-s">Special</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">Special</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Focused Witchfire</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-burning-powers-p-biomancy-haemorrhage-r61-librarian-power2-biomancy-haemorrhage-rule" name="Haemorrhage" hidden="false">
                              <description>Target model must pass two Toughness tests or suffer a Wound with no Armour or Cover save. If slain, select another model within 2 inches; it takes one Toughness test or suffers a Wound. Continue until a test is passed.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-burning-powers-p-biomancy-haemorrhage-r80-ih-consul-cat-9" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                          </categoryLinks>
                        </selectionEntry>
                        <selectionEntry id="r37-burning-powers-p-biomancy-iron-arm" name="Biomancy — Iron Arm" type="upgrade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r37-burning-powers-p-biomancy-iron-arm-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="0" />
                          </costs>
                          <profiles>
                            <profile id="r37-burning-powers-p-biomancy-iron-arm-r61-librarian-power2-biomancy-iron-arm-profile" name="Iron Arm" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                              <characteristics>
                                <characteristic name="Range" typeId="ranged-range">Self</characteristic>
                                <characteristic name="S" typeId="ranged-s">—</characteristic>
                                <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                          <rules>
                            <rule id="r37-burning-powers-p-biomancy-iron-arm-r61-librarian-power2-biomancy-iron-arm-rule" name="Iron Arm" hidden="false">
                              <description>The Psyker gains +2 Strength and +1 Toughness.</description>
                            </rule>
                          </rules>
                          <categoryLinks>
                            <categoryLink id="r37-burning-powers-p-biomancy-iron-arm-r80-ih-consul-cat-4" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                          </categoryLinks>
                        </selectionEntry>
                        <selectionEntry id="r37-burning-powers-p-biomancy-life-leech" name="Biomancy — Life Leech" type="upgrade" hidden="false" import="true">
                          <constraints>
