    <selectionEntry type="unit" name="Achilles-Alpha Pattern Land Raider" id="hs-achilles-alpha" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-achilles-alpha-cat" primary="true" name="Heavy Support" hidden="false" />
      <categoryLink id="hs-achilles-alpha-r40-covsup" name="Covenant of Fire — Fast/Heavy choices" targetId="r40-sal-covenant-support" hidden="false" /><categoryLink id="hs-achilles-alpha-r43-rg-heavy" name="Raven Guard — Heavy Support count" targetId="r43-rg-heavy-count" hidden="false" /><categoryLink id="hs-achilles-alpha-r43-rg-decap-heavy" name="Decapitation Strike — Heavy Support" targetId="r43-rg-decap-heavy" hidden="false" /></categoryLinks>
      <costs>
        <cost name="Points" typeId="pts" value="300" />
      </costs>
      <profiles>
        <profile name="Achilles-Alpha" id="hs-achilles-alpha-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <characteristics>
            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
            <characteristic name="Front" typeId="vehicle-front">14</characteristic>
            <characteristic name="Side" typeId="vehicle-side">14</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
          </characteristics>
        </profile>
        <profile name="Quad Launcher — Frag" id="hs-aa-frag" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12–60"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">5</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Shell Shock</characteristic>
          </characteristics>
        </profile>
        <profile name="Quad Launcher — Shatter" id="hs-aa-shatter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 4, Sunder</characteristic>
          </characteristics>
        </profile>
        <profile name="Twin-linked Volkite Culverin" id="hs-aa-volkite" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">45"</characteristic>
            <characteristic name="S" typeId="ranged-s">6</characteristic>
            <characteristic name="AP" typeId="ranged-ap">5</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 4, Rending, Twin-linked</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="hs-aa-wg" hidden="false">
          <description>Quad Launcher with Frag and Shatter Shells, two Twin-linked Volkite Culverins, Extra Armour, Searchlight and Smoke Launchers. Power of the Machine Spirit; Transport Capacity 6.

Twin-Linked: Re-roll failed To Hit rolls with this weapon. Does not count as two weapons. Twin-linked Template weapons automatically hit all models fully or partially under the Template.</description>
        </rule>
        <rule name="Enhanced Ferromantic Rites" id="hs-aa-ferro" hidden="false">
          <description>Melta weapons do not roll an additional Armour Penetration die; Lance weapons do not reduce the Achilles-Alpha’s Armour Value; apply -1 to Vehicle Damage table rolls caused by Penetrating Hits.</description>
        </rule>
        <rule name="Galvanic Traction Drive" id="hs-aa-traction" hidden="false">
          <description>May re-roll failed Dangerous Terrain tests.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Quad Launcher Ammunition" id="hs-aa-ammo" hidden="false">
          <selectionEntries>
            <selectionEntry type="upgrade" name="Incendiary Shells" id="hs-aa-incendiary" hidden="false" import="true">
              <constraints>
                <constraint id="hs-aa-incendiary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <profiles>
                <profile name="Quad Launcher — Incendiary" id="hs-aa-incendiary-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">12–60"</characteristic>
                    <characteristic name="S" typeId="ranged-s">4</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">5</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Ignores Cover</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Splinter Shells" id="hs-aa-splinter" hidden="false" import="true">
              <constraints>
                <constraint id="hs-aa-splinter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
