    <selectionEntry type="unit" import="true" name="Legion Rapier Weapons Battery" hidden="false" id="rapier-unit">
      <categoryLinks>
        <categoryLink targetId="cat-elites" id="rapier-unit-cat" primary="true" name="Elites" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="pts" value="0" />
      </costs>
      <rules>
        <rule name="Crew" id="rapier-crew-rule" hidden="false">
          <description>Each Rapier Carrier has two designated Legion Space Marine Crew equipped with Power Armour, Bolt Pistol and Frag Grenades. Crew have the Legiones Astartes special rule.</description>
        </rule>
        <rule name="Rapier Battery" id="rapier-battery-rule" hidden="false">
          <description>Follows the normal ProHammer Artillery rules. A Rapier requires at least one of its designated crew within 2" to move or fire. One crew model operates the Rapier when it fires and may not fire another weapon that Shooting phase. Rapier Carriers may move normally while accompanied by crew, but may not fire in a turn in which they moved. Rapier Carriers cannot be transported unless another rule explicitly states otherwise.</description>
        </rule>
        <rule name="Shell Shock" id="rapier-shellshock" hidden="false">
          <description>Any Pinning test caused by a weapon with Shell Shock suffers a -1 Leadership modifier.</description>
        </rule>
      </rules>
      <profiles>
        <profile name="Legion Space Marine Crew" id="rapier-crew-prof" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">1</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">1</characteristic>
            <characteristic name="Ld" typeId="model-ld">8</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Rapier Carrier" id="rapier-carrier-prof" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">-</characteristic>
            <characteristic name="BS" typeId="model-bs">-</characteristic>
            <characteristic name="S" typeId="model-s">-</characteristic>
            <characteristic name="T" typeId="model-t">7</characteristic>
            <characteristic name="W" typeId="model-w">2</characteristic>
            <characteristic name="I" typeId="model-i">-</characteristic>
            <characteristic name="A" typeId="model-a">-</characteristic>
            <characteristic name="Ld" typeId="model-ld">-</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Rapier Carrier" hidden="false" id="rapier-carrier" defaultAmount="1">
          <constraints>
            <constraint id="rapier-carrier-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="rapier-carrier-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Battery Weapon (all Rapiers use the same weapon)" id="rapier-armament" hidden="false">
          <constraints>
            <constraint id="rapier-armament-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="rapier-armament-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Quad Heavy Bolter" hidden="false" id="rapier-arm-qhb" defaultAmount="1">
              <constraints>
                <constraint id="rapier-arm-qhb-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <profiles>
                <profile name="Quad Heavy Bolter" id="rapier-qhb-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                    <characteristic name="S" typeId="ranged-s">5</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 6, Twin-linked</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Laser Destroyer (+20 pts per Rapier)" hidden="false" id="rapier-arm-laser">
              <constraints>
                <constraint id="rapier-arm-laser-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="increment" value="20" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="rapier-carrier" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Laser Destroyer" id="rapier-laser-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">48"</characteristic>
                    <characteristic name="S" typeId="ranged-s">10</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">1</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 1, Twin-linked</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Quad Launcher (+20 pts per Rapier)" hidden="false" id="rapier-arm-quad">
              <constraints>
                <constraint id="rapier-arm-quad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="increment" value="20" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="rapier-carrier" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Quad Launcher - Frag" id="rapier-frag-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">12-60"</characteristic>
                    <characteristic name="S" typeId="ranged-s">5</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">5</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Shell Shock</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Graviton Cannon (+35 pts per Rapier)" hidden="false" id="rapier-arm-grav">
              <constraints>
                <constraint id="rapier-arm-grav-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="increment" value="35" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="rapier-carrier" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Graviton Cannon" id="rapier-grav-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                    <characteristic name="S" typeId="ranged-s">Special</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 1, Large Blast, Concussive, Graviton</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Graviton" id="rapier-grav-rule" hidden="false">
                  <description>Against non-vehicle models, the number required To Wound is equal to the target's Armour Save. Against vehicles, roll a D6 for each hit; on a 6 the vehicle is Immobilised instead of making a normal Armour Penetration roll.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Quad Launcher Additional Ammunition" id="rapier-ammo" hidden="true">
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="rapier-arm-quad" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Incendiary Shells (+5 pts per Rapier)" hidden="false" id="rapier-ammo-inc">
              <constraints>
                <constraint id="rapier-ammo-inc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="increment" value="5" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="rapier-carrier" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Quad Launcher - Incendiary" id="rapier-inc-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">12-60"</characteristic>
                    <characteristic name="S" typeId="ranged-s">4</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">5</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Ignores Cover</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Shatter Shells (+10 pts per Rapier)" hidden="false" id="rapier-ammo-shatter">
              <constraints>
                <constraint id="rapier-ammo-shatter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="increment" value="10" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="rapier-carrier" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Quad Launcher - Shatter" id="rapier-shatter-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                    <characteristic name="S" typeId="ranged-s">8</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 4, Sunder</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Sunder" id="rapier-sunder-rule" hidden="false">
                  <description>May re-roll failed Armour Penetration rolls against vehicles.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Splinter Shells (+10 pts per Rapier)" hidden="false" id="rapier-ammo-splinter">
              <constraints>
                <constraint id="rapier-ammo-splinter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="increment" value="10" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="rapier-carrier" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Quad Launcher - Splinter" id="rapier-splinter-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">12-36"</characteristic>
                    <characteristic name="S" typeId="ranged-s">2</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Rending</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Phosphex Canister Shot (+20 pts per Rapier) — requires Siege Breaker/permission" hidden="false" id="rapier-ammo-phosphex">
              <constraints>
                <constraint id="rapier-ammo-phosphex-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="increment" value="20" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="rapier-carrier" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              <modifier id="rapier-ammo-phosphex-r40-sal-hide" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xviii" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="rapier-ammo-phosphex-r40-sal-hide-r62-shat-fd90fff07a38" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-c04bc06bd114" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers>
              <infoLinks><infoLink id="r36-link-475e5e08c37b" name="Lingering Death" hidden="false" targetId="r36-exact-lingering-death-99f0850" type="rule" /></infoLinks><profiles>
                <profile name="Quad Launcher - Phosphex" id="rapier-phosphex-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">12-36"</characteristic>
                    <characteristic name="S" typeId="ranged-s">4</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">3</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Poisoned (3+), Crawling Fire, Lingering Death</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Restriction" id="rapier-phosphex-restrict" hidden="false">
                  <description>May only be selected if the Detachment includes a Siege Breaker or another model whose rules specifically permit access to Phosphex ammunition. This requirement must be satisfied elsewhere in the roster.</description>
                </rule>
                </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
