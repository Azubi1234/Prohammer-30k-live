lse"><infoLinks><infoLink id="r62-shat-assign-513d7c469dff-info-75dd0ee7c4b0" name="Legiones Astartes (Raven Guard)" targetId="r43-rg-legiones-astartes-raven-guard" type="rule" hidden="false" /><infoLink id="r62-shat-assign-513d7c469dff-info-9ab1bf1e85f1" name="Surgical Strike" targetId="r43-rg-surgical-strike" type="rule" hidden="false" /><infoLink id="r62-shat-assign-513d7c469dff-info-047f7cf538c3" name="Rapid Reaction" targetId="r43-rg-rapid-reaction" type="rule" hidden="false" /><infoLink id="r62-shat-assign-513d7c469dff-info-db41feea9956" name="Shadow Masters" targetId="r43-rg-shadow-masters" type="rule" hidden="false" /><infoLink id="r62-shat-assign-513d7c469dff-info-c90b6dc986fe" name="Limited Vehicles" targetId="r43-rg-limited-vehicles" type="rule" hidden="false" /><infoLink id="r62-shat-assign-513d7c469dff-info-cd49071cd572" name="Raven's Talons" targetId="r43-rg-raven-s-talons" type="rule" hidden="false" /><infoLink id="r62-shat-assign-513d7c469dff-info-9c3d09934245" name="Infravisor" targetId="r43-rg-infravisor" type="rule" hidden="false" /><infoLink id="r62-shat-assign-513d7c469dff-info-3ddc92495b50" name="Shroud Bombs" targetId="r43-rg-shroud-bombs" type="rule" hidden="false" /><infoLink id="r62-shat-assign-513d7c469dff-info-ca5136e64e22" name="Cameleoline" targetId="r43-rg-cameleoline" type="rule" hidden="false" /><infoLink id="r62-shat-assign-513d7c469dff-info-abb7821cf8bd" name="Teleportation Transponders" targetId="r43-rg-teleportation-transponders" type="rule" hidden="false" /></infoLinks><rules><rule id="r62-shat-assign-513d7c469dff-identity" name="Legiones Astartes (Raven Guard)" hidden="false"><description>This unit is assigned to Raven Guard for the Shattered Legions Theme. It uses the normal Raven Guard Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-513d7c469dff-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xix" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-513d7c469dff-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-d2c7dcd60005" name="Alpha Legion" type="upgrade" hidden="false"><infoLinks><infoLink id="r62-shat-assign-d2c7dcd60005-info-95ff4019ee2d" name="Legiones Astartes (Alpha Legion)" targetId="r45-al-legiones-astartes-alpha-legion" type="rule" hidden="false" /><infoLink id="r62-shat-assign-d2c7dcd60005-info-91a8157a1170" name="Mutable Tactics" targetId="r45-al-mutable-tactics" type="rule" hidden="false" /><infoLink id="r62-shat-assign-d2c7dcd60005-info-072bb44b5ef9" name="Martial Hubris" targetId="r45-al-martial-hubris" type="rule" hidden="false" /><infoLink id="r62-shat-assign-d2c7dcd60005-info-2bb0015445ef" name="Infiltration Network" targetId="r45-al-infiltration-network" type="rule" hidden="false" /></infoLinks><rules><rule id="r62-shat-assign-d2c7dcd60005-identity" name="Legiones Astartes (Alpha Legion)" hidden="false"><description>This unit is assigned to Alpha Legion for the Shattered Legions Theme. It uses the normal Alpha Legion Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-d2c7dcd60005-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xx" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-d2c7dcd60005-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry></selectionEntries><modifiers><modifier id="r62-shat-assign-group-fa91e4b0964b-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier><modifier id="r62-shat-assign-group-fa91e4b0964b-min-on" type="set" field="r62-shat-assign-group-fa91e4b0964b-min" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-group-fa91e4b0964b-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r62-shat-assign-group-fa91e4b0964b-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntryGroup></selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="false" id="veteran-unit">
      <modifiers /><categoryLinks>
        <categoryLink targetId="cat-elites" id="veteran-unit-cat" primary="true" name="Elites" hidden="false" />
      </categoryLinks>
      <infoLinks><infoLink id="r36-link-88a9abb8a45a" name="Veteran Tactics" hidden="false" targetId="r36-exact-veteran-tactics-f7215db" type="rule" /></infoLinks><rules>
        <rule name="Standard Wargear" id="veteran-standard" hidden="false">
          <description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</description>
        </rule>
        <rule name="Legiones Astartes" id="veteran-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Dedicated Transport" id="veteran-transport-rule" hidden="false">
          <description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Veterans" hidden="false" id="veteran-included" defaultAmount="4">
          <constraints>
            <constraint id="veteran-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="veteran-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Veterans (included)" id="veteran-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="pts" value="20" />
          </costs>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Veteran Sergeant" hidden="false" id="veteran-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="veteran-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="veteran-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Veteran Sergeant" id="veteran-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <entryLink id="r37-assault-dfa-veteran-unit" name="Death from Above (Legion Assault Company)" targetId="r41-universal-gear-4a923840fad5ad" type="selectionEntry" import="true" hidden="true"><constraints>
            <constraint id="r37-assault-dfa-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-assault" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </entryLink><selectionEntry id="r71-nl-gen-4-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r71-nl-gen-4-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r71-nl-gen-4-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="veteran-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-4-stealth-cost-1" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="veteran-sergeant" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-4-stealth-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          <modifier id="r71-nl-gen-4-stealth-show-r62-shat-e8a6d65f65f7" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-ec7326b241e3" shared="true" includeChildSelections="true" includeChildForces="false" />
                  <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule id="r71-nl-gen-4-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.

Stealth: Adds +1 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 6+ Cover Save. Does not stack with Shrouded.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-4" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-4-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.

Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-4-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          <modifier id="r71-nl-bj-4-show-r62-shat-650a0e3dd596" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-ec7326b241e3" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
                </conditionGroup>
