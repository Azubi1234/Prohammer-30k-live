    <selectionEntry type="unit" import="true" name="Legion Contemptor Dreadnought — Keeper of the Keys" hidden="true" id="r40-sal-nomus-contemptor-hq">
      <categoryLinks>
        <categoryLink targetId="cat-elites" id="r40-sal-nomus-contemptor-hq-copy-contemptor-unit-cat" primary="false" name="Elites" hidden="false" />
      <categoryLink id="r40-sal-nomus-contemptor-hq-cat-cat-hq" name="HQ" targetId="cat-hq" hidden="false" primary="true" /><categoryLink id="r40-sal-nomus-contemptor-hq-lim" name="Nomus — Keeper of the Keys" targetId="r40-sal-nomus-dread-hq" hidden="false" /></categoryLinks>
      <infoLinks><infoLink id="r40-sal-nomus-contemptor-hq-copy-r36-link-091a90ada260" name="Fleet" hidden="false" targetId="r36-shared-fleet-e199151" type="rule" /></infoLinks><costs>
        <cost name="Points" typeId="pts" value="155" />
      </costs>
      <profiles>
        <profile name="Legion Contemptor Dreadnought" id="r40-sal-nomus-contemptor-hq-copy-contemptor-prof" typeId="prof-walker" typeName="Walker" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="walker-ws">5</characteristic>
            <characteristic name="BS" typeId="walker-bs">5</characteristic>
            <characteristic name="S" typeId="walker-s">7</characteristic>
            <characteristic name="Front" typeId="walker-front">13</characteristic>
            <characteristic name="Side" typeId="walker-side">12</characteristic>
            <characteristic name="Rear" typeId="walker-rear">10</characteristic>
            <characteristic name="I" typeId="walker-i">4</characteristic>
            <characteristic name="A" typeId="walker-a">2</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="r40-sal-nomus-contemptor-hq-copy-contemptor-standard" hidden="false">
          <description>Twin-linked Heavy Bolter; Dreadnought Close Combat Weapon with built-in Twin-linked Bolter; Smoke Launchers; Searchlight.

Twin-Linked: Re-roll failed To Hit rolls with this weapon. Does not count as two weapons. Twin-linked Template weapons automatically hit all models fully or partially under the Template.</description>
        </rule>
        <rule name="Atomantic Shielding" id="r40-sal-nomus-contemptor-hq-copy-contemptor-atomantic" hidden="false">
          <description>Each time the vehicle suffers a Glancing or Penetrating Hit from shooting, roll a D6; on a 5+ the hit is ignored. Against a Glancing or Penetrating Hit in close combat, the hit is ignored on a 6+. Make this roll before the Vehicle Damage table. If the vehicle suffers an Explodes! result, add +1" to the explosion radius.</description>
        </rule>
        <rule name="Paired Close-Combat Arms" id="r40-sal-nomus-contemptor-hq-copy-contemptor-paired" hidden="false">
          <description>If equipped with two Dreadnought Close Combat Weapons, the Contemptor gains +1 Attack. This bonus is not included in the profile.</description>
        </rule>
      <rule id="r40-sal-nomus-contemptor-hq-note" name="Keeper of the Keys" hidden="false"><description>Selected through Nomus Rhy'tan. This is a non-compulsory HQ choice and may not be the army's Warlord.</description></rule></rules>
