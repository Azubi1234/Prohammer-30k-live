      <rules>
        <rule id="r46-al-reward-9-donor-r63-sw-slayer-comp" name="Unit Composition" hidden="false">
          <description>4 Grey Slayers and 1 Grey Slayer Huscarl; may include up to 15 additional Grey Slayers (maximum 20 models). The Huscarl is a Character.</description>
        </rule>
        <rule id="r46-al-reward-9-donor-r63-sw-slayer-wg" name="Wargear" hidden="false">
          <description>Power Armour, Bolter and Close-combat weapon.</description>
        </rule>
        <rule id="r46-al-reward-9-donor-r63-sw-slayer-trugrit" name="True Grit" hidden="false">
          <description>A model armed with a Bolter and Close-combat weapon receives +1 Attack in close combat, but does not receive the normal +1 Attack for charging.</description>
        </rule>
        <rule id="r46-al-reward-9-donor-r63-sw-slayer-pack" name="Pack Assault" hidden="false">
          <description>If this unit charges an enemy unit that was already engaged by another friendly Space Wolves unit at the start of the Assault phase, every Grey Slayer receives +1 Attack for that Assault phase.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r46-al-reward-9-donor-r63-sw-slayer-shields" name="Bolter Replacements — any model" hidden="false" collective="false" import="true">
