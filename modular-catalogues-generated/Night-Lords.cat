        </modifier>
        <modifier id="r62-fixed-hide-const-70dcbd2bcd97" type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-viii" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier></modifiers>
      <constraints>
        <constraint id="r41-unit-viii-8-flaymaster-mawdrym-llansahai-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <infoLinks><infoLink id="r36-link-338b8d5cd5e1" name="Independent Character" hidden="false" targetId="r36-shared-independent-character-4fbd2ae" type="rule" /><infoLink id="r36-link-8bb35d5297e9" name="Fearless" hidden="false" targetId="r36-shared-fearless-8699dbc" type="rule" /></infoLinks><costs>
        <cost name="Points" typeId="pts" value="125" />
      </costs>
      <rules>
        <rule id="r71-nl-mawdrym-wargear" name="Wargear" hidden="false">
          <description>Power Armour; Refractor Field; Narthecium; Red Jaqa; Bolt pistol; Frag grenades.</description>
        </rule>
        <rule id="r71-nl-mawdrym-rule-0" name="Red Jaqa" hidden="false">
          <description>Red Jaqa is a Rending Weapon. Any natural To Wound roll of 6 made with Red Jaqa inflicts a Massive Wound (D3) instead of a normal Wound.</description>
        </rule>
        <rule id="r71-nl-mawdrym-rule-1" name="Devil’s Luck" hidden="false">
          <description>Mawdrym may re-roll Feel No Pain rolls of 1. A dice may never be re-rolled more than once.</description>
        </rule>
        <rule id="r71-nl-mawdrym-rule-2" name="Unfit for Command" hidden="false">
          <description>Mawdrym may not fulfil the army’s compulsory HQ requirement and may never be the army’s Warlord.</description>
        </rule>
        <rule id="r73-nl-rule-mawdrym-legiones-astartes-night-lords" name="Legiones Astartes (Night Lords)" hidden="false">
          <description>This model belongs to the VIII Legion and is affected by rules and effects which refer to Legiones Astartes (Night Lords).</description>
        </rule>
        <rule id="r73-nl-rule-mawdrym-feel-no-pain-5" name="Feel No Pain (5+)" hidden="false">
          <description>Feel No Pain (5+): after a model fails its normal saving throw, roll a D6; on 5+ the Wound is ignored. Feel No Pain may not be used where the applicable ProHammer edition restriction prevents it.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry id="r71-nl-mawdrym-opt-0" name="Krak grenades" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="2" />
          </costs>
          <constraints>
            <constraint id="r71-nl-mawdrym-opt-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-mawdrym-opt-0-rule" name="Option" hidden="false">
              <description>Adds Krak grenades.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r73-nl-mawdrym-model" name="Flaymaster Mawdrym Llansahai" type="model" hidden="false" import="true" defaultAmount="1">
          <categoryLinks><categoryLink id="r62-limit-link-caafbf3ef0f7" name="Shattered 0–1 — Flaymaster Mawdrym Llansahai" targetId="r62-shat-limit-c9cee5e47966" hidden="false" /></categoryLinks><costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r73-nl-mawdrym-model-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="r73-nl-mawdrym-model-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Mawdrym Llansahai" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-viii-8-flaymaster-mawdrym-llansahai-profile-0">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">5</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">3</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+/5+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="r73-nl-mawdrym-stealth" name="Stealth Adept" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
          <constraints>
            <constraint id="r73-nl-mawdrym-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r73-nl-mawdrym-stealth-rule" name="Stealth Adept" hidden="false">
              <description>This Independent Character gains Stealth. If joining a unit with Stealth Adept, both the unit and attached Independent Character must possess the upgrade for the unit to benefit.

Stealth: Adds +1 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 6+ Cover Save. Does not stack with Shrouded.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    <selectionEntryGroups /></selectionEntry>
    <selectionEntry type="unit" import="true" name="Konrad Curze, the Night Haunter" hidden="false" id="r41-unit-viii-9-viii-konrad-curze-the-night-haunter">
      <categoryLinks>
