      <selectionEntryGroups>
        <selectionEntryGroup id="r71-nl-oph-ret" name="Command Retinue (does not occupy a separate Force Organisation slot)" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r71-nl-oph-ret-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
