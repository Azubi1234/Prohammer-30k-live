                  </constraints>
                  <modifiers>
                    <modifier id="r71-nl-sev-ret-0-r71-nl-gen-10-stealth-cost-0" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r71-nl-sev-ret-0-hq-centurion-ret-command-vets" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
