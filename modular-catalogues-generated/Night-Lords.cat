      <infoLinks><infoLink id="r36-link-8193d5b2a4ff" name="Independent Character" hidden="false" targetId="r36-shared-independent-character-4fbd2ae" type="rule" /><infoLink id="r36-link-14850ba6ed44" name="Master of the Legion" hidden="false" targetId="r36-shared-master-of-the-legion-a3a88da" type="rule" /><infoLink id="r36-link-bba3e15ab159" name="Stubborn" hidden="false" targetId="r36-shared-stubborn-59f928d" type="rule" /></infoLinks><costs>
