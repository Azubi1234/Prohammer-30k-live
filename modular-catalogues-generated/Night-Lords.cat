                  </modifiers>
                  <rules>
                    <rule id="r71-nl-shang-ret-0-r71-nl-terror-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
                      <description>Every model gains Stealth. An attached Independent Character must also possess Stealth Adept or the squad may not benefit while that character remains attached.

Stealth: Adds +1 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 6+ Cover Save. Does not stack with Shrouded.</description>
                    </rule>
                  </rules>
                </selectionEntry>
