        <modifier id="r71-nl-mawdrym-traitor" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      <modifier type="set" value="true" field="hidden" id="mod-r62-fixed-2eb0763f28b5">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
