    <selectionEntry type="unit" import="true" name="Jago Sevatarion" hidden="false" id="r41-unit-viii-4-jago-sevatarion">
      <categoryLinks>
        <categoryLink id="r41-unit-viii-4-jago-sevatarion-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      <categoryLink id="r41-halo-carrier-c12375f1706e" name="Iron Halo — army-wide limit" targetId="r41-iron-halo-army-limit" hidden="false" /><categoryLink id="r62-limit-link-4d5725ec6c89" name="Shattered 0–1 — Jago Sevatarion" targetId="r62-shat-limit-719ff202c566" hidden="false" /></categoryLinks>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
