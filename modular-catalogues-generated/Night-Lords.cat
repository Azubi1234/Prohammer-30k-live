        </entryLink><selectionEntry id="r71-nl-ta-raptor-r71-nl-raptor-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r71-nl-ta-raptor-r71-nl-raptor-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
