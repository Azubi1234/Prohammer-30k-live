            <condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
        </modifier>
      <modifier id="r62-fixed-hide-const-c12375f1706e" type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-viii" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier></modifiers>
      <constraints>
        <constraint id="r41-unit-viii-4-jago-sevatarion-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <infoLinks><infoLink id="r36-link-ce25f334d6f8" name="Independent Character" hidden="false" targetId="r36-shared-independent-character-4fbd2ae" type="rule" /><infoLink id="r36-link-e5e0eac99672" name="Master of the Legion" hidden="false" targetId="r36-shared-master-of-the-legion-a3a88da" type="rule" /></infoLinks><costs>
        <cost name="Points" typeId="pts" value="200" />
      </costs>
      <rules>
        <rule id="r71-nl-sevatar-wargear" name="Wargear" hidden="false">
          <description>Artificer Armour; Iron Halo; Night’s Whisper; Bolt pistol; Trophies of Judgement; Frag grenades.</description>
        </rule>
        <rule id="r71-nl-sevatar-rule-0" name="Night’s Whisper" hidden="false">
          <description>Night’s Whisper is a Two-Handed, Master-crafted Power Weapon. Attacks made with it are resolved at Strength 6.</description>
        </rule>
        <rule id="r71-nl-sevatar-rule-1" name="Visions of Doom" hidden="false">
          <description>Sevatar knows only the Withering Gaze psychic power. When making its Psychic Test, Sevatar uses Leadership 7 rather than his normal Leadership.</description>
        </rule>
        <rule id="r71-nl-sevatar-rule-2" name="Withering Gaze" hidden="false">
          <description>Used during the Night Lords Shooting phase instead of Sevatar firing a weapon. Choose one visible enemy unit within 12 inches and take a Psychic Test. If successful, until the beginning of the next Night Lords turn that unit must pass a Leadership test before declaring a charge against Sevatar or a unit he has joined. If failed it may not declare that charge, but may charge another legal target.</description>
        </rule>
        <rule id="r73-nl-rule-sevatar-legiones-astartes-night-lords" name="Legiones Astartes (Night Lords)" hidden="false">
          <description>This model belongs to the VIII Legion and is affected by rules and effects which refer to Legiones Astartes (Night Lords).</description>
        </rule>
        <rule id="r73-nl-rule-sevatar-psyker-mastery-level-1" name="Psyker (Mastery Level 1)" hidden="false">
          <description>This model is a Psyker with Mastery Level 1 and follows the normal ProHammer psychic rules.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry id="r71-nl-sevatar-opt-0" name="Krak grenades" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="2" />
          </costs>
          <constraints>
            <constraint id="r71-nl-sevatar-opt-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-sevatar-opt-0-rule" name="Option" hidden="false">
              <description>Adds Krak grenades.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r73-nl-sevatar-model" name="Jago Sevatarion" type="model" hidden="false" import="true" defaultAmount="1">
          <categoryLinks><categoryLink id="r62-limit-link-f05e0081fd56" name="Shattered 0–1 — Jago Sevatarion" targetId="r62-shat-limit-719ff202c566" hidden="false" /></categoryLinks><costs>
            <cost name="Points" typeId="pts" value="0" />
