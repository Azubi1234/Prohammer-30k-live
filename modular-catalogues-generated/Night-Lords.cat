          <description>Artificer Armour; Refractor Field; Master-crafted Power Weapon; Bolt pistol; Trophies of Judgement; Frag grenades.</description>
        </rule>
        <rule id="r73-nl-rule-shang-legiones-astartes-night-lords" name="Legiones Astartes (Night Lords)" hidden="false">
          <description>This model belongs to the VIII Legion and is affected by rules and effects which refer to Legiones Astartes (Night Lords).</description>
        </rule>
        <rule id="r73-nl-rule-shang-preferred-enemy-independent-characters" name="Preferred Enemy (Independent Characters)" hidden="false">
          <description>Preferred Enemy (Independent Characters): the unit may re-roll failed hits in close combat against Independent Characters.</description>
        </rule>
      </rules>
