ade" hidden="false" import="true" defaultAmount="1"><infoLinks><infoLink id="r36-link-6d86134e124b" name="Apothecary" hidden="false" targetId="r36-exact-apothecary-3edecdc" type="rule" /></infoLinks><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-surlak-special-rules-2-apothecary-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-surlak-special-rules-2-apothecary-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r89-we-surlak-special-rules-3-architect-of-the-nails" name="Architect of the Nails" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-surlak-special-rules-3-architect-of-the-nails-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-surlak-special-rules-3-architect-of-the-nails-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-surlak-special-rules-3-architect-of-the-nails-rule" name="Architect of the Nails" hidden="false"><description>After deployment but before the first turn begins, nominate one friendly World Eaters Infantry unit which is not wearing any form of Terminator Armour. That unit gains Furious Charge for the duration of the battle. A unit enhanced in this manner must declare a charge whenever it is legally able to do so. Only one unit may be enhanced in this manner.

Furious Charge: Models gain +1 Strength and +1 Initiative in assault on the turn they charged.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-surlak-special-rules-4-legion-support-officer" name="Legion Support Officer" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-surlak-special-rules-4-legion-support-officer-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-surlak-special-rules-4-legion-support-officer-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-surlak-special-rules-4-legion-support-officer-rule" name="Legion Support Officer" hidden="false"><description>Uses the normal Legion Support Officer rule.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-surlak-options" name="Options" hidden="false" collective="false" import="true"><selectionEntries><entryLink id="r89-we-surlak-opt-0-krak-grenades" name="Krak grenades" targetId="gear-krak" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r89-we-surlak-opt-0-krak-grenades-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="2" /></costs></entryLink></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r62-shat-assign-group-84cca747aae0" name="Shattered Legions — Assigned Legion" hidden="false"><selectionEntries><selectionEntry id="r62-shat-assign-02642fea7f5c" name="Dark Angels" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-02642fea7f5c-identity" name="Legiones Astartes (Dark Angels)" hidden="false"><description>This unit is assigned to Dark Angels for the Shattered Legions Theme. It uses the normal Dark Angels Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-02642fea7f5c-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-i" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-02642fea7f5c-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-706f8b4a99a0" name="Emperor's Children" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-706f8b4a99a0-identity" name="Legiones Astartes (Emperor's Children)" hidden="false"><description>This unit is assigned to Emperor's Children for the Shattered Legions Theme. It uses the normal Emperor's Children Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-706f8b4a99a0-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-iii" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-706f8b4a99a0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" include