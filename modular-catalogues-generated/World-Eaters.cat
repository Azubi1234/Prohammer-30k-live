      <selectionEntryGroups><selectionEntryGroup id="r89-we-daemon-angron-wargear" name="Wargear" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="r89-we-daemon-angron-wargear-0-blades-of-the-red-angel" name="Blades of the Red Angel" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-daemon-angron-wargear-0-blades-of-the-red-angel-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-daemon-angron-wargear-0-blades-of-the-red-angel-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-daemon-angron-wargear-0-blades-of-the-red-angel-rule" name="Blades of the Red Angel" hidden="false"><description>The Blades count as a pair of Master-crafted Power Weapons. Angron receives the normal +1 Attack for two close-combat weapons. Against Vehicles they have Armourbane. Against Monstrous Creatures and models with Toughness 6 or greater, Angron may re-roll failed To Wound rolls.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-daemon-angron-wargear-1-daemonic-armour" name="Daemonic Armour" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-daemon-angron-wargear-1-daemonic-armour-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-daemon-angron-wargear-1-daemonic-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-daemon-angron-wargear-1-daemonic-armour-rule" name="Daemonic Armour" hidden="false"><description>Angron has a 2+ Armour Save and a 4+ Invulnerable Save.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-daemon-angron-special-rules" name="Special Rules" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="r89-we-daemon-angron-special-rules-0-daemon" name="Daemon" type="upgrade" hidden="false" import="true" defaultAmount="1"><infoLinks><infoLink id="r36-link-384db0d995d9" name="Daemon" hidden="false" targetId="r36-shared-daemon-48e6659" type="rule" /></infoLinks><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-daemon-angron-special-rules-0-daemon-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-daemon-angron-special-rules-0-daemon-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r89-we-daemon-angron-special-rules-1-fear" name="Fear" type="upgrade" hidden="false" import="true" defaultAmount="1"><infoLinks><infoLink id="r36-link-9a44f2dad368" name="Fear" hidden="false" targetId="r36-shared-fear-689e027" type="rule" /></infoLinks><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-daemon-angron-special-rules-1-fear-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-daemon-angron-special-rules-1-fear-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></co