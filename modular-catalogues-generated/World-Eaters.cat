              <modifier id="live-r5-chainaxe-live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-unit-berserker-scale-0" type="increment" field="pts" value="2"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-marine" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r5-chainaxe-live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-unit-berserker-scale-1" type="increment" field="pts" value="2"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-sergeant" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-r48-vis-31-r62-shat-b63e657f5335" type="set" value="true" field="hidden">
                  <conditions>
