raint id="r89-we-kharn-wargear-2-plasma-pistol-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kharn-wargear-2-plasma-pistol-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kharn-wargear-2-plasma-pistol-rule" name="Plasma pistol" hidden="false"><description>Uses the normal Plasma pistol profile.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-kharn-wargear-3-frag-grenades" name="Frag grenades" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kharn-wargear-3-frag-grenades-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kharn-wargear-3-frag-grenades-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kharn-wargear-3-frag-grenades-rule" name="Frag grenades" hidden="false"><description>Uses the normal Frag grenade rules.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-kharn-weapon" name="Weapon" hidden="false" collective="false" import="true"><constraints><constraint id="r89-we-kharn-weapon-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kharn-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="r89-we-kharn-weapon-0-the-cutter" name="The Cutter" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kharn-weapon-0-the-cutter-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kharn-weapon-0-the-cutter-rule" name="The Cutter" hidden="false"><description>The Cutter is a Power Weapon which grants Khârn +1 Strength.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-kharn-weapon-1-gorechild" name="Gorechild" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="55" /></costs><constraints><constraint id="r89-we-kharn-weapon-1-gorechild-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kharn-weapon-1-gorechild-rule" name="Gorechild" hidden="false"><description>Gorechild is a Master-crafted Power Weapon which grants Khârn +3 Strength. At the beginning of the first round of each close combat, roll a D3. Khârn gains that many additional Attacks for that round.</description></rule></rules><modifiers><modifier id="r89-we-kharn-gorechild-angron-lock" type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r89-we-angron-weapon-0-gorefather-gorechild" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-kharn-special-rules" name="Special Rules" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="r89-we-kharn-special-rules-0-legiones-astartes-world-eaters" name="Legiones Astartes (World Eaters)" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kharn-special-rules-0-legiones-astartes-world-eaters-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kharn-special-rules-0-legiones-astartes-world-eaters-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kharn-special-rules-0-legiones-astartes-world-eaters-rule" name="Legiones Astartes (World Eaters)" hidden="false"><description>Uses the World Eaters Legion special rule.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-kharn-special-rules-1-independent-character" name="Independent Character" type="upgrade" hidden="false" import="true" defaultAmount="1"><infoLinks><infoLink id="r36-link-9165a49da808" name="Independent Character" hidden="false" targetId="r36-shared-independent-character-4fbd2ae" type="rule" /></infoLinks><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kharn-special-rules-1-independent-character-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kharn-special-rules-1-independent-character-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r89-we-kharn-special-rules-2-master-of-the-legion" name="Master of the Legion" type="upgrade" hidden="false" import="true" defaultAmount="1"><infoLinks><infoLink id="r36-link-ad9c514e9ef8" name="Master of the Legion" hidden="false" targetId="r36-shared-master-of-the-legion-a3a88da" type="rule" /></infoLinks><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kharn-special-rules-2-master-of-the-legion-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kharn-special-rules-2-master-of-the-legion-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r89-we-kharn-special-rules-3-the-bloody" name="The Bloody" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kharn-special-rules-3-the-bloody-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kharn-special-rules-3-the-bloody-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kharn-special-rules-3-the-bloody-rule" name="The Bloody" hidden="false"><description>Whenever Khârn rolls a natural 1 To Hit in close combat, that attack instead hits the nearest friendly model within 6 inches. If several friendly models are equally close, the opposing player chooses which is hit. Resolve the hit using Khârn’s current Strength and the weapon being used. The friendly model may take any saves normally permitted. Wounds caused in this manner do not count towards the close-combat result. If no friendly model is within 6 inches, the roll of 1 is a miss.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-kharn-special-rules-4-command-retinue" name="Command Retinue" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kharn-special-rules-4-command-retinue-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kharn-special-rules-4-command-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kharn-special-rules-4-command-retinue-rule" name="Command Retinue" hidden="false"><description>Khârn may select one Legion Command Squad or Rampager Squad as his retinue. The selected unit does not occupy a separate Force Organisation slot.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-kharn-options" name="Options" hidden="false" collective="false" import="true"><selectionEntries><entryLink id="r89-we-kharn-opt-0-krak-grenades" name="Krak grenades" targetId="gear-krak" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r89-we-kharn-opt-0-krak-grenades-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="2" /></costs></entryLink><selectionEntry id="r89-we-kharn-opt-1-jump-pack" name="Jump Pack" type="upgrade" hidden="false" import="true"><categoryLinks><categoryLink id="r89-we-kharn-opt-1-jump-pack-r40-jump" name="Awakening Fire — Jump Infantry" targetId="r40-sal-awakening-jump" hidden="false" /></categoryLinks><costs><cost name="Points" typeId="pts" value="20" /></costs><constraints><constraint id="r89-we-kharn-opt-1-jump-pack-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kharn-opt-1-jump-pack-rule" name="Jump Pack" hidden="false"><description>Changes Khârn to Jump Infantry while equipped.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r3-we-r41-unit-xii-6-kharn-the-bloody-retinue" name="RETINUE — choose up to one (no separate FOC slot)" hidden="false" collective="false" import="true"><constraints><constraint id="live-r3-we-r41-unit-xii-6-kharn-the-bloody-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="unit" name="Legion Command Squad" id="live-r3-we-r41-unit-xii-6-kharn-the-bloody-retinue-0-hq-centurion-ret-command" hidden="false" import="true">
              <constraints>
                <constraint id="live-r3-we-r41-unit-xii-6-kharn-the-bloody-retinue-0-hq-centurion-ret-command-ret-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints>
              <costs>
                <cost name="Points" typeId="pts" value="90" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="live-r3-we-r41-unit-xii-6-kharn-the-bloody-retinue-0-hq-centurion-ret-command-std" hidden="false">
                  <description>Five Legion Veterans, each equipped with Power Armour, Bolt Pistol, Chainsword and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="live-r3-we-r41-unit-xii-6-kharn-the-bloody-retinue-0-hq-centurion-ret-command-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Retinue" id="live-r3-we-r41-unit-xii-6-kharn-the-bloody-retinue-0-hq-centurion-ret-command-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character. It occupies no separate Force Organisation slot; character and Command Squad count as one HQ choice but may deploy and operate separately.</description>
                </rule>
              </rules>
