e="false" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r89-we-ehrlen-special-rules-2-loyalist-only" name="Loyalist Only" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-ehrlen-special-rules-2-loyalist-only-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-ehrlen-special-rules-2-loyalist-only-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-ehrlen-special-rules-2-loyalist-only-rule" name="Loyalist Only" hidden="false"><description>Captain Ehrlen may only be selected in a Loyalist army.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-ehrlen-special-rules-3-command-retinue" name="Command Retinue" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-ehrlen-special-rules-3-command-retinue-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-ehrlen-special-rules-3-command-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-ehrlen-special-rules-3-command-retinue-rule" name="Command Retinue" hidden="false"><description>Ehrlen may select one Legion Command Squad as his retinue. Every model in the Command Squad may purchase a Jump Pack for +15 points per model. If Jump Packs are purchased, every model in the squad must receive one and the squad may not select a Dedicated Transport. This Command Squad does not occupy a separate Force Organisation slot.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-ehrlen-options" name="Options" hidden="false" collective="false" import="true"><selectionEntries><entryLink id="r89-we-ehrlen-opt-0-krak-grenades" name="Krak grenades" targetId="gear-krak" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r89-we-ehrlen-opt-0-krak-grenades-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="2" /></costs></entryLink><selectionEntry id="r89-we-ehrlen-opt-1-melta-bombs" name="Melta bombs" type="upgrade" hidden="false" import="true"><infoLinks><infoLink id="r36-link-ff8b3cfe7ef8" name="Melta bombs" hidden="false" targetId="r36-exact-melta-bombs-404bfc7" type="rule" /></infoLinks><costs><cost name="Points" typeId="pts" value="5" /></costs><constraints><constraint id="r89-we-ehrlen-opt-1-melta-bombs-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r3-we-r41-unit-xii-10-captain-ehrlen-retinue" name="RETINUE — choose up to one (no separate FOC slot)" hidden="false" collective="false" import="true"><constraints><constraint id="live-r3-we-r41-unit-xii-10-captain-ehrlen-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="unit" name="Legion Command Squad" id="live-r3-we-r41-unit-xii-10-captain-ehrlen-retinue-0-hq-centurion-ret-command" hidden="false" import="true">
              <constraints>
                <constraint id="live-r3-we-r41-unit-xii-10-captain-ehrlen-retinue-0-hq-centurion-ret-command-ret-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints>
              <costs>
                <cost name="Points" typeId="pts" value="90" />
