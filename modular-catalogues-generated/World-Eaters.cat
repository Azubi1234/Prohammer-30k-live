    <selectionEntry type="unit" import="true" name="Legion Assault Squad" hidden="false" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-unit">
      <rules>
        <rule name="Standard Wargear" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-standard-wargear" hidden="false">
          <description>Every model is equipped with Power Armour, a Bolt Pistol, a Chainsword, Frag Grenades and a Jump Pack.</description>
        </rule>
        <rule name="Power Armour" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-power-armour" hidden="false">
          <description>Models wearing Power Armour have a 3+ Armour Save.</description>
        </rule>
        <rule name="Legiones Astartes" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Frag Grenades" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
        <rule name="Jump Packs" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-jump-packs" hidden="false">
          <description>The squad is equipped with Jump Packs and is treated as Jump Infantry. It follows all normal ProHammer rules for Jump Infantry, including movement, terrain, Deep Strike, Fall Back movement and transport restrictions.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink import="true" name="Bolt Pistol" hidden="false" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-standard-bp-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-standard-bp-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Chainsword" hidden="false" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-standard-cs" type="selectionEntry" targetId="gear-chainsword" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-standard-cs-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-standard-cs-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
