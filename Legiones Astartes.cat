    <selectionEntry type="unit" import="true" name="XIAPHAS JURR, PROPHET OF FIRE" hidden="false" id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire">
      <costs>
        <cost name="Points" typeId="pts" value="150" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-xviii-7-xiaphas-jurr-prophet-of-fire-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
