              <selectionEntryGroup id="live-r2-fabius-enhanced-r52-ec-ful-honour-group" name="Fabius Bile" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fabius-enhanced-r52-ec-ful-honour" name="Enhanced Warriors" type="upgrade" hidden="false" import="true"><constraints><constraint id="live-r2-fabius-enhanced-r52-ec-ful-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="live-r2-fabius-enhanced-r52-ec-ful-honour-scale-0" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r52-ec-ful-honour-hq-praetor-ret-honour-champ" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r52-ec-ful-honour-scale-1" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r52-ec-ful-honour-hq-praetor-ret-honour-base" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r52-ec-ful-honour-scale-2" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r52-ec-ful-honour-hq-praetor-ret-honour-land-land-raider-phobos" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r52-ec-ful-honour-scale-3" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r52-ec-ful-honour-hq-praetor-ret-honour-land-land-raider-proteus" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r52-ec-ful-honour-scale-4" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r52-ec-ful-honour-hq-praetor-ret-honour-land-land-raider-achilles" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r52-ec-ful-honour-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-7-fabius-bile" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><rules><rule id="live-r2-fabius-enhanced-r52-ec-ful-honour-rule" name="Enhanced Warriors" hidden="false"><description>This squad has been enhanced by Fabius Bile for +3 points per model. After deployment but before the first turn, roll a D6 for this squad: 1 — Berserk Rage: make an Armour Save for every model; remove each failure, and survivors gain +1 Strength. 2–5 — Stable Mutation: every model gains +1 Strength and +1 Initiative. 6 — Created a Monster: every model gains +1 Strength, +1 Initiative and +1 Attack; in missions using Victory Points, surviving models from the squad count as casualties when calculating Victory Points.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r2-fulgrim-blessing-r52-ec-ful-honour-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-r52-ec-ful-honour" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="25" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-r52-ec-ful-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-r52-ec-ful-honour-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-r52-ec-ful-honour-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-10-fulgrim-transfigured" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
            </selectionEntry>
            <selectionEntry type="unit" name="Legion Terminator Command Squad" id="r52-ec-ful-termcommand" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-ful-termcommand-hq-praetor-ret-termcommand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="215" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r52-ec-ful-termcommand-hq-praetor-ret-tc-std" hidden="false">
                  <description>Five Terminator Veterans, each equipped with the selected Terminator Armour pattern, a Combi-Bolter and a Power Weapon.</description>
                </rule>
                <rule name="Legiones Astartes" id="r52-ec-ful-termcommand-hq-praetor-ret-tc-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Retinue" id="r52-ec-ful-termcommand-hq-praetor-ret-tc-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character equipped with Terminator, Tartaros or Cataphractii Terminator Armour. It occupies no separate Force Organisation slot; the character and squad count as one HQ selection but may deploy and operate separately.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Terminator Veterans" id="r52-ec-ful-termcommand-hq-praetor-ret-tc-vets" hidden="false" import="true" defaultAmount="5">
                  <constraints>
                    <constraint id="r52-ec-ful-termcommand-hq-praetor-ret-tc-vets-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r52-ec-ful-termcommand-hq-praetor-ret-tc-vets-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
