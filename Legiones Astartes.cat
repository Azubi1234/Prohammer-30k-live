                    </modifier>
                    <modifier type="set" value="1" field="live-r2-r41-unit-xvi-8-tybalt-marr-the-either-retinue-0-r40-da-steel-transport-veteran-unit-hs-spartan-da-wing-hs-spartan-min">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </conditions>
