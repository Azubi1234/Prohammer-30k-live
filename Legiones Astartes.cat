              <selectionEntries>
                <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r40-da-steel-transport-tactical-unit-hs-spartan-hs-spartan-hunter-killer-missile" hidden="false" import="true">
                  <constraints>
                    <constraint id="r40-da-steel-transport-tactical-unit-hs-spartan-hs-spartan-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
