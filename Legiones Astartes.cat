            <selectionEntry type="upgrade" import="true" name="Marksmen" hidden="false" id="r40-da-vow-veteran-veteran-tactic-marksmen">
              <constraints>
                <constraint id="r40-da-vow-veteran-veteran-tactic-marksmen-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Marksmen" id="r40-da-vow-veteran-veteran-tactic-marksmen-rule" hidden="false">
                  <description>Normal Bolters fired by models in the squad have Twin-linked. This does not apply to Combi-weapons, Foeblaster Boltguns or other bolt weapon variants.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
