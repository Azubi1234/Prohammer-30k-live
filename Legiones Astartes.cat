            <selectionEntry id="r46-wb-diabolist" name="Diabolist Consul" type="upgrade" hidden="false" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="35" />
              </costs>
              <constraints>
                <constraint id="r46-wb-diabolist-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <modifiers>
                <modifier id="r48-vis-299" type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xvii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <rules>
                <rule id="r46-wb-diabolist-rule" name="Diabolist" hidden="false">
                  <description>Gains Daemon and Preferred Enemy (Loyalists). May not select a Bike, Jetbike, Terminator Armour, Power Fist or Thunder Hammer. Enables eligible units to purchase Dark Channelling. May purchase an Accursed Crozius and then counts as a Dark Apostle.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="r80-ih-consul-cat-193" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
