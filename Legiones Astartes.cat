              </constraints>
              <rules>
                <rule name="Reapers of Hosts" id="da22-order-reapers-rule" hidden="false">
                  <description>A model beginning its Initiative step in base contact with more than one enemy gains +1 Attack for that Assault phase.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Breakers of Witches" hidden="false" id="da22-order-breakers">
