      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Breacher Marine" hidden="false" id="r57-iw-hammer-breacher-breacher-marine" defaultAmount="9">
          <constraints>
            <constraint type="min" value="9" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-marine-min" includeChildSelections="false" />
            <constraint type="max" value="19" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-marine-max" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <profiles>
            <profile name="Legion Breacher Marine" typeId="prof-model" typeName="Model" hidden="false" id="r57-iw-hammer-breacher-prof-breacher-marine">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">8</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Breacher Sergeant" hidden="false" id="r57-iw-hammer-breacher-breacher-sergeant" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-sgt-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-sgt-max" includeChildSelections="false" automatic="true" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <profiles>
            <profile name="Legion Breacher Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r57-iw-hammer-breacher-prof-breacher-sergeant">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Sergeant Armoury" id="r57-iw-hammer-breacher-breacher-rule-sgt-armoury" hidden="false">
              <description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. The Sergeant may carry no more than two weapons, only one of which may be two-handed. No item may be selected more than once unless a unit entry specifically permits otherwise. Unit-specific replacement options are available at the points costs shown in this squad entry and are not repeated in the additional Armoury. The Sergeant may not select Artificer Armour from this unit entry.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Replace Bolter" id="r57-iw-hammer-breacher-breacher-sgt-bolter" hidden="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-sgt-bolter-max" includeChildSelections="false" />
              </constraints>
              <entryLinks>
                <entryLink import="true" name="Combi-Flamer" hidden="false" id="r57-iw-hammer-breacher-breacher-sgt-cf" type="selectionEntry" targetId="gear-combi-flamer">
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Combi-Volkite Charger" hidden="false" id="r57-iw-hammer-breacher-breacher-sgt-cv" type="selectionEntry" targetId="gear-combi-volkite">
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Combi-Meltagun" hidden="false" id="r57-iw-hammer-breacher-breacher-sgt-cm" type="selectionEntry" targetId="gear-combi-melta">
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
