        </rule>
        <rule id="r79-ih-rule-r41-unit-x-1-gorgon-terminator-squad-fearless" name="Fearless" hidden="false">
          <description>Uses the normal ProHammer Fearless special rule.</description>
        </rule>
        <rule id="r79-ih-rule-r41-unit-x-1-gorgon-terminator-squad-gorgon-field" name="Gorgon Field" hidden="false">
          <description>If one or more models in this unit pass an Invulnerable Save against shooting from an enemy unit, resolve all attacks from that enemy unit, then the attacking unit takes one Initiative test. If failed, it is affected by the normal ProHammer Blind rule until the end of its next turn. A unit takes at most one Gorgon Field test per phase.</description>
        </rule>
      </rules>
