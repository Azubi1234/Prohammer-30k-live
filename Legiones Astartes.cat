    <selectionEntry id="r79-ih-castrmen-orth" name="CASTRMEN ORTH" type="unit" hidden="true" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="50" />
      </costs>
      <constraints>
        <constraint id="r79-ih-castrmen-orth-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <categoryLinks>
        <categoryLink id="r79-ih-castrmen-orth-hq" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier id="r79-ih-castrmen-orth-show" type="set" value="false" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="r79-ih-castrmen-orth-upgrade" name="Vehicle Commander" hidden="false">
          <description>Castrmen Orth is purchased as a +50 point upgrade for one Iron Hands Vehicle (Tank). Orth and that Vehicle together occupy the Vehicle’s normal Force Organisation selection and one HQ selection. He may not command a Walker, a Vehicle without a Ballistic Skill characteristic, or a Vehicle already commanded by another named character. Select the commanded Vehicle in your roster and apply these rules to it.</description>
        </rule>
        <rule id="r79-ih-castrmen-orth-spear" name="Spearhead Centurion" hidden="false">
          <description>The Vehicle commanded by Castrmen Orth has Ballistic Skill 5, replacing its normal Ballistic Skill.</description>
        </rule>
        <rule id="r79-ih-castrmen-orth-hunter" name="Tank Hunters" hidden="false">
          <description>Orth’s Vehicle has the normal ProHammer Tank Hunters special rule. If the Vehicle is destroyed, Castrmen Orth is also slain for Victory Point and mission purposes. Orth is not a separate model and may not leave his Vehicle.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Medusan Immortal Squad — Company of Bitter Iron Troops" hidden="true" id="r81-ih-bitter-role">
      <costs>
        <cost name="Points" typeId="pts" value="150" />
      </costs>
      <categoryLinks>
