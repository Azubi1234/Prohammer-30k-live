                    </entryLinks>
                </selectionEntryGroup>
              </selectionEntryGroups>
              <rules>
                <rule id="r57-iw-pert-retinue-dominator-cohort-r57-iw-dom-rule-0" name="Legiones Astartes (Iron Warriors)" hidden="false">
                  <description>This unit has Legiones Astartes (Iron Warriors).</description>
                </rule>
                <rule id="r57-iw-pert-retinue-dominator-cohort-r57-iw-dom-rule-1" name="Stubborn" hidden="false">
                  <description>This unit has Stubborn.</description>
                </rule>
                <rule id="r57-iw-pert-retinue-dominator-cohort-r57-iw-dom-rule-2" name="Hatred (Battle-Automata)" hidden="false">
                  <description>Use the normal ProHammer Hatred special rule when fighting enemy Battle-Automata.</description>
                </rule>
                <rule id="r57-iw-pert-retinue-dominator-cohort-r57-iw-dom-rule-3" name="Those Once Honoured" hidden="false">
                  <description>One Dominator Cohort may be selected as Perturabo's personal retinue. If selected in this manner, the squad does not occupy an Elites choice.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <rules>
            <rule id="r57-iw-pert-retinue-rule" name="Retinue" hidden="false">
              <description>IV — PERTURABO, THE LORD OF IRON may select one of: Legion Honour Guard Squad, Legion Terminator Command Squad, Dominator Cohort. The selected unit occupies no separate Force Organisation slot.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
