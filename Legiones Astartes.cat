    <selectionEntry type="unit" import="true" name="MORLOCK TERMINATOR SQUAD" hidden="false" id="r41-unit-x-2-morlock-terminator-squad">
      <costs>
        <cost name="Points" typeId="pts" value="275" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-x-2-morlock-terminator-squad-cat" name="Elites" hidden="false" targetId="cat-elites" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="r79-ih-rule-r41-unit-x-2-morlock-terminator-squad-legiones-astartes-iron-hands" name="Legiones Astartes (Iron Hands)" hidden="false">
          <description>This model belongs to the X Legion and is affected by rules and effects which refer to Legiones Astartes (Iron Hands).</description>
        </rule>
        <rule id="r79-ih-rule-r41-unit-x-2-morlock-terminator-squad-fearless" name="Fearless" hidden="false">
          <description>Uses the normal ProHammer Fearless special rule.</description>
        </rule>
        <rule id="r79-ih-rule-r41-unit-x-2-morlock-terminator-squad-gorgon-field" name="Gorgon Field" hidden="false">
          <description>If one or more models in this unit pass an Invulnerable Save against shooting from an enemy unit, resolve all attacks from that enemy unit, then the attacking unit takes one Initiative test. If failed, it is affected by the normal ProHammer Blind rule until the end of its next turn. A unit takes at most one Gorgon Field test per phase.</description>
        </rule>
      </rules>
