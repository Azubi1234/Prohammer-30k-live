                              <description>Use the normal ProHammer Dozer Blade rule.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Extra Armour" id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-extra-armour" hidden="false" import="true">
                          <constraints>
                            <constraint id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-extra-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <modifiers>
                            <modifier type="set" value="2" field="r63-sw-varagyr-transport-lr-hs-lr-ph-up-extra-armour-max">
                              <conditions>
                                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r63-sw-varagyr-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                            <modifier type="set" value="3" field="r63-sw-varagyr-transport-lr-hs-lr-ph-up-extra-armour-max">
                              <conditions>
                                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r63-sw-varagyr-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                          </modifiers>
                          <costs>
                            <cost name="Points" typeId="pts" value="5" />
                          </costs>
                          <rules>
                            <rule name="Extra Armour" id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-extra-armour-rule" hidden="false">
                              <description>Use the normal ProHammer Extra Armour rule.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Auxiliary Drive" id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-auxiliary-drive" hidden="false" import="true">
                          <constraints>
                            <constraint id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <modifiers>
                            <modifier type="set" value="2" field="r63-sw-varagyr-transport-lr-hs-lr-ph-up-auxiliary-drive-max">
                              <conditions>
                                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r63-sw-varagyr-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                            <modifier type="set" value="3" field="r63-sw-varagyr-transport-lr-hs-lr-ph-up-auxiliary-drive-max">
                              <conditions>
                                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r63-sw-varagyr-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                          </modifiers>
                          <costs>
                            <cost name="Points" typeId="pts" value="10" />
                          </costs>
                          <rules>
                            <rule name="Auxiliary Drive" id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-auxiliary-drive-rule" hidden="false">
                              <description>At the start of the controlling player's Movement phase, if the vehicle is Immobilised, roll a D6. On a 4+, remove one Immobilised result; it may move normally that phase.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Armoured Ceramite" id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-armoured-ceramite" hidden="false" import="true">
                          <constraints>
                            <constraint id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <modifiers>
                            <modifier type="set" value="2" field="r63-sw-varagyr-transport-lr-hs-lr-ph-up-armoured-ceramite-max">
                              <conditions>
                                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r63-sw-varagyr-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                            <modifier type="set" value="3" field="r63-sw-varagyr-transport-lr-hs-lr-ph-up-armoured-ceramite-max">
                              <conditions>
                                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r63-sw-varagyr-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                          </modifiers>
                          <costs>
                            <cost name="Points" typeId="pts" value="20" />
                          </costs>
                          <rules>
                            <rule name="Armoured Ceramite" id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-armoured-ceramite-rule" hidden="false">
                              <description>Melta weapons do not receive their additional Armour Penetration die against this vehicle, regardless of range.</description>
                            </rule>
