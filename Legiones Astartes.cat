              <constraints>
                <constraint id="r57-hq-centurion-iw-servo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="30" id="r57-hq-centurion-iw-servo-pts" />
