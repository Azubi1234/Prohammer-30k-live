      <profiles>
        <profile name="Chieftain" typeId="prof-model" typeName="Model" hidden="false" id="r46-al-reward-48-r41-unit-xvi-2-chieftain-squad-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
