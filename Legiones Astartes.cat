        </rule>
        <rule id="r68-if-diaz-retinue" name="CAMBA DIAZ — COMMAND RETINUE" hidden="false">
          <description>Diaz may select one Phalanx Warder Squad or Legion Command Squad as his retinue. The selected unit does not occupy a separate Force Organisation slot. The functional RETINUE selector is part of Diaz’s roster entry.</description>
        </rule>
