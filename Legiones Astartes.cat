          <rules>
            <rule id="r71-nl-terror-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model gains Stealth. An attached Independent Character must also possess Stealth Adept or the squad may not benefit while that character remains attached.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-37" name="Beyond Judgement — Fear (Trophies already equipped)" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-37-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-37-rule" name="Beyond Judgement" hidden="false">
              <description>This squad already carries Trophies of Judgement. Under Horror Cult it may still purchase Beyond Judgement for +25 points per unit; doing so grants Fear and treats the squad as equipped with Trophies of Judgement in the manner specified by the Rite. Measure the 8-inch Leadership penalty from any model. Trophies penalties remain non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-37-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule id="r71-nl-terror-rule-1" name="Wargear" hidden="false">
          <description>Power Armour, Bolter, Bolt pistol, Chainsword, Frag grenades and Trophies of Judgement.</description>
        </rule>
        <rule id="r73-nl-rule-r41-unit-viii-0-terror-squad-legiones-astartes-night-lords" name="Legiones Astartes (Night Lords)" hidden="false">
          <description>This model belongs to the VIII Legion and is affected by rules and effects which refer to Legiones Astartes (Night Lords).</description>
        </rule>
        <rule id="r73-nl-rule-r41-unit-viii-0-terror-squad-infiltrate" name="Infiltrate" hidden="false">
          <description>The unit uses the ProHammer Infiltrate special rule. If its mission or transport circumstances do not permit Infiltrate, deploy it normally.</description>
        </rule>
        <rule id="r73-nl-rule-r41-unit-viii-0-terror-squad-preferred-enemy-infantry" name="Preferred Enemy (Infantry)" hidden="false">
          <description>The unit has Preferred Enemy against Infantry and uses the normal ProHammer Preferred Enemy rules against eligible Infantry targets.</description>
        </rule>
      </rules>
