      <profiles>
        <profile name="Reaver" typeId="prof-model" typeName="Model" hidden="false" id="r46-al-reward-47-r41-unit-xvi-1-reaver-attack-squad-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
