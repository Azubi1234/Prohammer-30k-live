                <selectionEntry type="upgrade" name="Auxiliary Drive" id="r71-nl-contekar-transport-spartan-hs-spartan-auxiliary-drive" hidden="false" import="true">
                  <constraints>
                    <constraint id="r71-nl-contekar-transport-spartan-hs-spartan-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
