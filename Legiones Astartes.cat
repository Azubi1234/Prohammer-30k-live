          </constraints>
          <rules>
            <rule id="r71-nl-hc-raptor-r71-nl-raptor-headtaker-rule" name="Headtaker" hidden="false">
              <description>The Raptor Sergeant becomes a Headtaker and has Weapon Skill 5. The Headtaker may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury and Night Lords Armoury.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-hc-raptor-r71-nl-bj-38" name="Beyond Judgement — Fear (Trophies already equipped)" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-hc-raptor-r71-nl-bj-38-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-hc-raptor-r71-nl-bj-38-rule" name="Beyond Judgement" hidden="false">
              <description>This squad already carries Trophies of Judgement. Under Horror Cult it may still purchase Beyond Judgement for +25 points per unit; doing so grants Fear and treats the squad as equipped with Trophies of Judgement in the manner specified by the Rite. Measure the 8-inch Leadership penalty from any model. Trophies penalties remain non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-hc-raptor-r71-nl-bj-38-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
