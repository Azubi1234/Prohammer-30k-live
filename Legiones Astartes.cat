                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r71-nl-gen-7-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r71-nl-bj-8" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r71-nl-bj-8-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r71-nl-bj-8-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r71-nl-bj-8-show" type="set" value="false" field="hidden">
