        <profile name="Khenetai Blademaster" typeId="prof-model" typeName="Model" hidden="false" id="live-r2-r41-unit-xv-10-sanakht-retinue-0-r41-unit-xv-1-khenetai-occult-blade-cabal-profile-1">
