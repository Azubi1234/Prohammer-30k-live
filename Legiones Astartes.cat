                <rule id="r60-ws-jagh-voidbike-rule" name="Sojutsu Pattern Voidbike" hidden="false">
                  <description>Jaghatai Khan becomes Jetbike and follows the normal ProHammer Jetbike rules.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="r60-ws-jagh-retinue" name="Retinue (does not occupy a separate FOC slot)" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r60-ws-jagh-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Honour Guard Squad" id="r60-ws-jagh-retinue-legion-honour-guard-squad" hidden="false" import="true">
              <constraints>
                <constraint id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="55" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-std" hidden="false">
                  <description>Every model wears Artificer Armour and carries a Refractor Field, Power Weapon, Bolt Pistol and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Honour or Death" id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-hod" hidden="false">
                  <description>If the Legion Champion is in base contact with one or more enemy Independent Characters, he must direct all of his close-combat attacks against one of them. When attacking an enemy Independent Character in close combat, he may re-roll failed To Hit and To Wound rolls.</description>
                </rule>
                <rule name="Retinue" id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-ret" hidden="false">
                  <description>Selected for an eligible Praetor or Primarch. It occupies no separate Force Organisation slot; the commander and Honour Guard count as a single HQ selection but do not have to deploy together and operate as separate units after deployment.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Legion Champion" id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-champ" hidden="false" import="true" defaultAmount="1">
                  <constraints>
                    <constraint id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-champ-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-champ-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Champion" id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-champ-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">6</characteristic>
                        <characteristic name="BS" typeId="model-bs">5</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">2</characteristic>
