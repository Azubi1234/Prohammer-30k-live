                            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Pistol, Melta</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-1-krak-grenades">
                      <constraints>
                        <constraint id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-1-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <rules>
                        <rule name="Option restriction" id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-1-context" hidden="false">
                          <description>• The entire squad may take:</description>
                        </rule>
                        <rule name="Squad-wide cost note" id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-1-squadwide" hidden="false">
                          <description>The source prices this option at +2 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier id="r74-ba-pra-guard-r74-ba-guard-krak-cost" type="increment" value="2" field="pts">
                          <repeats>
                            <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                          </repeats>
                        </modifier>
                      </modifiers>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Melta bombs (base unit; +5 pts/model)" hidden="false" id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-2-melta-bombs">
                      <constraints>
                        <constraint id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-2-melta-bombs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <rules>
                        <rule name="Option restriction" id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-2-context" hidden="false">
                          <description>• The entire squad may take:</description>
                        </rule>
                        <rule name="Squad-wide cost note" id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-2-squadwide" hidden="false">
                          <description>The source prices this option at +5 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier id="r74-ba-pra-guard-r74-ba-guard-melta-cost" type="increment" value="5" field="pts">
                          <repeats>
                            <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                          </repeats>
                        </modifier>
                      </modifiers>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Azkaellon" hidden="false" id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-3-azkaellon">
                      <constraints>
                        <constraint id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-3-azkaellon-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="35" />
                      </costs>
                      <rules>
                        <rule id="r74-ba-pra-guard-r74-ba-azk-up-master" name="Master of the Seraphim" hidden="false">
                          <description>A Sanguinary Guard Squad containing Azkaellon may deploy using Deep Strike even if the mission does not normally permit it. If selected as a character’s retinue, that character must also be capable of Deep Striking or the unit deploys normally.</description>
                        </rule>
                        <rule id="r74-ba-pra-guard-r74-ba-azk-up-glaive" name="Glaive Encarmine" hidden="false">
                          <description>Two-Handed, Master-crafted Power Weapon. Attacks are resolved at Strength 6.</description>
                        </rule>
                        <rule id="r74-ba-pra-guard-r74-ba-azk-up-artificer-armour" name="Artificer Armour" hidden="false">
                          <description>Fixed Azkaellon wargear.</description>
                        </rule>
                        <rule id="r74-ba-pra-guard-r74-ba-azk-up-sanguine-pattern-jump-pack" name="Sanguine-pattern Jump Pack" hidden="false">
                          <description>Fixed Azkaellon wargear.</description>
                        </rule>
                        <rule id="r74-ba-pra-guard-r74-ba-azk-up-death-mask" name="Death Mask" hidden="false">
                          <description>Fixed Azkaellon wargear.</description>
                        </rule>
                        <rule id="r74-ba-pra-guard-r74-ba-azk-up-glaive-encarmine" name="Glaive Encarmine" hidden="false">
                          <description>Fixed Azkaellon wargear.</description>
                        </rule>
                        <rule id="r74-ba-pra-guard-r74-ba-azk-up-angelus-boltgun" name="Angelus Boltgun" hidden="false">
                          <description>Fixed Azkaellon wargear.</description>
                        </rule>
                        <rule id="r74-ba-pra-guard-r74-ba-azk-up-frag-grenades" name="Frag grenades" hidden="false">
                          <description>Fixed Azkaellon wargear.</description>
                        </rule>
                      </rules>
                      <profiles>
                        <profile name="Azkaellon" typeId="prof-model" typeName="Model" hidden="false" id="r74-ba-pra-guard-r74-ba-azk-up-profile-r41-unit-ix-9-azkaellon-profile-0">
                          <characteristics>
                            <characteristic name="WS" typeId="model-ws">6</characteristic>
                            <characteristic name="BS" typeId="model-bs">5</characteristic>
                            <characteristic name="S" typeId="model-s">4</characteristic>
                            <characteristic name="T" typeId="model-t">4</characteristic>
                            <characteristic name="W" typeId="model-w">2</characteristic>
                            <characteristic name="I" typeId="model-i">4</characteristic>
                            <characteristic name="A" typeId="model-a">3</characteristic>
                            <characteristic name="Ld" typeId="model-ld">10</characteristic>
                            <characteristic name="Sv" typeId="model-sv">2+/5+</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
              </selectionEntryGroups>
              <rules>
                <rule id="r74-ba-pra-guard-r74-ba-guard-rule-legiones-astartes-blood-angels" name="Legiones Astartes (Blood Angels)" hidden="false">
                  <description>This unit belongs to the IX Legion. It is affected by Blood Angels Legion rules and effects that refer to Legiones Astartes (Blood Angels).</description>
                </rule>
                <rule id="r74-ba-pra-guard-r74-ba-guard-rule-fearless" name="Fearless" hidden="false">
                  <description>Uses the normal ProHammer Fearless special rule.</description>
                </rule>
                <rule id="r74-ba-pra-guard-r74-ba-guard-servants" name="Servants of the Great Angel" hidden="false">
                  <description>A Sanguinary Guard Squad may only be selected as the retinue of a Blood Angels Praetor, Raldoron or Sanguinius. It occupies no separate Force Organisation slot. The character must begin the battle joined to the Sanguinary Guard but may leave normally later.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <rules>
            <rule name="Retinue Restriction" id="hq-praetor-ret-rule" hidden="false">
              <description>A Praetor may select one Honour Guard Squad. If equipped with any form of Terminator Armour, he may instead select a Legion Terminator Command Squad where permitted.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-hq-praetor" collective="false" import="true">
          <constraints>
            <constraint id="da-wing-hq-praetor-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="da-wing-hq-praetor-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" value="1" field="da-wing-hq-praetor-min">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-hq-praetor-0">
              <constraints>
                <constraint id="da-wing-hq-praetor-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Stormwing" id="da-wing-hq-praetor-0-rule" hidden="false">
                  <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-hq-praetor-1">
              <constraints>
                <constraint id="da-wing-hq-praetor-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Deathwing" id="da-wing-hq-praetor-1-rule" hidden="false">
                  <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-hq-praetor-2">
              <constraints>
                <constraint id="da-wing-hq-praetor-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Dreadwing" id="da-wing-hq-praetor-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-hq-praetor-3">
              <constraints>
                <constraint id="da-wing-hq-praetor-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ironwing" id="da-wing-hq-praetor-3-rule" hidden="false">
                  <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-hq-praetor-4">
              <constraints>
                <constraint id="da-wing-hq-praetor-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="da-wing-hq-praetor-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-hq-praetor-5">
              <constraints>
                <constraint id="da-wing-hq-praetor-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="da-wing-hq-praetor-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="r45-cult-hq-praetor" name="Prosperine Cult" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r45-cult-hq-praetor-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
            <constraint id="r45-cult-hq-praetor-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r48-vis-233" type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry id="r45-cult-hq-praetor-0" name="Pavoni" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-hq-praetor-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-hq-praetor-0-rule" name="Pavoni" hidden="false">
                  <description>Fleet; Psykers/Psychic Brotherhoods also gain Crusader.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-hq-praetor-1" name="Raptora" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-hq-praetor-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-hq-praetor-1-rule" name="Raptora" hidden="false">
                  <description>6+ invulnerable save against shooting; Psychic Mastery improves this to 5+ (or improves an existing invulnerable save by 1 to max 4+) and improves cover by 1 to max 3+.</description>
                </rule>
              </rules>
            </selectionEntry>
