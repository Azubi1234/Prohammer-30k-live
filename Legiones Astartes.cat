    <selectionEntry type="unit" import="true" name="Lion El'Jonson, The First" hidden="false" id="da22-lion">
      <costs>
        <cost name="Points" typeId="pts" value="550" />
      </costs>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="allegiance-loyalist" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
        <modifier type="set" value="true" field="hidden">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" />
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="da22-lion-rostermax" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <profiles>
        <profile name="Lion El'Jonson" typeId="prof-model" typeName="Model" hidden="false" id="da22-lion-prof">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">9</characteristic>
            <characteristic name="BS" typeId="model-bs">6</characteristic>
            <characteristic name="S" typeId="model-s">6</characteristic>
            <characteristic name="T" typeId="model-t">6</characteristic>
            <characteristic name="W" typeId="model-w">6</characteristic>
            <characteristic name="I" typeId="model-i">7</characteristic>
            <characteristic name="A" typeId="model-a">6</characteristic>
            <characteristic name="Ld" typeId="model-ld">10</characteristic>
            <characteristic name="Sv" typeId="model-sv">1+/4++</characteristic>
          </characteristics>
        </profile>
        <profile name="Fusil Actinaeus" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="da22-lion-fusil">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">18"</characteristic>
            <characteristic name="S" typeId="ranged-s">7</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Salvo 2/4, Twin-linked, Blind</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Primarch / Restrictions" id="da22-lion-base" hidden="false">
          <description>Primarch; Legiones Astartes (Dark Angels). Loyalist Dark Angels only. As a Primarch: Lord of War, normally 2,000+ points, Primary Detachment only, maximum one Primarch, must be Warlord; Independent Character, Eternal Warrior, Fear, Fearless, Adamantium Will, Fleet, It Will Not Die, Master of the Legion.</description>
        </rule>
        <rule name="Leonine Panoply" id="da22-lion-panoply" hidden="false">
          <description>Counts as Primarch Armour (1+ Armour, 4+ Invulnerable). The first failed Invulnerable Save made by the Lion during each player turn may be re-rolled.</description>
        </rule>
        <rule name="Stasis Grenades" id="da22-lion-stasis" hidden="false">
          <description>If the Lion and joined unit successfully charge, or are successfully charged, all enemy units engaged as a result are Initiative 1 until end of current player turn. Neither Assault nor Defensive Grenades.</description>
        </rule>
        <rule name="An Absolute Focus" id="da22-lion-focus" hidden="false">
          <description>May never require worse than 4+ To Hit in close combat regardless of enemy Weapon Skill or modifiers.</description>
        </rule>
        <rule name="The Point of the Blade" id="da22-lion-point" hidden="false">
          <description>The Lion and any unit he joins may declare charges against enemy units up to 8" away instead of 6". Difficult Terrain does not reduce this; Dangerous Terrain resolves normally.</description>
        </rule>
        <rule name="The Lion's Choler" id="da22-lion-choler" hidden="false">
          <description>At 4 Wounds or fewer, +1 Attack. At 2 Wounds or fewer, +2 Attacks instead. Not cumulative.</description>
        </rule>
        <rule name="Knight of Knights" id="da22-lion-knight" hidden="false">
          <description>Each Assault phase in which he directs attacks against an enemy Independent Character or Primarch, re-roll one failed To Hit OR one failed To Wound against such a model; second result accepted.</description>
        </rule>
        <rule name="Primarch Retinue" id="da22-lion-ret" hidden="false">
          <description>May select one Legion Honour Guard, Legion Terminator Command Squad, Deathwing Companion Detachment or Deathwing Terminator Companion Detachment as a slotless Primarch Retinue. Terminator Companions may be selected despite the Lion not wearing Terminator Armour.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Choose Weapon" hidden="false" id="da22-lion-blade" collective="false" import="true">
          <constraints>
            <constraint id="da22-lion-blade-min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="da22-lion-blade-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="The Lion Sword" hidden="false" id="da22-lion-sword">
              <constraints>
                <constraint id="da22-lion-sword-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="The Lion Sword" id="da22-lion-sword-rule" hidden="false">
                  <description>Master-crafted, Two-Handed Power Weapon; attacks at +1 Strength with Fleshbane and Lance; sword-type for Dark Angels rules.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Wolf Blade" hidden="false" id="da22-lion-wolf">
              <constraints>
                <constraint id="da22-lion-wolf-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="The Wolf Blade" id="da22-lion-wolf-rule" hidden="false">
                  <description>Two-Handed Power Weapon; attacks at +3 Strength with Shred; sword-type for Dark Angels rules.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <categoryLinks>
        <categoryLink id="da22-lion-cat" targetId="cat-low" name="Lords of War" hidden="false" primary="true" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Cerberus Heavy Tank Destroyer" hidden="false" id="r32-low-cerberus">
      <costs>
        <cost name="Points" typeId="pts" value="395" />
      </costs>
      <profiles>
        <profile name="Cerberus Heavy Tank Destroyer" id="r32-low-cerberus-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <characteristics>
            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
            <characteristic name="Front" typeId="vehicle-front">14</characteristic>
            <characteristic name="Side" typeId="vehicle-side">14</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">13</characteristic>
            <characteristic name="SP" typeId="vehicle-sp">3</characteristic>
          </characteristics>
        </profile>
        <profile name="Neutron Laser Battery" id="r32-low-cerberus-weapon-neutron-laser-battery-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">72"</characteristic>
            <characteristic name="S" typeId="ranged-s">10</characteristic>
            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
            <characteristic name="Type" typeId="ranged-type">Ordnance D3, Blast, Twin-linked, Concussive, Shock Pulse, Feedback</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-low-cerberus-type" hidden="false">
          <description>Vehicle (Tank, Super-heavy)</description>
        </rule>
        <rule name="Wargear" id="r32-low-cerberus-wargear" hidden="false">
          <description>Twin-linked Neutron Laser Battery; Searchlight; Smoke Launchers; Flare Shield.</description>
        </rule>
        <rule name="Shock Pulse" id="r32-low-cerberus-weapon-neutron-laser-battery-wr-0-shock-pulse" hidden="false">
          <description>A Vehicle suffering a Penetrating Hit may only fire Snap Shots in its following Shooting phase.</description>
        </rule>
        <rule name="Feedback" id="r32-low-cerberus-weapon-neutron-laser-battery-wr-0-feedback" hidden="false">
          <description>Whenever this weapon fails an Armour Penetration roll, or fails to wound a non-Vehicle model, roll a D6. On a 1 a firing Vehicle suffers one Glancing Hit; a non-Vehicle firing model suffers one Wound with no Armour Save allowed.</description>
        </rule>
        <rule name="Structure Points" id="r32-low-cerberus-low-0" hidden="false">
          <description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</description>
        </rule>
        <rule name="Massive Firepower" id="r32-low-cerberus-low-1" hidden="false">
          <description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</description>
        </rule>
        <rule name="Lumbering War Engine" id="r32-low-cerberus-low-2" hidden="false">
          <description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</description>
        </rule>
        <rule name="Super-heavy Tank Shock" id="r32-low-cerberus-low-3" hidden="false">
          <description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</description>
        </rule>
        <rule name="Crushing Advance" id="r32-low-cerberus-low-4" hidden="false">
          <description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</description>
        </rule>
        <rule name="Immense Machine" id="r32-low-cerberus-low-5" hidden="false">
          <description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</description>
        </rule>
        <rule name="Catastrophic Destruction" id="r32-low-cerberus-low-6" hidden="false">
          <description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</description>
        </rule>
        <rule name="Flare Shield" id="r32-low-cerberus-flare" hidden="false">
          <description>Reduce the Strength of shooting attacks that strike the Front Armour by 1, or by 2 if the weapon has Blast or Template. No effect against close combat, Haywire or Titan Killer.</description>
        </rule>
        <rule name="Reactor Blast" id="r32-low-cerberus-reactor" hidden="false">
          <description>When the Cerberus is finally destroyed, add +1 to the Catastrophic Destruction roll.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="r32-low-cerberus-hk">
          <constraints>
            <constraint id="r32-low-cerberus-hk-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
