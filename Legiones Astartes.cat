      </costs>
      <profiles>
        <profile name="Thunderhawk Gunship" id="r32-low-thunderhawk-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <modifiers>
            <modifier type="set" field="vehicle-rear" value="12" id="r32-low-thunderhawk-rear">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r32-low-thunderhawk-voidhull" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <characteristics>
            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
            <characteristic name="Front" typeId="vehicle-front">12</characteristic>
            <characteristic name="Side" typeId="vehicle-side">12</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">10</characteristic>
            <characteristic name="SP" typeId="vehicle-sp">3</characteristic>
          </characteristics>
        </profile>
        <profile name="Thunderhawk Cannon" id="r32-low-thunderhawk-weapon-thunderhawk-cannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">72"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">3</characteristic>
            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Massive Blast</characteristic>
          </characteristics>
        </profile>
        <profile name="Twin-linked Heavy Bolter" id="r32-low-thunderhawk-weapon-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
          </characteristics>
        </profile>
        <profile name="Hellstrike Missile" id="r32-low-thunderhawk-weapon-hellstrike-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">72"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</characteristic>
          </characteristics>
        </profile>
        <profile name="Lascannon" id="r32-low-thunderhawk-weapon-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">9</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-low-thunderhawk-type" hidden="false">
          <description>Vehicle (Super-heavy, Flyer, Hover, Transport)</description>
        </rule>
        <rule name="Wargear" id="r32-low-thunderhawk-wargear" hidden="false">
          <description>Thunderhawk Cannon; Four Twin-linked Heavy Bolters; Six Hellstrike Missiles; Two Lascannons; Armoured Ceramite; Power of the Machine Spirit.</description>
        </rule>
        <rule name="Massive Blast" id="r32-low-thunderhawk-weapon-thunderhawk-cannon-wr-0-massive-blast" hidden="false">
          <description>Uses the 7 inch Blast marker.</description>
        </rule>
        <rule name="Sunder" id="r32-low-thunderhawk-weapon-hellstrike-missile-wr-0-sunder" hidden="false">
          <description>May re-roll failed Armour Penetration rolls against Vehicles.</description>
        </rule>
        <rule name="Structure Points" id="r32-low-thunderhawk-low-0" hidden="false">
          <description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</description>
        </rule>
        <rule name="Massive Firepower" id="r32-low-thunderhawk-low-1" hidden="false">
          <description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</description>
        </rule>
        <rule name="Lumbering War Engine" id="r32-low-thunderhawk-low-2" hidden="false">
          <description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</description>
        </rule>
        <rule name="Super-heavy Tank Shock" id="r32-low-thunderhawk-low-3" hidden="false">
          <description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</description>
        </rule>
        <rule name="Crushing Advance" id="r32-low-thunderhawk-low-4" hidden="false">
          <description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</description>
        </rule>
        <rule name="Immense Machine" id="r32-low-thunderhawk-low-5" hidden="false">
          <description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</description>
        </rule>
        <rule name="Catastrophic Destruction" id="r32-low-thunderhawk-low-6" hidden="false">
          <description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</description>
        </rule>
        <rule name="Armoured Ceramite" id="r32-low-thunderhawk-ceramite" hidden="false">
          <description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</description>
        </rule>
        <rule name="Power of the Machine Spirit" id="r32-low-thunderhawk-potms" hidden="false">
          <description>Use the normal ProHammer Power of the Machine Spirit rule.</description>
        </rule>
        <rule name="Assault Vehicle" id="r32-low-thunderhawk-assault" hidden="false">
          <description>A Dreadnought may charge during a turn in which it disembarks from this Drop Pod, but may not charge during the same turn in which the Drop Pod itself arrived by Deep Strike.</description>
        </rule>
        <rule name="Transport Capacity" id="r32-low-thunderhawk-cap" hidden="false">
          <description>30 models. May transport Dreadnoughts, each counting as 10 models, as well as Jump Infantry and Bikes. Dreadnoughts may only embark or disembark through the forward ramp.</description>
        </rule>
        <rule name="Access Points" id="r32-low-thunderhawk-access" hidden="false">
          <description>One access hatch on each side and one forward assault ramp.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Replace Thunderhawk Cannon with Turbo-laser Destructor" hidden="false" id="r32-low-thunderhawk-turbo">
          <constraints>
            <constraint id="r32-low-thunderhawk-turbo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="90" />
          </costs>
          <profiles>
            <profile name="Turbo-laser Destructor" id="r32-low-thunderhawk-turbo-turbo-laser-destructor-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
              <characteristics>
                <characteristic name="Range" typeId="ranged-range">96"</characteristic>
                <characteristic name="S" typeId="ranged-s">10</characteristic>
                <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                <characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast, Titan Killer</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Titan Killer" id="r32-low-thunderhawk-turbo-turbo-laser-destructor-wr-0-titan-killer" hidden="false">
              <description>When a Titan Killer weapon scores a Penetrating Hit against a Super-heavy Vehicle, resolve the hit normally and then the target loses D3 Structure Points. Against a non-Vehicle model an unsaved Wound inflicts D3 Wounds instead of 1.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Replace six Hellstrike Missiles with six Thunderhawk Cluster Bombs" hidden="false" id="r32-low-thunderhawk-bombs">
          <constraints>
            <constraint id="r32-low-thunderhawk-bombs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="60" />
          </costs>
          <profiles>
            <profile name="Thunderhawk Cluster Bomb" id="r32-low-thunderhawk-bombs-thunderhawk-cluster-bomb-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
              <characteristics>
                <characteristic name="Range" typeId="ranged-range">—</characteristic>
                <characteristic name="S" typeId="ranged-s">6</characteristic>
                <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                <characteristic name="Type" typeId="ranged-type">Bomb 6, Barrage, Large Blast, One Use</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Chaff Launcher" hidden="false" id="r32-low-thunderhawk-chaff-launcher">
          <constraints>
            <constraint id="r32-low-thunderhawk-chaff-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="10" />
          </costs>
          <rules>
            <rule name="Chaff Launcher" id="r32-low-thunderhawk-chaff-launcher-effect" hidden="false">
              <description>Once per battle, when the vehicle suffers a Glancing or Penetrating Hit caused by a Missile weapon, roll a D6. On a 4+ the hit is ignored.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Armoured Cockpit" hidden="false" id="r32-low-thunderhawk-armoured-cockpit">
          <constraints>
            <constraint id="r32-low-thunderhawk-armoured-cockpit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <rules>
            <rule name="Armoured Cockpit" id="r32-low-thunderhawk-armoured-cockpit-effect" hidden="false">
              <description>Whenever the vehicle suffers Crew Shaken or Crew Stunned, roll a D6. On a 4+ the result is ignored.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Flare Shield" hidden="false" id="r32-low-thunderhawk-flare-shield">
          <constraints>
            <constraint id="r32-low-thunderhawk-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <rules>
            <rule name="Flare Shield" id="r32-low-thunderhawk-flare-shield-effect" hidden="false">
              <description>Reduce the Strength of shooting attacks that strike the Front Armour by 1, or by 2 if the weapon has Blast or Template. No effect against close combat, Haywire or Titan Killer.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Ramjet Diffraction Grid" hidden="false" id="r32-low-thunderhawk-ramjet-diffraction-grid">
          <constraints>
            <constraint id="r32-low-thunderhawk-ramjet-diffraction-grid-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <rules>
            <rule name="Ramjet Diffraction Grid" id="r32-low-thunderhawk-ramjet-diffraction-grid-effect" hidden="false">
              <description>Reduce the Strength of shooting attacks that strike Side or Rear Armour by 1, to a minimum of 1. The vehicle may not claim Cover Saves from Night Fighting.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Void-crafted Hull" hidden="false" id="r32-low-thunderhawk-voidhull">
          <constraints>
            <constraint id="r32-low-thunderhawk-voidhull-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="35" />
          </costs>
          <rules>
            <rule name="Void-crafted Hull" id="r32-low-thunderhawk-voidhull-rule" hidden="false">
              <description>Increase the Thunderhawk's Rear Armour from 10 to 12.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
      <categoryLinks>
        <categoryLink id="r32-low-thunderhawk-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" />
