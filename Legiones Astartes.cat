          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Augurs of Weakness" hidden="false" id="da22-order-augurs">
              <constraints>
                <constraint id="da22-order-augurs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Augurs of Weakness" id="da22-order-augurs-rule" hidden="false">
                  <description>+1 Strength when making Armour Penetration rolls against vehicles with AV11+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Icons of Resolve" hidden="false" id="da22-order-icons">
              <constraints>
                <constraint id="da22-order-icons-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Icons of Resolve" id="da22-order-icons-rule" hidden="false">
                  <description>If charged, each model gains +1 Attack during that Assault phase.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Guardians of Sanctity" hidden="false" id="da22-order-guardians">
              <constraints>
                <constraint id="da22-order-guardians-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Guardians of Sanctity" id="da22-order-guardians-rule" hidden="false">
                  <description>When making Deny the Witch, roll 2D6 and use the highest before modifiers.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Slayers of Kings" hidden="false" id="da22-order-slayers">
              <constraints>
                <constraint id="da22-order-slayers-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Slayers of Kings" id="da22-order-slayers-rule" hidden="false">
                  <description>Against enemy units whose majority WS is 5+, re-roll To Hit rolls of 1 in close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hunters of Beasts" hidden="false" id="da22-order-hunters">
              <constraints>
                <constraint id="da22-order-hunters-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Hunters of Beasts" id="da22-order-hunters-rule" hidden="false">
                  <description>Against T5 re-roll To Wound rolls of 1; against T6+ re-roll all failed To Wound rolls.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Reapers of Hosts" hidden="false" id="da22-order-reapers">
              <constraints>
