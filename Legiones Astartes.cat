                        <characteristic name="Front" typeId="vehicle-front">14</characteristic>
                        <characteristic name="Side" typeId="vehicle-side">14</characteristic>
                        <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry type="model" name="Land Raider Proteus" id="r57-iw-hammer-tactical-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus" hidden="false" import="true">
                  <constraints>
                    <constraint id="r57-iw-hammer-tactical-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="200" />
                  </costs>
                  <profiles>
                    <profile name="Land Raider Proteus" id="r57-iw-hammer-tactical-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                      <characteristics>
                        <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                        <characteristic name="Front" typeId="vehicle-front">14</characteristic>
                        <characteristic name="Side" typeId="vehicle-side">14</characteristic>
                        <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
