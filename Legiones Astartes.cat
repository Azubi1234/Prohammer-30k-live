            <entryLink id="r52-ec-sonic-hss-r46-hs-heavy-support-squad-sal-artificer" name="Artificer Armour — Salamanders access" type="selectionEntry" targetId="r46-sal-artificer-armour" hidden="false" import="true">
              <constraints>
