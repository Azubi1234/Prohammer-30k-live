                        <cost name="Points" typeId="pts" value="10" />
                      </costs>
                      <modifiers>
                        <modifier type="set" value="false" field="hidden">
                          <conditionGroups>
                            <conditionGroup type="and">
                              <conditions>
                                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" />
                              </conditions>
                            </conditionGroup>
                            <conditionGroup type="or">
                              <conditions>
                                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-term" shared="true" includeChildSelections="true" />
                                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-tart" shared="true" includeChildSelections="true" />
                                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-cat" shared="true" includeChildSelections="true" />
                              </conditions>
                            </conditionGroup>
                          </conditionGroups>
                        </modifier>
                      </modifiers>
                    </entryLink>
                  </entryLinks>
                </selectionEntryGroup>
                <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r40-da-storm-centurion-group-r40-da-storm-assault-da-wing-hq-centurion" collective="false" import="true">
                  <constraints>
                    <constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-da-wing-hq-centurion-r40-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                    <constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-da-wing-hq-centurion-r40-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <modifiers>
                    <modifier type="set" value="true" field="hidden">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </conditions>
                    </modifier>
                    <modifier type="set" value="1" field="r40-da-storm-centurion-group-r40-da-storm-assault-da-wing-hq-centurion-min">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </conditions>
                    </modifier>
                  </modifiers>
                  <selectionEntries>
                    <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r40-da-storm-centurion-group-r40-da-storm-assault-da-wing-hq-centurion-0">
                      <constraints>
                        <constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-da-wing-hq-centurion-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <rules>
                        <rule name="Stormwing" id="r40-da-storm-centurion-group-r40-da-storm-assault-da-wing-hq-centurion-0-rule" hidden="false">
                          <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
              </selectionEntryGroups>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <categoryLinks>
        <categoryLink id="r40-da-storm-assault-cat" targetId="cat-troops" name="Troops" hidden="false" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="set" value="false" field="hidden">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" />
                <condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-storm" shared="true" includeChildSelections="true" />
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="true" id="r40-da-vow-veteran">
      <rules>
        <rule name="Standard Wargear" id="r40-da-vow-veteran-veteran-standard" hidden="false">
          <description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</description>
        </rule>
        <rule name="Legiones Astartes" id="r40-da-vow-veteran-veteran-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Veteran Tactics" id="r40-da-vow-veteran-veteran-tactics-rule" hidden="false">
          <description>When constructing the army, select one Veteran Tactic for this squad. The chosen ability applies to every model in the squad for the duration of the battle.</description>
        </rule>
        <rule name="Dedicated Transport" id="r40-da-vow-veteran-veteran-transport-rule" hidden="false">
          <description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</description>
        </rule>
        <rule id="r40-da-vow-veteran-rite-rule" name="The Hammer of Caliban" hidden="false">
          <description>Selected as a Troops choice by The Unbroken Vow. This Rite-specific copy is fixed to the Deathwing.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Veterans" hidden="false" id="r40-da-vow-veteran-veteran-included" defaultAmount="4">
          <constraints>
            <constraint id="r40-da-vow-veteran-veteran-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r40-da-vow-veteran-veteran-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Veterans (included)" id="r40-da-vow-veteran-veteran-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="pts" value="20.0" />
          </costs>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Veteran Sergeant" hidden="false" id="r40-da-vow-veteran-veteran-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="r40-da-vow-veteran-veteran-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r40-da-vow-veteran-veteran-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Veteran Sergeant" id="r40-da-vow-veteran-veteran-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="r40-da-vow-veteran-r37-assault-dfa-veteran-unit" name="Death from Above (Legion Assault Company)" type="upgrade" hidden="true" import="true">
          <constraints>
            <constraint id="r40-da-vow-veteran-r37-assault-dfa-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <rules>
            <rule name="Death from Above (Legion Assault Company)" id="r40-da-vow-veteran-r37-assault-dfa-veteran-unit-rule" hidden="false">
              <description>Any unit composed entirely of models equipped with Jump Packs may deploy using Deep Strike even if the mission would not normally permit Deep Strike. Resolve arrival using the normal ProHammer Deep Strike rules.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-assault" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry id="r71-nl-gen-15-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r71-nl-gen-15-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r71-nl-gen-15-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r40-da-vow-veteran-veteran-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-15-stealth-cost-1" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r40-da-vow-veteran-veteran-sergeant" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-15-stealth-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule id="r71-nl-gen-15-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-17" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-17-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-17-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-17-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="Points" typeId="pts" value="45.0" />
      </costs>
      <selectionEntryGroups>
        <selectionEntryGroup name="Veteran Tactic (choose one)" id="r40-da-vow-veteran-veteran-tactics" hidden="false">
          <constraints>
