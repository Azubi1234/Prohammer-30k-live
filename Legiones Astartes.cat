                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                  <rules>
                    <rule name="Frag Assault Launchers" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-frag-assault-launchers-rule" hidden="false">
                      <description>Passengers charging during the same turn they disembark count as equipped with Frag Grenades for that Assault phase.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Armoured Ceramite" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-armoured-ceramite" hidden="false" import="true">
                  <constraints>
                    <constraint id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="20" />
                  </costs>
                  <rules>
                    <rule name="Armoured Ceramite" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-armoured-ceramite-rule" hidden="false">
                      <description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Flare Shield" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-flare-shield" hidden="false" import="true">
                  <constraints>
                    <constraint id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="45" />
                  </costs>
                  <rules>
                    <rule name="Flare Shield" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-flare-shield-rule" hidden="false">
                      <description>Against shooting attacks striking the Front Armour, reduce the Strength of Blast and Template weapons by 2 and all other ranged attacks by 1. No effect in close combat.</description>
                    </rule>
                  </rules>
                </selectionEntry>
