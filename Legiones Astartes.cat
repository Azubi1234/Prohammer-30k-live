                  <selectionEntries>
                    </selectionEntries>
                </selectionEntryGroup>
              <selectionEntryGroup id="live-r2-fabius-enhanced-r71-nl-mal-ret-0-hq-centurion-ret-command-group" name="Fabius Bile" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fabius-enhanced-r71-nl-mal-ret-0-hq-centurion-ret-command" name="Enhanced Warriors" type="upgrade" hidden="false" import="true"><constraints><constraint id="live-r2-fabius-enhanced-r71-nl-mal-ret-0-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="live-r2-fabius-enhanced-r71-nl-mal-ret-0-hq-centurion-ret-command-scale-0" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r71-nl-mal-ret-0-hq-centurion-ret-command-vets" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r71-nl-mal-ret-0-hq-centurion-ret-command-scale-1" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r71-nl-mal-ret-0-hq-centurion-ret-command-land-land-raider-phobos" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r71-nl-mal-ret-0-hq-centurion-ret-command-scale-2" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r71-nl-mal-ret-0-hq-centurion-ret-command-land-land-raider-proteus" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r71-nl-mal-ret-0-hq-centurion-ret-command-scale-3" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r71-nl-mal-ret-0-hq-centurion-ret-command-land-land-raider-achilles" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r71-nl-mal-ret-0-hq-centurion-ret-command-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-7-fabius-bile" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><rules><rule id="live-r2-fabius-enhanced-r71-nl-mal-ret-0-hq-centurion-ret-command-rule" name="Enhanced Warriors" hidden="false"><description>This squad has been enhanced by Fabius Bile for +3 points per model. After deployment but before the first turn, roll a D6 for this squad: 1 — Berserk Rage: make an Armour Save for every model; remove each failure, and survivors gain +1 Strength. 2–5 — Stable Mutation: every model gains +1 Strength and +1 Initiative. 6 — Created a Monster: every model gains +1 Strength, +1 Initiative and +1 Attack; in missions using Victory Points, surviving models from the squad count as casualties when calculating Victory Points.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r2-fulgrim-blessing-r71-nl-mal-ret-0-hq-centurion-ret-command-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-r71-nl-mal-ret-0-hq-centurion-ret-command" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="25" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-r71-nl-mal-ret-0-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-r71-nl-mal-ret-0-hq-centurion-ret-command-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-r71-nl-mal-ret-0-hq-centurion-ret-command-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-10-fulgrim-transfigured" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
            </selectionEntry>
            <selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="false" id="r71-nl-mal-ret-1-veteran-unit">
              <rules>
                <rule name="Standard Wargear" id="r71-nl-mal-ret-1-veteran-standard" hidden="false">
                  <description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</description>
                </rule>
                <rule name="Legiones Astartes" id="r71-nl-mal-ret-1-veteran-legiones" hidden="false">
                  <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
                </rule>
                <rule name="Veteran Tactics" id="r71-nl-mal-ret-1-veteran-tactics-rule" hidden="false">
                  <description>When constructing the army, select one Veteran Tactic for this squad. The chosen ability applies to every model in the squad for the duration of the battle.</description>
                </rule>
                <rule name="Dedicated Transport" id="r71-nl-mal-ret-1-veteran-transport-rule" hidden="false">
                  <description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" import="true" name="Legion Veterans" hidden="false" id="r71-nl-mal-ret-1-veteran-included" defaultAmount="4">
                  <constraints>
                    <constraint id="r71-nl-mal-ret-1-veteran-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r71-nl-mal-ret-1-veteran-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Veterans (included)" id="r71-nl-mal-ret-1-veteran-included-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">5</characteristic>
                        <characteristic name="BS" typeId="model-bs">4</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">1</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">2</characteristic>
                        <characteristic name="Ld" typeId="model-ld">9</characteristic>
                        <characteristic name="Sv" typeId="model-sv">3+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Points" typeId="pts" value="20" />
                  </costs>
                </selectionEntry>
                <selectionEntry type="model" import="true" name="Legion Veteran Sergeant" hidden="false" id="r71-nl-mal-ret-1-veteran-sergeant" defaultAmount="1">
                  <constraints>
                    <constraint id="r71-nl-mal-ret-1-veteran-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r71-nl-mal-ret-1-veteran-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Veteran Sergeant" id="r71-nl-mal-ret-1-veteran-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">5</characteristic>
                        <characteristic name="BS" typeId="model-bs">4</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">1</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">2</characteristic>
                        <characteristic name="Ld" typeId="model-ld">9</characteristic>
                        <characteristic name="Sv" typeId="model-sv">3+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry id="r71-nl-mal-ret-1-r37-assault-dfa-veteran-unit" name="Death from Above (Legion Assault Company)" type="upgrade" hidden="true" import="true">
                  <constraints>
                    <constraint id="r71-nl-mal-ret-1-r37-assault-dfa-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <rules>
                    <rule name="Death from Above (Legion Assault Company)" id="r71-nl-mal-ret-1-r37-assault-dfa-veteran-unit-rule" hidden="false">
                      <description>Any unit composed entirely of models equipped with Jump Packs may deploy using Deep Strike even if the mission would not normally permit Deep Strike. Resolve arrival using the normal ProHammer Deep Strike rules.</description>
                    </rule>
                  </rules>
                  <modifiers>
                    <modifier type="set" value="false" field="hidden">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-assault" shared="true" includeChildSelections="true" />
                      </conditions>
                    </modifier>
                  </modifiers>
                </selectionEntry>
                <selectionEntry id="r71-nl-mal-ret-1-r71-nl-gen-4-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="0" />
                  </costs>
                  <constraints>
                    <constraint id="r71-nl-mal-ret-1-r71-nl-gen-4-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <modifiers>
                    <modifier id="r71-nl-mal-ret-1-r71-nl-gen-4-stealth-cost-0" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r71-nl-mal-ret-1-veteran-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
                    </modifier>
                    <modifier id="r71-nl-mal-ret-1-r71-nl-gen-4-stealth-cost-1" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r71-nl-mal-ret-1-veteran-sergeant" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
                    </modifier>
                    <modifier id="r71-nl-mal-ret-1-r71-nl-gen-4-stealth-show" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <rules>
                    <rule id="r71-nl-mal-ret-1-r71-nl-gen-4-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
                      <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="r71-nl-mal-ret-1-r71-nl-bj-4" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  <constraints>
                    <constraint id="r71-nl-mal-ret-1-r71-nl-bj-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r71-nl-mal-ret-1-r71-nl-bj-4-rule" name="Beyond Judgement" hidden="false">
                      <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
                    </rule>
                  </rules>
                  <modifiers>
                    <modifier id="r71-nl-mal-ret-1-r71-nl-bj-4-show" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                </selectionEntry>
              </selectionEntries>
              <costs>
                <cost name="Points" typeId="pts" value="45" />
              </costs>
              <selectionEntryGroups>
                <selectionEntryGroup name="Veteran Tactic (choose one)" id="r71-nl-mal-ret-1-veteran-tactics" hidden="false">
                  <constraints>
                    <constraint id="r71-nl-mal-ret-1-veteran-tactics-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                    <constraint id="r71-nl-mal-ret-1-veteran-tactics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="upgrade" import="true" name="Resolve" hidden="false" id="r71-nl-mal-ret-1-veteran-tactic-resolve">
                      <constraints>
                        <constraint id="r71-nl-mal-ret-1-veteran-tactic-resolve-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Resolve" id="r71-nl-mal-ret-1-veteran-tactic-resolve-rule" hidden="false">
                          <description>The squad gains the Stubborn special rule.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Assault Veterans" hidden="false" id="r71-nl-mal-ret-1-veteran-tactic-assault">
                      <constraints>
                        <constraint id="r71-nl-mal-ret-1-veteran-tactic-assault-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Assault Veterans" id="r71-nl-mal-ret-1-veteran-tactic-assault-rule" hidden="false">
                          <description>The squad gains the Furious Charge special rule.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Counter-Assault" hidden="false" id="r71-nl-mal-ret-1-veteran-tactic-counter">
                      <constraints>
                        <constraint id="r71-nl-mal-ret-1-veteran-tactic-counter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Counter-Assault" id="r71-nl-mal-ret-1-veteran-tactic-counter-rule" hidden="false">
                          <description>The squad gains the Counter-Attack special rule.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Machine Killers" hidden="false" id="r71-nl-mal-ret-1-veteran-tactic-machine">
                      <constraints>
                        <constraint id="r71-nl-mal-ret-1-veteran-tactic-machine-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Machine Killers" id="r71-nl-mal-ret-1-veteran-tactic-machine-rule" hidden="false">
                          <description>The squad gains the Tank Hunters special rule.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Recon Veterans" hidden="false" id="r71-nl-mal-ret-1-veteran-tactic-recon">
                      <constraints>
                        <constraint id="r71-nl-mal-ret-1-veteran-tactic-recon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Recon Veterans" id="r71-nl-mal-ret-1-veteran-tactic-recon-rule" hidden="false">
                          <description>The squad gains the Infiltrate special rule.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Marksmen" hidden="false" id="r71-nl-mal-ret-1-veteran-tactic-marksmen">
                      <constraints>
                        <constraint id="r71-nl-mal-ret-1-veteran-tactic-marksmen-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <rules>
                        <rule name="Marksmen" id="r71-nl-mal-ret-1-veteran-tactic-marksmen-rule" hidden="false">
                          <description>Normal Bolters fired by models in the squad have Twin-linked. This does not apply to Combi-weapons, Foeblaster Boltguns or other bolt weapon variants.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
                <selectionEntryGroup name="Close Combat Weapon Replacements" id="r71-nl-mal-ret-1-veteran-melee" hidden="false">
                  <constraints>
                    <constraint id="r71-nl-mal-ret-1-veteran-melee-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <modifiers>
                    <modifier type="increment" value="1" field="r71-nl-mal-ret-1-veteran-melee-max">
                      <repeats>
                        <repeat value="5" repeats="1" field="selections" scope="root-entry" childId="r71-nl-mal-ret-1-veteran-included" shared="true" roundUp="false" includeChildSelections="false" />
                      </repeats>
                    </modifier>
                  </modifiers>
                  <entryLinks>
                    <entryLink import="true" name="Chainaxe (replaces Chainsword)" hidden="false" id="r71-nl-mal-ret-1-veteran-melee-chainaxe" type="selectionEntry" targetId="gear-hq-chainaxe">
                      <constraints>
                        <constraint id="r71-nl-mal-ret-1-veteran-melee-chainaxe-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" />
