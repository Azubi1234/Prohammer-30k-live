    <selectionEntry type="unit" name="Legion Artillery Tank Squadron — Artillery Column" id="r57-iw-ironfire-artillery" hidden="true" import="true">
      <constraints>
        <constraint id="r57-iw-ironfire-artillery-hs-artillery-roster-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="false" />
      </constraints>
      <rules>
        <rule name="Squadron Composition" id="r57-iw-ironfire-artillery-hs-artillery-comp" hidden="false">
          <description>1–3 vehicles. Every vehicle in the squadron must be of the same type.</description>
        </rule>
        <rule name="New Recruit note" id="r57-iw-ironfire-artillery-hs-art-note" hidden="false">
          <description>For a two- or three-vehicle squadron, select the appropriate number of Additional vehicles. Vehicle upgrades and pintle weapons may be selected in matching quantities up to the number of vehicles in the squadron; do not assign more than one copy of a given upgrade to the same vehicle.</description>
        </rule>
        <rule id="r57-iw-ironfire-artillery-rule" name="Artillery Column" hidden="false">
          <description>Non-compulsory Troops. Does not count as Scoring unless it normally would. The normal 0–1 Artillery Tank Squadron restriction still applies.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Artillery Type" id="r57-iw-ironfire-artillery-hs-artillery-type" hidden="false">
          <constraints>
            <constraint id="r57-iw-ironfire-artillery-hs-artillery-type-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="r57-iw-ironfire-artillery-hs-artillery-type-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
