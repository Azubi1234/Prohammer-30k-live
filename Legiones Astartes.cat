        <selectionEntry id="r75-ba-hq-praetor-rev-warlord" name="Designate as Day of Revelation Warlord" type="upgrade" hidden="true" import="true">
          <constraints>
            <constraint id="r75-ba-hq-praetor-rev-warlord-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <categoryLinks>
            <categoryLink id="r75-ba-hq-praetor-rev-warlord-cat" name="Day of Revelation — Warlord with Jump Pack" hidden="false" targetId="r75-ba-cat-rev-warlord-jump" primary="false" />
          </categoryLinks>
          <modifiers>
            <modifier id="r75-ba-hq-praetor-rev-warlord-show" type="set" value="false" field="hidden">
