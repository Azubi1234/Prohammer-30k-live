                              <conditions>
                                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" />
                                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-p6" shared="true" includeChildSelections="true" />
