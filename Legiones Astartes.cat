            </rule>
            <rule name="Titan Killer" id="r32-low-stormbird-orbital-orbital-strike-wr-0-titan-killer" hidden="false">
              <description>When a Titan Killer weapon scores a Penetrating Hit against a Super-heavy Vehicle, resolve the hit normally and then the target loses D3 Structure Points. Against a non-Vehicle model an unsaved Wound inflicts D3 Wounds instead of 1.</description>
            </rule>
            <rule name="Indirect Only" id="r32-low-stormbird-orbital-orbital-strike-wr-0-indirect-only" hidden="false">
              <description>Does not require Line of Sight, is always resolved using Barrage, and may not be fired directly.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
      <categoryLinks>
        <categoryLink id="r32-low-stormbird-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Primaris-Lightning Strike Fighter" hidden="false" id="r32-aero-lightning">
      <costs>
        <cost name="Points" typeId="pts" value="135" />
      </costs>
      <profiles>
        <profile name="Primaris-Lightning Strike Fighter" id="r32-aero-lightning-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <characteristics>
            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
            <characteristic name="Front" typeId="vehicle-front">11</characteristic>
            <characteristic name="Side" typeId="vehicle-side">11</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">10</characteristic>
          </characteristics>
        </profile>
        <profile name="Twin-linked Lascannon" id="r32-aero-lightning-weapon-twin-linked-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">9</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1, Twin-linked</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-aero-lightning-type" hidden="false">
          <description>Vehicle (Flyer)</description>
        </rule>
        <rule name="Wargear" id="r32-aero-lightning-wargear" hidden="false">
          <description>Twin-linked Lascannon; Chaff Launcher; Armoured Cockpit; Three Dual Hardpoint Mounts.</description>
        </rule>
        <rule name="Flyer" id="r32-aero-lightning-aero-flyer" hidden="false">
          <description>Uses the normal ProHammer Vehicle and Flyer rules, including deployment from Reserves, Zooming/Hovering where applicable, movement, turning, leaving the battlefield, Hard to Hit, Evasion and Flyer damage.</description>
        </rule>
        <rule name="Air-to-Air Targeting" id="r32-aero-lightning-aero-air-to-air-targeting" hidden="false">
          <description>When a Zooming Flyer fires at another Flyer or Flying Monster, it may use its normal Ballistic Skill when rolling To Hit.</description>
        </rule>
        <rule name="Agile" id="r32-aero-lightning-agile" hidden="false">
          <description>When this Flyer enters Evasion, improve the Cover Save granted by Evasion by +1, to a maximum of 3+.</description>
        </rule>
        <rule name="Deep Strike" id="r32-aero-lightning-deep" hidden="false">
          <description>Uses the normal ProHammer Deep Strike rules except as modified below.</description>
        </rule>
        <rule name="Supersonic" id="r32-aero-lightning-super" hidden="false">
          <description>Uses the normal ProHammer special rule.</description>
        </rule>
        <rule name="Chaff Launcher" id="r32-aero-lightning-chaff" hidden="false">
          <description>Once per battle, when the vehicle suffers a Glancing or Penetrating Hit caused by a Missile weapon, roll a D6. On a 4+ the hit is ignored.</description>
        </rule>
        <rule name="Armoured Cockpit" id="r32-aero-lightning-cockpit" hidden="false">
          <description>Whenever the vehicle suffers Crew Shaken or Crew Stunned, roll a D6. On a 4+ the result is ignored.</description>
        </rule>
      </rules>
