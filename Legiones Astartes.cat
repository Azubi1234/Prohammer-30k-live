          <profiles>
            <profile id="r63-sw-hq-praetor-wolves-profile" name="Fenrisian Wolf" hidden="false" typeId="prof-model" typeName="Model">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">0</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">8</characteristic>
                <characteristic name="Sv" typeId="model-sv">6+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="r63-sw-hq-praetor-wolves-rule" name="Wolf Retinue" hidden="false">
              <description>Two Fenrisian Wolves accompany the Independent Character. This may be selected in addition to any normal Retinue squad or alone. The Wolves may never voluntarily leave the character.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r63-sw-hq-praetor-wolves-hide" type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry id="r66-if-praetor-hammer-warlord" name="Designate as Hammerfall Warlord" type="upgrade" hidden="true" import="true">
          <constraints>
            <constraint id="r66-if-praetor-hammer-warlord-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <categoryLinks>
