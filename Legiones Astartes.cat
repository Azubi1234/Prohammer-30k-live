                      </conditions>
                    </modifier>
                    <modifier type="set" value="1" field="live-r2-r41-unit-xvi-6-garviel-loken-retinue-1-r40-da-steel-transport-veteran-unit-hs-spartan-da-wing-hs-spartan-min">
