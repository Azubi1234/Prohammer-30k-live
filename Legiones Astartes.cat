                                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-steel-transport-terminator-unit-hs-spartan-hs-spartan-p6" shared="true" includeChildSelections="true" />
                              </conditions>
                            </conditionGroup>
                          </conditionGroups>
                        </modifier>
                      </modifiers>
                    </entryLink>
                  </entryLinks>
