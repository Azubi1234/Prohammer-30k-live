              </constraints>
              <rules>
                <rule id="r57-iw-hammer-breacher-r45-cult-breacher-unit-4-rule" name="Pyrae" hidden="false">
                  <description>Hammer of Wrath; Psychic Mastery gives Soul Blaze to close-combat attacks and Flame weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
