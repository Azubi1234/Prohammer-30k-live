        <categoryLink id="r71-nl-r71-nl-hc-raptor-r41-unit-viii-1-night-raptor-squad-r71-nl-cat-horror-comp" name="r71-nl-cat-horror-comp" hidden="true" targetId="r71-nl-cat-horror-comp" primary="false" />
      </categoryLinks>
