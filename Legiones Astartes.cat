                  </costs>
                </entryLink>
                <entryLink name="Combi-Grenade Launcher" id="hs-vind-p2" type="selectionEntry" targetId="gear-combi-grenade" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-vind-p2-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
                <entryLink name="Combi-Meltagun" id="hs-vind-p3" type="selectionEntry" targetId="gear-combi-melta" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-vind-p3-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
                <entryLink name="Combi-Plasma Gun" id="hs-vind-p4" type="selectionEntry" targetId="gear-combi-plasma" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-vind-p4-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
                <entryLink name="Combi-Volkite Charger" id="hs-vind-p5" type="selectionEntry" targetId="gear-combi-volkite" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-vind-p5-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
                <entryLink name="Heavy Bolter" id="hs-vind-p6" type="selectionEntry" targetId="gear-heavy-bolter" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-vind-p6-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                </entryLink>
                <entryLink name="Heavy Flamer" id="hs-vind-p7" type="selectionEntry" targetId="gear-heavy-flamer" hidden="false" import="true">
                  <constraints>
