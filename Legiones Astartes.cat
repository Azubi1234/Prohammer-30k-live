                      <rules>
                        <rule name="Sanctuary" id="r29-null-power-3-rule" hidden="false">
                          <description>Blessing — targets Psyker. Psyker and joined unit receive +1 to Invulnerable Saves, or gain a 6+ Invulnerable Save; Daemons treat all terrain within 12” as Dangerous Terrain.</description>
