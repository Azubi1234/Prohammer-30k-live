                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Dozer Blade" id="r40-da-steel-transport-tactical-unit-hs-spartan-hs-spartan-dozer-blade" hidden="false" import="true">
                  <constraints>
                    <constraint id="r40-da-steel-transport-tactical-unit-hs-spartan-hs-spartan-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
