    <selectionEntry type="unit" import="true" name="ARMILLUS DYNAT" hidden="false" id="r41-unit-xx-4-armillus-dynat">
      <costs>
        <cost name="Points" typeId="pts" value="185" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-xx-4-armillus-dynat-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      </categoryLinks>
