          <selectionEntries>
            <selectionEntry type="upgrade" name="Armistos" id="r52-ec-sonic-hss-hs-hss-armistos" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-sonic-hss-hs-hss-armistos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule name="Armistos" id="r52-ec-sonic-hss-hs-hss-armistos-rule" hidden="false">
                  <description>Fire Control: When this Heavy Support Squad enters Overwatch, its models may declare Overwatch targets out to the normal maximum range of their weapons rather than being restricted to 24". All other Overwatch rules and restrictions apply normally.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Siege Breaker" id="r52-ec-sonic-hss-hs-hss-siegebreaker" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-sonic-hss-hs-hss-siegebreaker-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="35" />
              </costs>
              <rules>
                <rule name="Siege Breaker" id="r52-ec-sonic-hss-hs-hss-siegebreaker-rule" hidden="false">
                  <description>Art of Destruction: Heavy weapons fired by this unit receive +1 to Armour Penetration rolls against vehicles and fortifications. This does not apply to pistols, grenades or close-combat attacks.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
