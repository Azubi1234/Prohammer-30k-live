    <selectionEntry type="unit" import="true" name="Flaymaster Mawdrym Llansahai" hidden="false" id="r41-unit-viii-8-flaymaster-mawdrym-llansahai">
      <categoryLinks>
        <categoryLink id="r41-unit-viii-8-flaymaster-mawdrym-llansahai-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
        <modifier id="r71-nl-mawdrym-traitor" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="r41-unit-viii-8-flaymaster-mawdrym-llansahai-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <costs>
        <cost name="Points" typeId="pts" value="125" />
      </costs>
      <rules>
        <rule id="r71-nl-mawdrym-wargear" name="Wargear" hidden="false">
          <description>Power Armour; Refractor Field; Narthecium; Red Jaqa; Bolt pistol; Frag grenades.</description>
        </rule>
        <rule id="r71-nl-mawdrym-rule-0" name="Red Jaqa" hidden="false">
          <description>Red Jaqa is a Rending Weapon. Any natural To Wound roll of 6 made with Red Jaqa inflicts a Massive Wound (D3) instead of a normal Wound.</description>
        </rule>
        <rule id="r71-nl-mawdrym-rule-1" name="Devil’s Luck" hidden="false">
          <description>Mawdrym may re-roll Feel No Pain rolls of 1. A dice may never be re-rolled more than once.</description>
        </rule>
        <rule id="r71-nl-mawdrym-rule-2" name="Unfit for Command" hidden="false">
          <description>Mawdrym may not fulfil the army’s compulsory HQ requirement and may never be the army’s Warlord.</description>
        </rule>
        <rule id="r73-nl-rule-mawdrym-legiones-astartes-night-lords" name="Legiones Astartes (Night Lords)" hidden="false">
          <description>This model belongs to the VIII Legion and is affected by rules and effects which refer to Legiones Astartes (Night Lords).</description>
        </rule>
        <rule id="r73-nl-rule-mawdrym-independent-character" name="Independent Character" hidden="false">
          <description>Uses the normal ProHammer Independent Character rules.</description>
        </rule>
        <rule id="r73-nl-rule-mawdrym-fearless" name="Fearless" hidden="false">
          <description>The unit uses the ProHammer Fearless special rule.</description>
        </rule>
        <rule id="r73-nl-rule-mawdrym-feel-no-pain-5" name="Feel No Pain (5+)" hidden="false">
          <description>The model has Feel No Pain (5+) and uses the normal ProHammer Feel No Pain rules.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry id="r71-nl-mawdrym-opt-0" name="Krak Grenades" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="2" />
          </costs>
          <constraints>
            <constraint id="r71-nl-mawdrym-opt-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-mawdrym-opt-0-rule" name="Option" hidden="false">
              <description>Adds Krak grenades.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r73-nl-mawdrym-model" name="Flaymaster Mawdrym Llansahai" type="model" hidden="false" import="true" defaultAmount="1">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r73-nl-mawdrym-model-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="r73-nl-mawdrym-model-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Mawdrym Llansahai" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-viii-8-flaymaster-mawdrym-llansahai-profile-0">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">5</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">3</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+/5+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="r73-nl-mawdrym-stealth" name="Stealth Adept" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
          <constraints>
            <constraint id="r73-nl-mawdrym-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r73-nl-mawdrym-stealth-rule" name="Stealth Adept" hidden="false">
              <description>This Independent Character gains Stealth. If joining a unit with Stealth Adept, both the unit and attached Independent Character must possess the upgrade for the unit to benefit.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Konrad Curze, the Night Haunter" hidden="false" id="r41-unit-viii-9-viii-konrad-curze-the-night-haunter">
      <categoryLinks>
        <categoryLink id="r41-unit-viii-9-viii-konrad-curze-the-night-haunter-cat" name="Lords of War" hidden="false" targetId="cat-low" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="r41-unit-viii-9-viii-konrad-curze-the-night-haunter-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <costs>
        <cost name="Points" typeId="pts" value="500" />
      </costs>
      <rules>
        <rule id="r71-nl-curze-0" name="Wargear" hidden="false">
          <description>Nightmare Mantle; Mercy &amp; Forgiveness; Widowmakers; Frag Grenades.</description>
        </rule>
        <rule id="r71-nl-curze-2" name="Nightmare Mantle" hidden="false">
          <description>The Nightmare Mantle counts as Primarch Armour.</description>
        </rule>
        <rule id="r71-nl-curze-3" name="Mercy &amp; Forgiveness" hidden="false">
          <description>Mercy and Forgiveness are a matched pair of Master-crafted Power Weapons. Attacks are resolved at Curze’s normal Strength and have Shred and Rending. They count as two close combat weapons.</description>
        </rule>
        <rule id="r71-nl-curze-4" name="Lethal Precision" hidden="false">
          <description>On an unmodified To Wound roll of 6, a Wound inflicted by the Widowmakers allows neither Armour nor Invulnerable Saves. Cover Saves may be taken normally.</description>
        </rule>
        <rule id="r71-nl-curze-5" name="King of Terrors" hidden="false">
          <description>Enemy units with at least one model within 12 inches of Konrad Curze suffer -2 Leadership. Models and units with Fearless are unaffected.</description>
        </rule>
        <rule id="r71-nl-curze-6" name="Bloody Murder" hidden="false">
          <description>Curze may re-roll failed To Wound rolls of 1 against an enemy unit which is Pinned, Falling Back or below half strength.</description>
        </rule>
        <rule id="r71-nl-curze-7" name="Night Haunter" hidden="false">
          <description>Konrad Curze has Stealth and Hit &amp; Run. In the Movement phase he moves as though Jump Infantry despite not having a Jump Pack. This does not change his Unit Type or grant Deep Strike, Bulky, Swift or other Jump Infantry rules.</description>
        </rule>
        <rule id="r71-nl-curze-8" name="Dark Precognition" hidden="false">
          <description>The first successful To Hit roll made against Konrad Curze during each player turn must be re-rolled; the second result is accepted. Curze is a Psyker (Mastery Level 1) and knows only Precognition from Divination. He takes the Psychic Test for Precognition using Leadership 8. All other normal psychic rules apply.</description>
        </rule>
        <rule id="r71-nl-curze-raptor-ret" name="Night Raptor Retinue" hidden="false">
          <description>If Konrad Curze selects a Night Raptor Squad as his Primarch Retinue, that unit may use his Hit &amp; Run special rule while he remains part of the unit.</description>
        </rule>
        <rule id="r73-nl-rule-curze-primarch" name="Primarch" hidden="false">
          <description>Konrad Curze uses the universal Primarch rules presented in Forces of the Legions.</description>
        </rule>
        <rule id="r73-nl-rule-curze-legiones-astartes-night-lords" name="Legiones Astartes (Night Lords)" hidden="false">
          <description>This model belongs to the VIII Legion and is affected by rules and effects which refer to Legiones Astartes (Night Lords).</description>
        </rule>
        <rule id="r73-nl-rule-curze-psyker-mastery-level-1" name="Psyker (Mastery Level 1)" hidden="false">
          <description>This model is a Psyker with Mastery Level 1 and follows the normal ProHammer psychic rules.</description>
        </rule>
        <rule id="r73-nl-rule-curze-stealth" name="Stealth" hidden="false">
          <description>Konrad Curze has the Stealth special rule as part of Night Haunter.</description>
        </rule>
        <rule id="r73-nl-rule-curze-hit-run" name="Hit &amp; Run" hidden="false">
          <description>The unit uses the ProHammer Hit &amp; Run special rule.</description>
        </rule>
        <rule id="r73-nl-rule-curze-precognition" name="Precognition" hidden="false">
          <description>Blessing, Self. The Psyker re-rolls failed To Hit and To Wound rolls and failed saving throws. Curze knows only this Divination power and tests to invoke it using Leadership 8, as specified by Dark Precognition.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r71-nl-curze-ret" name="Command Retinue (does not occupy a separate Force Organisation slot)" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r71-nl-curze-ret-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Terminator Command Squad" id="r71-nl-curze-ret-0-hq-praetor-ret-termcommand" hidden="false" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="215" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r71-nl-curze-ret-0-hq-praetor-ret-tc-std" hidden="false">
                  <description>Five Terminator Veterans, each equipped with the selected Terminator Armour pattern, a Combi-Bolter and a Power Weapon.</description>
                </rule>
                <rule name="Legiones Astartes" id="r71-nl-curze-ret-0-hq-praetor-ret-tc-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Retinue" id="r71-nl-curze-ret-0-hq-praetor-ret-tc-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character equipped with Terminator, Tartaros or Cataphractii Terminator Armour. It occupies no separate Force Organisation slot; the character and squad count as one HQ selection but may deploy and operate separately.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Terminator Veterans" id="r71-nl-curze-ret-0-hq-praetor-ret-tc-vets" hidden="false" import="true" defaultAmount="5">
