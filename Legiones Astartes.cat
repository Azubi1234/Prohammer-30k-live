      <profiles>
        <profile name="Ammitara Intercessor" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-2-ammitara-occult-intercession-cabal-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
