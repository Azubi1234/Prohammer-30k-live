                <selectionEntry id="r64-if-praetor-huscarl-r64-if-huscarl-harness" name="Grenade Harness" type="upgrade" hidden="false" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                  <constraints>
                    <constraint id="r64-if-praetor-huscarl-r64-if-huscarl-harness-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
