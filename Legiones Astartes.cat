                                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r57-iw-hammer-tactical-r40-da-steel-transport-tactical-unit-hs-spartan-hs-spartan-p6" shared="true" includeChildSelections="true" />
                              </conditions>
                            </conditionGroup>
                          </conditionGroups>
                        </modifier>
                      </modifiers>
