      <categoryLinks>
        <categoryLink id="r45-dg-attack-bike-mobile-cat" name="Death Guard Mobile Support" targetId="cat-dg-mobile" hidden="false" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry type="model" name="Legion Attack Bike" hidden="false" id="r45-dg-attack-bike-fa-attack-bike-model" import="true" defaultAmount="1">
          <constraints>
            <constraint id="r45-dg-attack-bike-fa-attack-bike-model-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r45-dg-attack-bike-fa-attack-bike-model-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="40" />
