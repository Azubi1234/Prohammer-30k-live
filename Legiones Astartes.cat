            <entryLink id="r47-recon-unit-ih-bionics-sgt" name="Bionics — Veteran Sergeant" type="selectionEntry" targetId="r47-ih-bionics-veteran-sergeant" hidden="false" import="true">
              <constraints>
                <constraint id="r47-recon-unit-ih-bionics-sgt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
