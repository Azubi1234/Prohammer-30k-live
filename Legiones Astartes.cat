          <rules>
            <rule name="Forward Positions (Legion Recon Company)" id="r37-recon-forward-rule" hidden="false">
              <description>Units which deploy using Infiltrate or make a pre-game Scout move improve any Cover Save they receive by +1 during the first game turn, to a maximum of 3+.</description>
            </rule>
          </rules>
