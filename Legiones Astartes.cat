                <constraint id="r37-spear-destroyer-transport-src-hq-praetor-ret-honour-land-lrgrp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
              </constraints>
              <rules>
                <rule name="Land Raider Dedicated Transport" id="r37-spear-destroyer-transport-src-hq-praetor-ret-honour-land-lrrule" hidden="false">
                  <description>Select a pattern with sufficient Transport Capacity. These entries use the profiles and standard wargear/rules of the corresponding Legion Land Raider Battle Squadron entry; use that entry for full vehicle upgrade options.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Land Raider Phobos" id="r37-spear-destroyer-transport-src-hq-praetor-ret-honour-land-land-raider-phobos" hidden="false" import="true">
                  <constraints>
                    <constraint id="r37-spear-destroyer-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="250" />
                  </costs>
                  <profiles>
                    <profile name="Land Raider Phobos" id="r37-spear-destroyer-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                      <characteristics>
                        <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                        <characteristic name="Front" typeId="vehicle-front">14</characteristic>
                        <characteristic name="Side" typeId="vehicle-side">14</characteristic>
                        <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry type="model" name="Land Raider Proteus" id="r37-spear-destroyer-transport-src-hq-praetor-ret-honour-land-land-raider-proteus" hidden="false" import="true">
                  <constraints>
