                  <entryLinks>
                    <entryLink import="true" name="Lightning Claw" id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour-m-0" type="selectionEntry" targetId="gear-lightning-claw" hidden="false">
