      <rules>
        <rule name="Unit Type" id="r32-aero-caestus-type" hidden="false">
          <description>Vehicle (Flyer, Hover, Transport)</description>
        </rule>
        <rule name="Wargear" id="r32-aero-caestus-wargear" hidden="false">
          <description>Twin-linked Magna-Melta; Two Havoc Launchers; Armoured Ceramite; Extra Armour.</description>
        </rule>
        <rule name="Flyer" id="r32-aero-caestus-aero-flyer" hidden="false">
          <description>Uses the normal ProHammer Vehicle and Flyer rules, including deployment from Reserves, Zooming/Hovering where applicable, movement, turning, leaving the battlefield, Hard to Hit, Evasion and Flyer damage.</description>
        </rule>
        <rule name="Air-to-Air Targeting" id="r32-aero-caestus-aero-air-to-air-targeting" hidden="false">
          <description>When a Zooming Flyer fires at another Flyer or Flying Monster, it may use its normal Ballistic Skill when rolling To Hit.</description>
        </rule>
        <rule name="Deep Striike" id="r32-aero-caestus-deep-striike" hidden="false">
          <description>Uses the normal ProHammer special rule.</description>
        </rule>
        <rule name="Assault Vehicle" id="r32-aero-caestus-assault-vehicle" hidden="false">
          <description>A Dreadnought may charge during a turn in which it disembarks from this Drop Pod, but may not charge during the same turn in which the Drop Pod itself arrived by Deep Strike.</description>
        </rule>
        <rule name="Power of the Machine Spirit" id="r32-aero-caestus-power-of-the-machine-spirit" hidden="false">
          <description>Use the normal ProHammer Power of the Machine Spirit rule.</description>
        </rule>
        <rule name="Armoured Ceramite" id="r32-aero-caestus-ceramite" hidden="false">
          <description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</description>
        </rule>
        <rule name="Caestus Ram" id="r32-aero-caestus-ram" hidden="false">
          <description>May declare a Ram against an enemy vehicle despite lacking the Tank type. The Ram inflicts S10; roll two dice for Armour Penetration and use the higher, and add +1 to the Vehicle Damage roll. The Caestus has a 5+ Invulnerable Save against Glancing or Penetrating Hits striking its Front Armour, including from Ramming.</description>
        </rule>
        <rule name="Misericord" id="r32-aero-caestus-misericord" hidden="false">
          <description>May only transport models wearing Power Armour, Artificer Armour or Terminator Armour. Terminators count as one model each.</description>
        </rule>
        <rule name="Transport Capacity" id="r32-aero-caestus-cap" hidden="false">
          <description>10 models.</description>
        </rule>
        <rule name="Access Points" id="r32-aero-caestus-access" hidden="false">
          <description>Two front access points.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Frag Assault Launchers" hidden="false" id="r32-aero-caestus-frag">
