                <constraint id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="2" />
              </costs>
              <rules>
                <rule name="Option restriction" id="r41-unit-xviii-6-lord-chaplain-nomus-rhy-tan-opt-0-context" hidden="false">
                  <description>• Nomus Rhy'tan may take:</description>
                </rule>
              </rules>
            </selectionEntry>
