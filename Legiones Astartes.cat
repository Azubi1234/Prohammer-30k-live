        <selectionEntry id="r71-nl-gen-6-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r71-nl-gen-6-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r71-nl-gen-6-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="techmarine-I" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-6-stealth-cost-1" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="techmarine-II" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-6-stealth-cost-2" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="techmarine-III" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-6-stealth-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule id="r71-nl-gen-6-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-7" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-7-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-7-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-7-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-techmarine-covenant" collective="false" import="true">
          <constraints>
            <constraint id="da-wing-techmarine-covenant-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="da-wing-techmarine-covenant-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" value="1" field="da-wing-techmarine-covenant-min">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-techmarine-covenant-0">
              <constraints>
                <constraint id="da-wing-techmarine-covenant-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Stormwing" id="da-wing-techmarine-covenant-0-rule" hidden="false">
                  <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-techmarine-covenant-1">
              <constraints>
                <constraint id="da-wing-techmarine-covenant-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Deathwing" id="da-wing-techmarine-covenant-1-rule" hidden="false">
                  <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-techmarine-covenant-2">
              <constraints>
                <constraint id="da-wing-techmarine-covenant-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Dreadwing" id="da-wing-techmarine-covenant-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-techmarine-covenant-3">
              <constraints>
                <constraint id="da-wing-techmarine-covenant-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ironwing" id="da-wing-techmarine-covenant-3-rule" hidden="false">
                  <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-techmarine-covenant-4">
              <constraints>
                <constraint id="da-wing-techmarine-covenant-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="da-wing-techmarine-covenant-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-techmarine-covenant-5">
              <constraints>
                <constraint id="da-wing-techmarine-covenant-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="da-wing-techmarine-covenant-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
