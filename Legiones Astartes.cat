                      <description>The Standard Bearer may select up to 50 points of permitted Space Marine Armoury weapons and wargear.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Legion Champion" id="hq-centurion-ret-command-champ" hidden="false" import="true">
                  <constraints>
                    <constraint id="hq-centurion-ret-command-champ-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
