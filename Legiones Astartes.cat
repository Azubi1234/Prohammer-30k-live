              </costs>
              <rules>
                <rule id="r57-hq-centurion-iw-bionics-rule" name="Bionics" hidden="false">
                  <description>Iron Warriors Armoury price; otherwise follows the normal Bionics rules.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
