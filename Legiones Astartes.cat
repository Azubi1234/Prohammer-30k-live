                      <costs>
                        <cost name="Points" typeId="pts" value="5" />
                      </costs>
                    </entryLink>
                  </entryLinks>
                  <rules>
                    <rule name="Apothecary Armoury" id="hq-centurion-ret-command-apoth-armrule" hidden="false">
                      <description>The Apothecary may select up to 50 points of permitted Space Marine Armoury weapons and wargear in addition to the Narthecium. The Reductor is optional at +5 points.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Legion Standard Bearer" id="hq-centurion-ret-command-standard" hidden="false" import="true">
                  <constraints>
