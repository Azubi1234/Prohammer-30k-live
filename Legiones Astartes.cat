              <constraints>
                <constraint id="r64-if-templar-pw-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r64-if-templar-pw-rule" name="Power Weapon" hidden="false">
