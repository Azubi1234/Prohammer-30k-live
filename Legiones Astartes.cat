tion></rule></rules></selectionEntry><selectionEntry id="r89-we-kargos-special-rules-3-warrior-apothecary" name="Warrior-Apothecary" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kargos-special-rules-3-warrior-apothecary-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kargos-special-rules-3-warrior-apothecary-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kargos-special-rules-3-warrior-apothecary-rule" name="Warrior-Apothecary" hidden="false"><description>Kargos may use his Narthecium even while he is in base contact with an enemy model. All other normal Narthecium restrictions continue to apply.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-kargos-special-rules-4-command-retinue" name="Command Retinue" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-kargos-special-rules-4-command-retinue-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-kargos-special-rules-4-command-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kargos-special-rules-4-command-retinue-rule" name="Command Retinue" hidden="false"><description>Kargos may select one Legion Command Squad. If Kargos has a Jump Pack, the Command Squad may purchase Jump Packs normally. The selected squad does not occupy a separate Force Organisation slot.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-kargos-options" name="Options" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="r89-we-kargos-opt-0-krak-grenades" name="Krak grenades" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="2" /></costs><constraints><constraint id="r89-we-kargos-opt-0-krak-grenades-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r89-we-kargos-opt-1-melta-bombs" name="Melta bombs" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="5" /></costs><constraints><constraint id="r89-we-kargos-opt-1-melta-bombs-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kargos-opt-1-melta-bombs-rule" name="Melta bombs" hidden="false"><description>Uses the normal Melta bomb rules.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-kargos-opt-2-jump-pack" name="Jump Pack" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="20" /></costs><constraints><constraint id="r89-we-kargos-opt-2-jump-pack-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-kargos-opt-2-jump-pack-rule" name="Jump Pack" hidden="false"><description>Changes Kargos to Jump Infantry while equipped.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r3-we-r41-unit-xii-9-kargos-the-bloodspitter-retinue" name="RETINUE — choose up to one (n