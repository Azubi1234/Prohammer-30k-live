                      </constraints>
                      <rules>
                        <rule name="Dreadwing" id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-da-wing-hs-spartan-2-rule" hidden="false">
                          <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-da-wing-hs-spartan-3">
                      <constraints>
                        <constraint id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-da-wing-hs-spartan-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <rules>
                        <rule name="Ironwing" id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-da-wing-hs-spartan-3-rule" hidden="false">
                          <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-da-wing-hs-spartan-4">
                      <constraints>
                        <constraint id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-da-wing-hs-spartan-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <rules>
                        <rule name="Firewing" id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-da-wing-hs-spartan-4-rule" hidden="false">
                          <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-da-wing-hs-spartan-5">
                      <constraints>
                        <constraint id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-da-wing-hs-spartan-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <rules>
                        <rule name="Ravenwing" id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-da-wing-hs-spartan-5-rule" hidden="false">
                          <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
                <selectionEntryGroup id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-r40-da-ammo-hs-spartan" name="Dark Angels Armoury — Ammunition" hidden="false" collective="false" import="true">
                  <entryLinks>
                    <entryLink id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-r40-da-ammo-hs-spartan-hs-spartan-p6" name="Molecular Acid Shells (for Heavy Bolter)" type="selectionEntry" targetId="da22-acid-hb" hidden="true" import="true">
                      <constraints>
                        <constraint id="r57-iw-hammer-breacher-r40-da-steel-transport-breacher-unit-hs-spartan-r40-da-ammo-hs-spartan-hs-spartan-p6-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
