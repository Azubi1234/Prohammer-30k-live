              </costs>
            </entryLink>
            <entryLink name="Arachnus Heavy Lascannon Battery" id="hs-deredeo-arachnus" type="selectionEntry" targetId="hsgear-arachnus" hidden="false" import="true">
              <constraints>
                <constraint id="hs-deredeo-arachnus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
