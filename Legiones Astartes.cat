        <selectionEntryGroup id="r74-ba-amit-retinue" name="RETINUE — choose up to one (no separate FOC slot)" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r74-ba-amit-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Command Squad" id="r74-ba-amit-cmd-hq-centurion-ret-command" hidden="false" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="90" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r74-ba-amit-cmd-hq-centurion-ret-command-std" hidden="false">
                  <description>Five Legion Veterans, each equipped with Power Armour, Bolt Pistol, Chainsword and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="r74-ba-amit-cmd-hq-centurion-ret-command-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Retinue" id="r74-ba-amit-cmd-hq-centurion-ret-command-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character. It occupies no separate Force Organisation slot; character and Command Squad count as one HQ choice but may deploy and operate separately.</description>
