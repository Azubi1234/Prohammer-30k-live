                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="30" id="r60-ws-hibou-retinue-legion-veteran-squad-r57-veteran-unit-iw-servo-pts" />
                      </costs>
                      <rules>
                        <rule id="r60-ws-hibou-retinue-legion-veteran-squad-r57-veteran-unit-iw-servo-rule" name="Servo-Arm" hidden="false">
                          <description>Follows the normal Servo-Arm rules in the Legiones Astartes Army List. A model equipped with a Jump Pack may not purchase a Servo-Arm.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry id="r60-ws-hibou-retinue-legion-veteran-squad-r57-veteran-unit-iw-bionics" name="Bionics" type="upgrade" hidden="false" import="true">
