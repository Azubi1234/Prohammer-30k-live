      <rules>
        <rule name="Standard Wargear" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-wargear" hidden="false">
          <description>4 Legion Space Marines and 1 Legion Sergeant. Power Armour, Bolter, Bolt pistol and Frag grenades. The unit has Legiones Astartes; the Sergeant is a Character.</description>
        </rule>
        <rule name="Sergeant Armoury" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-armoury-rule" hidden="false">
          <description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Normal Sergeant weapon limits apply. Unit-specific replacements take precedence over duplicate Armoury purchases.</description>
        </rule>
        <rule id="r42-role-xiv-0-legion-heavy-support-squads-rite-note" name="Rite of War Interaction" hidden="false">
          <description>The Reaping is one of the characteristic attack formations of the XIV Legion. Heavy infantry and fire-support units advance in a relentless column, purging shattered cities and fortified battlefields through weight of fire and remorseless attrition.
EFFECTS
SUPERIOR FIREPOWER
Legion Veteran Squads and Legion Heavy Support Squads may be selected as non-compulsory Troops choices.
They may not fulfil compulsory Troops selections unless another rule specifically permits them to do so.
IMPLACABLE
All Death Guard Infantry units gain the Move Through Cover special rule.
This includes models wearing any form of Terminator Armour.
DARK ARSENAL
Any Death Guard Character or Independent Character may purchase Rad Grenades for +10 points.
Rad Grenades follow the normal rules presented in the Legiones Astartes Army List.
LIMITATIONS
Units in the Detachment may not make Advance Moves.
Vehicles in the Detachment may not move Flat Out.
Units in the Detachment may not deploy using Deep Strike. Units which are required to deploy using Deep Strike may not be selected.
The normal Death Guard restriction on Fast Attack choices from Footslogging Killers continues to apply.</description>
        </rule>
        <rule id="r42-role-xiv-0-legion-heavy-support-squads-clone-cleanup" name="Builder compatibility" hidden="false">
          <description>Removed 1 obsolete armoury link(s) inherited from the generic source entry while creating this Rite-specific battlefield-role copy.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" name="Squad Models" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-additional" hidden="false" import="true" defaultAmount="5">
          <constraints>
            <constraint id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-additional-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" />
            <constraint id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-additional-r56-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" name="Hardened Armour (entire squad)" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-hardened" hidden="false" import="true">
          <constraints>
            <constraint id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-hardened-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <rules>
            <rule name="Hardened Armour (entire squad)" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-hardened-rule" hidden="false">
              <description>Failed Armour Saves caused by Blast or Template weapons may be re-rolled. Reduce Advance additional distance, Charge distance and Pursuit distance by 1". Counts as Void Hardened where applicable.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-gen-35-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r71-nl-gen-35-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r71-nl-gen-35-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-35-stealth-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule id="r71-nl-gen-35-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-42" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-42-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-42-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-42-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
