      </modifiers>
      <costs>
        <cost name="Points" typeId="pts" value="0.0" />
      </costs>
      <selectionEntries>
        <selectionEntry id="r71-nl-atramentar-models" name="5 Atramentar" type="model" hidden="false" import="true" defaultAmount="5">
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <constraints>
            <constraint id="r71-nl-atramentar-models-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="r71-nl-atramentar-models-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
            <profile name="Atramentar" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-viii-3-atramentar-flay-clade-profile-0">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
