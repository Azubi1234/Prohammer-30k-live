                <selectionEntry id="r69-centurion-command-bikes" name="Space Marine Bikes (entire squad)" type="upgrade" hidden="true" import="true">
                  <constraints>
                    <constraint id="r69-centurion-command-bikes-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="100" id="r69-centurion-command-bikes-pts" />
                  </costs>
                  <modifiers>
                    <modifier id="r69-centurion-command-bikes-show" type="set" value="false" field="hidden">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="roster" childId="hq-centurion-bike" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </conditions>
                    </modifier>
                    <modifier id="r69-hide-r69-centurion-command-bikes-hq-centurion-ret-command-jump" type="set" value="true" field="hidden">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-centurion-ret-command-jump" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </conditions>
                    </modifier>
                    <modifier id="r69-hide-r69-centurion-command-bikes-r69-centurion-command-jetbikes" type="set" value="true" field="hidden">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r69-centurion-command-jetbikes" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </conditions>
                    </modifier>
                  </modifiers>
                  <rules>
                    <rule id="r69-centurion-command-bikes-rule" name="Mounted Retinue" hidden="false">
                      <description>Available when the selecting character is mounted as stated in its entry. Every model in this retinue takes the same Space Marine Bikes for +20 points per model. A mounted retinue may not select a Dedicated Transport.</description>
                    </rule>
                  </rules>
                </selectionEntry>
