                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="175" id="r69-centurion-command-jetbikes-pts" />
                  </costs>
                  <modifiers>
                    <modifier id="r69-centurion-command-jetbikes-show" type="set" value="false" field="hidden">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="roster" childId="r37-centurion-jetbike" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </conditions>
