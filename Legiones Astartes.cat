      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Assault Marine" hidden="false" id="assault-marine" defaultAmount="9">
          <constraints>
            <constraint type="min" value="9" field="selections" scope="parent" shared="true" id="assault-marine-min" includeChildSelections="false" />
            <constraint type="max" value="19" field="selections" scope="parent" shared="true" id="assault-marine-max" includeChildSelections="false" />
