                  <description>The squad gains the Counter-Attack special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Machine Killers" hidden="false" id="r40-da-vow-veteran-veteran-tactic-machine">
              <constraints>
