                            <constraint id="r63-sw-deathsworn-transport-lr-hs-lr-ac-up-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <modifiers>
                            <modifier type="set" value="2" field="r63-sw-deathsworn-transport-lr-hs-lr-ac-up-auxiliary-drive-max">
