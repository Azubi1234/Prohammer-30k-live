                        <selectionEntry type="upgrade" name="Auxiliary Drive" id="r64-if-templar-transport-lr-hs-lr-ph-up-auxiliary-drive" hidden="false" import="true">
                          <constraints>
                            <constraint id="r64-if-templar-transport-lr-hs-lr-ph-up-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
