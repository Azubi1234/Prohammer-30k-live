                                  </constraints>
                                  <modifiers>
                                    <modifier type="set" value="2" field="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-ac-up-auxiliary-drive-max">
                                      <conditions>
                                        <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-achilles" shared="true" includeChildSelections="true" />
                                      </conditions>
