    <selectionEntry type="unit" import="true" name="WOLF SCOUT SQUAD — Rewards of Treachery" hidden="false" id="r46-al-reward-11">
      <costs>
        <cost name="Points" typeId="pts" value="15.0" />
      </costs>
      <modifiers>
        <modifier id="r48-vis-392" type="set" value="true" field="hidden">
