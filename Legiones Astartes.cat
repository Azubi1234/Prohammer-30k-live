        <selectionEntry id="r71-nl-gen-7-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r71-nl-gen-7-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r71-nl-gen-7-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="fa-seeker-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-7-stealth-cost-1" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="fa-seeker-sgt" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-7-stealth-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule id="r71-nl-gen-7-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-8" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-8-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-8-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-8-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule name="Standard Wargear" id="fa-seeker-std" hidden="false">
          <description>Power Armour; Bolter; Bolt Pistol; Frag Grenades; Special Issue Ammunition.</description>
        </rule>
        <rule name="Legiones Astartes" id="fa-seeker-la" hidden="false">
          <description>Legiones Astartes; also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless.</description>
        </rule>
        <rule name="Infiltrate &amp; Move Through Cover" id="fa-seeker-move" hidden="false">
          <description>The squad has Infiltrate and Move Through Cover as defined in ProHammer Classic.</description>
        </rule>
        <rule name="Marked for Death" id="fa-seeker-mark" hidden="false">
          <description>After deployment, nominate one enemy unit for each Legion Seeker Squad. Against its nominated target, the squad re-rolls To Hit rolls of 1 and To Wound rolls of 1; against vehicles it re-rolls Armour Penetration rolls of 1 instead of To Wound rolls. If the target is destroyed, no new target is selected.</description>
        </rule>
        <rule name="Special Issue Ammunition" id="fa-seeker-ammo-rule" hidden="false">
          <description>Whenever the squad fires Bolters, Foeblaster Boltguns or the bolter component of Combi-weapons, choose one ammunition type for all eligible models: Dragonfire, Hellfire, Kraken or Vengeance. Use the profiles shown below.</description>
        </rule>
      </rules>
