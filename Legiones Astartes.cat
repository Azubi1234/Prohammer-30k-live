                            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                            <characteristic name="S" typeId="ranged-s">5</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Standard Wargear" id="r63-sw-slayer-transport-lr-hs-lr-phobos-wg" hidden="false">
                          <description>Two Twin-linked Lascannons, Twin-linked Heavy Bolter, Searchlight and Smoke Launchers. Power of the Machine Spirit; Assault Vehicle; Transport Capacity 10.</description>
                        </rule>
                        <rule name="Assault Vehicle" id="r63-sw-slayer-transport-lr-hs-lr-phobos-assault-vehicle" hidden="false">
                          <description>Units may charge after disembarking as allowed by ProHammer.</description>
                        </rule>
                      </rules>
                      <selectionEntries>
