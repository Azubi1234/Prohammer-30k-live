        <selectionEntryGroup name="Dedicated Transport" id="r57-iw-hammer-tactical-tac-transport" hidden="true">
          <selectionEntryGroups>
            <selectionEntryGroup name="Land Raider Dedicated Transport (Armoured Spearhead)" id="r57-iw-hammer-tactical-r37-spear-tac-transport" hidden="true">
