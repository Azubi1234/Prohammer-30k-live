                            <modifier type="set" value="2" field="r64-if-templar-transport-lr-hs-lr-ph-up-auxiliary-drive-max">
                              <conditions>
                                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r64-if-templar-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                            <modifier type="set" value="3" field="r64-if-templar-transport-lr-hs-lr-ph-up-auxiliary-drive-max">
                              <conditions>
                                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r64-if-templar-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                          </modifiers>
                          <costs>
                            <cost name="Points" typeId="pts" value="10" />
                          </costs>
                          <rules>
                            <rule name="Auxiliary Drive" id="r64-if-templar-transport-lr-hs-lr-ph-up-auxiliary-drive-rule" hidden="false">
                              <description>At the start of the controlling player's Movement phase, if the vehicle is Immobilised, roll a D6. On a 4+, remove one Immobilised result; it may move normally that phase.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Armoured Ceramite" id="r64-if-templar-transport-lr-hs-lr-ph-up-armoured-ceramite" hidden="false" import="true">
