        <rule name="Wargear" id="r32-aero-fireraptor-wargear" hidden="false">
          <description>Twin-linked Avenger Bolt Cannon; Two Quad Heavy Bolter Turrets; Four Tempest Rockets; Extra Armour.</description>
        </rule>
        <rule name="Sunder" id="r32-aero-fireraptor-weapon-tempest-rocket-wr-0-sunder" hidden="false">
          <description>May re-roll failed Armour Penetration rolls against Vehicles.</description>
        </rule>
        <rule name="Flyer" id="r32-aero-fireraptor-aero-flyer" hidden="false">
          <description>Uses the normal ProHammer Vehicle and Flyer rules, including deployment from Reserves, Zooming/Hovering where applicable, movement, turning, leaving the battlefield, Hard to Hit, Evasion and Flyer damage.</description>
        </rule>
        <rule name="Air-to-Air Targeting" id="r32-aero-fireraptor-aero-air-to-air-targeting" hidden="false">
          <description>When a Zooming Flyer fires at another Flyer or Flying Monster, it may use its normal Ballistic Skill when rolling To Hit.</description>
        </rule>
        <rule name="Deep Strike" id="r32-aero-fireraptor-deep-strike" hidden="false">
          <description>Uses the normal ProHammer Deep Strike rules except as modified below.</description>
        </rule>
        <rule name="Strafing Run" id="r32-aero-fireraptor-strafing-run" hidden="false">
          <description>When shooting Assault, Heavy, Rapid Fire or Salvo weapons at ground units that are not Flyers or Skimmers, the vehicle gains +1 Ballistic Skill and all such shots count as Pinning, as defined in ProHammer Classic.</description>
        </rule>
        <rule name="Power of the Machine Spirit" id="r32-aero-fireraptor-power-of-the-machine-spirit" hidden="false">
          <description>Use the normal ProHammer Power of the Machine Spirit rule.</description>
        </rule>
        <rule name="Independent Turret Fire" id="r32-aero-fireraptor-turrets" hidden="false">
          <description>The two waist-mounted turrets operate independently. Each may fire at a different target from the gunship's other weapons and from the other turret. Weapons fired by these turrets do not count towards the number of weapons normally permitted by movement speed.</description>
        </rule>
      </rules>
