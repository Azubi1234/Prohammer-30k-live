    <selectionEntry type="unit" name="Legion Vindicator Siege Tank Squadron" id="hs-vindicator" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-vindicator-cat" primary="true" name="Heavy Support" hidden="false" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry type="model" name="Legion Vindicator" id="hs-vindicator-model" hidden="false" defaultAmount="1" import="true">
          <constraints>
            <constraint id="hs-vindicator-model-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="hs-vindicator-model-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="120" />
          </costs>
          <profiles>
            <profile name="Legion Vindicator" id="hs-vindicator-model-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
              <characteristics>
                <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                <characteristic name="Front" typeId="vehicle-front">13</characteristic>
                <characteristic name="Side" typeId="vehicle-side">11</characteristic>
                <characteristic name="Rear" typeId="vehicle-rear">10</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Standard Wargear" id="hs-vind-wg" hidden="false">
              <description>Demolisher Cannon, Combi-bolter, Searchlight and Smoke Launchers.</description>
            </rule>
            <rule name="Power Capacitor" id="hs-vind-cap" hidden="false">
              <description>If a Vindicator armed with a Laser Destroyer Array remained stationary in its Movement phase, it may fire the weapon as Ordnance 2, Twin-linked. Alternatively it may fire an Overcharged Volley as Ordnance 3, Twin-linked; after firing an Overcharged Volley, on a D6 roll of 1 the Vindicator suffers an automatic Glancing Hit.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry type="upgrade" name="Laser Destroyer Array (replaces Demolisher Cannon)" id="hs-vind-laser" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-laser-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-laser-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-laser-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <profiles>
                <profile name="Laser Destroyer Array" id="hs-vind-laser-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                    <characteristic name="S" typeId="ranged-s">9</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">1</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Ordnance 1, Twin-linked</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hs-vind-up-hunter-killer-missile" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-up-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-up-hunter-killer-missile-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-up-hunter-killer-missile-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <rules>
                <rule name="Hunter-Killer Missile" id="hs-vind-up-hunter-killer-missile-rule" hidden="false">
                  <description>Unlimited range, S8 AP3, Heavy 1, One Use.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Dozer Blade" id="hs-vind-up-dozer-blade" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-up-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-up-dozer-blade-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-up-dozer-blade-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <rules>
                <rule name="Dozer Blade" id="hs-vind-up-dozer-blade-rule" hidden="false">
                  <description>Use the normal ProHammer Dozer Blade rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Extra Armour" id="hs-vind-up-extra-armour" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-up-extra-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-up-extra-armour-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-up-extra-armour-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <rules>
                <rule name="Extra Armour" id="hs-vind-up-extra-armour-rule" hidden="false">
                  <description>Use the normal ProHammer Extra Armour rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Auxiliary Drive" id="hs-vind-up-auxiliary-drive" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-up-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-up-auxiliary-drive-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-up-auxiliary-drive-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <rules>
                <rule name="Auxiliary Drive" id="hs-vind-up-auxiliary-drive-rule" hidden="false">
                  <description>At the start of the controlling player's Movement phase, if the vehicle is Immobilised, roll a D6. On a 4+, remove one Immobilised result; it may move normally that phase.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Armoured Ceramite" id="hs-vind-up-armoured-ceramite" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-up-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-up-armoured-ceramite-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-up-armoured-ceramite-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule name="Armoured Ceramite" id="hs-vind-up-armoured-ceramite-rule" hidden="false">
                  <description>Melta weapons do not receive their additional Armour Penetration die against this vehicle, regardless of range.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Power of the Machine Spirit" id="hs-vind-up-power-of-the-machine-spirit" hidden="false" import="true">
              <constraints>
                <constraint id="hs-vind-up-power-of-the-machine-spirit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-up-power-of-the-machine-spirit-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-up-power-of-the-machine-spirit-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <rules>
                <rule name="Power of the Machine Spirit" id="hs-vind-up-power-of-the-machine-spirit-rule" hidden="false">
                  <description>Use the normal ProHammer Power of the Machine Spirit rule.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup name="Pintle-mounted Weapon" id="hs-vind-pintle" hidden="false">
              <constraints>
                <constraint id="hs-vind-pintle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-vind-pintle-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-vind-pintle-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <entryLinks>
                <entryLink name="Twin-linked Bolter" id="hs-vind-p0" type="selectionEntry" targetId="gear-tl-bolter" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-vind-p0-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
                <entryLink name="Combi-Flamer" id="hs-vind-p1" type="selectionEntry" targetId="gear-combi-flamer" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-vind-p1-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
