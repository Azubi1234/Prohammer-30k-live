            <entryLink id="r45-terminator-unit-ts-brother" name="Brotherhood of Psykers (Mastery Level 1)" type="selectionEntry" targetId="r45-ts-brotherhood" hidden="false" import="true">
              <constraints>
                <constraint id="r45-terminator-unit-ts-brother-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="true" field="hidden" id="r45-terminator-unit-ts-brother-hide-rite">
                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="force" childId="r25-rite-xv-2-the-fellowships-of-prospero" shared="true" includeChildSelections="true" includeChildForces="false" />
