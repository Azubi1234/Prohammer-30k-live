    <selectionEntry type="unit" import="true" name="Fenrisian Wolf Pack" hidden="false" id="r41-unit-vi-6-fenrisian-wolf-pack">
      <costs>
        <cost name="Points" typeId="pts" value="0" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-vi-6-fenrisian-wolf-pack-cat" name="Fast Attack" hidden="false" targetId="cat-fast" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier id="r63-sw-r41-unit-vi-6-fenrisian-wolf-pack-legion-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Fenrisian Wolf" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-vi-6-fenrisian-wolf-pack-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
            <characteristic name="BS" typeId="model-bs">0</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">1</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">2</characteristic>
            <characteristic name="Ld" typeId="model-ld">8</characteristic>
            <characteristic name="Sv" typeId="model-sv">6+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry id="r63-sw-wolves-models" name="Fenrisian Wolves" type="model" hidden="false" import="true" defaultAmount="5">
          <costs>
            <cost name="Points" typeId="pts" value="12" />
          </costs>
          <constraints>
            <constraint id="r63-sw-wolves-models-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="r63-sw-wolves-models-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" automatic="true" />
          </constraints>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule id="r63-sw-wolves-type" name="Unit Type" hidden="false">
          <description>Cavalry.</description>
        </rule>
        <rule id="r63-sw-wolves-pack" name="Pack Hunters" hidden="false">
          <description>The pack must declare a charge if it is legally able to do so. If it wins a close combat and the enemy Retreats, the pack must Pursue whenever it is able.</description>
        </rule>
        <rule id="r63-sw-wolves-retinue-note" name="Wolf Retinue" hidden="false">
          <description>In addition to this Fast Attack pack, eligible Space Wolves Independent Characters may select a separate retinue of exactly two Fenrisian Wolves for +24 points. Those Wolves may be taken in addition to another Retinue and may never voluntarily leave the character.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Hvarl Red-Blade" hidden="false" id="r41-unit-vi-7-hvarl-red-blade">
      <costs>
        <cost name="Points" typeId="pts" value="195" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-vi-7-hvarl-red-blade-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier id="r63-sw-r41-unit-vi-7-hvarl-red-blade-legion-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
        <modifier id="r63-sw-hvarl-1500" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1500" field="limit::pts" scope="roster" childId="model" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="r41-unit-vi-7-hvarl-red-blade-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <profiles>
        <profile name="Hvarl Red-Blade" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-vi-7-hvarl-red-blade-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">6</characteristic>
            <characteristic name="BS" typeId="model-bs">5</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">3</characteristic>
            <characteristic name="I" typeId="model-i">5</characteristic>
            <characteristic name="A" typeId="model-a">4</characteristic>
            <characteristic name="Ld" typeId="model-ld">10</characteristic>
            <characteristic name="Sv" typeId="model-sv">2+/4+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="r63-sw-hvarl-wg" name="Wargear" hidden="false">
          <description>Terminator Armour, Iron Halo, Heavy Bolter and the Red-Blade.</description>
        </rule>
        <rule id="r63-sw-hvarl-special" name="Special Rules" hidden="false">
          <description>Legiones Astartes (Space Wolves), Independent Character, Master of the Legion, Headsman.</description>
        </rule>
        <rule id="r63-sw-hvarl-redblade" name="Red-Blade" hidden="false">
          <description>Two-Handed Power Weapon. The bearer has +2 Strength and suffers -1 Initiative while using it.</description>
        </rule>
        <rule id="r63-sw-hvarl-headsman" name="Headsman" hidden="false">
          <description>At the start of an Assault phase, if Hvarl is engaged with one or more enemy Independent Characters, nominate one. Hvarl must attack that character if able and may re-roll failed To Wound rolls against enemy Independent Characters.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r63-sw-hvarl-retinue" name="Retinue" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r63-sw-hvarl-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Terminator Command Squad" id="r63-sw-hvarl-term-hq-praetor-ret-termcommand" hidden="false" import="true">
              <constraints>
                <constraint id="r63-sw-hvarl-term-hq-praetor-ret-termcommand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="215" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r63-sw-hvarl-term-hq-praetor-ret-tc-std" hidden="false">
                  <description>Five Terminator Veterans, each equipped with the selected Terminator Armour pattern, a Combi-Bolter and a Power Weapon.</description>
                </rule>
                <rule name="Legiones Astartes" id="r63-sw-hvarl-term-hq-praetor-ret-tc-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Retinue" id="r63-sw-hvarl-term-hq-praetor-ret-tc-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character equipped with Terminator, Tartaros or Cataphractii Terminator Armour. It occupies no separate Force Organisation slot; the character and squad count as one HQ selection but may deploy and operate separately.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Terminator Veterans" id="r63-sw-hvarl-term-hq-praetor-ret-tc-vets" hidden="false" import="true" defaultAmount="5">
                  <constraints>
                    <constraint id="r63-sw-hvarl-term-hq-praetor-ret-tc-vets-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r63-sw-hvarl-term-hq-praetor-ret-tc-vets-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Terminator Veteran" id="r63-sw-hvarl-term-hq-praetor-ret-tc-vets-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">4</characteristic>
                        <characteristic name="BS" typeId="model-bs">4</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">1</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">2</characteristic>
                        <characteristic name="Ld" typeId="model-ld">9</characteristic>
                        <characteristic name="Sv" typeId="model-sv">2+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Terminator Apothecary" id="r63-sw-hvarl-term-hq-praetor-ret-tc-apoth" hidden="false" import="true">
                  <constraints>
                    <constraint id="r63-sw-hvarl-term-hq-praetor-ret-tc-apoth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
