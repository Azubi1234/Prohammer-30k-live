        </selectionEntry>
        <selectionEntry id="r71-nl-atramentar-pair" name="Pair of Lightning Claws — replaces both weapons" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <constraints>
            <constraint id="r71-nl-atramentar-pair-max" type="max" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r71-nl-atramentar-pair-inc" type="increment" value="1" field="r71-nl-atramentar-pair-max">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="r71-nl-atramentar-models" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-40" name="Beyond Judgement — Fear (Trophies already equipped)" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-40-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-40-rule" name="Beyond Judgement" hidden="false">
              <description>This squad already carries Trophies of Judgement. Under Horror Cult it may still purchase Beyond Judgement for +25 points per unit; doing so grants Fear and treats the squad as equipped with Trophies of Judgement in the manner specified by the Rite. Measure the 8-inch Leadership penalty from any model. Trophies penalties remain non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-40-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule id="r71-nl-atramentar-rule-1" name="Wargear" hidden="false">
          <description>Cataphractii Terminator Armour, Trophies of Judgement, Combi-bolter and Power Weapon.</description>
        </rule>
        <rule id="r71-nl-atramentar-rule-3" name="Teleport Assault" hidden="false">
          <description>An Atramentar Flay-Clade may deploy using Deep Strike even if the mission does not normally permit Deep Strike. All other normal ProHammer Deep Strike rules apply.</description>
        </rule>
        <rule id="r73-nl-rule-r41-unit-viii-3-atramentar-flay-clade-legiones-astartes-night-lords" name="Legiones Astartes (Night Lords)" hidden="false">
          <description>This model belongs to the VIII Legion and is affected by rules and effects which refer to Legiones Astartes (Night Lords).</description>
        </rule>
        <rule id="r73-nl-rule-r41-unit-viii-3-atramentar-flay-clade-fearless" name="Fearless" hidden="false">
          <description>The unit uses the ProHammer Fearless special rule.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r71-nl-atramentar-ranged" name="Combi-bolter Replacements" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r71-nl-atramentar-ranged-max" type="max" value="0" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r71-nl-atramentar-ranged-inc" type="increment" value="1" field="r71-nl-atramentar-ranged-max">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="r71-nl-atramentar-models" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-atramentar-pair-dec-0" type="decrement" value="1" field="r71-nl-atramentar-ranged-max">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="parent" childId="r71-nl-atramentar-pair" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry id="r71-nl-atramentar-r-storm" name="Storm Bolter" type="upgrade" hidden="false" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="0" />
              </costs>
              <constraints>
                <constraint id="r71-nl-atramentar-r-storm-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
