                  <constraints>
                    <constraint id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour-melee-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="true" />
