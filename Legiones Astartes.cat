                      <rules>
                        <rule id="r74-ba-ral-guard-r74-ba-azk-up-master" name="Master of the Seraphim" hidden="false">
                          <description>A Sanguinary Guard Squad containing Azkaellon may deploy using Deep Strike even if the mission does not normally permit it. If selected as a character’s retinue, that character must also be capable of Deep Striking or the unit deploys normally.</description>
                        </rule>
                        <rule id="r74-ba-ral-guard-r74-ba-azk-up-glaive" name="Glaive Encarmine" hidden="false">
                          <description>Two-Handed, Master-crafted Power Weapon. Attacks are resolved at Strength 6.</description>
                        </rule>
                        <rule id="r74-ba-ral-guard-r74-ba-azk-up-artificer-armour" name="Artificer Armour" hidden="false">
                          <description>Fixed Azkaellon wargear.</description>
                        </rule>
                        <rule id="r74-ba-ral-guard-r74-ba-azk-up-sanguine-pattern-jump-pack" name="Sanguine-pattern Jump Pack" hidden="false">
