                <entryLink import="true" name="Calibanite Plasma Pistol" hidden="false" id="da22-alt-pp-8" type="selectionEntry" targetId="da22-plasma-pistol">
                  <constraints>
                    <constraint id="da22-alt-pp-8-2" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
