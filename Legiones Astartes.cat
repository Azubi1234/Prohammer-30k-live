              <constraints>
                <constraint id="hs-hss-hw-3-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
            </entryLink>
            <entryLink name="Multi-Melta (replaces Bolter)" id="hs-hss-hw-4" type="selectionEntry" targetId="gear-multimelta" hidden="false" import="true">
              <constraints>
                <constraint id="hs-hss-hw-4-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
