                  <constraints>
                    <constraint id="r29-forge-servo-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r29-forge-servo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                </entryLink>
              </entryLinks>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Herald Consul" id="hq-consul-herald" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-herald-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="40" />
              </costs>
              <rules>
                <rule name="Legion Herald Consul" id="hq-consul-herald-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Herald Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Legion Support Officer" id="r29-herald-support" hidden="false">
                  <description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</description>
                </rule>
                <rule name="Banner of Allegiance" id="r29-herald-banner" hidden="false">
                  <description>Use the selected Banner of the Aquila or Banner of the Eye rule shown by the Herald upgrade.</description>
                </rule>
                <rule name="Fallen Honour" id="r29-herald-fallen" hidden="false">
                  <description>If the Herald is slain, the opposing player gains +1 Victory Point in missions using Victory Points.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Banner of Allegiance" id="hq-consul-herald-banner" hidden="false">
                  <constraints>
                    <constraint id="hq-consul-herald-banner-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                    <constraint id="hq-consul-herald-banner-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="upgrade" name="Banner of the Aquila — Loyalist" id="hq-consul-herald-aquila" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-herald-aquila-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <rules>
                        <rule name="Banner of the Aquila" id="hq-consul-herald-aquila-rule" hidden="false">
                          <description>The Herald and friendly Loyalist models with Legiones Astartes within 12" receive +1 Weapon Skill, to a maximum of WS5.</description>
                        </rule>
                      </rules>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-138" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Banner of the Eye — Traitor" id="hq-consul-herald-eye" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-herald-eye-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <rules>
                        <rule name="Banner of the Eye" id="hq-consul-herald-eye-rule" hidden="false">
                          <description>The Herald and friendly Traitor models with Legiones Astartes within 12" add +1" to Advance and Charge moves. On a turn in which such a unit successfully charges, it may re-roll To Hit rolls of 1 in close combat.</description>
                        </rule>
                      </rules>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-139" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
              </selectionEntryGroups>
              <categoryLinks>
                <categoryLink id="r80-ih-consul-cat-137" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                <categoryLink id="r81-ih-consul-cat-5" name="Head of the Gorgon — non-Forge Consul" hidden="true" targetId="r81-ih-nonforge-consul" primary="false" />
              </categoryLinks>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Master of Signals Consul" id="hq-consul-signals" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-signals-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="45" />
              </costs>
              <rules>
                <rule name="Legion Master of Signals Consul" id="hq-consul-signals-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Master of Signals Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Targeting Matrix" id="hq-consul-signals-matrix-rule" hidden="false">
                  <description>A Cognis Signum with Targeting Matrix also provides the normal benefits of a Signum to the unit the Master of Signals has joined.</description>
                </rule>
                <rule name="Legion Support Officer" id="r29-signals-support" hidden="false">
                  <description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</description>
                </rule>
                <rule name="Cognis Signum" id="r29-signals-cognis-rule" hidden="false">
                  <description>The Master of Signals’ Nuncio Vox no-scatter range is 12” instead of 6”. The optional Targeting Matrix also grants the normal Signum benefit to his joined unit.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="upgrade" name="Targeting Matrix" id="hq-consul-signals-matrix" hidden="false" import="true">
                  <constraints>
                    <constraint id="hq-consul-signals-matrix-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                  <categoryLinks>
                    <categoryLink id="r80-ih-consul-cat-141" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                  </categoryLinks>
                </selectionEntry>
              </selectionEntries>
              <selectionEntryGroups>
                <selectionEntryGroup name="Orbital Bombardment (choose at most one)" id="hq-consul-signals-orbital" hidden="false">
                  <constraints>
                    <constraint id="hq-consul-signals-orbital-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="upgrade" name="Lance Strike" id="hq-consul-signals-orb-lance" hidden="false" import="true">
