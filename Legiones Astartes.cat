    </selectionEntries><rules><rule id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-rule" name="Retinue" hidden="false"><description>Xii — Angron, The Red Angel may select one of the listed retinue units. The selected unit does not occupy a separate Force Organisation slot.</description></rule></rules></selectionEntryGroup></selectionEntryGroups><selectionEntries /></selectionEntry>
