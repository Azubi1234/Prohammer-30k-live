                  </constraints>
                  <modifiers>
                    <modifier id="r71-nl-gen-20-stealth-cost-0" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r52-ec-luc-command-hq-centurion-ret-command-vets" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
