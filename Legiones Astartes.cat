                <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r74-ba-rev-vet-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-hunter-killer-missile" hidden="false" import="true">
                  <constraints>
