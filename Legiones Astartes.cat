              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry id="r71-nl-ta-raptor-r71-nl-raptor-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
