        <selectionEntry type="model" name="Javelin Attack Speeder" hidden="false" id="fa-javelin-model" import="true" defaultAmount="1">
          <constraints>
            <constraint id="fa-javelin-model-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="fa-javelin-model-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="75" />
          </costs>
          <profiles>
            <profile name="Javelin Attack Speeder" id="fa-javelin-model-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
              <characteristics>
                <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                <characteristic name="Front" typeId="vehicle-front">11</characteristic>
                <characteristic name="Side" typeId="vehicle-side">11</characteristic>
                <characteristic name="Rear" typeId="vehicle-rear">10</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule name="Standard Wargear" id="fa-javelin-std" hidden="false">
          <description>Heavy Bolter; Twin-linked Cyclone Missile Launcher.</description>
        </rule>
        <rule name="Deep Strike &amp; Outflank" id="fa-javelin-deploy" hidden="false">
          <description>The squadron has Deep Strike and Outflank as defined in ProHammer Classic.</description>
        </rule>
        <rule name="Strafing Run" id="fa-javelin-strafe" hidden="false">
          <description>When shooting Assault, Heavy, Rapid Fire or Salvo weapons at ground units that are not Flyers or Skimmers, the vehicle gains +1 Ballistic Skill and all such shots count as Pinning, as defined in ProHammer Classic.</description>
        </rule>
        <rule name="Armoured Crew" id="fa-javelin-armoured" hidden="false">
          <description>A Javelin Attack Speeder does not count as Open-topped.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Cyclone Missile Launcher Replacement" id="fa-javelin-cyclone" hidden="false">
          <constraints>
            <constraint id="fa-javelin-cyclone-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier type="set" value="2" field="fa-javelin-cyclone-max">
              <conditions>
                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="fa-javelin-model" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
            <modifier type="set" value="3" field="fa-javelin-cyclone-max">
              <conditions>
                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="fa-javelin-model" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <entryLinks>
            <entryLink name="Twin-linked Lascannon" hidden="false" id="fa-javelin-tllas" type="selectionEntry" targetId="fa-gear-tl-las" import="true">
              <constraints>
                <constraint id="fa-javelin-tllas-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Heavy Bolter Replacement" id="fa-javelin-primary" hidden="false">
          <constraints>
            <constraint id="fa-javelin-primary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier type="set" value="2" field="fa-javelin-primary-max">
              <conditions>
                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="fa-javelin-model" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
            <modifier type="set" value="3" field="fa-javelin-primary-max">
              <conditions>
                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="fa-javelin-model" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <entryLinks>
            <entryLink name="Heavy Flamer" hidden="false" id="fa-javelin-hf" type="selectionEntry" targetId="gear-heavy-flamer" import="true">
              <constraints>
                <constraint id="fa-javelin-hf-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
            </entryLink>
            <entryLink name="Multi-Melta" hidden="false" id="fa-javelin-mm" type="selectionEntry" targetId="gear-multimelta" import="true">
              <constraints>
                <constraint id="fa-javelin-mm-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Vehicle Equipment" id="fa-javelin-eq" hidden="false">
          <constraints>
            <constraint id="fa-javelin-eq-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier type="set" value="2" field="fa-javelin-eq-max">
              <conditions>
                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="fa-javelin-model" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
            <modifier type="set" value="3" field="fa-javelin-eq-max">
              <conditions>
                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="fa-javelin-model" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" name="Searchlight" hidden="false" id="fa-javelin-search" import="true">
              <constraints>
                <constraint id="fa-javelin-search-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="1" />
              </costs>
              <rules>
                <rule name="Searchlight" id="fa-javelin-search-rule" hidden="false">
                  <description>When Night Fighting is in effect, the vehicle may illuminate itself and a chosen target, negating the effects of Night Fighting for those models as described in ProHammer Classic.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Hunter-Killer Missiles — up to two per Speeder" id="fa-javelin-hk" hidden="false">
          <constraints>
            <constraint id="fa-javelin-hk-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier type="set" value="4" field="fa-javelin-hk-max">
              <conditions>
                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="fa-javelin-model" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
            <modifier type="set" value="6" field="fa-javelin-hk-max">
              <conditions>
                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="fa-javelin-model" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
          <entryLinks>
            <entryLink name="Hunter-Killer Missile" hidden="false" id="fa-javelin-hk-item" type="selectionEntry" targetId="gear-hk" import="true">
              <constraints>
                <constraint id="fa-javelin-hk-item-max" type="max" value="6" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-fa-javelin" collective="false" import="true">
          <constraints>
            <constraint id="da-wing-fa-javelin-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="da-wing-fa-javelin-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" value="1" field="da-wing-fa-javelin-min">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-fa-javelin-0">
              <constraints>
                <constraint id="da-wing-fa-javelin-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Stormwing" id="da-wing-fa-javelin-0-rule" hidden="false">
                  <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-fa-javelin-1">
              <constraints>
                <constraint id="da-wing-fa-javelin-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Deathwing" id="da-wing-fa-javelin-1-rule" hidden="false">
                  <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-fa-javelin-2">
              <constraints>
                <constraint id="da-wing-fa-javelin-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Dreadwing" id="da-wing-fa-javelin-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-fa-javelin-3">
              <constraints>
                <constraint id="da-wing-fa-javelin-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ironwing" id="da-wing-fa-javelin-3-rule" hidden="false">
                  <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-fa-javelin-4">
              <constraints>
                <constraint id="da-wing-fa-javelin-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="da-wing-fa-javelin-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-fa-javelin-5">
              <constraints>
                <constraint id="da-wing-fa-javelin-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="da-wing-fa-javelin-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="unit" name="Legion Heavy Support Squad" id="hs-heavy-support-squad" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-heavy-support-squad-cat" primary="true" name="Heavy Support" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="pts" value="0" />
      </costs>
      <profiles>
        <profile name="Legion Space Marine" id="hs-hss-marine-prof" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">1</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">1</characteristic>
            <characteristic name="Ld" typeId="model-ld">8</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Legion Sergeant" id="hs-hss-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">1</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">2</characteristic>
            <characteristic name="Ld" typeId="model-ld">9</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="hs-hss-wargear" hidden="false">
          <description>4 Legion Space Marines and 1 Legion Sergeant. Power Armour, Bolter, Bolt pistol and Frag grenades. The unit has Legiones Astartes; the Sergeant is a Character.</description>
        </rule>
        <rule name="Sergeant Armoury" id="hs-hss-armoury-rule" hidden="false">
          <description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Normal Sergeant weapon limits apply. Unit-specific replacements take precedence over duplicate Armoury purchases.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" name="Squad Models" id="hs-hss-additional" hidden="false" import="true" defaultAmount="5">
          <constraints>
            <constraint id="hs-hss-additional-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" />
            <constraint id="hs-hss-additional-r56-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" name="Hardened Armour (entire squad)" id="hs-hss-hardened" hidden="false" import="true">
          <constraints>
            <constraint id="hs-hss-hardened-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <rules>
            <rule name="Hardened Armour (entire squad)" id="hs-hss-hardened-rule" hidden="false">
              <description>Failed Armour Saves caused by Blast or Template weapons may be re-rolled. Reduce Advance additional distance, Charge distance and Pursuit distance by 1". Counts as Void Hardened where applicable.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-gen-8-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r71-nl-gen-8-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r71-nl-gen-8-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="hs-hss-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r71-nl-gen-8-stealth-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule id="r71-nl-gen-8-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-9" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-9-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-9-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-9-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Heavy Weapons — up to four Marines" id="hs-hss-heavy" hidden="false">
          <constraints>
            <constraint id="hs-hss-heavy-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <entryLinks>
