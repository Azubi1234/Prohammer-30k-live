        </rule>
        <rule id="r64-if-diaz-special" name="Special Rules" hidden="false">
          <description>Legiones Astartes (Imperial Fists), Independent Character, Stubborn, Hold the Line.</description>
        </rule>
        <rule id="r64-if-diaz-hold" name="Hold the Line" hidden="false">
          <description>If Diaz and the unit he has joined did not move during the Movement phase, they gain Counter-Attack until the beginning of the next Imperial Fists turn. They may also re-roll failed Morale tests during this time.</description>
        </rule>
        <rule id="r68-if-diaz-wargear" name="CAMBA DIAZ — WARGEAR" hidden="false">
