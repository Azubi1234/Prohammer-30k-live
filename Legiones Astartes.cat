                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">3</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+/5+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="r71-nl-contekar-harness" name="Grenade Harness — Contekar Dissident" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="10" />
          </costs>
          <constraints>
            <constraint id="r71-nl-contekar-harness-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-39" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-39-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-39-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-39-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule id="r71-nl-contekar-rule-1" name="Wargear" hidden="false">
          <description>Tartaros Terminator Armour, Heavy Flamer and Nostraman Chainblade.</description>
        </rule>
        <rule id="r71-nl-contekar-rule-3" name="Nostraman Chainblade" hidden="false">
          <description>A Nostraman Chainblade is a Two-Handed Rending Weapon which grants +1 Strength.</description>
        </rule>
        <rule id="r71-nl-contekar-rule-4" name="Escaton Power Claw" hidden="false">
          <description>An Escaton Power Claw counts as a Power Fist. In addition, the wielder may re-roll failed To Wound rolls made with it.</description>
        </rule>
        <rule id="r73-nl-rule-r41-unit-viii-2-contekar-terminator-elite-legiones-astartes-night-lords" name="Legiones Astartes (Night Lords)" hidden="false">
          <description>This model belongs to the VIII Legion and is affected by rules and effects which refer to Legiones Astartes (Night Lords).</description>
        </rule>
        <rule id="r73-nl-rule-r41-unit-viii-2-contekar-terminator-elite-stubborn" name="Stubborn" hidden="false">
          <description>The unit uses the ProHammer Stubborn special rule.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r71-nl-contekar-ranged" name="Heavy Flamer Replacements — every model" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r71-nl-contekar-ranged-max" type="max" value="0" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
