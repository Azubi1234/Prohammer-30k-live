                    <modifier id="r71-nl-gen-26-stealth-cost-1" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r60-ws-hibou-retinue-legion-veteran-squad-veteran-sergeant" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
