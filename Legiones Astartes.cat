                                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-p6" shared="true" includeChildSelections="true" />
                              </conditions>
                            </conditionGroup>
                          </conditionGroups>
                        </modifier>
                      </modifiers>
                    </entryLink>
                  </entryLinks>
                </selectionEntryGroup>
              </selectionEntryGroups>
              <selectionEntries>
                <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile" hidden="false" import="true">
                  <constraints>
                    <constraint id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                  <rules>
                    <rule name="Hunter-Killer Missile" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile-rule" hidden="false">
                      <description>Unlimited range, S8 AP3, Heavy 1, One Use.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Dozer Blade" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-dozer-blade" hidden="false" import="true">
                  <constraints>
                    <constraint id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                  <rules>
                    <rule name="Dozer Blade" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-dozer-blade-rule" hidden="false">
                      <description>Use the normal ProHammer Dozer Blade rule.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Auxiliary Drive" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-auxiliary-drive" hidden="false" import="true">
                  <constraints>
                    <constraint id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                  <rules>
                    <rule name="Auxiliary Drive" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-auxiliary-drive-rule" hidden="false">
                      <description>At the start of the controlling player's Movement phase, if Immobilised, on a 4+ remove one Immobilised result.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Frag Assault Launchers" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-frag-assault-launchers" hidden="false" import="true">
                  <constraints>
                    <constraint id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-frag-assault-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                  <rules>
                    <rule name="Frag Assault Launchers" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-frag-assault-launchers-rule" hidden="false">
                      <description>Passengers charging during the same turn they disembark count as equipped with Frag Grenades for that Assault phase.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Armoured Ceramite" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-armoured-ceramite" hidden="false" import="true">
                  <constraints>
                    <constraint id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="20" />
                  </costs>
                  <rules>
                    <rule name="Armoured Ceramite" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-armoured-ceramite-rule" hidden="false">
                      <description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Flare Shield" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-flare-shield" hidden="false" import="true">
                  <constraints>
                    <constraint id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="45" />
                  </costs>
                  <rules>
                    <rule name="Flare Shield" id="r52-ec-sonic-hss-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-flare-shield-rule" hidden="false">
                      <description>Against shooting attacks striking the Front Armour, reduce the Strength of Blast and Template weapons by 2 and all other ranged attacks by 1. No effect in close combat.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
          </selectionEntries>
