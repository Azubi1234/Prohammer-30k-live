                <selectionEntry id="r71-nl-gen-33-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="0" />
                  </costs>
                  <constraints>
                    <constraint id="r71-nl-gen-33-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <modifiers>
                    <modifier id="r71-nl-gen-33-stealth-cost-0" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r64-if-dorn-honour-hq-praetor-ret-honour-champ" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
                    </modifier>
                    <modifier id="r71-nl-gen-33-stealth-cost-1" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r64-if-dorn-honour-hq-praetor-ret-honour-base" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
