          </conditions>
        </modifier>
      </modifiers>
      <entryLinks>
        <entryLink id="r40-da-forward-r35-breakthrough-predator-hs-predator" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true">
          <constraints>
            <constraint id="r40-da-forward-r35-breakthrough-predator-hs-predator-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" />
