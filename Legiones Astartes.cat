                            <constraint id="r71-nl-curze-ret-1-r71-nl-atramentar-transport-spartan-hs-spartan-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="10" />
                          </costs>
                          <rules>
                            <rule name="Auxiliary Drive" id="r71-nl-curze-ret-1-r71-nl-atramentar-transport-spartan-hs-spartan-auxiliary-drive-rule" hidden="false">
                              <description>At the start of the controlling player's Movement phase, if Immobilised, on a 4+ remove one Immobilised result.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Frag Assault Launchers" id="r71-nl-curze-ret-1-r71-nl-atramentar-transport-spartan-hs-spartan-frag-assault-launchers" hidden="false" import="true">
                          <constraints>
                            <constraint id="r71-nl-curze-ret-1-r71-nl-atramentar-transport-spartan-hs-spartan-frag-assault-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="10" />
                          </costs>
                          <rules>
                            <rule name="Frag Assault Launchers" id="r71-nl-curze-ret-1-r71-nl-atramentar-transport-spartan-hs-spartan-frag-assault-launchers-rule" hidden="false">
                              <description>Passengers charging during the same turn they disembark count as equipped with Frag Grenades for that Assault phase.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Armoured Ceramite" id="r71-nl-curze-ret-1-r71-nl-atramentar-transport-spartan-hs-spartan-armoured-ceramite" hidden="false" import="true">
                          <constraints>
