                  <modifiers>
                    <modifier id="r71-nl-mal-ret-0-r69-hide-hq-centurion-ret-command-transport-r69-centurion-command-bikes" type="set" value="true" field="hidden">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r71-nl-mal-ret-0-r69-centurion-command-bikes" shared="true" includeChildSelections="true" includeChildForces="false" />
