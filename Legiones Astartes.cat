              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule name="Armistos" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-armistos-rule" hidden="false">
                  <description>Fire Control: When this Heavy Support Squad enters Overwatch, its models may declare Overwatch targets out to the normal maximum range of their weapons rather than being restricted to 24". All other Overwatch rules and restrictions apply normally.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Siege Breaker" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-siegebreaker" hidden="false" import="true">
