                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r57-iw-pert-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-champ" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
