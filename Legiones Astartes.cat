    <selectionEntry type="upgrade" import="true" name="Grenade Harness" hidden="false" id="gear-grenade-harness">
      <profiles>
        <profile name="Grenade Harness" id="gear-grenade-harness-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
