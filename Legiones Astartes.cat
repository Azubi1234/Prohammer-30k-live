                          </costs>
                          <rules>
                            <rule name="Auxiliary Drive" id="r70-if-ta-1-1-hs-lr-pr-up-auxiliary-drive-rule" hidden="false">
                              <description>At the start of the controlling player's Movement phase, if the vehicle is Immobilised, roll a D6. On a 4+, remove one Immobilised result; it may move normally that phase.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Armoured Ceramite" id="r70-if-ta-1-1-hs-lr-pr-up-armoured-ceramite" hidden="false" import="true">
                          <constraints>
                            <constraint id="r70-if-ta-1-1-hs-lr-pr-up-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <modifiers>
                            <modifier type="set" value="2" field="r70-if-ta-1-1-hs-lr-pr-up-armoured-ceramite-max">
