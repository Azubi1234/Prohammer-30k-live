        <selectionEntryGroup name="Retinue (does not occupy a separate FOC slot)" id="hq-praetor-retinue" hidden="false">
          <constraints>
            <constraint id="hq-praetor-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Honour Guard Squad" id="hq-praetor-ret-honour" hidden="false" import="true">
              <constraints>
                <constraint id="hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="55" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="hq-praetor-ret-honour-std" hidden="false">
                  <description>Every model wears Artificer Armour and carries a Refractor Field, Power Weapon, Bolt Pistol and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="hq-praetor-ret-honour-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Honour or Death" id="hq-praetor-ret-honour-hod" hidden="false">
                  <description>If the Legion Champion is in base contact with one or more enemy Independent Characters, he must direct all of his close-combat attacks against one of them. When attacking an enemy Independent Character in close combat, he may re-roll failed To Hit and To Wound rolls.</description>
                </rule>
                <rule name="Retinue" id="hq-praetor-ret-honour-ret" hidden="false">
                  <description>Selected for an eligible Praetor or Primarch. It occupies no separate Force Organisation slot; the commander and Honour Guard count as a single HQ selection but do not have to deploy together and operate as separate units after deployment.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Legion Champion" id="hq-praetor-ret-honour-champ" hidden="false" import="true" defaultAmount="1">
                  <constraints>
                    <constraint id="hq-praetor-ret-honour-champ-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="hq-praetor-ret-honour-champ-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Champion" id="hq-praetor-ret-honour-champ-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">6</characteristic>
                        <characteristic name="BS" typeId="model-bs">5</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">2</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">3</characteristic>
                        <characteristic name="Ld" typeId="model-ld">10</characteristic>
                        <characteristic name="Sv" typeId="model-sv">2+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry type="model" name="Legion Honour Guard" id="hq-praetor-ret-honour-base" hidden="false" import="true" defaultAmount="2">
                  <constraints>
                    <constraint id="hq-praetor-ret-honour-base-min" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="hq-praetor-ret-honour-base-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Honour Guard" id="hq-praetor-ret-honour-base-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">5</characteristic>
                        <characteristic name="BS" typeId="model-bs">5</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">1</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">2</characteristic>
                        <characteristic name="Ld" typeId="model-ld">10</characteristic>
                        <characteristic name="Sv" typeId="model-sv">2+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Points" typeId="pts" value="40" />
                  </costs>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Legion Standard Bearer" id="hq-praetor-ret-honour-standard" hidden="false" import="true">
                  <constraints>
                    <constraint id="hq-praetor-ret-honour-standard-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="60" />
                  </costs>
                  <entryLinks>
                    <entryLink import="true" name="Legion Standard" id="hq-praetor-ret-honour-standard-link" type="selectionEntry" targetId="gear-hq-legion-standard" hidden="false" defaultAmount="1">
                      <constraints>
                        <constraint id="hq-praetor-ret-honour-standard-link-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                        <constraint id="hq-praetor-ret-honour-standard-link-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                    </entryLink>
                  </entryLinks>
                </selectionEntry>
                <selectionEntry id="r71-nl-gen-9-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="0" />
                  </costs>
                  <constraints>
                    <constraint id="r71-nl-gen-9-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <modifiers>
                    <modifier id="r71-nl-gen-9-stealth-cost-0" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="hq-praetor-ret-honour-champ" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
                    </modifier>
                    <modifier id="r71-nl-gen-9-stealth-cost-1" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="hq-praetor-ret-honour-base" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
                    </modifier>
                    <modifier id="r71-nl-gen-9-stealth-show" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                  <rules>
                    <rule id="r71-nl-gen-9-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
                      <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="r71-nl-bj-10" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  <constraints>
                    <constraint id="r71-nl-bj-10-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r71-nl-bj-10-rule" name="Beyond Judgement" hidden="false">
                      <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
                    </rule>
                  </rules>
                  <modifiers>
                    <modifier id="r71-nl-bj-10-show" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                            <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                  </modifiers>
                </selectionEntry>
              </selectionEntries>
              <entryLinks>
                <entryLink import="true" name="Bolt Pistol" id="hq-praetor-ret-honour-bp" type="selectionEntry" targetId="gear-bolt-pistol" hidden="false" defaultAmount="1">
                  <constraints>
                    <constraint id="hq-praetor-ret-honour-bp-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="hq-praetor-ret-honour-bp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                </entryLink>
                <entryLink import="true" name="Power Weapon" id="hq-praetor-ret-honour-pw" type="selectionEntry" targetId="gear-power-weapon" hidden="false" defaultAmount="1">
                  <constraints>
                    <constraint id="hq-praetor-ret-honour-pw-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="hq-praetor-ret-honour-pw-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                </entryLink>
                <entryLink import="true" name="Krak Grenades (+2 pts/model)" id="hq-praetor-ret-honour-krak" type="selectionEntry" targetId="gear-krak" hidden="false">
                  <constraints>
                    <constraint id="hq-praetor-ret-honour-krak-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="6" />
                  </costs>
                  <modifiers>
                    <modifier type="increment" value="2" field="pts">
                      <repeats>
                        <repeat value="3" repeats="1" field="selections" scope="root-entry" childId="hq-praetor-ret-honour-base" shared="true" roundUp="false" includeChildSelections="false" />
                      </repeats>
                    </modifier>
