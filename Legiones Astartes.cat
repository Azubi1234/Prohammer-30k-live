      </categoryLinks>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Terminator Squad — Terminator Attack" hidden="false" id="r57-iw-golg-term-troops">
      <rules>
        <rule name="Standard Wargear" id="r57-iw-golg-term-troops-terminator-standard" hidden="false">
          <description>Every model is equipped with the selected Terminator Armour pattern, a Combi-bolter and a Power Weapon unless replaced below.</description>
        </rule>
        <rule name="Legiones Astartes" id="r57-iw-golg-term-troops-terminator-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Implacable Advance" id="r57-iw-golg-term-troops-terminator-implacable" hidden="false">
          <description>In any mission which distinguishes between Scoring and non-Scoring units, a Legion Terminator Squad counts as a Scoring Unit whenever Troops choices normally count as Scoring Units.</description>
        </rule>
        <rule name="Dedicated Transport" id="r57-iw-golg-term-troops-terminator-transport-rule" hidden="false">
          <description>The squad may select a Land Raider, a Land Raider variant with sufficient Transport Capacity, a Dreadclaw Drop Pod or a Spartan Assault Tank where permitted. A Dreadclaw can carry only five models in Terminator Armour, so it is selectable here only for a five-model squad. Land Raider and Spartan choices will become selectable when their vehicle entries are added.</description>
        </rule>
        <rule id="r57-iw-golg-term-rule" name="Terminator Attack" hidden="false">
          <description>Available only while Erasmus Golg is the army's Warlord. This unit is a Troops choice but may not fulfil a compulsory Troops selection.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Terminators" hidden="false" id="r57-iw-golg-term-troops-terminator-included" defaultAmount="4">
          <constraints>
            <constraint id="r57-iw-golg-term-troops-terminator-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r57-iw-golg-term-troops-terminator-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminators (included)" id="r57-iw-golg-term-troops-terminator-included-prof" typeId="prof-model" typeName="Model" hidden="false">
