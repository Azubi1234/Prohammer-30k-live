    <selectionEntry type="unit" import="true" name="HATHOR MAAT" hidden="false" id="r41-unit-xv-9-hathor-maat">
      <costs>
        <cost name="Points" typeId="pts" value="190" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-xv-9-hathor-maat-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="r41-unit-xv-9-hathor-maat-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <profiles>
        <profile name="Hathor Maat" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-9-hathor-maat-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
            <characteristic name="BS" typeId="model-bs">5</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">3</characteristic>
            <characteristic name="I" typeId="model-i">5</characteristic>
            <characteristic name="A" typeId="model-a">3</characteristic>
            <characteristic name="Ld" typeId="model-ld">10</characteristic>
            <characteristic name="Sv" typeId="model-sv">2+/5+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Source Entry" id="r41-unit-xv-9-hathor-maat-source" hidden="false">
          <description>Hathor Maat | 5 | 5 | 4 | 4 | 3 | 5 | 3 | 10 | 2+/5+
Force Organisation:
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• Artificer Armour
• Aetheric Refractor Field
• Prosperine Force Weapon
• Bolt pistol
• Narthecium
• Reductor
• Frag grenades
Special Rules:
• Legiones Astartes (Thousand Sons)
• Independent Character
• Master of the Legion
• Psyker (Mastery Level 2\)
• Pavoni
• Magister Templi of the Pavoni
• Pavoni Vitalist
OPTIONS
• Hathor Maat may take:
• Krak grenades .................................. +2 points
PAVONI Hathor Maat always belongs to the Pavoni and may not select another Prosperine Cult. He receives both the Pavoni Cult Arcana and Cult Mastery benefits. MAGISTER TEMPLI OF THE PAVONI Hathor Maat selects both of his psychic powers from the ProHammer Biomancy discipline. He otherwise follows all normal ProHammer rules for a Mastery Level 2 Psyker. AETHERIC REFRACTOR FIELD Hathor Maat has a 4+ Invulnerable Save. This is already included in his profile. PAVONI VITALIST Hathor Maat has Feel No Pain (5+). While Hathor Maat is joined to a friendly Thousand Sons Infantry unit, that unit also gains Feel No Pain (5+). If a model already has Feel No Pain, improve its existing roll by one step instead, to a maximum of 4+. The unit loses this benefit immediately if Hathor leaves the unit or is slain. NARTHECIUM Hathor Maat additionally uses the normal Narthecium rules from the Legiones Astartes Army List. COMMAND RETINUE Hathor Maat may select one Legion Command Squad as his retinue. The squad does not occupy a separate Force Organisation slot.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Options" hidden="false" id="r41-unit-xv-9-hathor-maat-options" collective="false" import="true">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-xv-9-hathor-maat-opt-0-krak-grenades">
              <constraints>
                <constraint id="r41-unit-xv-9-hathor-maat-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="2" />
              </costs>
              <rules>
                <rule name="Option restriction" id="r41-unit-xv-9-hathor-maat-opt-0-context" hidden="false">
                  <description>• Hathor Maat may take:</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="r45-cult-r41-unit-xv-9-hathor-maat" name="Prosperine Cult" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r45-cult-r41-unit-xv-9-hathor-maat-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
            <constraint id="r45-cult-r41-unit-xv-9-hathor-maat-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r48-vis-327" type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry id="r45-cult-r41-unit-xv-9-hathor-maat-0" name="Pavoni" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-r41-unit-xv-9-hathor-maat-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-r41-unit-xv-9-hathor-maat-0-rule" name="Pavoni" hidden="false">
                  <description>Fleet; Psykers/Psychic Brotherhoods also gain Crusader.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-r41-unit-xv-9-hathor-maat-1" name="Raptora" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-r41-unit-xv-9-hathor-maat-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-r41-unit-xv-9-hathor-maat-1-rule" name="Raptora" hidden="false">
                  <description>6+ invulnerable save against shooting; Psychic Mastery improves this to 5+ (or improves an existing invulnerable save by 1 to max 4+) and improves cover by 1 to max 3+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-r41-unit-xv-9-hathor-maat-2" name="Corvidae" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-r41-unit-xv-9-hathor-maat-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-r41-unit-xv-9-hathor-maat-2-rule" name="Corvidae" hidden="false">
