              <selectionEntries>
                <selectionEntry id="r64-if-praetor-huscarl-r64-if-huscarl-models" name="Retinue Models" type="model" hidden="false" import="true" defaultAmount="5">
                  <costs>
                    <cost name="Points" typeId="pts" value="50" />
                  </costs>
                  <constraints>
                    <constraint id="r64-if-praetor-huscarl-r64-if-huscarl-models-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                    <constraint id="r64-if-praetor-huscarl-r64-if-huscarl-models-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
