                  <rules>
                    <rule id="r70-if-ta-1-note" name="Spartan condition" hidden="false">
                      <description>The Rite permits a Spartan only for a Templar Brethren Squad too large for both a Land Raider Phobos and a Land Raider Proteus. The current Templar Brethren unit size is 5–10, so a Spartan is not a legal Rite transport at present.</description>
                    </rule>
                  </rules>
                </selectionEntryGroup>
              </selectionEntryGroups>
