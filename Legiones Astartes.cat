      <profiles>
        <profile name="Khenetai Blade" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-1-khenetai-occult-blade-cabal-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
