    <selectionEntry id="r47-wb-favour-visage" name="Daemonic Visage" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r47-wb-favour-visage-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r47-wb-favour-visage-rule" name="Daemonic Visage" hidden="false">
          <description>An enemy unit which loses a close combat involving the bearer suffers an additional -1 Leadership when taking the resulting Morale test.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="r47-wb-favour-visage-cat" targetId="r47-cat-wb-favour" name="Favour of the Pantheon" hidden="false" primary="false" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry id="r52-ec-sonic-character" name="Sonic Weaponry (one Praetor or Centurion per army)" type="upgrade" hidden="false" import="true">
      <constraints>
        <constraint id="r52-ec-sonic-character-parent" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
        <constraint id="r52-ec-sonic-character-roster" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <selectionEntryGroups>
        <selectionEntryGroup id="r52-ec-sonic-character-choice" name="Choose one Sonic Weapon" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r52-ec-sonic-character-choice-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="r52-ec-sonic-character-blaster" name="Sonic Blaster" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-sonic-character-blaster-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
            </selectionEntry>
            <selectionEntry id="r52-ec-sonic-character-siren" name="Doom Siren" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-sonic-character-siren-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <rules>
        <rule id="r52-ec-sonic-character-rule" name="Restriction" hidden="false">
          <description>TRAITOR ONLY. One Emperor's Children Praetor or Centurion in the army may carry one Sonic Weapon.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-frost" name="Frost Weapon" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="20" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-frost-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-frost-rule" name="Frost Weapon" hidden="false">
          <description>Strength: User +1. Power Weapon. May be represented by a sword, axe, claw or similar Fenrisian weapon; appearance has no additional rules effect.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-frost-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-frost-exchange" name="Frost Weapon — exchange an existing Power Weapon" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-frost-exchange-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-frost-exchange-rule" name="Frost Weapon — exchange an existing Power Weapon" hidden="false">
          <description>Only a model already equipped with a Power Weapon may select this +5 point exchange. The Power Weapon is replaced by a Frost Weapon: Strength User +1, Power Weapon.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-frost-exchange-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-great-frost" name="Great Frost Blade" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="35" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-great-frost-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-great-frost-rule" name="Great Frost Blade" hidden="false">
          <description>Strength: User +2. Power Weapon, Two-Handed, Master-crafted. A model using it suffers -1 Initiative during that Assault phase.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-great-frost-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-pelt" name="Wolf Pelt" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-pelt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-pelt-rule" name="Wolf Pelt" hidden="false">
          <description>When the bearer's unit successfully uses Counter-Attack, the bearer receives +2 Attacks instead of the normal +1 Attack granted by Counter-Attack.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-pelt-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-necklace" name="Wolf Tooth Necklace" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-necklace-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-necklace-rule" name="Wolf Tooth Necklace" hidden="false">
          <description>The bearer always hits enemy models on a 3+ in close combat, unless the bearer would normally hit on a better result.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-necklace-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-talisman" name="Wolf Tail Talisman" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-talisman-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-talisman-rule" name="Wolf Tail Talisman" hidden="false">
          <description>Whenever an enemy psychic power directly affects the bearer or a unit he has joined, after the power is successfully invoked and any normal Deny the Witch attempt is resolved, roll a D6. On a 6, the bearer is unaffected. If joined to a unit, the remainder of the unit is affected normally.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-talisman-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r63-sw-gear-runic-armour" name="Runic Armour" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="25" />
      </costs>
      <constraints>
        <constraint id="r63-sw-gear-runic-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r63-sw-gear-runic-armour-rule" name="Runic Armour" hidden="false">
          <description>Only a Space Wolves Independent Character wearing Power Armour may select this option. Replace Power Armour with Runic Armour. It grants a 2+ Armour Save and Adamantium Will, and counts as Artificer Armour for all other rules and restrictions.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r63-sw-gear-runic-armour-hide" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r64-if-gear-solarite" name="Solarite Power Gauntlet" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="30" />
      </costs>
      <constraints>
        <constraint id="r64-if-gear-solarite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r64-if-gear-solarite-rule" name="Solarite Power Gauntlet" hidden="false">
          <description>Imperial Fists Character with Space Marine Armoury access. Strength 10; Power Weapon, Unwieldy, Specialist Weapon. Unlike a normal Power Fist it always strikes at Strength 10 regardless of the bearer's Strength.</description>
        </rule>
        <rule id="r67-if-r64-if-gear-solarite-visible" name="Rules" hidden="false">
          <description>Strength 10. Power Weapon, Unwieldy, Specialist Weapon. Always strikes at Strength 10 regardless of the bearer’s Strength.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r64-if-gear-solarite-hide-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r64-if-gear-solarite-exchange" name="Solarite Power Gauntlet — exchange Power Fist" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="5" />
      </costs>
      <constraints>
        <constraint id="r64-if-gear-solarite-exchange-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r64-if-gear-solarite-exchange-rule" name="Solarite Power Gauntlet — exchange Power Fist" hidden="false">
          <description>Only a model already equipped with a Power Fist may select this exchange. Replace that Power Fist with a Solarite Power Gauntlet.</description>
        </rule>
        <rule id="r67-if-r64-if-gear-solarite-exchange-visible" name="Rules" hidden="false">
          <description>Replace an already-equipped Power Fist with a Solarite Power Gauntlet for +5 points.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r64-if-gear-solarite-exchange-hide-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry id="r64-if-gear-vigil" name="Vigil Pattern Storm Shield" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="25" />
      </costs>
      <constraints>
        <constraint id="r64-if-gear-vigil-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r64-if-gear-vigil-rule" name="Vigil Pattern Storm Shield" hidden="false">
          <description>Imperial Fists Independent Character only. Grants a 3+ Invulnerable Save. The bearer may carry no more than one weapon in addition to the shield; the shield occupies one hand and the bearer never receives the bonus Attack for fighting with two close-combat weapons.</description>
        </rule>
        <rule id="r67-if-r64-if-gear-vigil-visible" name="Rules" hidden="false">
          <description>3+ Invulnerable Save. The bearer may carry no more than one other weapon; the shield occupies one hand and prevents the bonus Attack for fighting with two close-combat weapons.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r64-if-gear-vigil-hide-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <categoryLinks>
        <categoryLink id="r66-if-vigil-cat" name="Stone Gauntlet — Shield-bearing Independent Character" hidden="true" targetId="r66-if-cat-stone-shield-ic" primary="false" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry id="r64-if-gear-trans-ic" name="Teleportation Transponders" type="upgrade" hidden="false" import="true">
      <costs>
        <cost name="Points" typeId="pts" value="10" />
      </costs>
      <constraints>
        <constraint id="r64-if-gear-trans-ic-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r64-if-gear-trans-ic-rule" name="Teleportation Transponders" hidden="false">
          <description>Imperial Fists Independent Character. Normally only available while wearing Terminator Armour; Hammerfall Strike Force removes this restriction. Grants Deep Strike even if the mission would not normally permit it. An Independent Character joining another Deep Striking unit must purchase Transponders separately.</description>
        </rule>
        <rule id="r67-if-r64-if-gear-trans-ic-visible" name="Rules" hidden="false">
          <description>Grants Deep Strike even if the mission would not normally permit it. An Independent Character joining another Deep Striking unit must purchase Transponders separately.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier id="r64-if-gear-trans-ic-hide-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <categoryLinks>
        </categoryLinks>
    </selectionEntry>
