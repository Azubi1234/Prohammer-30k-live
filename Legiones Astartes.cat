                            </entryLink>
                          </entryLinks>
                        </selectionEntryGroup>
                      </selectionEntryGroups>
                      <selectionEntries>
                        <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r71-nl-mal-ret-1-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-hunter-killer-missile" hidden="false" import="true">
                          <constraints>
