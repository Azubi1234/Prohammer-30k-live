    <selectionEntry type="unit" name="Leviathan Siege Dreadnought" id="hs-leviathan" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-leviathan-cat" primary="true" name="Heavy Support" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="pts" value="270" />
      </costs>
      <profiles>
        <profile name="Leviathan Siege Dreadnought" id="hs-leviathan-prof" typeId="prof-walker" typeName="Walker" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="walker-ws">5</characteristic>
            <characteristic name="BS" typeId="walker-bs">5</characteristic>
            <characteristic name="S" typeId="walker-s">8</characteristic>
            <characteristic name="Front" typeId="walker-front">13</characteristic>
            <characteristic name="Side" typeId="walker-side">13</characteristic>
            <characteristic name="Rear" typeId="walker-rear">12</characteristic>
            <characteristic name="I" typeId="walker-i">4</characteristic>
            <characteristic name="A" typeId="walker-a">4</characteristic>
          </characteristics>
        </profile>
        <profile name="Meltagun" id="hs-lev-melta-base" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 1, Melta</characteristic>
          </characteristics>
        </profile>
        <profile name="Heavy Flamer" id="hs-lev-hf-base" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">Template</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="hs-lev-wg" hidden="false">
          <description>Two Leviathan Siege Claws, each with an inbuilt Meltagun; two Heavy Flamers; Extra Armour; Frag grenades; Searchlight; Smoke Launchers.</description>
        </rule>
        <rule name="Reinforced Atomantic Shielding" id="hs-lev-shield" hidden="false">
          <description>Each time the Leviathan suffers a Glancing or Penetrating Hit, on a 4+ the hit is ignored, before rolling on the Vehicle Damage table. If it suffers an Explodes! result, increase the Strength of the explosion by D3 and its radius by D3".</description>
        </rule>
        <rule name="Crushing Charge" id="hs-lev-charge" hidden="false">
          <description>On a turn in which the Leviathan charges, it may resolve two of its normally allowed close-combat attacks at Initiative 10 instead of only one as normally permitted by Hammer of Wrath.</description>
        </rule>
        <rule name="Move Through Cover" id="hs-lev-mtc" hidden="false">
          <description>Uses the normal ProHammer Move Through Cover rule.</description>
        </rule>
        <rule name="Leviathan Siege Claw" id="hs-lev-claw-rule" hidden="false">
          <description>Counts as a Dreadnought Close Combat Weapon.</description>
        </rule>
        <rule name="Leviathan Siege Drill" id="hs-lev-drill-rule" hidden="false">
          <description>Counts as a Dreadnought Close Combat Weapon with Armourbane.</description>
        </rule>
        <rule name="Arm Replacement and Attacks" id="hs-lev-arms-rule" hidden="false">
          <description>Either Siege Claw and its Meltagun may be replaced by a ranged weapon. For each Siege Claw replaced by a ranged weapon, reduce the Leviathan’s Attacks characteristic by 1.</description>
        </rule>
        <rule name="Graviton Collapse" id="hs-lev-grav-collapse" hidden="false">
          <description>Against non-vehicle models hit by a Grav-flux Bombard, roll 2D6; if the result is greater than the model’s Strength it suffers a wound. Against vehicles, do not use the normal ProHammer Graviton rule; instead roll 3D6 for Armour Penetration.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Arm A" id="hs-lev-arm-a" hidden="false">
