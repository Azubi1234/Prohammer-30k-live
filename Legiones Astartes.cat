                      </conditions>
                    </modifier>
                  </modifiers>
                  <rules>
                    <rule id="r69-centurion-command-jetbikes-rule" name="Mounted Retinue" hidden="false">
                      <description>Available when the selecting character is mounted as stated in its entry. Every model in this retinue takes the same Jetbikes for +35 points per model. A mounted retinue may not select a Dedicated Transport.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="r71-nl-gen-10-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="0" />
                  </costs>
                  <constraints>
                    <constraint id="r71-nl-gen-10-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <modifiers>
                    <modifier id="r71-nl-gen-10-stealth-cost-0" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="hq-centurion-ret-command-vets" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
