    <selectionEntry type="unit" import="true" name="Legion Veteran Squad (Jump Packs) — Day of Revelation" hidden="true" id="r74-ba-rev-vet-veteran-unit" defaultAmount="1">
      <rules>
        <rule name="Standard Wargear" id="r74-ba-rev-vet-veteran-standard" hidden="false">
          <description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</description>
        </rule>
        <rule name="Legiones Astartes" id="r74-ba-rev-vet-veteran-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Veteran Tactics" id="r74-ba-rev-vet-veteran-tactics-rule" hidden="false">
          <description>When constructing the army, select one Veteran Tactic for this squad. The chosen ability applies to every model in the squad for the duration of the battle.</description>
        </rule>
        <rule name="Dedicated Transport" id="r74-ba-rev-vet-veteran-transport-rule" hidden="false">
          <description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Veterans" hidden="false" id="r74-ba-rev-vet-veteran-included" defaultAmount="4">
          <constraints>
            <constraint id="r74-ba-rev-vet-veteran-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r74-ba-rev-vet-veteran-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Veterans (included)" id="r74-ba-rev-vet-veteran-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="pts" value="20" />
          </costs>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Veteran Sergeant" hidden="false" id="r74-ba-rev-vet-veteran-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="r74-ba-rev-vet-veteran-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r74-ba-rev-vet-veteran-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Veteran Sergeant" id="r74-ba-rev-vet-veteran-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="r74-ba-rev-vet-r37-assault-dfa-veteran-unit" name="Death from Above (Legion Assault Company)" type="upgrade" hidden="true" import="true">
          <constraints>
            <constraint id="r74-ba-rev-vet-r37-assault-dfa-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <rules>
            <rule name="Death from Above (Legion Assault Company)" id="r74-ba-rev-vet-r37-assault-dfa-veteran-unit-rule" hidden="false">
              <description>Any unit composed entirely of models equipped with Jump Packs may deploy using Deep Strike even if the mission would not normally permit Deep Strike. Resolve arrival using the normal ProHammer Deep Strike rules.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-assault" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry id="r74-ba-rev-vet-r71-nl-gen-4-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r74-ba-rev-vet-r71-nl-gen-4-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r74-ba-rev-vet-r71-nl-gen-4-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r74-ba-rev-vet-veteran-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r74-ba-rev-vet-r71-nl-gen-4-stealth-cost-1" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r74-ba-rev-vet-veteran-sergeant" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r74-ba-rev-vet-r71-nl-gen-4-stealth-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule id="r74-ba-rev-vet-r71-nl-gen-4-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r74-ba-rev-vet-r71-nl-bj-4" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r74-ba-rev-vet-r71-nl-bj-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r74-ba-rev-vet-r71-nl-bj-4-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r74-ba-rev-vet-r71-nl-bj-4-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="Points" typeId="pts" value="45" />
      </costs>
      <selectionEntryGroups>
        <selectionEntryGroup name="Veteran Tactic (choose one)" id="r74-ba-rev-vet-veteran-tactics" hidden="false">
          <constraints>
            <constraint id="r74-ba-rev-vet-veteran-tactics-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="r74-ba-rev-vet-veteran-tactics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Resolve" hidden="false" id="r74-ba-rev-vet-veteran-tactic-resolve">
              <constraints>
                <constraint id="r74-ba-rev-vet-veteran-tactic-resolve-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Resolve" id="r74-ba-rev-vet-veteran-tactic-resolve-rule" hidden="false">
                  <description>The squad gains the Stubborn special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Assault Veterans" hidden="false" id="r74-ba-rev-vet-veteran-tactic-assault">
              <constraints>
                <constraint id="r74-ba-rev-vet-veteran-tactic-assault-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Assault Veterans" id="r74-ba-rev-vet-veteran-tactic-assault-rule" hidden="false">
                  <description>The squad gains the Furious Charge special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Counter-Assault" hidden="false" id="r74-ba-rev-vet-veteran-tactic-counter">
              <constraints>
                <constraint id="r74-ba-rev-vet-veteran-tactic-counter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Counter-Assault" id="r74-ba-rev-vet-veteran-tactic-counter-rule" hidden="false">
                  <description>The squad gains the Counter-Attack special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Machine Killers" hidden="false" id="r74-ba-rev-vet-veteran-tactic-machine">
              <constraints>
                <constraint id="r74-ba-rev-vet-veteran-tactic-machine-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Machine Killers" id="r74-ba-rev-vet-veteran-tactic-machine-rule" hidden="false">
                  <description>The squad gains the Tank Hunters special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Recon Veterans" hidden="false" id="r74-ba-rev-vet-veteran-tactic-recon">
              <constraints>
                <constraint id="r74-ba-rev-vet-veteran-tactic-recon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Recon Veterans" id="r74-ba-rev-vet-veteran-tactic-recon-rule" hidden="false">
                  <description>The squad gains the Infiltrate special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Marksmen" hidden="false" id="r74-ba-rev-vet-veteran-tactic-marksmen">
              <constraints>
                <constraint id="r74-ba-rev-vet-veteran-tactic-marksmen-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Marksmen" id="r74-ba-rev-vet-veteran-tactic-marksmen-rule" hidden="false">
                  <description>Normal Bolters fired by models in the squad have Twin-linked. This does not apply to Combi-weapons, Foeblaster Boltguns or other bolt weapon variants.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Close Combat Weapon Replacements" id="r74-ba-rev-vet-veteran-melee" hidden="false">
          <constraints>
            <constraint id="r74-ba-rev-vet-veteran-melee-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier type="increment" value="1" field="r74-ba-rev-vet-veteran-melee-max">
              <repeats>
                <repeat value="5" repeats="1" field="selections" scope="root-entry" childId="r74-ba-rev-vet-veteran-included" shared="true" roundUp="false" includeChildSelections="false" />
              </repeats>
            </modifier>
          </modifiers>
          <entryLinks>
            <entryLink import="true" name="Chainaxe (replaces Chainsword)" hidden="false" id="r74-ba-rev-vet-veteran-melee-chainaxe" type="selectionEntry" targetId="gear-hq-chainaxe">
              <constraints>
