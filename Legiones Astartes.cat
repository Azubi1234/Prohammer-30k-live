                      <rules>
                        <rule name="Land Raider Dedicated Transport" id="r71-nl-mal-ret-0-hq-centurion-ret-command-land-lrrule" hidden="false">
                          <description>Select a pattern with sufficient Transport Capacity. These entries use the profiles and standard wargear/rules of the corresponding Legion Land Raider Battle Squadron entry; use that entry for full vehicle upgrade options.</description>
                        </rule>
                      </rules>
                      <selectionEntries>
                        <selectionEntry type="model" name="Land Raider Phobos" id="r71-nl-mal-ret-0-hq-centurion-ret-command-land-land-raider-phobos" hidden="false" import="true">
                          <constraints>
                            <constraint id="r71-nl-mal-ret-0-hq-centurion-ret-command-land-land-raider-phobos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
