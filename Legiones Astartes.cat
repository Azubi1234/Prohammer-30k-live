        <selectionEntry id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r71-nl-gen-7-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r71-nl-gen-7-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r71-nl-gen-7-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-fa-seeker-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r71-nl-gen-7-stealth-cost-1" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-fa-seeker-sgt" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
