      <rules>
        <rule id="r63-sw-jorlund-comp" name="Unit Composition" hidden="false">
          <description>4 Jorlund Hunters and 1 Hunt-master; may include up to 5 additional Jorlund Hunters (maximum 10 models). The Hunt-master is a Character.</description>
        </rule>
        <rule id="r63-sw-jorlund-wg" name="Wargear" hidden="false">
          <description>Power Armour, Hand flamer, Chainsword and Frag grenades.</description>
        </rule>
        <rule id="r63-sw-jorlund-tempest" name="Scouring Tempest" hidden="false">
          <description>Once per battle, declare Scouring Tempest before this unit shoots. During that Shooting phase, the unit may re-roll failed To Wound rolls made with Hand Flamers and Flamers.</description>
        </rule>
      </rules>
