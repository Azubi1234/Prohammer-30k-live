                  <entryLinks>
                    <entryLink id="r71-nl-atramentar-transport-spartan-r44-hs-spartan-ih-auto" name="Blessed Autosimulacra" type="selectionEntry" targetId="r44-ih-autosimulacra" hidden="false" import="true">
                      <constraints>
