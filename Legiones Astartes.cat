                    <constraint id="hq-consul-medicae-n-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                </entryLink>
                <entryLink import="true" name="Reductor" id="hq-consul-medicae-r" type="selectionEntry" targetId="gear-hq-reductor" hidden="false">
                  <constraints>
                    <constraint id="hq-consul-medicae-r-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
              </entryLinks>
