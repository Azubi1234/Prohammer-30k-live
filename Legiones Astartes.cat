                </profile>
                <profile name="Whirlwind Launcher — Vengeance" id="r42-role-iv-1-legion-artillery-tank-squadron-hs-art-whirlwind-wp0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">12–48"</characteristic>
