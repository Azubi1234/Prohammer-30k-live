                  <rules>
                    <rule name="Auxiliary Drive" id="r71-nl-atramentar-transport-spartan-hs-spartan-auxiliary-drive-rule" hidden="false">
                      <description>At the start of the controlling player's Movement phase, if Immobilised, on a 4+ remove one Immobilised result.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Frag Assault Launchers" id="r71-nl-atramentar-transport-spartan-hs-spartan-frag-assault-launchers" hidden="false" import="true">
                  <constraints>
                    <constraint id="r71-nl-atramentar-transport-spartan-hs-spartan-frag-assault-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
