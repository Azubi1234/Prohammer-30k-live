        <selectionEntryGroup id="r63-sw-varagyr-transport" name="Dedicated Transport" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r63-sw-varagyr-transport-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Land Raider" id="r63-sw-varagyr-transport-lr-hs-land-raider" hidden="false" import="true">
              <rules>
                <rule name="Squadron Composition" id="r63-sw-varagyr-transport-lr-hs-lr-comp-rule" hidden="false">
                  <description>Dedicated Transport: select exactly one Land Raider pattern. Normal Transport Capacity restrictions apply.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Land Raider Patterns" id="r63-sw-varagyr-transport-lr-hs-lr-patterns" hidden="false">
                  <constraints>
                    <constraint id="r63-sw-varagyr-transport-lr-hs-lr-patterns-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                    <constraint id="r63-sw-varagyr-transport-lr-hs-lr-patterns-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="model" name="Land Raider Phobos" id="r63-sw-varagyr-transport-lr-hs-lr-phobos" hidden="false" import="true" defaultAmount="1">
                      <constraints>
                        <constraint id="r63-sw-varagyr-transport-lr-hs-lr-phobos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="250" />
                      </costs>
                      <profiles>
                        <profile name="Land Raider Phobos" id="r63-sw-varagyr-transport-lr-hs-lr-phobos-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                          <characteristics>
                            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                            <characteristic name="Front" typeId="vehicle-front">14</characteristic>
                            <characteristic name="Side" typeId="vehicle-side">14</characteristic>
                            <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="Twin-linked Lascannon" id="r63-sw-varagyr-transport-lr-hs-lr-phobos-las" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
                            <characteristic name="S" typeId="ranged-s">9</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Heavy 1, Twin-linked</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="Twin-linked Heavy Bolter" id="r63-sw-varagyr-transport-lr-hs-lr-phobos-hb" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                            <characteristic name="S" typeId="ranged-s">5</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Standard Wargear" id="r63-sw-varagyr-transport-lr-hs-lr-phobos-wg" hidden="false">
                          <description>Two Twin-linked Lascannons, Twin-linked Heavy Bolter, Searchlight and Smoke Launchers. Power of the Machine Spirit; Assault Vehicle; Transport Capacity 10.</description>
                        </rule>
                        <rule name="Assault Vehicle" id="r63-sw-varagyr-transport-lr-hs-lr-phobos-assault-vehicle" hidden="false">
                          <description>Units may charge after disembarking as allowed by ProHammer.</description>
                        </rule>
                      </rules>
                      <selectionEntries>
                        <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-hunter-killer-missile" hidden="false" import="true">
                          <constraints>
                            <constraint id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <modifiers>
                            <modifier type="set" value="2" field="r63-sw-varagyr-transport-lr-hs-lr-ph-up-hunter-killer-missile-max">
                              <conditions>
                                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r63-sw-varagyr-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                            <modifier type="set" value="3" field="r63-sw-varagyr-transport-lr-hs-lr-ph-up-hunter-killer-missile-max">
                              <conditions>
                                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r63-sw-varagyr-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
