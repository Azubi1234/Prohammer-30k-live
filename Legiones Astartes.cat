                        </rule>
                      </rules>
                      <modifiers>
                        <modifier id="r74-ba-pra-guard-r74-ba-guard-inferno-max-inc" type="increment" value="1" field="r74-ba-pra-guard-r74-ba-guard-inferno-max">
                          <repeats>
                            <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-additional" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
