                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r64-if-gear-trans-ic" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
