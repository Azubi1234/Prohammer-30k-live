                      </constraints>
                      <rules>
                        <rule id="r71-nl-mal-ret-1-r45-cult-veteran-unit-3-rule" name="Athanaeans" hidden="false">
                          <description>Stubborn and re-roll failed Pinning tests; Psychic Mastery also grants Adamantium Will.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry id="r71-nl-mal-ret-1-r45-cult-veteran-unit-4" name="Pyrae" type="upgrade" hidden="false" import="true">
                      <constraints>
                        <constraint id="r71-nl-mal-ret-1-r45-cult-veteran-unit-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
                      <rules>
                        <rule id="r71-nl-mal-ret-1-r45-cult-veteran-unit-4-rule" name="Pyrae" hidden="false">
                          <description>Hammer of Wrath; Psychic Mastery gives Soul Blaze to close-combat attacks and Flame weapons.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
