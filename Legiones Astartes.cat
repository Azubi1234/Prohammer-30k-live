        <selectionEntry id="r71-nl-ta-terror-r71-nl-bj-37" name="Beyond Judgement — Fear (Trophies already equipped)" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-ta-terror-r71-nl-bj-37-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-ta-terror-r71-nl-bj-37-rule" name="Beyond Judgement" hidden="false">
              <description>This squad already carries Trophies of Judgement. Under Horror Cult it may still purchase Beyond Judgement for +25 points per unit; doing so grants Fear and treats the squad as equipped with Trophies of Judgement in the manner specified by the Rite. Measure the 8-inch Leadership penalty from any model. Trophies penalties remain non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-ta-terror-r71-nl-bj-37-show" type="set" value="false" field="hidden">
