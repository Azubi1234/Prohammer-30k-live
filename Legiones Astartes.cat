                        <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r60-ws-hasik-retinue-legion-veteran-squad-r40-da-steel-transport-veteran-unit-hs-spartan-da-wing-hs-spartan" collective="false" import="true">
