                        </selectionEntry>
                      </selectionEntries>
                      <selectionEntryGroups>
                        <selectionEntryGroup name="Pintle-mounted Weapon" id="r63-sw-varagyr-transport-lr-hs-lr-ph-pintle" hidden="false">
                          <constraints>
                            <constraint id="r63-sw-varagyr-transport-lr-hs-lr-ph-pintle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                          </constraints>
                          <modifiers>
                            <modifier type="set" value="2" field="r63-sw-varagyr-transport-lr-hs-lr-ph-pintle-max">
                              <conditions>
                                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r63-sw-varagyr-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
