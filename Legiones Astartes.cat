    <selectionEntry type="unit" import="true" name="Malcharion, the War-Sage" hidden="false" id="r41-unit-viii-6-malcharion-the-war-sage">
      <categoryLinks>
        <categoryLink id="r41-unit-viii-6-malcharion-the-war-sage-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      </categoryLinks>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint id="r41-unit-viii-6-malcharion-the-war-sage-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <costs>
        <cost name="Points" typeId="pts" value="155" />
      </costs>
      <rules>
        <rule id="r71-nl-malcharion-wargear" name="Wargear" hidden="false">
          <description>Artificer Armour; Refractor Field; Master-crafted Power Weapon; Bolter; Bolt pistol; Frag grenades.</description>
        </rule>
        <rule id="r71-nl-malcharion-rule-0" name="War-Sage" hidden="false">
          <description>Malcharion and any Night Lords unit he has joined may re-roll failed Morale and Pinning tests. The second result must be accepted.</description>
        </rule>
        <rule id="r73-nl-rule-malcharion-legiones-astartes-night-lords" name="Legiones Astartes (Night Lords)" hidden="false">
          <description>This model belongs to the VIII Legion and is affected by rules and effects which refer to Legiones Astartes (Night Lords).</description>
        </rule>
        <rule id="r73-nl-rule-malcharion-independent-character" name="Independent Character" hidden="false">
          <description>Uses the normal ProHammer Independent Character rules.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry id="r71-nl-malcharion-opt-0" name="Krak Grenades" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="2" />
          </costs>
          <constraints>
            <constraint id="r71-nl-malcharion-opt-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-malcharion-opt-0-rule" name="Option" hidden="false">
              <description>Adds Krak grenades.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r71-nl-malcharion-opt-1" name="Melta Bombs" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
          <constraints>
            <constraint id="r71-nl-malcharion-opt-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-malcharion-opt-1-rule" name="Option" hidden="false">
              <description>Adds Melta bombs.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r73-nl-malcharion-model" name="Malcharion, the War-Sage" type="model" hidden="false" import="true" defaultAmount="1">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r73-nl-malcharion-model-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="r73-nl-malcharion-model-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
