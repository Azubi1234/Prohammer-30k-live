          <rules>
            <rule name="Auxiliary Drive" id="r32-aero-caestus-aux-effect" hidden="false">
              <description>At the start of the Movement phase, if Immobilised, roll a D6. On a 4+ remove Immobilised and the vehicle may move normally that turn.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Replace two Havoc Launchers with two Missile Launchers (Frag/Krak)" hidden="false" id="r32-aero-caestus-missiles">
          <constraints>
            <constraint id="r32-aero-caestus-missiles-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
