                        <modifier id="r48-vis-355" type="set" value="true" field="hidden">
                          <conditions>
                            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-p6" shared="true" includeChildSelections="true" includeChildForces="false" />
