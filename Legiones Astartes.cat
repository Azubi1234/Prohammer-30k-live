              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="2" />
              </costs>
              <rules>
                <rule name="Option restriction" id="r41-unit-xvi-7-maloghurst-the-twisted-opt-0-context" hidden="false">
                  <description>• Maloghurst may take:</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="TYBALT MARR, “THE EITHER”" hidden="false" id="r41-unit-xvi-8-tybalt-marr-the-either">
