                              <rules>
                                <rule name="Standard Wargear" id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-achilles-wg" hidden="false">
                                  <description>Quad Launcher with Frag and Shatter Shells; two Twin-linked Multi-Meltas; Extra Armour; Armoured Ceramite; Searchlight and Smoke Launchers. Power of the Machine Spirit; Transport Capacity 6.</description>
                                </rule>
                                <rule name="Ferromantic Invulnerability" id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-achilles-ferromantic-invulnerability" hidden="false">
                                  <description>Weapons with Melta do not roll an additional Armour Penetration die against the Achilles. Weapons with Lance do not reduce its Armour Value.</description>
                                </rule>
                              </rules>
                              <selectionEntries>
                                <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-ac-up-hunter-killer-missile" hidden="false" import="true">
