              </costs>
              <rules>
                <rule id="r57-iw-hammer-breacher-r57-breacher-unit-iw-bionics-rule" name="Bionics" hidden="false">
                  <description>Iron Warriors Armoury price; otherwise follows the normal Bionics rules.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <modifiers>
            <modifier id="r57-iw-hammer-breacher-r57-breacher-unit-iw-hide-missing-legion-iv" type="set" value="true" field="hidden">
