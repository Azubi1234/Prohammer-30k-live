      </constraints>
      <costs>
        <cost name="Points" typeId="pts" value="490" />
      </costs>
      <profiles>
        <profile id="r64-if-dorn-profile" name="Rogal Dorn" hidden="false" typeId="prof-model" typeName="Model">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">7</characteristic>
            <characteristic name="BS" typeId="model-bs">6</characteristic>
            <characteristic name="S" typeId="model-s">6</characteristic>
            <characteristic name="T" typeId="model-t">6</characteristic>
            <characteristic name="W" typeId="model-w">6</characteristic>
            <characteristic name="I" typeId="model-i">6</characteristic>
            <characteristic name="A" typeId="model-a">5</characteristic>
            <characteristic name="Ld" typeId="model-ld">10</characteristic>
            <characteristic name="Sv" typeId="model-sv">1+</characteristic>
          </characteristics>
        </profile>
        <profile id="r64-if-dorn-voice" name="Voice of Terra" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">24"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Salvo 3/5, Rending</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="r64-if-dorn-wg" name="Wargear" hidden="false">
          <description>Auric Armour, Storm’s Teeth, Voice of Terra, Frag Grenades.</description>
        </rule>
        <rule id="r64-if-dorn-special" name="Special Rules" hidden="false">
          <description>Primarch, Legiones Astartes (Imperial Fists), The Unyielding, Lord Castellan, Master of Defence, This Ground Shall Not Fall.</description>
        </rule>
        <rule id="r64-if-dorn-armour" name="Auric Armour" hidden="false">
          <description>Counts as Primarch Armour.</description>
        </rule>
        <rule id="r64-if-dorn-teeth" name="Storm’s Teeth" hidden="false">
          <description>Two-Handed Power Weapon. Attacks are resolved at +2 Strength and have Shred and Rampage.</description>
        </rule>
        <rule id="r64-if-dorn-unyield" name="The Unyielding" hidden="false">
          <description>Rogal Dorn may re-roll Armour Saves of 1. The second result must be accepted.</description>
        </rule>
        <rule id="r64-if-dorn-castellan" name="Lord Castellan" hidden="false">
          <description>Friendly Imperial Fists units with at least one model within 12 inches of Dorn gain Stubborn. A unit which already has Stubborn may instead re-roll failed Pinning tests while within 12 inches.</description>
        </rule>
        <rule id="r64-if-dorn-defence" name="Master of Defence" hidden="false">
          <description>Dorn and any unit he has joined count as equipped with Frag Grenades when assaulted through Difficult Terrain. In addition, Dorn and any unit he has joined may make an Overwatch attack when charged even if another rule or circumstance would normally prevent it.</description>
        </rule>
        <rule id="r64-if-dorn-ground" name="This Ground Shall Not Fall" hidden="false">
          <description>After terrain has been placed but before deployment, nominate up to two Fortifications, ruins or other suitable defensive terrain features wholly or partially within the Imperial Fists deployment zone. Each nominated feature improves its Cover Save by 1 to a maximum of 3+. Friendly Imperial Fists units occupying either nominated feature may not be Pinned. These benefits last for the battle.</description>
        </rule>
        <rule id="r64-if-dorn-retinue-note" name="Primarch Retinue" hidden="false">
          <description>A Huscarl Terminator Retinue selected for Rogal Dorn ignores any normal requirement for the accompanying Character to wear Terminator Armour.</description>
        </rule>
        <rule id="r68-if-dorn-wargear" name="ROGAL DORN — WARGEAR" hidden="false">
          <description>Auric Armour; Storm’s Teeth; Voice of Terra; Frag Grenades.</description>
        </rule>
        <rule id="r68-if-dorn-special" name="ROGAL DORN — SPECIAL RULES" hidden="false">
          <description>Primarch; Legiones Astartes (Imperial Fists); The Unyielding; Lord Castellan; Master of Defence; This Ground Shall Not Fall.</description>
        </rule>
        <rule id="r68-if-dorn-retinue" name="ROGAL DORN — PRIMARCH RETINUE" hidden="false">
          <description>Rogal Dorn may select one Legion Honour Guard Squad, Legion Terminator Command Squad, Huscarl Terminator Retinue, or Templar Brethren Squad as his Primarch Retinue. It occupies no additional Force Organisation selection. A Huscarl Retinue selected for Dorn ignores the normal requirement for the accompanying Character to wear Terminator Armour. The functional PRIMARCH RETINUE selector is part of Dorn’s roster entry.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r64-if-dorn-retinue" name="PRIMARCH RETINUE — choose up to one (no separate FOC slot)" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r64-if-dorn-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Honour Guard Squad" id="r64-if-dorn-honour-hq-praetor-ret-honour" hidden="false" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="55" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r64-if-dorn-honour-hq-praetor-ret-honour-std" hidden="false">
                  <description>Every model wears Artificer Armour and carries a Refractor Field, Power Weapon, Bolt Pistol and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="r64-if-dorn-honour-hq-praetor-ret-honour-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Honour or Death" id="r64-if-dorn-honour-hq-praetor-ret-honour-hod" hidden="false">
                  <description>If the Legion Champion is in base contact with one or more enemy Independent Characters, he must direct all of his close-combat attacks against one of them. When attacking an enemy Independent Character in close combat, he may re-roll failed To Hit and To Wound rolls.</description>
                </rule>
                <rule name="Retinue" id="r64-if-dorn-honour-hq-praetor-ret-honour-ret" hidden="false">
                  <description>Selected for an eligible Praetor or Primarch. It occupies no separate Force Organisation slot; the commander and Honour Guard count as a single HQ selection but do not have to deploy together and operate as separate units after deployment.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Legion Champion" id="r64-if-dorn-honour-hq-praetor-ret-honour-champ" hidden="false" import="true" defaultAmount="1">
                  <constraints>
                    <constraint id="r64-if-dorn-honour-hq-praetor-ret-honour-champ-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r64-if-dorn-honour-hq-praetor-ret-honour-champ-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Champion" id="r64-if-dorn-honour-hq-praetor-ret-honour-champ-prof" typeId="prof-model" typeName="Model" hidden="false">
