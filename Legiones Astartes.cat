            <selectionEntry type="unit" name="Legion Terminator Command Squad" id="r57-iw-pert-retinue-legion-terminator-command-squad" hidden="false" import="true">
              <constraints>
                <constraint id="r57-iw-pert-retinue-legion-terminator-command-squad-hq-praetor-ret-termcommand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
