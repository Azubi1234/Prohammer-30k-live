                </rule>
                <rule id="r57-iw-golg-retinue-dominator-cohort-r57-iw-dom-rule-1" name="Stubborn" hidden="false">
                  <description>This unit has Stubborn.</description>
                </rule>
                <rule id="r57-iw-golg-retinue-dominator-cohort-r57-iw-dom-rule-2" name="Hatred (Battle-Automata)" hidden="false">
                  <description>Use the normal ProHammer Hatred special rule when fighting enemy Battle-Automata.</description>
                </rule>
                <rule id="r57-iw-golg-retinue-dominator-cohort-r57-iw-dom-rule-3" name="Those Once Honoured" hidden="false">
                  <description>One Dominator Cohort may be selected as Perturabo's personal retinue. If selected in this manner, the squad does not occupy an Elites choice.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <rules>
            <rule id="r57-iw-golg-retinue-rule" name="Retinue" hidden="false">
              <description>ERASMUS GOLG may select one of: Legion Terminator Command Squad, Tyrant Siege Terminator Squad, Dominator Cohort. The selected unit occupies no separate Force Organisation slot.</description>
            </rule>
          </rules>
