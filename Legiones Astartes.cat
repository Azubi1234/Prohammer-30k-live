            <selectionEntry type="unit" name="Legion Terminator Command Squad" id="r64-if-garrius-term-hq-praetor-ret-termcommand" hidden="false" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="215" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r64-if-garrius-term-hq-praetor-ret-tc-std" hidden="false">
                  <description>Five Terminator Veterans, each equipped with the selected Terminator Armour pattern, a Combi-Bolter and a Power Weapon.</description>
                </rule>
                <rule name="Legiones Astartes" id="r64-if-garrius-term-hq-praetor-ret-tc-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Retinue" id="r64-if-garrius-term-hq-praetor-ret-tc-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character equipped with Terminator, Tartaros or Cataphractii Terminator Armour. It occupies no separate Force Organisation slot; the character and squad count as one HQ selection but may deploy and operate separately.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Terminator Veterans" id="r64-if-garrius-term-hq-praetor-ret-tc-vets" hidden="false" import="true" defaultAmount="5">
                  <constraints>
                    <constraint id="r64-if-garrius-term-hq-praetor-ret-tc-vets-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r64-if-garrius-term-hq-praetor-ret-tc-vets-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Terminator Veteran" id="r64-if-garrius-term-hq-praetor-ret-tc-vets-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">4</characteristic>
                        <characteristic name="BS" typeId="model-bs">4</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">1</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">2</characteristic>
                        <characteristic name="Ld" typeId="model-ld">9</characteristic>
                        <characteristic name="Sv" typeId="model-sv">2+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
