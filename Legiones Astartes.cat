                <selectionEntry id="r74-ba-sang-honour-r71-nl-gen-9-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="0" />
                  </costs>
                  <constraints>
                    <constraint id="r74-ba-sang-honour-r71-nl-gen-9-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
