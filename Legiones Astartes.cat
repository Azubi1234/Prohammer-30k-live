                  <rules>
                    <rule name="Armoured Ceramite" id="r71-nl-contekar-transport-spartan-hs-spartan-armoured-ceramite-rule" hidden="false">
                      <description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</description>
                    </rule>
