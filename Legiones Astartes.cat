                                  <characteristics>
                                    <characteristic name="Range" typeId="ranged-range">Self / 6"</characteristic>
                                    <characteristic name="S" typeId="ranged-s">—</characteristic>
                                    <characteristic name="AP" typeId="ranged-ap">—</characteristic>
                                    <characteristic name="Type" typeId="ranged-type">Blessing</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                              <rules>
                                <rule id="r61-ws-stormseer-power2-telepathy-shrouding-rule" name="Shrouding" hidden="false">
                                  <description>All friendly models within 6 inches of the Psyker gain the Shrouded special rule.</description>
                                </rule>
                              </rules>
                            </selectionEntry>
                          </selectionEntries>
                        </selectionEntryGroup>
                      </selectionEntryGroups>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
              </selectionEntryGroups>
              <rules>
                <rule id="r61-ws-stormseer-rule" name="Stormseer Consul" hidden="false">
                  <description>Replace the Centurion's Chainsword with a Force Weapon. Gains Psyker (Mastery Level 1), Adamantium Will and Legion Support Officer. A White Scars army uses the Stormseer Consul instead of the normal Legion Librarian Consul.</description>
                </rule>
                <rule id="r61-ws-unseen-bolt-rule" name="Unseen Bolt" hidden="false">
                  <description>Psychic Shooting Power. Use during the Stormseer's Shooting phase instead of firing another weapon. Take a Psychic Test; if successful resolve the attack using the profile shown. Unseen Bolt may not be invoked during Return Fire, Overwatch or Stand &amp; Shoot.</description>
                </rule>
              </rules>
              <profiles>
                <profile id="r61-ws-unseen-bolt-profile" name="Unseen Bolt" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                    <characteristic name="S" typeId="ranged-s">6</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Assault 1, Blast, Pinning, Psychic</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
