      <selectionEntries>
        <selectionEntry id="r71-nl-contekar-models" name="4 Contekar + Contekar Dissident" type="model" hidden="false" import="true" defaultAmount="5">
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <constraints>
            <constraint id="r71-nl-contekar-models-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
            <constraint id="r71-nl-contekar-models-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <profiles>
