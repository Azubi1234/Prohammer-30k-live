        <selectionEntry id="r42-role-v-0-effects-ride-like-the-wind-legion-sky-hunter-jetbike-squadrons-r37-rapid-fa-sky-hunter" name="Rapid Encirclement (Sky Hunter Phalanx)" type="upgrade" hidden="true" import="true">
          <constraints>
            <constraint id="r42-role-v-0-effects-ride-like-the-wind-legion-sky-hunter-jetbike-squadrons-r37-rapid-fa-sky-hunter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <rules>
            <rule name="Rapid Encirclement" id="r42-role-v-0-effects-ride-like-the-wind-legion-sky-hunter-jetbike-squadrons-r37-rapid-fa-sky-hunter-rule" hidden="false">
              <description>Once per battle, during its Movement phase, if every model in this unit can move completely off a table edge, remove the unit and place it into Ongoing Reserves. It returns during the controlling player’s following turn using the normal Outflank rules.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
