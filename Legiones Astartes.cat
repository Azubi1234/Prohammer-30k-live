              <costs>
                <cost name="Points" typeId="pts" value="30" id="r57-breacher-unit-iw-servo-pts" />
              </costs>
              <rules>
                <rule id="r57-breacher-unit-iw-servo-rule" name="Servo-Arm" hidden="false">
                  <description>Follows the normal Servo-Arm rules in the Legiones Astartes Army List. A model equipped with a Jump Pack may not purchase a Servo-Arm.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r57-breacher-unit-iw-bionics" name="Bionics" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r57-breacher-unit-iw-bionics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
