          </modifiers>
          <entryLinks>
            </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <entryLinks>
        <entryLink id="r57-iw-golg-term-troops-r40-da-term-transponders" name="Teleportation Transponders" type="selectionEntry" targetId="da22-transponders" hidden="true" import="true">
          <constraints>
