                    <constraint id="r52-ec-ful-honour-hq-praetor-ret-honour-base-min" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r52-ec-ful-honour-hq-praetor-ret-honour-base-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" />
