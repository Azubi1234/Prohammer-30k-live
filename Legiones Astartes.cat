                <selectionEntry type="model" name="Legion Honour Guard" id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-base" hidden="false" import="true" defaultAmount="2">
                  <constraints>
                    <constraint id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-base-min" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r60-ws-jagh-retinue-legion-honour-guard-squad-hq-praetor-ret-honour-base-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" />
