                                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r70-if-ta-1-1-hs-lr-proteus" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                            <modifier type="set" value="3" field="r70-if-ta-1-1-hs-lr-pr-up-armoured-ceramite-max">
                              <conditions>
                                <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r70-if-ta-1-1-hs-lr-proteus" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                          </modifiers>
                          <costs>
                            <cost name="Points" typeId="pts" value="20" />
                          </costs>
                          <rules>
                            <rule name="Armoured Ceramite" id="r70-if-ta-1-1-hs-lr-pr-up-armoured-ceramite-rule" hidden="false">
                              <description>Melta weapons do not receive their additional Armour Penetration die against this vehicle, regardless of range.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Explorator Augury Web" id="r70-if-ta-1-1-hs-lr-proteus-web" hidden="false" import="true">
                          <constraints>
                            <constraint id="r70-if-ta-1-1-hs-lr-proteus-web-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <modifiers>
                            <modifier type="set" value="2" field="r70-if-ta-1-1-hs-lr-proteus-web-max">
                              <conditions>
                                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r70-if-ta-1-1-hs-lr-proteus" shared="true" includeChildSelections="true" />
