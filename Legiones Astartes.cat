            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Moritat Consul" id="hq-consul-moritat" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-moritat-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="45" />
              </costs>
              <rules>
                <rule name="Legion Moritat Consul" id="hq-consul-moritat-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Moritat Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Scout" id="r29-mor-scout" hidden="false">
                  <description>Uses the normal ProHammer Scout special rule.</description>
                </rule>
                <rule name="Counter-Attack" id="r29-mor-counter" hidden="false">
                  <description>Uses the normal ProHammer Counter-Attack special rule.</description>
                </rule>
                <rule name="Dual Pistols" id="r29-mor-dual" hidden="false">
                  <description>The Moritat may fire both pistols during the Shooting phase. If he does so, he may not fire any other weapon that phase.</description>
                </rule>
                <rule name="Lone Killer" id="r29-mor-lone" hidden="false">
                  <description>The Moritat may not fulfil a compulsory HQ choice and may never be the Warlord. He may only join a Legion Destroyer Squad and may not benefit from beneficial psychic powers used by another model or another model’s Leadership/re-rolls.</description>
                </rule>
                <rule name="Chain Fire" id="r29-mor-chain" hidden="false">
                  <description>When firing his pistols, each successful To Hit roll immediately generates another shot with that pistol against the same target, continuing until it misses. Maximum 12 successful hits in total. Gets Hot on a natural 1 ends the attack. After Chain Fire, the Moritat may not charge that turn and may not shoot in his following Shooting phase.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Pistol Pair" id="r29-mor-pair-group" hidden="false">
                  <constraints>
                    <constraint id="r29-mor-pair-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                    <constraint id="r29-mor-pair-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="upgrade" name="Two Bolt Pistols" id="r29-mor-bolt" hidden="false" import="true" defaultAmount="1">
                      <constraints>
                        <constraint id="r29-mor-bolt-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                        <constraint id="r29-mor-bolt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <profiles>
                        <profile name="Two Bolt Pistols" id="r29-mor-bolt-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">12”</characteristic>
                            <characteristic name="S" typeId="ranged-s">4</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">5</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Pistol</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Two Bolt Pistols" id="r29-mor-bolt-rule" hidden="false">
                          <description>The Moritat carries two Bolt Pistols.</description>
                        </rule>
                      </rules>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-114" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Two Hand Flamers" id="r29-mor-hand" hidden="false" import="true">
                      <constraints>
                        <constraint id="r29-mor-hand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="10" />
                      </costs>
                      <profiles>
                        <profile name="Two Hand Flamers" id="r29-mor-hand-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Template</characteristic>
                            <characteristic name="S" typeId="ranged-s">3</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">6</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Pistol</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Two Hand Flamers" id="r29-mor-hand-rule" hidden="false">
                          <description>Both Bolt Pistols are replaced by Hand Flamers.</description>
                        </rule>
                      </rules>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-115" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Two Plasma Pistols" id="r29-mor-plasma" hidden="false" import="true">
                      <constraints>
                        <constraint id="r29-mor-plasma-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="30" />
                      </costs>
                      <profiles>
                        <profile name="Two Plasma Pistols" id="r29-mor-plasma-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">12”</characteristic>
                            <characteristic name="S" typeId="ranged-s">7</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Pistol, Gets Hot</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Two Plasma Pistols" id="r29-mor-plasma-rule" hidden="false">
                          <description>Both Bolt Pistols are replaced by Plasma Pistols.</description>
                        </rule>
                      </rules>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-116" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Two Calibanite Plasma Pistols" id="r29-mor-calibanite" hidden="false" import="true">
                      <constraints>
                        <constraint id="r29-mor-calibanite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="30" />
                      </costs>
                      <profiles>
                        <profile name="Calibanite Plasma Pistol (x2)" id="r29-mor-calibanite-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">12”</characteristic>
                            <characteristic name="S" typeId="ranged-s">6</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Pistol</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Ancient Plasma Weaponry" id="r29-mor-calibanite-rule" hidden="false">
                          <description>Both Bolt Pistols are replaced by Calibanite Plasma Pistols. Calibanite Plasma weapons do not have Gets Hot.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier type="set" value="true" field="hidden">
                          <conditions>
                            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" />
                          </conditions>
                        </modifier>
                      </modifiers>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-117" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
              </selectionEntryGroups>
              <selectionEntries>
                <selectionEntry id="r74-ba-moritat-two-inferno" name="Two Inferno Pistols — replace both Bolt Pistols" type="upgrade" hidden="false" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="20" />
                  </costs>
                  <constraints>
                    <constraint id="r74-ba-moritat-two-inferno-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r74-ba-moritat-two-inferno-rule" name="Inferno Pistols" hidden="false">
                      <description>Replaces both of the Moritat’s Bolt Pistols with two Inferno Pistols. Each uses Range 6 inches, Strength 8, AP1, Pistol, Melta.</description>
                    </rule>
                  </rules>
                  <modifiers>
                    <modifier id="r74-ba-moritat-two-inferno-legion" type="set" value="true" field="hidden">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-ix" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </conditions>
                    </modifier>
                  </modifiers>
                  <categoryLinks>
                    <categoryLink id="r80-ih-consul-cat-118" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                  </categoryLinks>
                </selectionEntry>
              </selectionEntries>
              <categoryLinks>
                <categoryLink id="r80-ih-consul-cat-113" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                <categoryLink id="r81-ih-consul-cat-2" name="Head of the Gorgon — non-Forge Consul" hidden="true" targetId="r81-ih-nonforge-consul" primary="false" />
              </categoryLinks>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Delegatus Consul" id="hq-consul-delegatus" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-delegatus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule name="Legion Delegatus Consul" id="hq-consul-delegatus-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Delegatus Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Master of the Legion" id="r29-delegatus-master" hidden="false">
                  <description>The Delegatus has Master of the Legion and may enable one Rite of War, subject to the normal limits on that rule.</description>
                </rule>
                <rule name="Delegated Authority" id="r29-delegatus-authority" hidden="false">
                  <description>A Delegatus may possess Master of the Legion in an army of fewer than 1,000 points. Unless the army contains its Primarch, a Delegatus with Master of the Legion must be the Warlord. A Detachment containing a Delegatus may not also contain a Legion Praetor.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink id="r80-ih-consul-cat-119" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                <categoryLink id="r81-ih-consul-cat-3" name="Head of the Gorgon — non-Forge Consul" hidden="true" targetId="r81-ih-nonforge-consul" primary="false" />
              </categoryLinks>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Esoterist Consul" id="hq-consul-esoterist" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-esoterist-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <rules>
                <rule name="Legion Esoterist Consul" id="hq-consul-esoterist-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Esoterist Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Psyker (Mastery Level 1)" id="r29-eso-psyker" hidden="false">
                  <description>The Esoterist is a Psyker with Mastery Level 1 and follows the ProHammer Classic psychic rules.</description>
                </rule>
                <rule name="Legion Support Officer" id="r29-eso-support" hidden="false">
                  <description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</description>
                </rule>
                <rule name="Forbidden Lore" id="r29-eso-lore" hidden="false">
                  <description>Select powers from Sanctic Daemonology or Malefic Daemonology regardless of Legion or Allegiance. Possession is not selectable because ProHammer restricts it to Mastery Level 2 or greater.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Psychic Discipline(s)" id="r29-eso-discipline-group" hidden="false">
                  <constraints>
                    <constraint id="r29-eso-discipline-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
