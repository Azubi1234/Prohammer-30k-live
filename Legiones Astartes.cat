                    <constraint id="r52-ec-ful-honour-hq-praetor-ret-honour-standard-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="60" />
                  </costs>
                  <entryLinks>
                    <entryLink import="true" name="Legion Standard" id="r52-ec-ful-honour-hq-praetor-ret-honour-standard-link" type="selectionEntry" targetId="gear-hq-legion-standard" hidden="false" defaultAmount="1">
                      <constraints>
                        <constraint id="r52-ec-ful-honour-hq-praetor-ret-honour-standard-link-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                        <constraint id="r52-ec-ful-honour-hq-praetor-ret-honour-standard-link-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
