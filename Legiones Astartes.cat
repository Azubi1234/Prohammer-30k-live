                    <constraint id="r63-sw-rp-hood-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                </entryLink>
              </entryLinks>
              <selectionEntries>
