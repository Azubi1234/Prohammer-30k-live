        <selectionEntryGroup name="Weapon Replacements (max 100 Armoury pts; max 2 weapons)" id="hq-centurion-weapons" hidden="false">
          <constraints>
            <constraint id="hq-centurion-weapons-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="hq-centurion-weapons-pts-max" type="max" value="100" field="pts" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <rules>
            <rule name="Armoury Weapon Restrictions" id="hq-centurion-weap-rule" hidden="false">
              <description>These selections replace the model's Bolt Pistol and/or Chainsword. A model may carry no more than two weapons, only one of which may be two-handed. A Pair of Lightning Claws counts as both weapon choices. No item may be selected more than once unless specifically permitted. Equipment included in the unit entry does not count against the Armoury allowance.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Single-handed Weapons" id="hq-centurion-single" hidden="false">
              <constraints>
                <constraint id="hq-centurion-single-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="true" />
              </constraints>
