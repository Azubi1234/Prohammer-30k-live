              <rules>
                <rule name="Space Marine Bike" id="r37-centurion-jetbike-gear-gear-hq-bike-rule" hidden="false">
                  <description>The bearer becomes Bike unit type and follows the normal ProHammer Bike rules. The bike is armed with twin-linked bolters. It may not be combined with a Jump Pack, Jetbike or Terminator Armour.</description>
                </rule>
                <rule name="Jetbike Command" id="r37-centurion-jetbike-rule" hidden="false">
                  <description>Replaces the model’s Space Marine Bike. This option includes the normal +35 point Space Marine Bike and the +5 point Sky Hunter Phalanx Jetbike upgrade. The model follows the normal rules for Jetbikes.</description>
                </rule>
              </rules>
              <modifiers>
