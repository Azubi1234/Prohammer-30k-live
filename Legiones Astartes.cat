            </selectionEntry>
            <selectionEntry type="upgrade" name="Auxiliary Drive" id="hq-dam-vu-3" hidden="false" import="true">
              <constraints>
                <constraint id="hq-dam-vu-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <rules>
                <rule name="Auxiliary Drive" id="hq-dam-vu-3-r" hidden="false">
                  <description>If Immobilised at the start of the controlling player's Movement phase, roll a D6; on 4+ remove one Immobilised result and the vehicle may move normally that phase.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Armoured Ceramite" id="hq-dam-vu-4" hidden="false" import="true">
