                  </costs>
                  <constraints>
                    <constraint id="r71-nl-bj-29-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r71-nl-bj-29-rule" name="Beyond Judgement" hidden="false">
                      <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
                    </rule>
                  </rules>
                  <modifiers>
                    <modifier id="r71-nl-bj-29-show" type="set" value="false" field="hidden">
