                        <constraint id="r64-if-sig-templar-r64-if-templar-transport-drop-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                    </entryLink>
                    <entryLink id="r64-if-sig-templar-r64-if-templar-transport-dread" name="Dreadclaw Drop Pod" type="selectionEntry" targetId="transport-dreadclaw" hidden="false" import="true">
                      <constraints>
                        <constraint id="r64-if-sig-templar-r64-if-templar-transport-dread-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                    </entryLink>
                  </entryLinks>
                  <selectionEntries>
                    <selectionEntry type="unit" name="Legion Land Raider" id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-land-raider" hidden="false" import="true">
                      <rules>
                        <rule name="Squadron Composition" id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-comp-rule" hidden="false">
                          <description>Select 1–3 Land Raiders. Any may be Phobos or Proteus patterns; no more than one may be an Achilles.</description>
                        </rule>
                      </rules>
                      <selectionEntryGroups>
                        <selectionEntryGroup name="Land Raider Patterns" id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-patterns" hidden="false">
                          <constraints>
                            <constraint id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-patterns-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                            <constraint id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-patterns-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                          </constraints>
                          <selectionEntries>
                            <selectionEntry type="model" name="Land Raider Phobos" id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-phobos" hidden="false" import="true" defaultAmount="1">
                              <constraints>
                                <constraint id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-phobos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                              </constraints>
                              <costs>
                                <cost name="Points" typeId="pts" value="250" />
                              </costs>
                              <profiles>
                                <profile name="Land Raider Phobos" id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-phobos-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                                  <characteristics>
                                    <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                                    <characteristic name="Front" typeId="vehicle-front">14</characteristic>
                                    <characteristic name="Side" typeId="vehicle-side">14</characteristic>
                                    <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
                                  </characteristics>
                                </profile>
                                <profile name="Twin-linked Lascannon" id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-phobos-las" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                                  <characteristics>
                                    <characteristic name="Range" typeId="ranged-range">48"</characteristic>
                                    <characteristic name="S" typeId="ranged-s">9</characteristic>
