                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r74-ba-sang-honour-hq-praetor-ret-honour-champ" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
                      </repeats>
                    </modifier>
                    <modifier id="r74-ba-sang-honour-r71-nl-gen-9-stealth-cost-1" type="increment" value="1" field="pts">
                      <repeats>
                        <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r74-ba-sang-honour-hq-praetor-ret-honour-base" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
