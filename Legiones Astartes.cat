                <constraint id="r35-fury-dread-dreadnought-extra-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <rules>
                <rule name="Extra Armour" id="r35-fury-dread-dreadnought-extra-rule" hidden="false">
                  <description>Crew Stunned results are treated as Crew Shaken instead.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="r35-fury-dread-dreadnought-hk">
              <constraints>
                <constraint id="r35-fury-dread-dreadnought-hk-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <profiles>
                <profile name="Hunter-Killer Missile" id="r35-fury-dread-dreadnought-hk-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">Unlimited</characteristic>
                    <characteristic name="S" typeId="ranged-s">8</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">3</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 1, One Use</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Frag Assault Launchers" hidden="false" id="r35-fury-dread-dreadnought-frag-launchers">
              <constraints>
                <constraint id="r35-fury-dread-dreadnought-frag-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule name="Frag Assault Launchers" id="r35-fury-dread-dreadnought-frag-rule" hidden="false">
                  <description>The Walker counts as equipped with Frag Grenades when charging an enemy in or behind cover. If a Transport is equipped with Frag Assault Launchers, a unit charging in the same turn it disembarks counts as equipped with Frag Grenades for that Assault phase.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Armoured Sarcophagus" hidden="false" id="r35-fury-dread-dreadnought-sarcophagus">
              <constraints>
                <constraint id="r35-fury-dread-dreadnought-sarcophagus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule name="Armoured Sarcophagus" id="r35-fury-dread-dreadnought-sarc-rule" hidden="false">
                  <description>Increase Front Armour from 12 to 13. Side and Rear Armour are unaffected.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Veteran Pilot" hidden="false" id="r35-fury-dread-dreadnought-veteran-pilot">
              <constraints>
                <constraint id="r35-fury-dread-dreadnought-veteran-pilot-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule name="Veteran Pilot" id="r35-fury-dread-dreadnought-veteran-rule" hidden="false">
                  <description>Increase Weapon Skill and Ballistic Skill by +1. This Dreadnought therefore has WS5 and BS5.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <entryLinks>
            <entryLink import="true" name="Havoc Launcher" hidden="false" id="r35-fury-dread-dreadnought-havoc" type="selectionEntry" targetId="gear-havoc">
              <constraints>
                <constraint id="r35-fury-dread-dreadnought-havoc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Dedicated Transport" id="r35-fury-dread-dreadnought-transport" hidden="false">
          <constraints>
            <constraint id="r35-fury-dread-dreadnought-transport-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <entryLinks>
            <entryLink import="true" name="Legion Dreadnought Drop Pod" hidden="false" id="r35-fury-dread-dreadnought-dreadpod" type="selectionEntry" targetId="transport-dreadnought-pod">
              <constraints>
                <constraint id="r35-fury-dread-dreadnought-dreadpod-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit" collective="false" import="true">
          <constraints>
            <constraint id="r35-fury-dread-da-wing-dreadnought-unit-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="r35-fury-dread-da-wing-dreadnought-unit-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" value="1" field="da-wing-dreadnought-unit-min">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-0">
              <constraints>
                <constraint id="r35-fury-dread-da-wing-dreadnought-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Stormwing" id="r35-fury-dread-da-wing-dreadnought-unit-0-rule" hidden="false">
                  <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-1">
              <constraints>
                <constraint id="r35-fury-dread-da-wing-dreadnought-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Deathwing" id="r35-fury-dread-da-wing-dreadnought-unit-1-rule" hidden="false">
                  <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-2">
              <constraints>
                <constraint id="r35-fury-dread-da-wing-dreadnought-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Dreadwing" id="r35-fury-dread-da-wing-dreadnought-unit-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-3">
              <constraints>
                <constraint id="r35-fury-dread-da-wing-dreadnought-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ironwing" id="r35-fury-dread-da-wing-dreadnought-unit-3-rule" hidden="false">
                  <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-4">
              <constraints>
                <constraint id="r35-fury-dread-da-wing-dreadnought-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="r35-fury-dread-da-wing-dreadnought-unit-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-5">
              <constraints>
                <constraint id="r35-fury-dread-da-wing-dreadnought-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="r35-fury-dread-da-wing-dreadnought-unit-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <modifiers>
        <modifier type="set" value="false" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-ancients" shared="true" includeChildSelections="true" />
          </conditions>
        </modifier>
      </modifiers>
      <entryLinks>
        <entryLink id="r40-da-forward-r35-fury-dread-dreadnought-unit" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true">
          <constraints>
            <constraint id="r40-da-forward-r35-fury-dread-dreadnought-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" />
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-serpent" shared="true" includeChildSelections="true" />
                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-fury-dread-da-wing-dreadnought-unit-4" shared="true" includeChildSelections="true" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </entryLink>
      </entryLinks>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Contemptor Dreadnought" hidden="true" id="r35-fury-contemptor-contemptor-unit">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="r35-fury-contemptor-cat" primary="true" name="Troops" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="pts" value="155" />
      </costs>
      <profiles>
        <profile name="Legion Contemptor Dreadnought" id="r35-fury-contemptor-contemptor-prof" typeId="prof-walker" typeName="Walker" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="walker-ws">5</characteristic>
            <characteristic name="BS" typeId="walker-bs">5</characteristic>
            <characteristic name="S" typeId="walker-s">7</characteristic>
            <characteristic name="Front" typeId="walker-front">13</characteristic>
            <characteristic name="Side" typeId="walker-side">12</characteristic>
            <characteristic name="Rear" typeId="walker-rear">10</characteristic>
            <characteristic name="I" typeId="walker-i">4</characteristic>
            <characteristic name="A" typeId="walker-a">2</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="r35-fury-contemptor-contemptor-standard" hidden="false">
          <description>Twin-linked Heavy Bolter; Dreadnought Close Combat Weapon with built-in Twin-linked Bolter; Smoke Launchers; Searchlight.</description>
        </rule>
        <rule name="Atomantic Shielding" id="r35-fury-contemptor-contemptor-atomantic" hidden="false">
          <description>Each time the vehicle suffers a Glancing or Penetrating Hit from shooting, roll a D6; on a 5+ the hit is ignored. Against a Glancing or Penetrating Hit in close combat, the hit is ignored on a 6+. Make this roll before the Vehicle Damage table. If the vehicle suffers an Explodes! result, add +1" to the explosion radius.</description>
        </rule>
        <rule name="Fleet" id="r35-fury-contemptor-contemptor-fleet" hidden="false">
          <description>Uses the normal ProHammer Fleet special rule.</description>
        </rule>
        <rule name="Paired Close-Combat Arms" id="r35-fury-contemptor-contemptor-paired" hidden="false">
          <description>If equipped with two Dreadnought Close Combat Weapons, the Contemptor gains +1 Attack. This bonus is not included in the profile.</description>
        </rule>
        <rule name="Rite of War Selection" id="r35-fury-contemptor-note" hidden="false">
          <description>This Troops entry is available while Fury of the Ancients is selected.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Primary Arm" id="r35-fury-contemptor-contemptor-primary" hidden="false">
