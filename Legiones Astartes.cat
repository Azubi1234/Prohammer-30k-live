                    <constraint id="r74-ba-pra-guard-r74-ba-guard-mask-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r74-ba-pra-guard-r74-ba-guard-mask-rule" name="Death Mask" hidden="false">
                      <description>Uses the Blood Angels Death Mask rule.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry id="r74-ba-pra-guard-r74-ba-guard-perdition" name="Perdition Weapon" type="upgrade" hidden="false" import="true" defaultAmount="1">
                  <costs>
                    <cost name="Points" typeId="pts" value="0" />
                  </costs>
                  <constraints>
                    <constraint id="r74-ba-pra-guard-r74-ba-guard-perdition-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                    <constraint id="r74-ba-pra-guard-r74-ba-guard-perdition-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r74-ba-pra-guard-r74-ba-guard-perdition-rule" name="Perdition Weapon" hidden="false">
                      <description>Counts as a Power Weapon. A natural To Wound roll of 6 inflicts a Massive Wound (D3) instead of a normal Wound.</description>
                    </rule>
                  </rules>
                </selectionEntry>
