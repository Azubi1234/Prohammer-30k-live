        <selectionEntry id="r40-da-arrow-sky-r37-rapid-fa-sky-hunter" name="Rapid Encirclement (Sky Hunter Phalanx)" type="upgrade" hidden="true" import="true">
          <constraints>
            <constraint id="r40-da-arrow-sky-r37-rapid-fa-sky-hunter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <rules>
            <rule name="Rapid Encirclement" id="r40-da-arrow-sky-r37-rapid-fa-sky-hunter-rule" hidden="false">
              <description>Once per battle, during its Movement phase, if every model in this unit can move completely off a table edge, remove the unit and place it into Ongoing Reserves. It returns during the controlling player’s following turn using the normal Outflank rules.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule name="Standard Wargear" id="r40-da-arrow-sky-fa-sky-std" hidden="false">
          <description>Power Armour; Legion Scimitar Jetbike with Heavy Bolter; Bolt Pistol; Chainsword; Frag Grenades.</description>
        </rule>
        <rule name="Legiones Astartes &amp; Deep Strike" id="r40-da-arrow-sky-fa-sky-la" hidden="false">
          <description>Legiones Astartes and Deep Strike. The unit also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless.</description>
        </rule>
        <rule id="r40-da-arrow-sky-rite-rule" name="Ravenwing Host" hidden="false">
          <description>Selected as a Troops choice by The Seeker’s Arrow. This Rite-specific copy is fixed to the Ravenwing. It gains Outflank and Hit &amp; Run while the Rite is active.</description>
        </rule>
      </rules>
