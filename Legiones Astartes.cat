                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="upgrade" import="true" name="Jetbike (Sky Hunter Phalanx)" hidden="true" id="r40-da-storm-centurion-group-r40-da-storm-tactical-r37-centurion-jetbike">
                      <constraints>
                        <constraint id="r40-da-storm-centurion-group-r40-da-storm-tactical-r37-centurion-jetbike-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="40" />
                      </costs>
                      <rules>
                        <rule name="Space Marine Bike" id="r40-da-storm-centurion-group-r40-da-storm-tactical-r37-centurion-jetbike-gear-gear-hq-bike-rule" hidden="false">
                          <description>The bearer becomes Bike unit type and follows the normal ProHammer Bike rules. The bike is armed with twin-linked bolters. It may not be combined with a Jump Pack, Jetbike or Terminator Armour.</description>
                        </rule>
                        <rule name="Jetbike Command" id="r40-da-storm-centurion-group-r40-da-storm-tactical-r37-centurion-jetbike-rule" hidden="false">
                          <description>Replaces the model’s Space Marine Bike. This option includes the normal +35 point Space Marine Bike and the +5 point Sky Hunter Phalanx Jetbike upgrade. The model follows the normal rules for Jetbikes.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier type="set" value="false" field="hidden">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" />
                          </conditions>
                        </modifier>
                      </modifiers>
                    </selectionEntry>
                  </selectionEntries>
                  <entryLinks>
                    <entryLink import="true" name="Jump Pack" id="r40-da-storm-centurion-group-r40-da-storm-tactical-hq-centurion-jump" type="selectionEntry" targetId="gear-hq-jump" hidden="false">
