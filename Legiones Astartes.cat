        <selectionEntry id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-assault-dfa-veteran-unit" name="Death from Above (Legion Assault Company)" type="upgrade" hidden="true" import="true">
          <constraints>
            <constraint id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-assault-dfa-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <rules>
            <rule name="Death from Above (Legion Assault Company)" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-assault-dfa-veteran-unit-rule" hidden="false">
              <description>Any unit composed entirely of models equipped with Jump Packs may deploy using Deep Strike even if the mission would not normally permit Deep Strike. Resolve arrival using the normal ProHammer Deep Strike rules.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-assault" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry id="r71-nl-gen-34-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
