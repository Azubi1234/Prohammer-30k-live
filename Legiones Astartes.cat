port-squads-r37-spear-hs-hss-transport-src-hq-praetor-ret-honour-land-land-raider-proteus" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-legion-heavy-support-squads-hs-heavy-support-squad-scale-3" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r42-role-xiv-0-legion-heavy-support-squads-r37-spear-hs-hss-transport-src-hq-praetor-ret-honour-land-land-raider-achilles" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-legion-heavy-support-squads-hs-heavy-support-squad-scale-4" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-r37-spear-tac-transport-src-hq-praetor-ret-h" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-legion-heavy-support-squads-hs-heavy-support-squad-scale-5" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-r37-spear-tac-transport-src-hq-praetor-ret-h-5" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-legion-heavy-support-squads-hs-heavy-support-squad-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-7-fabius-bile" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><rules><rule id="live-r2-fabius-enhanced-r42-role-xiv-0-legion-heavy-support-squads-hs-heavy-support-squad-rule" name="Enhanced Warriors" hidden="false"><description>This squad has been enhanced by Fabius Bile for +3 points per model. After deployment but before the first turn, roll a D6 for this squad: 1 — Berserk Rage: make an Armour Save for every model; remove each failure, and survivors gain +1 Strength. 2–5 — Stable Mutation: every model gains +1 Strength and +1 Initiative. 6 — Created a Monster: every model gains +1 Strength, +1 Initiative and +1 Attack; in missions using Victory Points, surviving models from the squad count as casualties when calculating Victory Points.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r2-fulgrim-blessing-r42-role-xiv-0-legion-heavy-support-squads-hs-heavy-support-squad-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-r42-role-xiv-0-legion-heavy-support-squads-hs-heavy-support-squad" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="25" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-r42-role-xiv-0-legion-heavy-support-squads-hs-heavy-support-squad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-r42-role-xiv-0-legion-heavy-support-squads-hs-heavy-support-squad-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-r42-role-xiv-0-legion-heavy-support-squads-hs-heavy-support-squad-hide" type="set" field="hidden" value="true