              <rules>
                <rule name="Standard Wargear" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-wg" hidden="false">
                  <description>Two Quad Lascannons, Twin-linked Heavy Bolter, Extra Armour, Searchlight and Smoke Launchers. Power of the Machine Spirit; Assault Vehicle; Transport Capacity 25.</description>
                </rule>
                <rule id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-rite-size" name="Armoured Assault" hidden="false">
                  <description>Select Phobos/Proteus only for an Ironwing Infantry unit of 10 models or fewer; select the Spartan only for an Ironwing Infantry unit of 11–20 models. Normal Transport Capacity restrictions apply.</description>
                </rule>
              </rules>
