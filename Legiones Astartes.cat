    <selectionEntry type="unit" import="true" name="Legion Breacher Siege Squad — Hammer Compulsory" hidden="true" id="r57-iw-hammer-breacher">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="r57-iw-hammer-breacher-breacher-cat" primary="true" name="Troops" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Standard Wargear" id="r57-iw-hammer-breacher-breacher-standard-wargear" hidden="false">
          <description>Every model is equipped with Hardened Power Armour, a Bolter, a Bolt Pistol, a Boarding Shield and Frag Grenades.</description>
        </rule>
        <rule name="Legiones Astartes" id="r57-iw-hammer-breacher-breacher-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Frag Grenades" id="r57-iw-hammer-breacher-breacher-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
        <rule name="Dedicated Transport" id="r57-iw-hammer-breacher-breacher-transport-rule" hidden="false">
          <description>A Legion Breacher Siege Squad containing ten models or fewer may select a Land Raider, Land Raider Proteus or Land Raider Phobos as a Dedicated Transport where permitted by the relevant vehicle entry. A Legion Breacher Siege Squad may not select a Rhino or Drop Pod unless specifically permitted by a Rite of War or Legion-specific rule.</description>
        </rule>
        <rule id="r57-iw-hammer-breacher-rule" name="Compulsory Troops" hidden="false">
          <description>Use this version for one of the army’s compulsory Troops selections under The Hammer of Olympia.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink import="true" name="Hardened Power Armour" hidden="false" id="r57-iw-hammer-breacher-breacher-standard-armour" type="selectionEntry" targetId="gear-hardened-power-armour" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-standard-armour-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-standard-armour-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Bolter" hidden="false" id="r57-iw-hammer-breacher-breacher-standard-bolter" type="selectionEntry" targetId="gear-bolter" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-standard-bolter-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-standard-bolter-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Bolt Pistol" hidden="false" id="r57-iw-hammer-breacher-breacher-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-standard-bp-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-standard-bp-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Boarding Shield" hidden="false" id="r57-iw-hammer-breacher-breacher-standard-shield" type="selectionEntry" targetId="gear-boarding-shield" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-standard-shield-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-breacher-breacher-standard-shield-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink id="r57-iw-hammer-breacher-r40-da-forward-breacher-unit" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true">
          <constraints>
            <constraint id="r57-iw-hammer-breacher-r40-da-forward-breacher-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
