        <selectionEntry id="live-r2-r41-unit-xvi-8-tybalt-marr-the-either-retinue-0-r37-assault-dfa-veteran-unit" name="Death from Above (Legion Assault Company)" type="upgrade" hidden="true" import="true">
          <constraints>
            <constraint id="live-r2-r41-unit-xvi-8-tybalt-marr-the-either-retinue-0-r37-assault-dfa-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <rules>
            <rule name="Death from Above (Legion Assault Company)" id="live-r2-r41-unit-xvi-8-tybalt-marr-the-either-retinue-0-r37-assault-dfa-veteran-unit-rule" hidden="false">
              <description>Any unit composed entirely of models equipped with Jump Packs may deploy using Deep Strike even if the mission would not normally permit Deep Strike. Resolve arrival using the normal ProHammer Deep Strike rules.</description>
            </rule>
          </rules>
          <modifiers>
