              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="live-r2-r41-unit-xv-8-magistus-amon-the-hidden-retinue-1-fa-seeker-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="live-r2-r41-unit-xv-8-magistus-amon-the-hidden-retinue-1-r71-nl-gen-7-stealth-cost-1" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="live-r2-r41-unit-xv-8-magistus-amon-the-hidden-retinue-1-fa-seeker-sgt" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
