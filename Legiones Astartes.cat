      <selectionEntryGroups>
        <selectionEntryGroup id="r60-ws-jagh-options" name="Options" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="r60-ws-jagh-voidbike" name="Sojutsu Pattern Voidbike" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r60-ws-jagh-voidbike-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
