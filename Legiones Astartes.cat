                    <constraint id="r40-da-steel-transport-r35-destroyer-troops-destroyer-unit-hs-spartan-da-wing-hs-spartan-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
