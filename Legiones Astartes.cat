                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-spearhead" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntryGroup>
          </selectionEntryGroups>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="equalTo" value="9" field="selections" scope="root-entry" childId="r57-iw-hammer-tactical-tac-marine" shared="true" includeChildSelections="false" />
