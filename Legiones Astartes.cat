                                      <conditions>
                                        <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-achilles" shared="true" includeChildSelections="true" />
                                      </conditions>
                                    </modifier>
                                  </modifiers>
                                  <costs>
                                    <cost name="Points" typeId="pts" value="5" />
                                  </costs>
                                  <rules>
                                    <rule name="Hunter-Killer Missile" id="r64-if-sig-templar-r64-if-templar-transport-lr-hs-lr-ac-up-hunter-killer-missile-rule" hidden="false">
                                      <description>Unlimited range, S8 AP3, Heavy 1, One Use.</description>
                                    </rule>
                                  </rules>
                                </selectionEntry>
