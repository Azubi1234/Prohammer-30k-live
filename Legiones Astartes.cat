      <selectionEntryGroup id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-group" name="Fabius Bile" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit" name="Enhanced Warriors" type="upgrade" hidden="false" import="true"><constraints><constraint id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-scale-0" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-included" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-scale-1" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-sergeant" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-scale-2" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-spear-veteran-transport-src-hq-praetor-ret-honour-land-land-raider-phobos" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-scale-3" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-spear-veteran-transport-src-hq-praetor-ret-honour-land-land-raider-proteus" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-scale-4" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-spear-veteran-transport-src-hq-praetor-ret-honour-land-land-raider-achilles" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-scale-5" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r40-da-steel-transport-veteran-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-scale-6" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r40-da-steel-transport-veteran-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-5" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-7-fabius-bile" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><rules><rule id="live-r2-fabius-enhanced-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-rule" name="Enhanced Warriors" hidden="false"><description>This squad has been enhanced by Fabius Bile for +3 points per model. After deployment but before the first turn, roll a D6 for this squad: 1 — Berserk Rage: make an Armour Save for every model; remove each failure, and survivors gain +1 Strength. 2–5 — Stable Mutation: every model gains +1 Strength and +1 Initiative. 6 — Created a Monster: every model gains +1 Strength, +1 Initiative and +1 Attack; in missions using Victory Points, surviving models from the squad count as casualties when calculating Victory Points.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r2-fulgrim-blessing-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="25" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-unit-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-10-fulgrim-transfigured" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
      <modifiers>
        <modifier type="set" value="true" field="hidden" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-hide">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-xiv-0-the-reaping" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
