                </selectionEntry>
                <selectionEntry type="upgrade" name="Legion Standard Bearer" id="r64-if-dorn-honour-hq-praetor-ret-honour-standard" hidden="false" import="true">
                  <constraints>
                    <constraint id="r64-if-dorn-honour-hq-praetor-ret-honour-standard-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="60" />
                  </costs>
                  <entryLinks>
                    <entryLink import="true" name="Legion Standard" id="r64-if-dorn-honour-hq-praetor-ret-honour-standard-link" type="selectionEntry" targetId="gear-hq-legion-standard" hidden="false" defaultAmount="1">
                      <constraints>
