    <selectionEntry type="unit" name="Legion Land Raider Battle Squadron" id="hs-land-raider" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-land-raider-cat" primary="true" name="Heavy Support" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Squadron Composition" id="hs-lr-comp-rule" hidden="false">
          <description>Select 1–3 Land Raiders. Any may be Phobos or Proteus patterns; no more than one may be an Achilles.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Land Raider Patterns" id="hs-lr-patterns" hidden="false">
