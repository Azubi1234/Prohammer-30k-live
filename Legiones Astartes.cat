                      <costs>
                        <cost name="Points" typeId="pts" value="5" />
                      </costs>
                      <constraints>
                        <constraint id="r64-if-praetor-huscarl-r64-if-huscarl-foe-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <rules>
                        <rule id="r64-if-praetor-huscarl-r64-if-huscarl-foe-rule" name="Foeblaster Boltgun" hidden="false">
                          <description>Replaces that Huscarl’s Combi-bolter.</description>
                        </rule>
