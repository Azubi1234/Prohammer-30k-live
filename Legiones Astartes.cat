      <selectionEntryGroups><selectionEntryGroup id="r89-we-angron-wargear" name="Wargear" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="r89-we-angron-wargear-0-armour-of-mars" name="Armour of Mars" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-wargear-0-armour-of-mars-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-wargear-0-armour-of-mars-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-wargear-0-armour-of-mars-rule" name="Armour of Mars" hidden="false"><description>The Armour of Mars counts as Primarch Armour.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-angron-wargear-1-frag-grenades" name="Frag Grenades" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-wargear-1-frag-grenades-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-wargear-1-frag-grenades-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-wargear-1-frag-grenades-rule" name="Frag Grenades" hidden="false"><description>Uses the normal Frag grenade rules.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-angron-spite-furnace" name="Spite Furnace" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-spite-furnace-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-spite-furnace-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-spite-furnace-rule" name="Spite Furnace" hidden="false"><description>A brutal plasma weapon carried by Angron into the thickest fighting.</description></rule></rules><profiles><profile id="r89-we-angron-spite-profile" name="Spite Furnace" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon"><characteristics><characteristic name="Range" typeId="ranged-range">12"</characteristic><characteristic name="S" typeId="ranged-s">7</characteristic><characteristic name="AP" typeId="ranged-ap">2</characteristic><characteristic name="Type" typeId="ranged-type">Pistol, Gets Hot, Master-crafted</characteristic></characteristics></profile></profiles></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-angron-weapon" name="Weapon" hidden="false" collective="false" import="true"><constraints><constraint id="r89-we-angron-weapon-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry id="r89-we-angron-weapon-0-gorefather-gorechild" name="Gorefather &amp; Gorechild" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-weapon-0-gorefather-gorechild-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-weapon-0-gorefather-gorechild-rule" name="Gorefather &amp; Gorechild" hidden="false"><description>Gorefather and Gorechild are a matched pair of Power Weapons. Attacks made with them are resolved at +1 Strength and have Shred and Armourbane. They count as two close-combat weapons.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-angron-weapon-1-widowmaker" name="Widowmaker" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-weapon-1-widowmaker-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-weapon-1-widowmaker-rule" name="Widowmaker" hidden="false"><description>Widowmaker is a Two-Handed Power Weapon. Attacks made with Widowmaker are resolved at Strength 10 and have Armourbane. All attacks made with Widowmaker are resolved at -2 Initiative.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r89-we-angron-special-rules" name="Special Rules" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="r89-we-angron-special-rules-0-primarch" name="Primarch" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-special-rules-0-primarch-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-special-rules-0-primarch-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-special-rules-0-primarch-rule" name="Primarch" hidden="false"><description>Angron uses the universal Primarch rules.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-angron-special-rules-1-legiones-astartes-world-eaters" name="Legiones Astartes (World Eaters)" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-special-rules-1-legiones-astartes-world-eaters-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-special-rules-1-legiones-astartes-world-eaters-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-special-rules-1-legiones-astartes-world-eaters-rule" name="Legiones Astartes (World Eaters)" hidden="false"><description>Uses the World Eaters Legion special rule.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-angron-special-rules-2-the-red-angel" name="The Red Angel" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-special-rules-2-the-red-angel-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-special-rules-2-the-red-angel-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-special-rules-2-the-red-angel-rule" name="The Red Angel" hidden="false"><description>If Angron is able to declare a charge during the Assault phase, he must do so. Angron and any unit he has joined may declare charges against enemy units up to 8 inches away instead of 6. They must charge the closest eligible enemy unit to Angron; if two or more are equally close, the World Eaters player chooses. Difficult Terrain does not reduce this charge distance, although Dangerous Terrain is resolved normally.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-angron-special-rules-3-butcher-s-nails" name="Butcher’s Nails" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-special-rules-3-butcher-s-nails-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-special-rules-3-butcher-s-nails-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-special-rules-3-butcher-s-nails-rule" name="Butcher’s Nails" hidden="false"><description>Angron has Furious Charge and may never voluntarily Withdraw from close combat. Whenever Angron rolls an unmodified 1 To Hit in close combat, that attack instead strikes another friendly model in Angron’s unit. The roll of 1 may not be re-rolled. Resolve the hit using Angron’s current Strength and all rules of the close-combat weapon he is using. If more than one eligible friendly model is present, the opposing player chooses which is struck. Saves are allowed normally and Wounds caused this way do not count toward the close-combat result. If Angron is not accompanied by another friendly model, the roll of 1 is a miss.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-angron-special-rules-4-sire-of-the-world-eaters" name="Sire of the World Eaters" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-special-rules-4-sire-of-the-world-eaters-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-special-rules-4-sire-of-the-world-eaters-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-special-rules-4-sire-of-the-world-eaters-rule" name="Sire of the World Eaters" hidden="false"><description>Friendly World Eaters units with at least one model within 12 inches of Angron add +1 to all Pursuit rolls. Such units may also re-roll failed Break Tests caused by losing close combat; the second result must be accepted.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-angron-special-rules-5-the-nails-demand-blood" name="The Nails Demand Blood" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-special-rules-5-the-nails-demand-blood-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-special-rules-5-the-nails-demand-blood-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-special-rules-5-the-nails-demand-blood-rule" name="The Nails Demand Blood" hidden="false"><description>Each time an enemy unit is completely destroyed during an Assault phase in a close combat involving Angron, increase Angron’s Attacks characteristic by +1 for the remainder of the battle, cumulative to a maximum of +3 Attacks.</description></rule></rules></selectionEntry><selectionEntry id="r89-we-angron-special-rules-6-primarch-retinue" name="Primarch Retinue" type="upgrade" hidden="false" import="true" defaultAmount="1"><costs><cost name="Points" typeId="pts" value="0" /></costs><constraints><constraint id="r89-we-angron-special-rules-6-primarch-retinue-min" type="min" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /><constraint id="r89-we-angron-special-rules-6-primarch-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="r89-we-angron-special-rules-6-primarch-retinue-rule" name="Primarch Retinue" hidden="false"><description>Angron may select one Legion Honour Guard Squad, Legion Terminator Command Squad or Devourer Terminator Squad as his Primarch Retinue. It does not occupy an additional Force Organisation selection and follows the normal Primarch Retinue rules.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue" name="RETINUE — choose up to one (no separate FOC slot)" hidden="false" collective="false" import="true"><constraints><constraint id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="unit" name="Legion Honour Guard Squad" id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour" hidden="false" import="true">
              <constraints>
                <constraint id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour-ret-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints>
              <costs>
                <cost name="Points" typeId="pts" value="55" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour-std" hidden="false">
                  <description>Every model wears Artificer Armour and carries a Refractor Field, Power Weapon, Bolt Pistol and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Honour or Death" id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour-hod" hidden="false">
                  <description>If the Legion Champion is in base contact with one or more enemy Independent Characters, he must direct all of his close-combat attacks against one of them. When attacking an enemy Independent Character in close combat, he may re-roll failed To Hit and To Wound rolls.</description>
                </rule>
                <rule name="Retinue" id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour-ret" hidden="false">
                  <description>Selected for an eligible Praetor or Primarch. It occupies no separate Force Organisation slot; the commander and Honour Guard count as a single HQ selection but do not have to deploy together and operate as separate units after deployment.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Legion Champion" id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour-champ" hidden="false" import="true" defaultAmount="1">
                  <constraints>
                    <constraint id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour-champ-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="live-r3-we-r41-unit-xii-12-xii-angron-the-red-angel-retinue-0-hq-praetor-ret-honour-champ-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
