                <selectionEntry id="r79-ih-autek-termcommand-r73-nl-bj-11" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  <constraints>
                    <constraint id="r79-ih-autek-termcommand-r73-nl-bj-11-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </constraints>
                  <rules>
                    <rule id="r79-ih-autek-termcommand-r73-nl-bj-11-rule" name="Beyond Judgement" hidden="false">
                      <description>Under Horror Cult this unit purchases Beyond Judgement for +25 points. Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model; multiple Trophies penalties remain non-cumulative.</description>
                    </rule>
                  </rules>
                  <modifiers>
                    <modifier id="r79-ih-autek-termcommand-r73-nl-bj-11-show" type="set" value="false" field="hidden">
                      <conditionGroups>
