            <selectionEntry type="upgrade" name="Auxiliary Drive" id="r35-breakthrough-predator-hs-pred-up-auxiliary-drive" hidden="false" import="true">
              <constraints>
                <constraint id="r35-breakthrough-predator-hs-pred-up-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="2" field="hs-pred-up-auxiliary-drive-max">
                  <conditions>
                    <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
                <modifier type="set" value="3" field="hs-pred-up-auxiliary-drive-max">
                  <conditions>
                    <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <rules>
                <rule name="Auxiliary Drive" id="r35-breakthrough-predator-hs-pred-up-auxiliary-drive-rule" hidden="false">
                  <description>At the start of the controlling player's Movement phase, if the vehicle is Immobilised, roll a D6. On a 4+, remove one Immobilised result; it may move normally that phase.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Armoured Ceramite" id="r35-breakthrough-predator-hs-pred-up-armoured-ceramite" hidden="false" import="true">
