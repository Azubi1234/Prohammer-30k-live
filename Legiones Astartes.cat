        <profile name="Fulmentarus Decurion" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xiii-1-fulmentarus-terminator-squad-profile-1">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
