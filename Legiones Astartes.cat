        <selectionEntryGroup id="r52-destroyer-unit-third-shrieker" name="3rd Company Elite — Sonic Assault" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="r52-destroyer-unit-third-shrieker-model" name="Sonic Shrieker — select once per model in the unit" type="upgrade" hidden="false" import="true">
