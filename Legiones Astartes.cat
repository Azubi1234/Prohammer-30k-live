      <rules>
        <rule id="r52-ec-third-kako-r52-ec-ka-rule-0" name="Fearless" hidden="false">
          <description>This unit is Fearless.</description>
        </rule>
        <rule id="r52-ec-third-kako-r52-ec-ka-rule-1" name="Cacophony" hidden="false">
          <description>If an enemy unit suffers one or more casualties from shooting attacks made by this squad, it must take a Pinning test after the squad has finished firing.</description>
        </rule>
        <rule id="r52-ec-third-kako-r52-ec-ka-traitor" name="Traitor Only" hidden="false">
          <description>Kakophoni may only be selected in a Traitor Emperor's Children army.</description>
        </rule>
        <rule id="r52-ec-third-kako-relentless" name="Relentless" hidden="false">
          <description>CHOSEN OF VAIROSEAN: Kakophoni in a 3rd Company Elite Detachment gain Relentless. This Troops entry may fulfil compulsory Troops selections.</description>
        </rule>
      </rules>
