        <profile id="r63-sw-russ-scorn-profile" name="Scornspitter" hidden="false" typeId="prof-ranged" typeName="Ranged Weapon">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
            <characteristic name="S" typeId="ranged-s">4</characteristic>
