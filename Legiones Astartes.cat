        <entryLink id="r71-nl-kraken-4" name="Kraken Light Bolts" type="selectionEntry" targetId="r44-nl-kraken-bolts" hidden="false" import="true">
          <constraints>
            <constraint id="r71-nl-kraken-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
