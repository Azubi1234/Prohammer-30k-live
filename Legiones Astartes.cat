              <selectionEntries>
                <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile" hidden="false" import="true">
                  <constraints>
                    <constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile-" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
