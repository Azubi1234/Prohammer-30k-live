          <selectionEntries>
            <selectionEntry type="model" name="Land Raider Phobos (10 models or fewer)" id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r40-da-steel-transport-fa-seeker-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos" hidden="false" import="true">
              <constraints>
                <constraint id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r40-da-steel-transport-fa-seeker-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="250" />
              </costs>
              <profiles>
                <profile name="Land Raider Phobos" id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r40-da-steel-transport-fa-seeker-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                  <characteristics>
                    <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                    <characteristic name="Front" typeId="vehicle-front">14</characteristic>
                    <characteristic name="Side" typeId="vehicle-side">14</characteristic>
                    <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="live-r2-r41-unit-xx-7-ingo-pech-retinue-3-r40-da-steel-transport-fa-seeker-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-rite-size" name="Armoured Assault" hidden="false">
                  <description>Select Phobos/Proteus only for an Ironwing Infantry unit of 10 models or fewer; select the Spartan only for an Ironwing Infantry unit of 11–20 models. Normal Transport Capacity restrictions apply.</description>
                </rule>
