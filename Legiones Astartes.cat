          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="force" childId="r25-rite-xx-0-the-coils-of-the-hydra" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Wolf Scout" typeId="prof-model" typeName="Model" hidden="false" id="r46-al-reward-11-r41-unit-vi-2-wolf-scout-squad-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
