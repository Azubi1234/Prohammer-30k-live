                  <rules>
                    <rule name="Hunter-Killer Missile" id="r74-ba-rev-vet-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-hunter-killer-missile-rule" hidden="false">
                      <description>Unlimited range, S8 AP3, Heavy 1, One Use.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Dozer Blade" id="r74-ba-rev-vet-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-dozer-blade" hidden="false" import="true">
                  <constraints>
                    <constraint id="r74-ba-rev-vet-r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
