              <costs>
                <cost name="Points" typeId="pts" value="5" id="r57-tactical-unit-iw-shrapnel-pts" />
              </costs>
              <rules>
                <rule id="r57-tactical-unit-iw-shrapnel-rule" name="Shrapnel Bolts" hidden="false">
                  <description>Bolt Pistols, Bolters, Combi-Bolters, Storm Bolters, Heavy Bolters, Twin-linked Bolters and bolter components of Combi-Weapons carried by models in this unit gain Pinning. May not be combined with Special Issue Ammunition, Hellfire Rounds or another special ammunition type.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r57-tactical-unit-iw-servo" name="Servo-Arm" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r57-tactical-unit-iw-servo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
