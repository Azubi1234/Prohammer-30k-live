    <selectionEntry type="unit" import="true" name="Legion Terminator Squad" hidden="true" id="r35-pride-terminator-terminator-unit">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="r35-pride-terminator-cat" primary="true" name="Troops" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Standard Wargear" id="r35-pride-terminator-terminator-standard" hidden="false">
          <description>Every model is equipped with the selected Terminator Armour pattern, a Combi-bolter and a Power Weapon unless replaced below.</description>
        </rule>
        <rule name="Legiones Astartes" id="r35-pride-terminator-terminator-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Implacable Advance" id="r35-pride-terminator-terminator-implacable" hidden="false">
          <description>In any mission which distinguishes between Scoring and non-Scoring units, a Legion Terminator Squad counts as a Scoring Unit whenever Troops choices normally count as Scoring Units.</description>
        </rule>
        <rule name="Dedicated Transport" id="r35-pride-terminator-terminator-transport-rule" hidden="false">
          <description>The squad may select a Land Raider, a Land Raider variant with sufficient Transport Capacity, a Dreadclaw Drop Pod or a Spartan Assault Tank where permitted. A Dreadclaw can carry only five models in Terminator Armour, so it is selectable here only for a five-model squad. Land Raider and Spartan choices will become selectable when their vehicle entries are added.</description>
        </rule>
        <rule name="Rite of War Selection" id="r35-pride-terminator-note" hidden="false">
          <description>This Troops entry is available while Pride of the Legion is selected.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Terminators" hidden="false" id="r35-pride-terminator-terminator-included" defaultAmount="4">
          <constraints>
            <constraint id="r35-pride-terminator-terminator-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r35-pride-terminator-terminator-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminators (included)" id="r35-pride-terminator-terminator-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Points" typeId="pts" value="30" />
          </costs>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Terminator Sergeant" hidden="false" id="r35-pride-terminator-terminator-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="r35-pride-terminator-terminator-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="r35-pride-terminator-terminator-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminator Sergeant" id="r35-pride-terminator-terminator-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry id="r37-orbital-teleport-r35-pride-terminator-terminator-unit" name="Teleport Assault (Orbital Assault)" type="upgrade" hidden="true" import="true">
          <constraints>
            <constraint id="r37-orbital-teleport-r35-pride-terminator-terminator-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <rules>
            <rule name="Teleport Assault" id="r37-orbital-teleport-r35-pride-terminator-terminator-unit-rule" hidden="false">
              <description>A unit composed entirely of models wearing Terminator Armour or Cataphractii Terminator Armour may deploy using Deep Strike even if the mission would not normally permit Deep Strike.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-orbital" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry id="r71-nl-bj-13" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r71-nl-bj-13-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r71-nl-bj-13-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r71-nl-bj-13-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="Points" typeId="pts" value="55" />
      </costs>
      <selectionEntryGroups>
        <selectionEntryGroup name="Terminator Armour Pattern (entire squad)" id="r35-pride-terminator-terminator-armour-pattern" hidden="false">
          <constraints>
            <constraint id="r35-pride-terminator-terminator-armour-pattern-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="r35-pride-terminator-terminator-armour-pattern-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Terminator Armour" hidden="false" id="r35-pride-terminator-terminator-armour-normal" defaultAmount="1">
              <constraints>
                <constraint id="r35-pride-terminator-terminator-armour-normal-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Terminator Armour" id="r35-pride-terminator-terminator-armour-normal-rule" hidden="false">
                  <description>2+ Armour Save, 5+ Invulnerable Save; Relentless, Bulky, Deep Strike; may not Pursue. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tartaros Terminator Armour" hidden="false" id="r35-pride-terminator-terminator-armour-tartaros">
              <constraints>
                <constraint id="r35-pride-terminator-terminator-armour-tartaros-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Tartaros Terminator Armour" id="r35-pride-terminator-terminator-armour-tartaros-rule" hidden="false">
                  <description>2+ Armour Save, 5+ Invulnerable Save; Relentless, Bulky, Deep Strike; may Pursue. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Cataphractii Terminator Armour" hidden="false" id="r35-pride-terminator-terminator-armour-cataphractii">
              <constraints>
                <constraint id="r35-pride-terminator-terminator-armour-cataphractii-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Cataphractii Terminator Armour" id="r35-pride-terminator-terminator-armour-cataphractii-rule" hidden="false">
                  <description>2+ Armour Save, 4+ Invulnerable Save; Relentless, Bulky, Deep Strike; may not Advance, Pursue or fire Overwatch. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Ranged Weapon Replacements" id="r35-pride-terminator-terminator-ranged" hidden="false">
          <constraints>
            <constraint id="r35-pride-terminator-terminator-ranged-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier type="increment" value="1" field="terminator-ranged-max">
              <repeats>
                <repeat value="5" repeats="1" field="selections" scope="root-entry" childId="r35-pride-terminator-terminator-included" shared="true" roundUp="false" includeChildSelections="false" />
              </repeats>
            </modifier>
            <modifier type="increment" value="-1" field="terminator-ranged-max">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r35-pride-terminator-terminator-pair-claws" shared="true" roundUp="false" includeChildSelections="true" />
              </repeats>
            </modifier>
            <modifier type="increment" value="-1" field="terminator-ranged-max">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r35-pride-terminator-terminator-h-hf" shared="true" roundUp="false" includeChildSelections="true" />
              </repeats>
            </modifier>
            <modifier type="increment" value="-1" field="terminator-ranged-max">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r35-pride-terminator-terminator-h-ra" shared="true" roundUp="false" includeChildSelections="true" />
              </repeats>
            </modifier>
            <modifier type="increment" value="-1" field="terminator-ranged-max">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r35-pride-terminator-terminator-h-pb" shared="true" roundUp="false" includeChildSelections="true" />
              </repeats>
            </modifier>
            <modifier type="increment" value="-1" field="terminator-ranged-max">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r35-pride-terminator-terminator-h-ac" shared="true" roundUp="false" includeChildSelections="true" />
              </repeats>
            </modifier>
          </modifiers>
          <entryLinks>
            <entryLink import="true" name="Storm Bolter (replaces Combi-bolter)" hidden="false" id="r35-pride-terminator-terminator-r-sb" type="selectionEntry" targetId="gear-storm-bolter">
              <constraints>
                <constraint id="r35-pride-terminator-terminator-r-sb-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
            </entryLink>
            <entryLink import="true" name="Foeblaster Boltgun (replaces Combi-bolter)" hidden="false" id="r35-pride-terminator-terminator-r-foe" type="selectionEntry" targetId="gear-foeblaster">
              <constraints>
                <constraint id="r35-pride-terminator-terminator-r-foe-max" type="max" value="10" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
            </entryLink>
