        <selectionEntry id="r64-if-templar-nuncio" name="Nuncio-vox" type="upgrade" hidden="false" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="10" />
          </costs>
          <constraints>
            <constraint id="r64-if-templar-nuncio-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
