                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Barrage Bomb" id="hq-consul-signals-orb-barrage" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-signals-orb-barrage-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="30" />
                      </costs>
                      <profiles>
                        <profile name="Barrage Bomb" id="hq-consul-signals-orb-barrage-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Special</characteristic>
                            <characteristic name="S" typeId="ranged-s">6</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Blast</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-144" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                  </selectionEntries>
                  <rules>
                    <rule name="Orbital Bombardment" id="hq-consul-signals-orb-rule" hidden="false">
                      <description>After deployment zones are determined but before either army deploys, nominate one terrain feature. The bombardment begins in Reserve and its controlling player may choose not to roll for it. Once available, it strikes in every subsequent friendly Shooting phase. Place the Blast marker anywhere within the nominated terrain. Scatter normally; an arrow doubles the distance, while a Hit still scatters the rolled distance along the small arrow. The attack counts as Ordnance Barrage and causes Pinning.</description>
                    </rule>
                  </rules>
                </selectionEntryGroup>
                <selectionEntryGroup name="Dedicated Transport" id="hq-consul-signals-dt" hidden="false">
                  <constraints>
                    <constraint id="hq-consul-signals-dt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="unit" name="Damocles Command Rhino" id="hq-consul-signals-damocles" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-signals-damocles-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="100" />
                      </costs>
                      <profiles>
                        <profile name="Damocles Command Rhino" id="hq-consul-signals-damocles-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                          <characteristics>
                            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                            <characteristic name="Front" typeId="vehicle-front">11</characteristic>
                            <characteristic name="Side" typeId="vehicle-side">11</characteristic>
                            <characteristic name="Rear" typeId="vehicle-rear">11</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="Focused Bombardment" id="hq-consul-signals-damocles-bomb" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Unlimited</characteristic>
                            <characteristic name="S" typeId="ranged-s">8</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">3</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast, Barrage, Lance, Twin-linked</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Standard Wargear &amp; Transport" id="hq-consul-signals-damocles-std" hidden="false">
                          <description>Vehicle (Tank). Twin-linked Bolter, Searchlight and Smoke Launchers. Transport Capacity 6. No Fire Points. One Access Point on each side and one at the rear.</description>
                        </rule>
                        <rule name="Geo-Locator Beacon" id="hq-consul-signals-damocles-geo" hidden="false">
                          <description>Friendly units arriving by Deep Strike do not scatter if their first model is placed within 24" of the Damocles and otherwise has a legal deployment position.</description>
                        </rule>
                        <rule name="Command Vox Relay" id="hq-consul-signals-damocles-relay" hidden="false">
                          <description>While the Damocles is on the battlefield, its controlling player may apply either +1 or -1 to any of their Reserve rolls.</description>
                        </rule>
                        <rule name="Command Vehicle" id="hq-consul-signals-damocles-command" hidden="false">
                          <description>0–1 Damocles Command Rhino may be selected as a non-compulsory HQ choice in an army of at least 1,000 points. Alternatively, a Master of Signals may select one as a Dedicated Transport.</description>
                        </rule>
                        <rule name="Focused Bombardment" id="hq-consul-signals-damocles-bombrule" hidden="false">
                          <description>Once per battle, provided the Damocles did not move that turn, it may fire the Focused Bombardment profile.</description>
                        </rule>
                      </rules>
                      <selectionEntryGroups>
                        <selectionEntryGroup name="Legion Vehicle Armoury" id="hq-consul-signals-damocles-upgrades" hidden="false">
                          <selectionEntries>
                            <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hq-consul-signals-dam-vu-0" hidden="false" import="true">
