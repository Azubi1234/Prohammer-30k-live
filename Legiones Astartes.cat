        <categoryLink id="r81-ih-bitter-role-r80-ih-bitter-imm-cat" name="Company of Bitter Iron — compulsory Medusan Immortal" hidden="false" targetId="r80-ih-bitter-comp" primary="false" />
        <categoryLink id="r81-ih-bitter-comp-cat" name="Company of Bitter Iron — compulsory Immortal" hidden="true" targetId="r81-ih-bitter-comp" primary="false" />
      </categoryLinks>
      <rules>
        <rule id="r81-ih-bitter-role-r79-ih-rule-r41-unit-x-0-medusan-immortal-squad-legiones-astartes-iron-hands" name="Legiones Astartes (Iron Hands)" hidden="false">
          <description>This model belongs to the X Legion and is affected by rules and effects which refer to Legiones Astartes (Iron Hands).</description>
        </rule>
        <rule id="r81-ih-bitter-role-r79-ih-rule-r41-unit-x-0-medusan-immortal-squad-stubborn" name="Stubborn" hidden="false">
          <description>Uses the normal ProHammer Stubborn special rule.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Options" hidden="false" id="r81-ih-bitter-role-r41-unit-x-0-medusan-immortal-squad-options" collective="false" import="true">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Flamer" hidden="false" id="r81-ih-bitter-role-r41-unit-x-0-medusan-immortal-squad-opt-0-flamer">
              <constraints>
                <constraint id="r81-ih-bitter-role-r41-unit-x-0-medusan-immortal-squad-opt-0-flamer-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <rules>
                <rule name="Option restriction" id="r81-ih-bitter-role-r41-unit-x-0-medusan-immortal-squad-opt-0-context" hidden="false">
                  <description>replace his Bolter with:</description>
                </rule>
