                            <rule name="Hunter-Killer Missile" id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-hunter-killer-missile-rule" hidden="false">
                              <description>Unlimited range, S8 AP3, Heavy 1, One Use.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Dozer Blade" id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-dozer-blade" hidden="false" import="true">
                          <constraints>
                            <constraint id="r63-sw-varagyr-transport-lr-hs-lr-ph-up-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <modifiers>
                            <modifier type="set" value="2" field="r63-sw-varagyr-transport-lr-hs-lr-ph-up-dozer-blade-max">
                              <conditions>
                                <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r63-sw-varagyr-transport-lr-hs-lr-phobos" shared="true" includeChildSelections="true" />
                              </conditions>
                            </modifier>
                            <modifier type="set" value="3" field="r63-sw-varagyr-transport-lr-hs-lr-ph-up-dozer-blade-max">
