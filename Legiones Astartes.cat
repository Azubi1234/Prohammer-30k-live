                  <constraints>
                    <constraint id="r60-ws-hibou-retinue-legion-veteran-squad-da-wing-veteran-unit-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
                    <constraint id="r60-ws-hibou-retinue-legion-veteran-squad-da-wing-veteran-unit-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
