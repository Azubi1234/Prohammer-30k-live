    <selectionEntry type="unit" import="true" name="EZEKYLE ABADDON, FIRST CAPTAIN" hidden="false" id="r41-unit-xvi-4-ezekyle-abaddon-first-captain">
      <costs>
        <cost name="Points" typeId="pts" value="210" />
      </costs>
      <categoryLinks>
        <categoryLink id="r41-unit-xvi-4-ezekyle-abaddon-first-captain-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" />
      </categoryLinks>
