                              </costs>
                              <rules>
                                <rule name="Auxiliary Drive" id="hq-consul-signals-dam-vu-3-r" hidden="false">
                                  <description>If Immobilised at the start of the controlling player's Movement phase, roll a D6; on 4+ remove one Immobilised result and the vehicle may move normally that phase.</description>
