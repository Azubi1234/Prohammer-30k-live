            <entryLink id="r37-orbital-dreadnought-transport-dreadclaw" name="Anvillus Pattern Dreadclaw Drop Pod (Orbital Assault)" type="selectionEntry" targetId="transport-dreadclaw" hidden="true" import="true">
              <constraints>
