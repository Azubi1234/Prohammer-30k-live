<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="cat-7b24-e6f1-83a9-4c50" name="Legiones Astartes" revision="3" battleScribeVersion="2.03" library="false" gameSystemId="sys-6f3a-91d2-b47c-5e08" gameSystemRevision="1" type="catalogue">
  <comment>Revision 90: World Eaters character cleanup verified; forced full New Recruit refresh by bumping both catalogue and game-system revisions. Gahlan Surlak capitalization corrected.</comment>
  <readme>Core Legiones Astartes catalogue for Prohammer 30k. Revision 32 includes the generic Legion army list and Consuls, Dark Angels package, Legiones Astartes Lords of War, and Legiones Astartes Aeronautica Imperialis aircraft. Experimental Wargear and Units remains excluded.</readme>
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="Bolter" hidden="false" id="gear-bolter">
      <profiles>
        <profile name="Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-bolter">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">24"</characteristic>
            <characteristic name="S" typeId="ranged-s">4</characteristic>
            <characteristic name="AP" typeId="ranged-ap">5</characteristic>
            <characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic>
          </characteristics>
        </profile>
