                      </constraints>
                      <rules>
                        <rule id="r71-nl-mal-ret-1-r45-cult-veteran-unit-0-rule" name="Pavoni" hidden="false">
                          <description>Fleet; Psykers/Psychic Brotherhoods also gain Crusader.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry id="r71-nl-mal-ret-1-r45-cult-veteran-unit-1" name="Raptora" type="upgrade" hidden="false" import="true">
                      <constraints>
                        <constraint id="r71-nl-mal-ret-1-r45-cult-veteran-unit-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
                      <rules>
                        <rule id="r71-nl-mal-ret-1-r45-cult-veteran-unit-1-rule" name="Raptora" hidden="false">
                          <description>6+ invulnerable save against shooting; Psychic Mastery improves this to 5+ (or improves an existing invulnerable save by 1 to max 4+) and improves cover by 1 to max 3+.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry id="r71-nl-mal-ret-1-r45-cult-veteran-unit-2" name="Corvidae" type="upgrade" hidden="false" import="true">
                      <constraints>
                        <constraint id="r71-nl-mal-ret-1-r45-cult-veteran-unit-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
                      <rules>
                        <rule id="r71-nl-mal-ret-1-r45-cult-veteran-unit-2-rule" name="Corvidae" hidden="false">
                          <description>Re-roll To Hit rolls of 1 on First Fire; Psychic Mastery also applies to Overwatch, Return Fire and Stand &amp; Shoot.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry id="r71-nl-mal-ret-1-r45-cult-veteran-unit-3" name="Athanaeans" type="upgrade" hidden="false" import="true">
                      <constraints>
