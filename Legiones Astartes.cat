    <selectionEntry type="unit" import="true" name="Rogal Dorn — The Praetorian of Terra" hidden="false" id="r41-unit-vii-9-vii-rogal-dorn-the-praetorian-of-terra">
      <categoryLinks>
        <categoryLink id="r41-unit-vii-9-vii-rogal-dorn-the-praetorian-of-terra-cat" name="Lords of War" hidden="false" targetId="cat-low" primary="true" />
        <categoryLink id="r67-if-dorn-templar-warlord-cat" name="Templar Assault — Warlord with qualifying melee weapon" hidden="true" targetId="r66-if-cat-templar-warlord" primary="false" />
      </categoryLinks>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
        <modifier id="r64-if-r41-unit-vii-9-vii-rogal-dorn-the-praetorian-of-terra-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
        <modifier id="r67-if-dorn-base-legion" type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
