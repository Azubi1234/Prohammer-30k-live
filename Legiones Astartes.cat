                <rule id="r64-if-praetor-huscarl-r64-if-huscarl-comp" name="Unit Composition" hidden="false">
                  <description>4 Huscarls and 1 Huscarl Captain; may include up to five additional Huscarls. The Huscarl Captain is a Character.</description>
                </rule>
                <rule id="r64-if-praetor-huscarl-r64-if-huscarl-wg" name="Wargear" hidden="false">
                  <description>Cataphractii Terminator Armour, Combi-bolter and Power Weapon.</description>
                </rule>
                <rule id="r64-if-praetor-huscarl-r64-if-huscarl-special" name="Special Rules" hidden="false">
                  <description>Legiones Astartes (Imperial Fists), Stubborn, Retinue.</description>
                </rule>
                <rule id="r64-if-praetor-huscarl-r64-if-huscarl-retinue" name="Retinue" hidden="false">
                  <description>One Huscarl Terminator Retinue may be selected for Rogal Dorn, Sigismund or an Imperial Fists Praetor wearing Terminator Armour. The squad does not occupy a separate Force Organisation slot.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup id="r64-if-praetor-huscarl-r64-if-huscarl-ranged" name="Combi-bolter Replacements — any Huscarl" hidden="false" collective="false" import="true">
