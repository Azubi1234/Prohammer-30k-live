      <selectionEntryGroups>
        <selectionEntryGroup id="r79-ih-ferrus-honour-group" name="Retinue (does not occupy a separate FOC slot)" hidden="false">
          <constraints>
            <constraint id="r79-ih-ferrus-honour-group-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Honour Guard Squad" id="r79-ih-ferrus-honour-hq-praetor-ret-honour" hidden="false" import="true">
              <constraints>
                <constraint id="r79-ih-ferrus-honour-hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="55" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r79-ih-ferrus-honour-hq-praetor-ret-honour-std" hidden="false">
                  <description>Every model wears Artificer Armour and carries a Refractor Field, Power Weapon, Bolt Pistol and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="r79-ih-ferrus-honour-hq-praetor-ret-honour-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Honour or Death" id="r79-ih-ferrus-honour-hq-praetor-ret-honour-hod" hidden="false">
                  <description>If the Legion Champion is in base contact with one or more enemy Independent Characters, he must direct all of his close-combat attacks against one of them. When attacking an enemy Independent Character in close combat, he may re-roll failed To Hit and To Wound rolls.</description>
                </rule>
                <rule name="Retinue" id="r79-ih-ferrus-honour-hq-praetor-ret-honour-ret" hidden="false">
                  <description>Selected for an eligible Praetor or Primarch. It occupies no separate Force Organisation slot; the commander and Honour Guard count as a single HQ selection but do not have to deploy together and operate as separate units after deployment.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Legion Champion" id="r79-ih-ferrus-honour-hq-praetor-ret-honour-champ" hidden="false" import="true" defaultAmount="1">
                  <constraints>
                    <constraint id="r79-ih-ferrus-honour-hq-praetor-ret-honour-champ-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r79-ih-ferrus-honour-hq-praetor-ret-honour-champ-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Champion" id="r79-ih-ferrus-honour-hq-praetor-ret-honour-champ-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">6</characteristic>
