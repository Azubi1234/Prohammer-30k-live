                    <entryLink import="true" name="Cataphractii Terminator Armour" id="r40-da-storm-centurion-group-r40-da-storm-tactical-hq-centurion-cat" type="selectionEntry" targetId="gear-hq-cataphractii" hidden="false">
                      <constraints>
                        <constraint id="r40-da-storm-centurion-group-r40-da-storm-tactical-hq-centurion-cat-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
