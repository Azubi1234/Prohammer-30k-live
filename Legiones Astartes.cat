                <rule id="r60-ws-bike-troops-r60-fa-bike-warlance-rule" name="Chogorian Warlance" hidden="false">
                  <description>Power Weapon, Cavalry Lance. +1 Initiative in the first round when charging; -1 Initiative in rounds in which the bearer did not charge. One-handed.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
