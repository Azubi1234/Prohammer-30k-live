                <entryLink import="true" name="Rad Grenades" hidden="false" id="techmarine-I-rad" type="selectionEntry" targetId="gear-rad-grenades">
                  <constraints>
                    <constraint id="techmarine-I-rad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Krak Grenades" hidden="false" id="techmarine-I-krak" type="selectionEntry" targetId="gear-krak">
                  <constraints>
                    <constraint id="techmarine-I-krak-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="2" />
                  </costs>
                </entryLink>
              </entryLinks>
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="techmarine-I-signum">
                  <constraints>
                    <constraint id="techmarine-I-signum-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <rules>
                    <rule name="Signum" id="techmarine-I-signum-rule" hidden="false">
                      <description>Once during each friendly Shooting phase, a unit containing a Signum may re-roll one failed To Hit roll made with a shooting weapon. A unit may benefit from only one Signum each Shooting phase.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Space Marine Bike" hidden="false" id="techmarine-I-bike">
                  <constraints>
                    <constraint id="techmarine-I-bike-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="35" />
                  </costs>
                  <rules>
                    <rule name="Space Marine Bike" id="techmarine-I-bike-rule" hidden="false">
                      <description>The model becomes Bike and the bike is armed with twin-linked bolters.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
            <selectionEntryGroup name="Bolt Pistol Replacement" id="techmarine-I-pistol" hidden="false">
              <constraints>
                <constraint id="techmarine-I-pistol-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
              </constraints>
              <entryLinks>
                <entryLink import="true" name="Volkite Serpenta" hidden="false" id="techmarine-I-vs" type="selectionEntry" targetId="gear-volkite-serpenta">
                  <constraints>
                    <constraint id="techmarine-I-vs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
