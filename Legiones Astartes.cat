    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Tactical Squad — Hammer Compulsory" hidden="true" id="r57-iw-hammer-tactical">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="r57-iw-hammer-tactical-tactical-cat" primary="true" name="Troops" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Power Armour" id="r57-iw-hammer-tactical-tactical-power-armour" hidden="false">
          <description>Models wearing Power Armour have a 3+ Armour Save.</description>
        </rule>
        <rule name="Legiones Astartes" id="r57-iw-hammer-tactical-tactical-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Frag Grenades" id="r57-iw-hammer-tactical-tactical-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
        <rule name="Fury of the Legion" id="r57-iw-hammer-tactical-tactical-fury" hidden="false">
          <description>The squad may declare Fury of the Legion in its Shooting phase if it did not move in the preceding Movement phase, did not arrive from Reserves or Deep Strike or disembark that turn, and at least five models remain armed with Bolters or Bolt Pistols. Models armed with Bolters or Bolt Pistols may fire those weapons twice: a Bolter fires 2 shots up to 24" or 4 shots up to 12", and a Bolt Pistol fires 2 shots. All Fury attacks are directed at the same target unless another rule permits otherwise. After using Fury, the squad may not enter Overwatch, make Return Fire or Stand &amp; Shoot reactions, or fire during its next friendly Shooting phase.</description>
        </rule>
        <rule name="Automatic Basic Wargear" id="r57-iw-hammer-tactical-rev23-tactical-wargear-auto" hidden="false">
          <description>A Legion Tactical Squad begins with its listed basic wargear automatically. Squad-wide Chainsword purchases, Bolter-for-Chainsword exchanges and Krak Grenade purchases are selected once for the squad and their points scale with squad size; they are not selected model-by-model.</description>
        </rule>
        <rule id="r57-iw-hammer-tactical-rule" name="Compulsory Troops" hidden="false">
          <description>Use this version for one of the army’s compulsory Troops selections under The Hammer of Olympia.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Tactical Marine" hidden="false" id="r57-iw-hammer-tactical-tac-marine" defaultAmount="9">
          <constraints>
            <constraint type="min" value="9" field="selections" scope="parent" shared="true" id="r57-iw-hammer-tactical-tac-marine-min" includeChildSelections="false" />
            <constraint type="max" value="19" field="selections" scope="parent" shared="true" id="r57-iw-hammer-tactical-tac-marine-max" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <profiles>
            <profile name="Legion Tactical Marine" typeId="prof-model" typeName="Model" hidden="false" id="r57-iw-hammer-tactical-prof-tac-marine">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">8</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Tactical Sergeant" hidden="false" id="r57-iw-hammer-tactical-tac-sergeant" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-tactical-tac-sgt-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r57-iw-hammer-tactical-tac-sgt-max" includeChildSelections="false" automatic="true" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <profiles>
            <profile name="Legion Tactical Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r57-iw-hammer-tactical-prof-tac-sergeant">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
