                    <modifier id="live-r2-r42-role-xv-crimson-magnus-hq-r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-retinue-0-r71-nl-gen-9-stealth-cost-0" type="increment" value="1" field="pts">
