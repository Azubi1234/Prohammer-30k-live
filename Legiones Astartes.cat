                        <condition type="atLeast" value="1" field="selections" scope="parent" childId="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-sgt-melee" shared="true" includeChildSelections="true" />
                        <condition type="atLeast" value="1" field="selections" scope="parent" childId="live-r3-we-r41-unit-xii-7-shabran-darr-retinue-1-assault-sgt-armoury-weapons" shared="true" includeChildSelections="true" />
                      </conditions>
