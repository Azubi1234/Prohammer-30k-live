            <selectionEntryGroup name="Additional Sergeant Armoury (max 50 pts)" id="breacher-sgt-armoury" hidden="false">
              <constraints>
                <constraint type="max" value="50" field="pts" scope="parent" shared="true" id="breacher-sgt-armoury-pts-max" includeChildSelections="true" />
              </constraints>
              <selectionEntryGroups>
                <selectionEntryGroup name="Additional Armoury Weapon (replaces one carried weapon)" id="breacher-sgt-armoury-weapons" hidden="false">
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="breacher-sgt-armoury-weapons-max" includeChildSelections="true" />
                  </constraints>
                  <selectionEntryGroups>
                    <selectionEntryGroup name="Single-Handed Weapons" id="breacher-sgt-armoury-single" hidden="false">
                      <constraints>
                        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="breacher-sgt-armoury-single-max" includeChildSelections="false" />
                      </constraints>
                      <entryLinks>
