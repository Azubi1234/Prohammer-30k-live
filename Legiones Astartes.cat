        <selectionEntry id="r66-if-praetor-templar-warlord" name="Designate as Templar Assault Warlord" type="upgrade" hidden="true" import="true">
          <constraints>
            <constraint id="r66-if-praetor-templar-warlord-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="0" />
