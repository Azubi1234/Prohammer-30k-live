              <constraints>
                <constraint id="hs-hss-hw-5-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="30" />
              </costs>
            </entryLink>
            <entryLink name="Lascannon (replaces Bolter)" id="hs-hss-hw-6" type="selectionEntry" targetId="gear-lascannon" hidden="false" import="true">
              <constraints>
                <constraint id="hs-hss-hw-6-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
