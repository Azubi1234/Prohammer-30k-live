                              <description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Flare Shield" id="r71-nl-curze-ret-1-r71-nl-atramentar-transport-spartan-hs-spartan-flare-shield" hidden="false" import="true">
                          <constraints>
                            <constraint id="r71-nl-curze-ret-1-r71-nl-atramentar-transport-spartan-hs-spartan-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
