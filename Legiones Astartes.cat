          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Flamer" hidden="false" id="r46-al-reward-47-r41-unit-xvi-1-reaver-attack-squad-opt-0-flamer">
              <constraints>
                <constraint id="r46-al-reward-47-r41-unit-xvi-1-reaver-attack-squad-opt-0-flamer-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
