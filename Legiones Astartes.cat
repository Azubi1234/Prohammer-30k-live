        <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter" collective="false" import="true">
          <constraints>
            <constraint id="r35-sky-troops-da-wing-fa-sky-hunter-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="r35-sky-troops-da-wing-fa-sky-hunter-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" value="1" field="da-wing-fa-sky-hunter-min">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-0">
              <constraints>
                <constraint id="r35-sky-troops-da-wing-fa-sky-hunter-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Stormwing" id="r35-sky-troops-da-wing-fa-sky-hunter-0-rule" hidden="false">
                  <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-1">
              <constraints>
                <constraint id="r35-sky-troops-da-wing-fa-sky-hunter-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Deathwing" id="r35-sky-troops-da-wing-fa-sky-hunter-1-rule" hidden="false">
                  <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-2">
              <constraints>
                <constraint id="r35-sky-troops-da-wing-fa-sky-hunter-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Dreadwing" id="r35-sky-troops-da-wing-fa-sky-hunter-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-3">
              <constraints>
                <constraint id="r35-sky-troops-da-wing-fa-sky-hunter-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ironwing" id="r35-sky-troops-da-wing-fa-sky-hunter-3-rule" hidden="false">
                  <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-4">
              <constraints>
                <constraint id="r35-sky-troops-da-wing-fa-sky-hunter-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="r35-sky-troops-da-wing-fa-sky-hunter-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-5">
              <constraints>
                <constraint id="r35-sky-troops-da-wing-fa-sky-hunter-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="r35-sky-troops-da-wing-fa-sky-hunter-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <modifiers>
        <modifier type="set" value="false" field="hidden">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" />
          </conditions>
        </modifier>
      </modifiers>
      <entryLinks>
        <entryLink id="r40-da-forward-r35-sky-troops-fa-sky-hunter" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true">
          <constraints>
            <constraint id="r40-da-forward-r35-sky-troops-fa-sky-hunter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" />
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-serpent" shared="true" includeChildSelections="true" />
                    <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-sky-troops-da-wing-fa-sky-hunter-4" shared="true" includeChildSelections="true" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </entryLink>
      </entryLinks>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Tactical Squad (Storm of War compulsory)" hidden="true" id="r40-da-storm-tactical">
      <rules>
        <rule name="Power Armour" id="r40-da-storm-tactical-tactical-power-armour" hidden="false">
          <description>Models wearing Power Armour have a 3+ Armour Save.</description>
        </rule>
        <rule name="Legiones Astartes" id="r40-da-storm-tactical-tactical-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Frag Grenades" id="r40-da-storm-tactical-tactical-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
        <rule name="Fury of the Legion" id="r40-da-storm-tactical-tactical-fury" hidden="false">
          <description>The squad may declare Fury of the Legion in its Shooting phase if it did not move in the preceding Movement phase, did not arrive from Reserves or Deep Strike or disembark that turn, and at least five models remain armed with Bolters or Bolt Pistols. Models armed with Bolters or Bolt Pistols may fire those weapons twice: a Bolter fires 2 shots up to 24" or 4 shots up to 12", and a Bolt Pistol fires 2 shots. All Fury attacks are directed at the same target unless another rule permits otherwise. After using Fury, the squad may not enter Overwatch, make Return Fire or Stand &amp; Shoot reactions, or fire during its next friendly Shooting phase.</description>
        </rule>
        <rule name="Automatic Basic Wargear" id="r40-da-storm-tactical-rev23-tactical-wargear-auto" hidden="false">
          <description>A Legion Tactical Squad begins with its listed basic wargear automatically. Squad-wide Chainsword purchases, Bolter-for-Chainsword exchanges and Krak Grenade purchases are selected once for the squad and their points scale with squad size; they are not selected model-by-model.</description>
        </rule>
        <rule id="r40-da-storm-tactical-rite-rule" name="Storm of War — Compulsory Formation" hidden="false">
          <description>This Rite-specific entry represents a compulsory 20-model Stormwing Tactical Squad. It may not select a Dedicated Transport.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Tactical Marine" hidden="false" id="r40-da-storm-tactical-tac-marine" defaultAmount="9">
          <constraints>
            <constraint type="min" value="9" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-tac-marine-min" includeChildSelections="false" />
            <constraint type="max" value="19" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-tac-marine-max" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <profiles>
            <profile name="Legion Tactical Marine" typeId="prof-model" typeName="Model" hidden="false" id="r40-da-storm-tactical-prof-tac-marine">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
