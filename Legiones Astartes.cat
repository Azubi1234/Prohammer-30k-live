              </costs>
              <rules>
                <rule name="Siege Breaker" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-siegebreaker-rule" hidden="false">
                  <description>Art of Destruction: Heavy weapons fired by this unit receive +1 to Armour Penetration rolls against vehicles and fortifications. This does not apply to pistols, grenades or close-combat attacks.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
