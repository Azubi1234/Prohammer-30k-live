              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r71-nl-raptor-models" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
          </modifiers>
        </selectionEntry>
        <selectionEntry id="r71-nl-raptor-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="false" import="true">
          <costs>
