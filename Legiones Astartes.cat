      <profiles>
        <profile name="Lernaean Terminator" typeId="prof-model" typeName="Model" hidden="false" id="live-r2-r41-unit-xx-7-ingo-pech-retinue-2-r41-unit-xx-2-lernaean-terminator-squad-profile-0">
