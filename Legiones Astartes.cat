              <selectionEntryGroup id="live-r2-fabius-enhanced-r60-ws-hasik-retinue-legion-command-squad-group" name="Fabius Bile" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fabius-enhanced-r60-ws-hasik-retinue-legion-command-squad" name="Enhanced Warriors" type="upgrade" hidden="false" import="true"><constraints><constraint id="live-r2-fabius-enhanced-r60-ws-hasik-retinue-legion-command-squad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="live-r2-fabius-enhanced-r60-ws-hasik-retinue-legion-command-squad-scale-0" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r60-ws-hasik-retinue-legion-command-squad-hq-centurion-ret-command-vets" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r60-ws-hasik-retinue-legion-command-squad-scale-1" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r60-ws-hasik-retinue-legion-command-squad-hq-centurion-ret-command-land-land-raider-phobos" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r60-ws-hasik-retinue-legion-command-squad-scale-2" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r60-ws-hasik-retinue-legion-command-squad-hq-centurion-ret-command-land-land-raider-proteus" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r60-ws-hasik-retinue-legion-command-squad-scale-3" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r60-ws-hasik-retinue-legion-command-squad-hq-centurion-ret-command-land-land-raider-achilles" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r60-ws-hasik-retinue-legion-command-squad-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-7-fabius-bile" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><rules><rule id="live-r2-fabius-enhanced-r60-ws-hasik-retinue-legion-command-squad-rule" name="Enhanced Warriors" hidden="false"><description>This squad has been enhanced by Fabius Bile for +3 points per model. After deployment but before the first turn, roll a D6 for this squad: 1 — Berserk Rage: make an Armour Save for every model; remove each failure, and survivors gain +1 Strength. 2–5 — Stable Mutation: every model gains +1 Strength and +1 Initiative. 6 — Created a Monster: every model gains +1 Strength, +1 Initiative and +1 Attack; in missions using Victory Points, surviving models from the squad count as casualties when calculating Victory Points.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="live-r2-fulgrim-blessing-r60-ws-hasik-retinue-legion-command-squad-group" name="Special Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="live-r2-fulgrim-blessing-r60-ws-hasik-retinue-legion-command-squad" name="Blessing of Slaanesh" type="upgrade" hidden="false" import="true"><costs><cost name="Points" typeId="pts" value="25" /></costs><constraints><constraint id="live-r2-fulgrim-blessing-r60-ws-hasik-retinue-legion-command-squad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><rules><rule id="live-r2-fulgrim-blessing-r60-ws-hasik-retinue-legion-command-squad-rule" name="Blessing of Slaanesh" hidden="false"><description>Models with the Blessing of Slaanesh gain +1 Initiative. This bonus is cumulative with other Initiative modifiers.</description></rule></rules><modifiers><modifier id="live-r2-live-r2-fulgrim-blessing-r60-ws-hasik-retinue-legion-command-squad-hide" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r41-unit-iii-10-fulgrim-transfigured" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups>
            </selectionEntry>
            <selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="false" id="r60-ws-hasik-retinue-legion-veteran-squad">
              <rules>
                <rule name="Standard Wargear" id="r60-ws-hasik-retinue-legion-veteran-squad-veteran-standard" hidden="false">
                  <description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</description>
                </rule>
                <rule name="Legiones Astartes" id="r60-ws-hasik-retinue-legion-veteran-squad-veteran-legiones" hidden="false">
                  <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
                </rule>
                <rule name="Veteran Tactics" id="r60-ws-hasik-retinue-legion-veteran-squad-veteran-tactics-rule" hidden="false">
                  <description>When constructing the army, select one Veteran Tactic for this squad. The chosen ability applies to every model in the squad for the duration of the battle.</description>
                </rule>
                <rule name="Dedicated Transport" id="r60-ws-hasik-retinue-legion-veteran-squad-veteran-transport-rule" hidden="false">
                  <description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" import="true" name="Legion Veterans" hidden="false" id="r60-ws-hasik-retinue-legion-veteran-squad-veteran-included" defaultAmount="4">
                  <constraints>
                    <constraint id="r60-ws-hasik-retinue-legion-veteran-squad-veteran-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r60-ws-hasik-retinue-legion-veteran-squad-veteran-included-max" type="max" value="9" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                  </constraints>
                  <profiles>
                    <profile name="Legion Veterans (included)" id="r60-ws-hasik-retinue-legion-veteran-squad-veteran-included-prof" typeId="prof-model" typeName="Model" hidden="false">
                      <characteristics>
                        <characteristic name="WS" typeId="model-ws">5</characteristic>
                        <characteristic name="BS" typeId="model-bs">4</characteristic>
                        <characteristic name="S" typeId="model-s">4</characteristic>
                        <characteristic name="T" typeId="model-t">4</characteristic>
                        <characteristic name="W" typeId="model-w">1</characteristic>
                        <characteristic name="I" typeId="model-i">4</characteristic>
                        <characteristic name="A" typeId="model-a">2</characteristic>
                        <characteristic name="Ld" typeId="model-ld">9</characteristic>
                        <characteristic name="Sv" typeId="model-sv">3+</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Points" typeId="pts" value="20" />
                  </costs>
                </selectionEntry>
