                              <description>Use the normal ProHammer Dozer Blade rule.</description>
                            </rule>
                          </rules>
                        </selectionEntry>
                        <selectionEntry type="upgrade" name="Auxiliary Drive" id="r71-nl-curze-ret-1-r71-nl-atramentar-transport-spartan-hs-spartan-auxiliary-drive" hidden="false" import="true">
