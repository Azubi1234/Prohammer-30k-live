        <selectionEntryGroup name="Vehicle Upgrades" id="dreadnought-vehicle" hidden="false">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Extra Armour" hidden="false" id="dreadnought-extra">
              <constraints>
                <constraint id="dreadnought-extra-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <rules>
                <rule name="Extra Armour" id="dreadnought-extra-rule" hidden="false">
                  <description>Crew Stunned results are treated as Crew Shaken instead.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="dreadnought-hk">
              <constraints>
                <constraint id="dreadnought-hk-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <profiles>
                <profile name="Hunter-Killer Missile" id="dreadnought-hk-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">Unlimited</characteristic>
                    <characteristic name="S" typeId="ranged-s">8</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">3</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 1, One Use</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Frag Assault Launchers" hidden="false" id="dreadnought-frag-launchers">
              <constraints>
                <constraint id="dreadnought-frag-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule name="Frag Assault Launchers" id="dreadnought-frag-rule" hidden="false">
                  <description>The Walker counts as equipped with Frag Grenades when charging an enemy in or behind cover. If a Transport is equipped with Frag Assault Launchers, a unit charging in the same turn it disembarks counts as equipped with Frag Grenades for that Assault phase.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Armoured Sarcophagus" hidden="false" id="dreadnought-sarcophagus">
              <constraints>
                <constraint id="dreadnought-sarcophagus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule name="Armoured Sarcophagus" id="dreadnought-sarc-rule" hidden="false">
                  <description>Increase Front Armour from 12 to 13. Side and Rear Armour are unaffected.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Veteran Pilot" hidden="false" id="dreadnought-veteran-pilot">
              <constraints>
                <constraint id="dreadnought-veteran-pilot-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule name="Veteran Pilot" id="dreadnought-veteran-rule" hidden="false">
                  <description>Increase Weapon Skill and Ballistic Skill by +1. This Dreadnought therefore has WS5 and BS5.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <entryLinks>
            <entryLink import="true" name="Havoc Launcher" hidden="false" id="dreadnought-havoc" type="selectionEntry" targetId="gear-havoc">
              <constraints>
                <constraint id="dreadnought-havoc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
