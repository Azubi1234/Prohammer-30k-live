            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-hs-leviathan-4">
              <constraints>
                <constraint id="da-wing-hs-leviathan-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="da-wing-hs-leviathan-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-hs-leviathan-5">
              <constraints>
                <constraint id="da-wing-hs-leviathan-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="da-wing-hs-leviathan-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="r49-legion-upgrades-hs-leviathan" name="Legion Wargear &amp; Upgrades" hidden="false" collective="false" import="true">
