          <characteristics>
            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unit Type" id="r32-low-transporter-type" hidden="false">
          <description>Vehicle (Super-heavy, Flyer, Hover, Transport)</description>
        </rule>
        <rule name="Wargear" id="r32-low-transporter-wargear" hidden="false">
          <description>Four Twin-linked Heavy Bolters; Armoured Ceramite.</description>
        </rule>
        <rule name="Structure Points" id="r32-low-transporter-low-0" hidden="false">
          <description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</description>
        </rule>
        <rule name="Massive Firepower" id="r32-low-transporter-low-1" hidden="false">
          <description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</description>
        </rule>
        <rule name="Lumbering War Engine" id="r32-low-transporter-low-2" hidden="false">
          <description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</description>
        </rule>
        <rule name="Super-heavy Tank Shock" id="r32-low-transporter-low-3" hidden="false">
          <description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</description>
        </rule>
        <rule name="Crushing Advance" id="r32-low-transporter-low-4" hidden="false">
          <description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</description>
        </rule>
        <rule name="Immense Machine" id="r32-low-transporter-low-5" hidden="false">
          <description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</description>
        </rule>
        <rule name="Catastrophic Destruction" id="r32-low-transporter-low-6" hidden="false">
          <description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</description>
        </rule>
        <rule name="Armoured Ceramite" id="r32-low-transporter-ceramite" hidden="false">
          <description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</description>
        </rule>
        <rule name="Loading Vehicles" id="r32-low-transporter-load" hidden="false">
          <description>While Hovering, an empty Transporter may move over a stationary friendly vehicle that has not moved that turn; that vehicle is embarked. The Transporter may move normally from its following turn.</description>
        </rule>
        <rule name="Unloading Vehicles" id="r32-low-transporter-unload" hidden="false">
          <description>If the Transporter remains stationary while Hovering, transported vehicles may disembark and move normally that turn.</description>
        </rule>
        <rule name="Transport Capacity" id="r32-low-transporter-cap" hidden="false">
          <description>15 models, plus either two Rhino-sized vehicles or one Land Raider-sized vehicle. Transported vehicles may contain passengers.</description>
        </rule>
        <rule name="Access Points" id="r32-low-transporter-access" hidden="false">
          <description>One access hatch on each side of the cockpit section.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Chaff Launcher" hidden="false" id="r32-low-transporter-chaff-launcher">
          <constraints>
            <constraint id="r32-low-transporter-chaff-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="10" />
          </costs>
          <rules>
            <rule name="Chaff Launcher" id="r32-low-transporter-chaff-launcher-effect" hidden="false">
              <description>Once per battle, when the vehicle suffers a Glancing or Penetrating Hit caused by a Missile weapon, roll a D6. On a 4+ the hit is ignored.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Armoured Cockpit" hidden="false" id="r32-low-transporter-armoured-cockpit">
          <constraints>
            <constraint id="r32-low-transporter-armoured-cockpit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <rules>
            <rule name="Armoured Cockpit" id="r32-low-transporter-armoured-cockpit-effect" hidden="false">
              <description>Whenever the vehicle suffers Crew Shaken or Crew Stunned, roll a D6. On a 4+ the result is ignored.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Illum Flares" hidden="false" id="r32-low-transporter-illum-flares">
          <constraints>
            <constraint id="r32-low-transporter-illum-flares-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="5" />
          </costs>
          <rules>
            <rule name="Illum Flares" id="r32-low-transporter-illum-flares-effect" hidden="false">
              <description>May drop one flare in each friendly Movement phase in the same manner as a Bomb. After scatter, friendly units firing at an enemy with at least one model within 12 inches of the marker gain Night Vision for that Shooting phase.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Flare Shield" hidden="false" id="r32-low-transporter-flare-shield">
          <constraints>
            <constraint id="r32-low-transporter-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <rules>
            <rule name="Flare Shield" id="r32-low-transporter-flare-shield-effect" hidden="false">
              <description>Reduce the Strength of shooting attacks that strike the Front Armour by 1, or by 2 if the weapon has Blast or Template. No effect against close combat, Haywire or Titan Killer.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Ramjet Diffraction Grid" hidden="false" id="r32-low-transporter-ramjet-diffraction-grid">
          <constraints>
            <constraint id="r32-low-transporter-ramjet-diffraction-grid-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <rules>
            <rule name="Ramjet Diffraction Grid" id="r32-low-transporter-ramjet-diffraction-grid-effect" hidden="false">
              <description>Reduce the Strength of shooting attacks that strike Side or Rear Armour by 1, to a minimum of 1. The vehicle may not claim Cover Saves from Night Fighting.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Void-crafted Hull" hidden="false" id="r32-low-transporter-voidhull">
          <constraints>
            <constraint id="r32-low-transporter-voidhull-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="35" />
          </costs>
          <rules>
            <rule name="Void-crafted Hull" id="r32-low-transporter-voidhull-rule" hidden="false">
              <description>Increase the Thunderhawk Transporter's Rear Armour from 10 to 12.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hellstrike Missile" hidden="false" id="r32-low-transporter-hellstrike">
          <constraints>
            <constraint id="r32-low-transporter-hellstrike-max" type="max" value="6" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="10" />
          </costs>
          <profiles>
            <profile name="Hellstrike Missile" id="r32-low-transporter-hellstrike-hellstrike-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
              <characteristics>
                <characteristic name="Range" typeId="ranged-range">72"</characteristic>
                <characteristic name="S" typeId="ranged-s">8</characteristic>
                <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                <characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Sunder" id="r32-low-transporter-hellstrike-hellstrike-missile-wr-0-sunder" hidden="false">
              <description>May re-roll failed Armour Penetration rolls against Vehicles.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
      <categoryLinks>
        <categoryLink id="r32-low-transporter-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Thunderhawk Gunship" hidden="false" id="r32-low-thunderhawk">
