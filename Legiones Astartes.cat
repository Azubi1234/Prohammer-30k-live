    <selectionEntry type="unit" name="0–1 Legion Artillery Tank Squadron" id="hs-artillery" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-artillery-cat" primary="true" name="Heavy Support" hidden="false" />
      </categoryLinks>
      <constraints>
        <constraint id="hs-artillery-roster-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="false" />
      </constraints>
      <rules>
        <rule name="Squadron Composition" id="hs-artillery-comp" hidden="false">
          <description>1–3 vehicles. Every vehicle in the squadron must be of the same type.</description>
        </rule>
        <rule name="New Recruit note" id="hs-art-note" hidden="false">
          <description>For a two- or three-vehicle squadron, select the appropriate number of Additional vehicles. Vehicle upgrades and pintle weapons may be selected in matching quantities up to the number of vehicles in the squadron; do not assign more than one copy of a given upgrade to the same vehicle.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Artillery Type" id="hs-artillery-type" hidden="false">
          <constraints>
            <constraint id="hs-artillery-type-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="hs-artillery-type-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="model" name="Legion Whirlwinds" id="hs-art-whirlwind" hidden="false" defaultAmount="1" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="75" />
              </costs>
              <constraints>
                <constraint id="hs-art-whirlwind-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                <constraint id="hs-art-whirlwind-r56-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <profiles>
                <profile name="Legion Whirlwind" id="hs-art-whirlwind-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                  <characteristics>
                    <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                    <characteristic name="Front" typeId="vehicle-front">11</characteristic>
                    <characteristic name="Side" typeId="vehicle-side">11</characteristic>
                    <characteristic name="Rear" typeId="vehicle-rear">10</characteristic>
                  </characteristics>
                </profile>
                <profile name="Whirlwind Launcher — Vengeance" id="hs-art-whirlwind-wp0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">12–48"</characteristic>
                    <characteristic name="S" typeId="ranged-s">5</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Ordnance 1, Barrage, Large Blast</characteristic>
                  </characteristics>
                </profile>
                <profile name="Whirlwind Launcher — Castellan" id="hs-art-whirlwind-wp1" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">12–48"</characteristic>
                    <characteristic name="S" typeId="ranged-s">4</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">5</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Ordnance 1, Barrage, Large Blast, Ignores Cover</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Standard Wargear" id="hs-art-whirlwind-wg" hidden="false">
                  <description>Whirlwind Launcher, Twin-linked Bolter, Searchlight and Smoke Launchers.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="upgrade" name="Hyperios Warheads (replace Vengeance &amp; Castellan)" id="hs-art-hyperios" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-art-hyperios-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>
                    <profile name="Hyperios Warheads" id="hs-art-hyperios-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                      <characteristics>
                        <characteristic name="Range" typeId="ranged-range">48"</characteristic>
                        <characteristic name="S" typeId="ranged-s">8</characteristic>
                        <characteristic name="AP" typeId="ranged-ap">3</characteristic>
                        <characteristic name="Type" typeId="ranged-type">Heavy 1, Skyfire, Interceptor</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hs-art-wh-hunter-killer-missile" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-art-wh-hunter-killer-missile-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                  <rules>
                    <rule name="Hunter-Killer Missile" id="hs-art-wh-hunter-killer-missile-rule" hidden="false">
                      <description>Unlimited range, S8 AP3, Heavy 1, One Use.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Dozer Blade" id="hs-art-wh-dozer-blade" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-art-wh-dozer-blade-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                  <rules>
                    <rule name="Dozer Blade" id="hs-art-wh-dozer-blade-rule" hidden="false">
                      <description>Use the normal ProHammer Dozer Blade rule.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Extra Armour" id="hs-art-wh-extra-armour" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-art-wh-extra-armour-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                  <rules>
                    <rule name="Extra Armour" id="hs-art-wh-extra-armour-rule" hidden="false">
                      <description>Use the normal ProHammer Extra Armour rule.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Auxiliary Drive" id="hs-art-wh-auxiliary-drive" hidden="false" import="true">
                  <constraints>
                    <constraint id="hs-art-wh-auxiliary-drive-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                  <rules>
                    <rule name="Auxiliary Drive" id="hs-art-wh-auxiliary-drive-rule" hidden="false">
                      <description>At the start of the controlling player's Movement phase, if the vehicle is Immobilised, roll a D6. On a 4+, remove one Immobilised result.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
              <selectionEntryGroups>
                <selectionEntryGroup name="Pintle-mounted Weapons (max one per vehicle)" id="hs-art-wh-pintle" hidden="false">
                  <constraints>
                    <constraint id="hs-art-wh-pintle-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="true" />
