              <rules>
                <rule name="Sergeant Armoury Restrictions" id="r42-role-v-0-effects-ride-like-the-wind-legion-sky-hunter-jetbike-squadrons-fa-sky-sgt-arm-rule" hidden="false">
                  <description>Up to 50 points of permitted additional Space Marine Armoury equipment. Standard wargear and unit-specific options are not repeated here. No item may be selected more than once unless specifically permitted; normal Armoury weapon limits still apply.</description>
                </rule>
              </rules>
