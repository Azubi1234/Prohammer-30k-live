      <rules>
        <rule id="r47-wb-favour-aura-rule" name="Daemonic Aura" hidden="false">
          <description>The model gains a 5+ Invulnerable Save.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="r47-wb-favour-aura-cat" targetId="r47-cat-wb-favour" name="Favour of the Pantheon" hidden="false" primary="false" />
