          <selectionEntries>
            <selectionEntry type="unit" name="Legion Command Squad" id="r63-sw-ohthere-command-hq-centurion-ret-command" hidden="false" import="true">
              <constraints>
                <constraint id="r63-sw-ohthere-command-hq-centurion-ret-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
