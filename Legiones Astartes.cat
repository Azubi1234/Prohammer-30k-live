                  <constraints>
                    <constraint id="r40-da-steel-transport-veteran-unit-hs-spartan-hs-spartan-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
