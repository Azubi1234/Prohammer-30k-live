      <rules>
        <rule name="Unit Type" id="r32-aero-xiphon-type" hidden="false">
          <description>Vehicle (Flyer)</description>
        </rule>
        <rule name="Wargear" id="r32-aero-xiphon-wargear" hidden="false">
          <description>Two Twin-linked Lascannons; Xiphon Rotary Missile Launcher; Armoured Ceramite.</description>
        </rule>
        <rule name="Cluster Warhead" id="r32-aero-xiphon-weapon-xiphon-rotary-missile-launcher-wr-0-cluster-warhead" hidden="false">
          <description>If this weapon scores a Penetrating Hit against a target with an Armour Value, roll D3 times on the Vehicle Damage table and apply the highest result. Only one Penetrating Hit is inflicted.</description>
        </rule>
        <rule name="Terminal Tracking" id="r32-aero-xiphon-weapon-xiphon-rotary-missile-launcher-wr-0-terminal-tracking" hidden="false">
          <description>Successful Cover Saves, including Evasion, made against this weapon must be re-rolled.</description>
        </rule>
        <rule name="Flyer" id="r32-aero-xiphon-aero-flyer" hidden="false">
          <description>Uses the normal ProHammer Vehicle and Flyer rules, including deployment from Reserves, Zooming/Hovering where applicable, movement, turning, leaving the battlefield, Hard to Hit, Evasion and Flyer damage.</description>
        </rule>
        <rule name="Air-to-Air Targeting" id="r32-aero-xiphon-aero-air-to-air-targeting" hidden="false">
          <description>When a Zooming Flyer fires at another Flyer or Flying Monster, it may use its normal Ballistic Skill when rolling To Hit.</description>
        </rule>
        <rule name="Agile" id="r32-aero-xiphon-agile" hidden="false">
          <description>When this Flyer enters Evasion, improve the Cover Save granted by Evasion by +1, to a maximum of 3+.</description>
        </rule>
        <rule name="Deep Strike" id="r32-aero-xiphon-deep" hidden="false">
          <description>Uses the normal ProHammer Deep Strike rules except as modified below.</description>
        </rule>
        <rule name="Supersonic" id="r32-aero-xiphon-super" hidden="false">
          <description>Uses the normal ProHammer special rule.</description>
        </rule>
        <rule name="Armoured Ceramite" id="r32-aero-xiphon-ceramite" hidden="false">
          <description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</description>
        </rule>
