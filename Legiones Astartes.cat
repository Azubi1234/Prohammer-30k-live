      </constraints>
      <profiles>
        <profile name="Zardu Layak" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xvii-9-zardu-layak-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
