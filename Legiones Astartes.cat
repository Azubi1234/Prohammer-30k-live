      <rules>
        <rule id="r52-ec-eid-rule-0" name="Legiones Astartes (Emperor's Children)" hidden="false">
          <description>This model has the Emperor's Children Legion rules.</description>
        </rule>
        <rule id="r52-ec-eid-rule-1" name="Independent Character" hidden="false">
          <description>This model is an Independent Character.</description>
        </rule>
        <rule id="r52-ec-eid-rule-2" name="Master of the Legion" hidden="false">
          <description>This model has Master of the Legion.</description>
        </rule>
        <rule id="r52-ec-eid-rule-3" name="Thunderous Charge" hidden="false">
          <description>During an Assault phase in which Eidolon charges, attacks made with his Thunder Hammer are resolved at Initiative 5 instead of Initiative 1. This Initiative value already includes any Initiative bonus gained for charging and may not be further increased.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r52-ec-eid-retinue" name="Command Retinue (does not occupy a separate FOC slot)" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r52-ec-eid-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Honour Guard Squad" id="r52-ec-eid-honour" hidden="false" import="true">
              <constraints>
                <constraint id="r52-ec-eid-honour-hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="55" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r52-ec-eid-honour-hq-praetor-ret-honour-std" hidden="false">
                  <description>Every model wears Artificer Armour and carries a Refractor Field, Power Weapon, Bolt Pistol and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="r52-ec-eid-honour-hq-praetor-ret-honour-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Honour or Death" id="r52-ec-eid-honour-hq-praetor-ret-honour-hod" hidden="false">
                  <description>If the Legion Champion is in base contact with one or more enemy Independent Characters, he must direct all of his close-combat attacks against one of them. When attacking an enemy Independent Character in close combat, he may re-roll failed To Hit and To Wound rolls.</description>
                </rule>
                <rule name="Retinue" id="r52-ec-eid-honour-hq-praetor-ret-honour-ret" hidden="false">
                  <description>Selected for an eligible Praetor or Primarch. It occupies no separate Force Organisation slot; the commander and Honour Guard count as a single HQ selection but do not have to deploy together and operate as separate units after deployment.</description>
                </rule>
              </rules>
