                <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan" collective="false" import="true">
                  <constraints>
                    <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
                    <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                  </constraints>
                  <modifiers>
                    <modifier type="set" value="true" field="hidden">
                      <conditions>
                        <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </conditions>
                    </modifier>
                    <modifier type="set" value="1" field="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-min">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </conditions>
                    </modifier>
                  </modifiers>
                  <selectionEntries>
                    <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-0">
                      <constraints>
                        <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <rules>
                        <rule name="Stormwing" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-0-rule" hidden="false">
                          <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-1">
                      <constraints>
                        <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <rules>
                        <rule name="Deathwing" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-1-rule" hidden="false">
                          <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-2">
                      <constraints>
                        <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <rules>
                        <rule name="Dreadwing" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-2-rule" hidden="false">
                          <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-3">
                      <constraints>
                        <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <rules>
                        <rule name="Ironwing" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-3-rule" hidden="false">
                          <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-4">
                      <constraints>
                        <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <rules>
                        <rule name="Firewing" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-4-rule" hidden="false">
                          <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-5">
                      <constraints>
                        <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <rules>
                        <rule name="Ravenwing" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-5-rule" hidden="false">
                          <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
                <selectionEntryGroup id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-r40-da-ammo-hs-spartan" name="Dark Angels Armoury — Ammunition" hidden="false" collective="false" import="true">
                  <entryLinks>
                    <entryLink id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-r40-da-ammo-hs-spartan-hs-spartan-p6" name="Molecular Acid Shells (for Heavy Bolter)" type="selectionEntry" targetId="da22-acid-hb" hidden="true" import="true">
                      <constraints>
                        <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-r40-da-ammo-hs-spartan-hs-spartan-p6-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="7" />
                      </costs>
                      <modifiers>
                        <modifier type="set" value="false" field="hidden">
                          <conditionGroups>
                            <conditionGroup type="and">
                              <conditions>
                                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" />
                                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-p6" shared="true" includeChildSelections="true" />
                              </conditions>
                            </conditionGroup>
                          </conditionGroups>
                        </modifier>
                      </modifiers>
                    </entryLink>
                  </entryLinks>
                </selectionEntryGroup>
              </selectionEntryGroups>
              <selectionEntries>
                <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile" hidden="false" import="true">
                  <constraints>
                    <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                  <rules>
                    <rule name="Hunter-Killer Missile" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile-rule" hidden="false">
                      <description>Unlimited range, S8 AP3, Heavy 1, One Use.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Dozer Blade" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-dozer-blade" hidden="false" import="true">
                  <constraints>
                    <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                  <rules>
                    <rule name="Dozer Blade" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-dozer-blade-rule" hidden="false">
                      <description>Use the normal ProHammer Dozer Blade rule.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Auxiliary Drive" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-auxiliary-drive" hidden="false" import="true">
                  <constraints>
                    <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                  <rules>
                    <rule name="Auxiliary Drive" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-auxiliary-drive-rule" hidden="false">
                      <description>At the start of the controlling player's Movement phase, if Immobilised, on a 4+ remove one Immobilised result.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Frag Assault Launchers" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-frag-assault-launchers" hidden="false" import="true">
                  <constraints>
                    <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-frag-assault-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                  <rules>
                    <rule name="Frag Assault Launchers" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-frag-assault-launchers-rule" hidden="false">
                      <description>Passengers charging during the same turn they disembark count as equipped with Frag Grenades for that Assault phase.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Armoured Ceramite" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-armoured-ceramite" hidden="false" import="true">
                  <constraints>
                    <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="20" />
                  </costs>
                  <rules>
                    <rule name="Armoured Ceramite" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-armoured-ceramite-rule" hidden="false">
                      <description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" name="Flare Shield" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-flare-shield" hidden="false" import="true">
                  <constraints>
                    <constraint id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="45" />
                  </costs>
                  <rules>
                    <rule name="Flare Shield" id="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-flare-shield-rule" hidden="false">
                      <description>Against shooting attacks striking the Front Armour, reduce the Strength of Blast and Template weapons by 2 and all other ranged attacks by 1. No effect in close combat.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="r45-cult-hs-heavy-support-squad" name="Prosperine Cult" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r45-cult-hs-heavy-support-squad-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
            <constraint id="r45-cult-hs-heavy-support-squad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r48-vis-130" type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry id="r45-cult-hs-heavy-support-squad-0" name="Pavoni" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-hs-heavy-support-squad-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-hs-heavy-support-squad-0-rule" name="Pavoni" hidden="false">
                  <description>Fleet; Psykers/Psychic Brotherhoods also gain Crusader.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-hs-heavy-support-squad-1" name="Raptora" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-hs-heavy-support-squad-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-hs-heavy-support-squad-1-rule" name="Raptora" hidden="false">
                  <description>6+ invulnerable save against shooting; Psychic Mastery improves this to 5+ (or improves an existing invulnerable save by 1 to max 4+) and improves cover by 1 to max 3+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-hs-heavy-support-squad-2" name="Corvidae" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-hs-heavy-support-squad-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-hs-heavy-support-squad-2-rule" name="Corvidae" hidden="false">
                  <description>Re-roll To Hit rolls of 1 on First Fire; Psychic Mastery also applies to Overwatch, Return Fire and Stand &amp; Shoot.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-hs-heavy-support-squad-3" name="Athanaeans" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-hs-heavy-support-squad-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-hs-heavy-support-squad-3-rule" name="Athanaeans" hidden="false">
                  <description>Stubborn and re-roll failed Pinning tests; Psychic Mastery also grants Adamantium Will.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-hs-heavy-support-squad-4" name="Pyrae" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-hs-heavy-support-squad-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-hs-heavy-support-squad-4-rule" name="Pyrae" hidden="false">
                  <description>Hammer of Wrath; Psychic Mastery gives Soul Blaze to close-combat attacks and Flame weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
