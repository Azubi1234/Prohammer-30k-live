                          </conditions>
                        </modifier>
                      </modifiers>
                    </selectionEntry>
                    </selectionEntries>
                  <rules>
                    <rule name="Mobility Restrictions" id="r60-ws-hibou-retinue-legion-command-squad-hq-centurion-ret-command-mobrule" hidden="false">
                      <description>Every model must take the same mobility upgrade. It may only be selected if the character for whom the squad was selected has the corresponding Jump Pack, Bike or Jetbike. If any mobility option is selected, the squad may not take a Dedicated Transport.</description>
                    </rule>
                  </rules>
                </selectionEntryGroup>
