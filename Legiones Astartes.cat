          <selectionEntries>
            <selectionEntry id="r45-cult-veteran-unit-0" name="Pavoni" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-veteran-unit-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-veteran-unit-0-rule" name="Pavoni" hidden="false">
                  <description>Fleet; Psykers/Psychic Brotherhoods also gain Crusader.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-veteran-unit-1" name="Raptora" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-veteran-unit-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-veteran-unit-1-rule" name="Raptora" hidden="false">
                  <description>6+ invulnerable save against shooting; Psychic Mastery improves this to 5+ (or improves an existing invulnerable save by 1 to max 4+) and improves cover by 1 to max 3+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-veteran-unit-2" name="Corvidae" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-veteran-unit-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-veteran-unit-2-rule" name="Corvidae" hidden="false">
                  <description>Re-roll To Hit rolls of 1 on First Fire; Psychic Mastery also applies to Overwatch, Return Fire and Stand &amp; Shoot.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-veteran-unit-3" name="Athanaeans" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-veteran-unit-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-veteran-unit-3-rule" name="Athanaeans" hidden="false">
                  <description>Stubborn and re-roll failed Pinning tests; Psychic Mastery also grants Adamantium Will.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="r45-cult-veteran-unit-4" name="Pyrae" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r45-cult-veteran-unit-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
              <rules>
                <rule id="r45-cult-veteran-unit-4-rule" name="Pyrae" hidden="false">
                  <description>Hammer of Wrath; Psychic Mastery gives Soul Blaze to close-combat attacks and Flame weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
