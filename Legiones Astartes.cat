                <selectionEntryGroup name="Options" hidden="false" id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-options" collective="false" import="true">
                  <selectionEntries>
                    <selectionEntry type="upgrade" import="true" name="Inferno Pistol" hidden="false" id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-0-inferno-pistol">
                      <constraints>
                        <constraint id="r74-ba-pra-guard-r74-ba-guard-inferno-max" type="max" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="10" />
                      </costs>
                      <rules>
                        <rule name="Option restriction" id="r74-ba-pra-guard-r41-unit-ix-5-sanguinary-guard-opt-0-context" hidden="false">
