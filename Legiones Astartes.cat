    <selectionEntry type="unit" name="Deredeo Pattern Dreadnought" id="hs-deredeo" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-deredeo-cat" primary="true" name="Heavy Support" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="pts" value="185" />
      </costs>
      <profiles>
        <profile name="Deredeo Dreadnought" id="hs-deredeo-prof" typeId="prof-walker" typeName="Walker" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="walker-ws">4</characteristic>
            <characteristic name="BS" typeId="walker-bs">5</characteristic>
            <characteristic name="S" typeId="walker-s">6</characteristic>
            <characteristic name="Front" typeId="walker-front">13</characteristic>
            <characteristic name="Side" typeId="walker-side">12</characteristic>
            <characteristic name="Rear" typeId="walker-rear">11</characteristic>
            <characteristic name="I" typeId="walker-i">4</characteristic>
            <characteristic name="A" typeId="walker-a">1</characteristic>
          </characteristics>
        </profile>
        <profile name="Anvilus Autocannon Battery" id="hs-deredeo-anvilus" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 4</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="hs-deredeo-wg" hidden="false">
          <description>Anvilus Autocannon Battery, Twin-linked Heavy Bolter, Extra Armour, Searchlight and Smoke Launchers.</description>
        </rule>
        <rule name="Atomantic Shielding" id="hs-deredeo-atomantic" hidden="false">
          <description>Each time the vehicle suffers a Glancing or Penetrating Hit from shooting, on a 5+ the hit is ignored; in close combat, on a 6+ it is ignored. Roll before the Vehicle Damage table. If it suffers an Explodes! result, add +1" to the explosion radius.</description>
        </rule>
        <rule name="Helical Targeting Array" id="hs-deredeo-helical" hidden="false">
          <description>At the beginning of the controlling player's turn, the Deredeo may activate the array. If it does, it must remain stationary that turn and its ranged weapons gain Skyfire and Interceptor until the beginning of its next turn.</description>
        </rule>
        <rule name="Plasma Overload" id="hs-deredeo-overload" hidden="false">
          <description>After firing the Hellfire Plasma Cannonade in Maximal mode, roll a D6. On a 1, the Deredeo suffers an automatic Glancing Hit; this hit may not be prevented by cover saves or Atomantic Shielding.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Primary Battery" id="hs-deredeo-primary" hidden="false">
          <constraints>
            <constraint id="hs-deredeo-primary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <entryLinks>
            <entryLink name="Hellfire Plasma Cannonade" id="hs-deredeo-hellfire" type="selectionEntry" targetId="hsgear-hellfire" hidden="false" import="true">
              <constraints>
                <constraint id="hs-deredeo-hellfire-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
