        <cost name="Points" typeId="pts" value="20" />
      </costs>
      <constraints>
        <constraint id="r47-wb-favour-wings-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <rules>
        <rule id="r47-wb-favour-wings-rule" name="Daemonic Wings" hidden="false">
          <description>The model becomes Jump Infantry. This may not be combined with a Jump Pack, Bike, Jetbike or Terminator Armour.</description>
