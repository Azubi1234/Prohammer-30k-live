    <selectionEntry id="r71-bs-marauders" name="Blackshield Marauder Squad" type="unit" hidden="false" import="true">
      <modifiers>
        </modifiers>
      <costs>
        <cost name="Points" typeId="pts" value="100" />
      </costs>
      <categoryLinks>
        <categoryLink id="r71-bs-mara-troop" name="Troops" targetId="cat-troops" primary="true" hidden="false" />
      </categoryLinks>
      <profiles>
