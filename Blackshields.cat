              </constraints>
            </selectionEntry>
          </selectionEntries>
          <rules>
            <rule name="Command Retinue" id="hq-centurion-ret-rule" hidden="false">
              <description>A Centurion may select one Legion Command Squad. If equipped with any form of Terminator Armour, he may instead select one Legion Terminator Command Squad. The character and squad count as a single HQ selection but may deploy and operate separately.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup id="bs2-hq-centurion-armoury" name="Blackshield Armoury" hidden="false">
          <constraints>
            <constraint id="bs2-hq-centurion-armoury-max" type="max" value="1000" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="bs2-hq-centurion-rad" name="Rad Grenades" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-rad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-rad-rule" name="Rad Grenades" hidden="false">
                  <description>While bearer is engaged, enemy models in the same combat count Toughness as 1 lower for To Wound rolls made by the bearer and its unit (minimum 1; non-stacking).</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-centurion-cyber" name="Cyber-familiar" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-cyber-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-cyber-rule" name="Cyber-familiar" hidden="false">
                  <description>Improve bearer’s Invulnerable Save by 1; if none, grants 6+. Cannot improve beyond 3+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-centurion-digital" name="Digital Weapons" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-digital-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-digital-rule" name="Digital Weapons" hidden="false">
                  <description>Each Assault phase, re-roll one failed To Wound roll made by the bearer in close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-centurion-mind" name="Mind Projector" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-mind-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-mind-rule" name="Mind Projector" hidden="false">
                  <description>When charged, may use instead of Stand and Shoot: bearer and one enemy Character/unit leader each roll D6 + Ld. If bearer is higher the charge fails; tie or charger higher means it proceeds. No effect on vehicles, Fearless units or units without Leadership.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="bs2-hq-centurion-xenos" name="Xenos Armoury — Alien Brotherhood" hidden="false">
          <constraints>
            <constraint id="bs2-hq-centurion-xenos-max" type="max" value="1000" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier id="bs2-hq-centurion-xhide" type="set" field="hidden" value="true">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="r71-bs-oath-alien" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry id="bs2-hq-centurion-ghost" name="Ghosthelm" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-ghost-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-ghost-rule" name="Ghosthelm" hidden="false">
                  <description>Librarian only. Ignore a Perils wound on 3+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-centurion-stones" name="Spirit Stones" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-stones-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-stones-rule" name="Spirit Stones" hidden="false">
                  <description>Librarian only. May attempt one additional psychic power per turn; this does not permit the same power twice.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-centurion-shadow" name="Shadow Field" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-shadow-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="30" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-shadow-rule" name="Shadow Field" hidden="false">
                  <description>0–1 per army. Grants 2++ until the first failed save using it, after which it collapses.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-centurion-drugs" name="Xenos Combat Drugs" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-drugs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-drugs-rule" name="Xenos Combat Drugs" hidden="false">
                  <description>Once per battle at the start of an Assault phase choose +1 S, +1 I or +1 A until end of phase; afterward on a 1 suffer one wound with no Armour Save.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-centurion-tele" name="Deathlock Teleporter" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-tele-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-tele-rule" name="Deathlock Teleporter" hidden="false">
                  <description>0–1 per army. When the bearer would lose its last Wound, on 3+ survive on 1 Wound and teleport Scatter + 4D6, then become Pinned. Unstable Technology may trigger at the start of a controlling turn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-centurion-halo" name="Halo Blade" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-halo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="30" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-halo-rule" name="Halo Blade" hidden="false">
                  <description>Character only. Two-handed Power Weapon, +3 Strength; replaces an eligible close-combat weapon.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-centurion-witch" name="Witchblade" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-witch-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-witch-rule" name="Witchblade" hidden="false">
                  <description>Librarian only. Wounds non-vehicles on 2+ with normal Armour Saves; counts as S9 against vehicles. Replaces Force/Power Weapon.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-centurion-agon" name="Agoniser" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-centurion-agon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule id="bs2-hq-centurion-agon-rule" name="Agoniser" hidden="false">
                  <description>Character/Veteran Sergeant. Power Weapon; wounds non-vehicles on 4+.</description>
