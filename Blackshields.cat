            <characteristic name="Ld" typeId="model-ld">8</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
        <profile id="r71-bs-chief-prof" name="Marauder Chief" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">1</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">3</characteristic>
            <characteristic name="Ld" typeId="model-ld">9</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="r71-bs-mara-std" name="Unit Composition &amp; Wargear" hidden="false">
          <description>1 Marauder Chief + 4 Marauders. Power Armour, Bolt pistol, Chainsword, Frag grenades and Krak grenades. Legiones Astartes (Blackshields).</description>
        </rule>
        <rule id="r71-bs-mara-special-scale" name="Special/Heavy Weapon Scaling" hidden="false">
          <description>For every five models in the squad, one Marauder may forgo a Marauder Weapon option and select one Special/Heavy option. The builder maximum is dynamically scaled from squad size.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r71-bs-mara-size" name="Additional Marauders" hidden="false">
