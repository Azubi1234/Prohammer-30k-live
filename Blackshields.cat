                            <modifier id="r40-sal-fury-ce8eda14d2-show" type="set" field="hidden" value="false">
                              <conditionGroups>
                                <conditionGroup type="and">
                                  <conditions>
                                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xviii-1-the-awakening-fire" shared="true" includeChildSelections="true" includeChildForces="false" />
