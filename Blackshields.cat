          <rules>
            <rule name="Retinue Restriction" id="hq-praetor-ret-rule" hidden="false">
              <description>A Praetor may select one Honour Guard Squad. If equipped with any form of Terminator Armour, he may instead select a Legion Terminator Command Squad where permitted.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup id="bs2-hq-praetor-armoury" name="Blackshield Armoury" hidden="false">
          <constraints>
            <constraint id="bs2-hq-praetor-armoury-max" type="max" value="1000" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="bs2-hq-praetor-rad" name="Rad Grenades" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-rad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-rad-rule" name="Rad Grenades" hidden="false">
                  <description>While bearer is engaged, enemy models in the same combat count Toughness as 1 lower for To Wound rolls made by the bearer and its unit (minimum 1; non-stacking).</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-cyber" name="Cyber-familiar" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-cyber-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-cyber-rule" name="Cyber-familiar" hidden="false">
                  <description>Improve bearer’s Invulnerable Save by 1; if none, grants 6+. Cannot improve beyond 3+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-digital" name="Digital Weapons" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-digital-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-digital-rule" name="Digital Weapons" hidden="false">
                  <description>Each Assault phase, re-roll one failed To Wound roll made by the bearer in close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-mind" name="Mind Projector" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-mind-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-mind-rule" name="Mind Projector" hidden="false">
                  <description>When charged, may use instead of Stand and Shoot: bearer and one enemy Character/unit leader each roll D6 + Ld. If bearer is higher the charge fails; tie or charger higher means it proceeds. No effect on vehicles, Fearless units or units without Leadership.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="bs2-hq-praetor-xenos" name="Xenos Armoury — Alien Brotherhood" hidden="false">
          <constraints>
            <constraint id="bs2-hq-praetor-xenos-max" type="max" value="1000" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier id="bs2-hq-praetor-xhide" type="set" field="hidden" value="true">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="r71-bs-oath-alien" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry id="bs2-hq-praetor-ghost" name="Ghosthelm" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-ghost-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-ghost-rule" name="Ghosthelm" hidden="false">
                  <description>Librarian only. Ignore a Perils wound on 3+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-stones" name="Spirit Stones" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-stones-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-stones-rule" name="Spirit Stones" hidden="false">
                  <description>Librarian only. May attempt one additional psychic power per turn; this does not permit the same power twice.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-shadow" name="Shadow Field" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-shadow-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="30" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-shadow-rule" name="Shadow Field" hidden="false">
                  <description>0–1 per army. Grants 2++ until the first failed save using it, after which it collapses.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-drugs" name="Xenos Combat Drugs" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-drugs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-drugs-rule" name="Xenos Combat Drugs" hidden="false">
                  <description>Once per battle at the start of an Assault phase choose +1 S, +1 I or +1 A until end of phase; afterward on a 1 suffer one wound with no Armour Save.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-tele" name="Deathlock Teleporter" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-tele-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-tele-rule" name="Deathlock Teleporter" hidden="false">
                  <description>0–1 per army. When the bearer would lose its last Wound, on 3+ survive on 1 Wound and teleport Scatter + 4D6, then become Pinned. Unstable Technology may trigger at the start of a controlling turn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-halo" name="Halo Blade" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-halo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="30" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-halo-rule" name="Halo Blade" hidden="false">
                  <description>Character only. Two-handed Power Weapon, +3 Strength; replaces an eligible close-combat weapon.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-witch" name="Witchblade" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-witch-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-witch-rule" name="Witchblade" hidden="false">
                  <description>Librarian only. Wounds non-vehicles on 2+ with normal Armour Saves; counts as S9 against vehicles. Replaces Force/Power Weapon.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-agon" name="Agoniser" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-agon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-agon-rule" name="Agoniser" hidden="false">
                  <description>Character/Veteran Sergeant. Power Weapon; wounds non-vehicles on 4+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-pun" name="Punisher" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-pun-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-pun-rule" name="Punisher" hidden="false">
                  <description>Character only. Two-handed Power Weapon, +1 Strength.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-kiss" name="Harlequin’s Kiss" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="bs2-hq-praetor-kiss-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <rules>
                <rule id="bs2-hq-praetor-kiss-rule" name="Harlequin’s Kiss" hidden="false">
                  <description>Character/Veteran Sergeant. Rending Weapon; successful Rending hits wound automatically.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="bs2-hq-praetor-scorp" name="Scorpion Chainsword" type="upgrade" hidden="false" import="true">
              <constraints>
