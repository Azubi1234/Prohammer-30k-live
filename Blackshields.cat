          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" name="Legion Chaplain Consul" id="hq-consul-chaplain" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-chaplain-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="35" />
              </costs>
              <rules>
                <rule name="Legion Chaplain Consul" id="hq-consul-chaplain-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Chaplain Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Honour of the Legion" id="r29-chap-honour" hidden="false">
                  <description>The Chaplain and any unit he has joined have the Fearless special rule.

Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Liturgies of Battle" id="r29-chap-liturgies" hidden="false">
                  <description>In a player turn in which the Chaplain and a unit he has joined successfully charge, the Chaplain and all models in that unit may re-roll failed To Hit rolls in close combat for that Assault phase.</description>
                </rule>
              </rules>
              <entryLinks>
                <entryLink import="true" name="Crozius Arcanum" id="r29-chap-crozius" type="selectionEntry" targetId="r29-gear-crozius" hidden="false" defaultAmount="1">
