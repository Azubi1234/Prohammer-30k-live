              </categoryLinks>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Esoterist Consul" id="hq-consul-esoterist" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-esoterist-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
