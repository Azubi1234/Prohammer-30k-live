              <rules>
                <rule name="Legion Librarian Consul" id="hq-consul-librarian-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Librarian Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Psyker (Mastery Level 1)" id="r29-lib-psyker" hidden="false">
                  <description>The Librarian is a Psyker with Mastery Level 1 and follows the ProHammer Classic psychic rules.</description>
                </rule>
                <rule name="Legion Support Officer" id="r29-lib-support" hidden="false">
                  <description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</description>
                </rule>
                <rule name="Psychic Powers" id="r29-lib-powers" hidden="false">
                  <description>Select powers from Biomancy, Divination, Pyromancy, Telekinesis or Telepathy. Daemonology is not available. ProHammer allows powers to be chosen rather than randomly generated.</description>
                </rule>
              </rules>
              <selectionEntries>
