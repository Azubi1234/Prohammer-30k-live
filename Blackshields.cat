                                  <description>The entire Maniple may take Searchlights for +1 point per model; select this once for each Castellax in the Maniple.</description>
                                </rule>
                              </rules>
                              <categoryLinks>
                                <categoryLink id="r80-ih-consul-cat-173" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                              </categoryLinks>
                            </selectionEntry>
