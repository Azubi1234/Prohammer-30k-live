                                <cost name="Points" typeId="pts" value="5" />
                              </costs>
                              <rules>
                                <rule name="Frag Grenades" id="r30-prae-castellax-frag-rule" hidden="false">
                                  <description>The entire Maniple may take Frag Grenades for +5 points per model; select this once for each Castellax in the Maniple.</description>
                                </rule>
                              </rules>
                              <categoryLinks>
