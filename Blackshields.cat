                    <selectionEntry id="r61-librarian-power1-telepathy-psychic-shriek" name="Telepathy — Psychic Shriek" type="upgrade" hidden="false" import="true">
                      <constraints>
                        <constraint id="r61-librarian-power1-telepathy-psychic-shriek-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
