                            </conditionGroup>
                          </conditionGroups>
                        </modifier>
                      </modifiers>
                      <rules>
                        <rule id="r40-sal-fury-16d811e6e0-rule" name="Elemental Horror" hidden="false">
                          <description>If the target unit suffers one or more unsaved Wounds, it immediately takes a Morale test with a Leadership penalty equal to the number of unsaved Wounds caused.</description>
                        </rule>
                        <rule id="r40-sal-fury-16d811e6e0-disc" name="Pyromancy restriction" hidden="false">
                          <description>May only be selected as a Pyromancy power.</description>
                        </rule>
                      </rules>
                      <infoLinks>
