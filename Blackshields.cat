                          </repeats>
                        </modifier>
                      </modifiers>
                    </selectionEntry>
                    <entryLink id="r11-dg-hq-praetor-deathshroud-r11-dg-deathshroud-cataphractii" name="Exchange entire squad’s Terminator Armour for Cataphractii Terminator Armour — Free" targetId="r41-universal-gear-54b6d66012b244" type="selectionEntry" import="true" hidden="false">
                      <constraints>
