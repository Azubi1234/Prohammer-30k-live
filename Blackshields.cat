                      <rules>
                        <rule name="Shrouding" id="r29-lib-power-34-rule" hidden="false">
                          <description>Blessing — targets Psyker. All friendly models within 6” gain Shrouded.

Shrouded: Adds +2 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 5+ Cover Save. Does not stack with Stealth.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier type="set" value="true" field="hidden">
                          <conditions>
                            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-4" shared="true" includeChildSelections="true" />
