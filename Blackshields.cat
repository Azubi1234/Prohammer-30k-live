                    <constraint id="r11-dg-hq-praetor-deathshroud-r41-unit-xiv-0-deathshroud-terminators-additional-min-total" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="55" />
                  </costs>
