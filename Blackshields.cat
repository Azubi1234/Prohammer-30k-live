              </selectionEntries>
              <selectionEntryGroups>
                <selectionEntryGroup name="Options" hidden="false" id="r11-dg-hq-praetor-deathshroud-r41-unit-xiv-0-deathshroud-terminators-options" collective="false" import="true">
                  <selectionEntries>
                    <selectionEntry type="upgrade" import="true" name="Melta bombs — entire squad (+5 pts/model)" hidden="false" id="r11-dg-hq-praetor-deathshroud-r41-unit-xiv-0-deathshroud-terminators-opt-0-melta-bombs">
                      <constraints>
                        <constraint id="r11-dg-hq-praetor-deathshroud-r41-unit-xiv-0-deathshroud-terminators-opt-0-melta-bombs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                      </constraints>
                      <infoLinks>
                        <infoLink id="r36-link-68c4dc73a123" name="Whole-squad Melta Bombs" hidden="false" targetId="r36-exact-whole-squad-melta-bombs-9e41e7a" type="rule" />
                      </infoLinks>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <rules>
                        <rule name="Option restriction" id="r11-dg-hq-praetor-deathshroud-r41-unit-xiv-0-deathshroud-terminators-opt-0-context" hidden="false">
                          <description>• The entire squad may take:</description>
                        </rule>
                        <rule name="Squad-wide cost note" id="r11-dg-hq-praetor-deathshroud-r41-unit-xiv-0-deathshroud-terminators-opt-0-squadwide" hidden="false">
                          <description>The source prices this option at +5 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</description>
                        </rule>
                      </rules>
                      <modifiers>
                        <modifier id="r11-dg-hq-praetor-deathshroud-r11-dg-ds-melta-scale" type="increment" field="pts" value="5">
                          <repeats>
