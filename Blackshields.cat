              <rules>
                <rule id="r72-bs-xw-agon-rule" name="Agoniser" hidden="false">
                  <description>Character/Veteran Sergeant. Power Weapon; wounds T models on 4+ regardless of Toughness; no special vehicle effect.</description>
                </rule>
