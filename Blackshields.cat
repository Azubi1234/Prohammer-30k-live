            <selectionEntry type="upgrade" name="Legion Forge Lord Consul" id="hq-consul-forge" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-forge-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="70" />
              </costs>
              <rules>
                <rule name="Legion Forge Lord Consul" id="hq-consul-forge-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Forge Lord Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Battlesmith" id="r29-forge-battlesmith" hidden="false">
                  <description>During the Shooting phase, instead of firing a weapon, a Forge Lord in base contact with or embarked upon a friendly damaged Vehicle may attempt a repair. On 5+, remove one Engine Damaged, Weapon Destroyed or Immobilised result. His Servo-Arm grants +1, so he normally succeeds on 4+.</description>
                </rule>
                <rule name="Lord of the Armoury" id="r29-forge-armoury" hidden="false">
                  <description>May select equipment restricted to Techmarines from the Space Marine Armoury in addition to equipment normally available to a Centurion.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="upgrade" name="Cortex Controller" id="hq-consul-forge-cortex" hidden="false" import="true">
                  <constraints>
                    <constraint id="hq-consul-forge-cortex-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <categoryLinks>
                    <categoryLink id="r80-ih-consul-cat-136" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                  </categoryLinks>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Iron Father" hidden="false" id="r25-consul-x-iron-father">
                  <constraints>
                    <constraint id="r25-consul-x-iron-father-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  <modifiers>
                    </modifiers>
                  <rules>
                    <rule name="Iron Father" id="r25-consul-x-iron-father-rule" hidden="false">
                      <description>Any Iron Hands Forge Lord Consul may be further upgraded to an Iron Father for +25 points.
Wargear:
• Iron Halo
• Bionics
Special Rules:
• Rites of Battle
The Iron Father retains all rules, wargear and options of a normalForge Lord Consul.
RITES OF BATTLE
The Iron Father and any Iron Hands unit he has joined may re-roll failed Morale tests. The second result must be accepted.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
              <entryLinks>
                <entryLink import="true" name="Artificer Armour" id="r29-forge-artificer" type="selectionEntry" targetId="gear-hq-artificer" hidden="false" defaultAmount="1">
                  <constraints>
                    <constraint id="r29-forge-artificer-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r29-forge-artificer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                </entryLink>
                <entryLink import="true" name="Servo-Arm" id="r29-forge-servo" type="selectionEntry" targetId="r29-gear-servo-arm" hidden="false" defaultAmount="1">
                  <constraints>
                    <constraint id="r29-forge-servo-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r29-forge-servo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                </entryLink>
              </entryLinks>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Herald Consul" id="hq-consul-herald" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-herald-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="40" />
              </costs>
              <rules>
                <rule name="Legion Herald Consul" id="hq-consul-herald-rule" hidden="false">
                  <description>This Centurion is upgraded to Legion Herald Consul. Granted wargear and special rules are shown separately below.</description>
                </rule>
                <rule name="Legion Support Officer" id="r29-herald-support" hidden="false">
                  <description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</description>
                </rule>
                <rule name="Banner of Allegiance" id="r29-herald-banner" hidden="false">
                  <description>Use the selected Banner of the Aquila or Banner of the Eye rule shown by the Herald upgrade.</description>
                </rule>
                <rule name="Fallen Honour" id="r29-herald-fallen" hidden="false">
                  <description>If the Herald is slain, the opposing player gains +1 Victory Point in missions using Victory Points.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Banner of Allegiance" id="hq-consul-herald-banner" hidden="false">
                  <constraints>
                    <constraint id="hq-consul-herald-banner-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                    <constraint id="hq-consul-herald-banner-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="upgrade" name="Banner of the Aquila — Loyalist" id="hq-consul-herald-aquila" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-herald-aquila-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <rules>
                        <rule name="Banner of the Aquila" id="hq-consul-herald-aquila-rule" hidden="false">
                          <description>The Herald and friendly Loyalist models with Legiones Astartes within 12" receive +1 Weapon Skill, to a maximum of WS5.</description>
                        </rule>
                      </rules>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-138" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Banner of the Eye — Traitor" id="hq-consul-herald-eye" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-herald-eye-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <rules>
                        <rule name="Banner of the Eye" id="hq-consul-herald-eye-rule" hidden="false">
                          <description>The Herald and friendly Traitor models with Legiones Astartes within 12" add +1" to Advance and Charge moves. On a turn in which such a unit successfully charges, it may re-roll To Hit rolls of 1 in close combat.</description>
                        </rule>
                      </rules>
                      <categoryLinks>
                        <categoryLink id="r80-ih-consul-cat-139" name="Head of the Gorgon — non-Forge-Lord Consul" hidden="false" targetId="r80-ih-head-nonforge-consul" primary="false" />
                      </categoryLinks>
                    </selectionEntry>
