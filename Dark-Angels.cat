ea9956" name="Shadow Masters" targetId="r43-rg-shadow-masters" type="rule" hidden="false" /><infoLink id="r62-shat-assign-98f4c95bcbe0-info-c90b6dc986fe" name="Limited Vehicles" targetId="r43-rg-limited-vehicles" type="rule" hidden="false" /><infoLink id="r62-shat-assign-98f4c95bcbe0-info-cd49071cd572" name="Raven's Talons" targetId="r43-rg-raven-s-talons" type="rule" hidden="false" /><infoLink id="r62-shat-assign-98f4c95bcbe0-info-9c3d09934245" name="Infravisor" targetId="r43-rg-infravisor" type="rule" hidden="false" /><infoLink id="r62-shat-assign-98f4c95bcbe0-info-3ddc92495b50" name="Shroud Bombs" targetId="r43-rg-shroud-bombs" type="rule" hidden="false" /><infoLink id="r62-shat-assign-98f4c95bcbe0-info-ca5136e64e22" name="Cameleoline" targetId="r43-rg-cameleoline" type="rule" hidden="false" /><infoLink id="r62-shat-assign-98f4c95bcbe0-info-abb7821cf8bd" name="Teleportation Transponders" targetId="r43-rg-teleportation-transponders" type="rule" hidden="false" /></infoLinks><rules><rule id="r62-shat-assign-98f4c95bcbe0-identity" name="Legiones Astartes (Raven Guard)" hidden="false"><description>This unit is assigned to Raven Guard for the Shattered Legions Theme. It uses the normal Raven Guard Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-98f4c95bcbe0-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xix" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-98f4c95bcbe0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-