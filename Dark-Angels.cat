      <selectionEntry id="r37-wb-covenant-config" name="Daemonic Covenant — external Ruinstorm Allied Detachment" type="upgrade" hidden="true" defaultAmount="True"><infoLinks><infoLink id="r37-wb-cov-rule" name="Daemonic Covenant" targetId="r37-wb-rule-daemonic-covenant" type="rule" hidden="false" /><infoLink id="r37-wb-cov-summ" name="Daemonic Summoning" targetId="r37-wb-rule-daemonic-summoning" type="rule" hidden="false" /></infoLinks><modifiers><modifier id="r37-wb-covenant-config-r37-show" type="set" field="hidden" value="false"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-xvii" shared="true" includeChildSelections="true" includeChildForces="false" /><condition type="atLeast" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></conditionGroup></conditionGroups></modifier></modifiers><constraints><constraint id="r37-wb-covenant-config-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs></selectionEntry></selectionEntries>
