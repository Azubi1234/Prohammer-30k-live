      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Assault Marine" hidden="false" id="r40-da-serpent-assault-assault-marine" defaultAmount="9">
          <constraints>
            <constraint type="min" value="9" field="selections" scope="parent" shared="true" id="r40-da-serpent-assault-assault-marine-min" includeChildSelections="false" />
            <constraint type="max" value="19" field="selections" scope="parent" shared="true" id="r40-da-serpent-assault-assault-marine-max" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="18" />
          </costs>
          <profiles>
            <profile name="Legion Assault Marine" typeId="prof-model" typeName="Model" hidden="false" id="r40-da-serpent-assault-prof-assault-marine">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">8</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        <modifiers><modifier id="r19-axis-max-r40-da-serpent-assault-assault-marine" type="set" field="r40-da-serpent-assault-assault-marine-min" value="19"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xv-0-the-axis-of-dissolution" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Assault Sergeant" hidden="false" id="r40-da-serpent-assault-assault-sergeant" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r40-da-serpent-assault-assault-sgt-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-serpent-assault-assault-sgt-max" includeChildSelections="false" automatic="true" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="18" />
          </costs>
          <profiles>
            <profile name="Legion Assault Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r40-da-serpent-assault-prof-assault-sergeant">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Sergeant Armoury" id="r40-da-serpent-assault-assault-rule-sgt-armoury" hidden="false">
              <description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. The Sergeant may carry no more than two weapons, only one of which may be two-handed. A pair of Lightning Claws counts as both weapon choices. No item may be selected more than once unless a unit entry specifically permits otherwise. Unit-specific replacement options are available at the points costs shown in this squad entry and are not repeated in the additional Armoury.</description>
            </rule>
          </rules>
          <selectionEntries>
            <entryLink id="r40-da-serpent-assault-assault-sgt-pair-claws" name="Pair of Lightning Claws (replaces Bolt Pistol and Chainsword)" targetId="r41-universal-gear-a04af5f26d85b5" type="selectionEntry" import="true" hidden="false"><constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-serpent-assault-assault-sgt-pair-claws-max" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditionGroups>
                    <conditionGroup type="or">
