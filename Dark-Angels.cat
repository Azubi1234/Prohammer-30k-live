      <profiles>
        <profile name="Marduk Sedras, Lord of the Twenty-Third Order" typeId="prof-model" typeName="Model" hidden="false" id="da22-sedras-prof">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">6</characteristic>
            <characteristic name="BS" typeId="model-bs">5</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">3</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">4</characteristic>
            <characteristic name="Ld" typeId="model-ld">10</characteristic>
            <characteristic name="Sv" typeId="model-sv">2+/4+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Wargear" id="da22-sedras-wargear" hidden="false">
          <description>Regalia of the Shattered Sceptre (Cataphractii Terminator Armour); Combi-volkite; Death of Worlds; Grenade Harness.</description>
        </rule>
        <rule name="Special Rules" id="da22-sedras-base" hidden="false">
          <description>Legiones Astartes (Dark Angels); Independent Character; Master of the Legion; Stubborn; Dreadwing.</description>
        </rule>
        <rule name="Death of Worlds" id="da22-sedras-deathworlds" hidden="false">
          <description>Two-Handed Power Weapon. Attacks are Strength 6. Natural To Wound rolls of 5 or 6 inflict Massive Wound (D3).</description>
        </rule>
        <rule name="Ancient of War" id="da22-sedras-ancient" hidden="false">
          <description>After deployment but before first turn nominate one enemy faction. Sedras and friendly Dark Angels units with a model within 6" may re-roll To Hit rolls of 1 and To Wound rolls of 1 against models of that faction in Shooting and Assault.</description>
        </rule>
        <rule name="Eskaton" id="da22-sedras-eskaton" hidden="false">
          <description>Always Dreadwing. Sedras and any Dark Angels unit he joins gain the Siege Specialists Veteran Skill.</description>
        </rule>
        <rule name="Cenobium Retinue" id="da22-sedras-ret" hidden="false">
          <description>One Inner Circle Knights Cenobium may be his personal retinue without a separate FOC slot; Sedras and the Cenobium count as one HQ selection.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="da22-sedras-cat" targetId="cat-hq" name="HQ" hidden="false" primary="true" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Farith Redloss" hidden="false" id="da22-redloss">
      <costs>
        <cost name="Points" typeId="pts" value="185" />
