    <selectionEntry type="unit" import="true" name="Legion Assault Squad (Serpent’s Bane compulsory)" hidden="true" id="r40-da-serpent-assault">
      <rules>
        <rule name="Standard Wargear" id="r40-da-serpent-assault-assault-standard-wargear" hidden="false">
          <description>Every model is equipped with Power Armour, a Bolt Pistol, a Chainsword, Frag Grenades and a Jump Pack.</description>
        </rule>
        <rule name="Power Armour" id="r40-da-serpent-assault-assault-power-armour" hidden="false">
          <description>Models wearing Power Armour have a 3+ Armour Save.</description>
        </rule>
        <rule name="Legiones Astartes" id="r40-da-serpent-assault-assault-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Frag Grenades" id="r40-da-serpent-assault-assault-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
        <rule name="Jump Packs" id="r40-da-serpent-assault-assault-jump-packs" hidden="false">
          <description>The squad is equipped with Jump Packs and is treated as Jump Infantry. It follows all normal ProHammer rules for Jump Infantry, including movement, terrain, Deep Strike, Fall Back movement and transport restrictions.</description>
        </rule>
        <rule id="r40-da-serpent-assault-rite-rule" name="The Serpent’s Bane — Compulsory Formation" hidden="false">
          <description>This Rite-specific copy represents a Firewing Assault Squad eligible to fulfil compulsory Troops.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink import="true" name="Bolt Pistol" hidden="false" id="r40-da-serpent-assault-assault-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r40-da-serpent-assault-assault-standard-bp-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-serpent-assault-assault-standard-bp-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
