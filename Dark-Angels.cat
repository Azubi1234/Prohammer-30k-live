                  </constraints>
                  <entryLinks>
                    <entryLink import="true" name="Artificer Armour" id="r40-da-storm-centurion-group-r40-da-storm-tactical-hq-centurion-art" type="selectionEntry" targetId="gear-hq-artificer" hidden="false">
