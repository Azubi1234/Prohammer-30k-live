                      <rules>
                        <rule name="Space Marine Bike" id="r40-da-storm-centurion-group-r40-da-storm-assault-r37-centurion-jetbike-gear-gear-hq-bike-rule" hidden="false">
                          <description>The bearer becomes Bike unit type and follows the normal ProHammer Bike rules. The bike is armed with twin-linked bolters. It may not be combined with a Jump Pack, Jetbike or Terminator Armour.

Twin-Linked: Re-roll failed To Hit rolls with this weapon. Does not count as two weapons. Twin-linked Template weapons automatically hit all models fully or partially under the Template.</description>
                        </rule>
                        </rules>
                      <modifiers>
                        <modifier type="set" value="false" field="hidden">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" />
                          </conditions>
                        </modifier>
                      </modifiers>
                    </selectionEntry>
                  </selectionEntries>
