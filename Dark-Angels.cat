        <selectionEntryGroup id="r40-da-storm-centurion-group-r40-da-storm-assault" name="Storm of War — Embedded Legion Centurion (20-model squad only)" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Centurion" id="r40-da-storm-centurion-group-r40-da-storm-assault-centurion" hidden="false" import="true">
              <infoLinks><infoLink id="r36-link-a8420c4af100" name="Masters of the Storm of War" hidden="false" targetId="r36-exact-masters-of-the-storm-of-war-5d02d51" type="rule" /></infoLinks><costs>
                <cost name="Points" typeId="pts" value="50" />
              </costs>
              <profiles>
                <profile name="Legion Centurion" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-prof" typeId="prof-model" typeName="Model" hidden="false">
                  <characteristics>
                    <characteristic name="WS" typeId="model-ws">5</characteristic>
                    <characteristic name="BS" typeId="model-bs">5</characteristic>
                    <characteristic name="S" typeId="model-s">4</characteristic>
                    <characteristic name="T" typeId="model-t">4</characteristic>
                    <characteristic name="W" typeId="model-w">2</characteristic>
                    <characteristic name="I" typeId="model-i">5</characteristic>
                    <characteristic name="A" typeId="model-a">3</characteristic>
                    <characteristic name="Ld" typeId="model-ld">9</characteristic>
                    <characteristic name="Sv" typeId="model-sv">3+</characteristic>
                  </characteristics>
                  <modifiers />
                </profile>
              </profiles>
              <rules>
                <rule name="Standard Wargear" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-std" hidden="false">
                  <description>Power Armour, Bolt Pistol, Chainsword and Frag Grenades.</description>
                </rule>
                <rule name="Legiones Astartes" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-la" hidden="false">
                  <description>The model has the Legiones Astartes special rule, also has And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless unless another rule says otherwise.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Frag Grenades" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-frag" hidden="false">
                  <description>Uses the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
                </rule>
                <rule name="Space Marine Armoury" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-armoury-rule" hidden="false">
                  <description>The Centurion may select up to 100 points of weapons and wargear from the Space Marine Armoury. Armour, Mobility, Weapon Replacements and Additional Wargear all count toward the same 100-point limit. All normal Armoury restrictions apply. Consul-granted wargear is included in the Consul cost and does not count against this allowance.</description>
                </rule>
                </rules>
              <entryLinks>
                <entryLink import="true" name="Bolt Pistol" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-bp" type="selectionEntry" targetId="gear-bolt-pistol" hidden="false" defaultAmount="1">
                  <constraints>
                    <constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-bp-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-bp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                </entryLink>
                <entryLink import="true" name="Chainsword" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-cs" type="selectionEntry" targetId="gear-chainsword" hidden="false" defaultAmount="1">
                  <constraints>
