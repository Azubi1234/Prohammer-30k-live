      <rules>
        <rule name="Wargear" id="r40-da-eskaton-interemptor-da22-int-wg" hidden="false">
          <description>4 Interemptors + 1 Interemptor Praefectus; Power Armour; Plasma Burner; Chainsword; Frag Grenades; Rad Grenades.</description>
        </rule>
        <rule name="Special Rules" id="r40-da-eskaton-interemptor-da22-int-rules" hidden="false">
          <description>Legiones Astartes (Dark Angels); Dreadwing (fixed); Stubborn; Bitter Duty. Only a Dark Angels Independent Character assigned to the Dreadwing may join this unit.</description>
        </rule>
        <rule id="r40-da-eskaton-interemptor-rite-rule" name="Dread Legion" hidden="false">
          <description>Dreadwing Interemptors count as Troops under The Eskaton Imperative.</description>
        </rule>
