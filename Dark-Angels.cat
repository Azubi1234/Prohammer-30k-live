          <description>4 Deathwing Companions + 1 Oathbearer. Artificer Armour, Calibanite Warblade, Bolter, Bolt Pistol, Frag Grenades; Oathbearer additionally has a Refractor Field.</description>
        </rule>
        <rule name="Special Rules" id="da22-dwc-rules" hidden="false">
          <description>Legiones Astartes (Dark Angels); Deathwing (fixed); Stubborn; Death-sworn Companions; Deathwing Retinue.</description>
        </rule>
        <rule name="Deathwing Retinue" id="da22-dwc-ret" hidden="false">
          <description>May replace a Legion Command/Honour Guard retinue for an eligible Dark Angels Praetor or named character. It does not occupy a separate Force Organisation slot when selected as that retinue.</description>
        </rule>
        </rules>
