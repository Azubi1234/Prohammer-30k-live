        <constraint id="da22-holguin-rostermax" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </constraints>
      <profiles>
        <profile name="Holguin" typeId="prof-model" typeName="Model" hidden="false" id="da22-holguin-prof">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">6</characteristic>
            <characteristic name="BS" typeId="model-bs">5</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">3</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">3</characteristic>
            <characteristic name="Ld" typeId="model-ld">10</characteristic>
            <characteristic name="Sv" typeId="model-sv">2+/4+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Wargear" id="da22-holguin-wargear" hidden="false">
          <description>Cataphractii Terminator Armour; Combi-bolter; Master-crafted Terranic Greatsword; Grenade Harness.</description>
        </rule>
        <rule name="Special Rules" id="da22-holguin-base" hidden="false">
          <description>Legiones Astartes (Dark Angels); Independent Character; Master of the Legion; Stubborn; Deathwing.</description>
        </rule>
        <rule name="Voted-Lieutenant of the Deathwing" id="da22-holguin-voted" hidden="false">
          <description>Always Deathwing. May select a Deathwing Terminator Companion Detachment as personal retinue without a separate FOC slot; together count as one HQ selection.</description>
        </rule>
        <rule name="Unbroken Line" id="da22-holguin-line" hidden="false">
          <description>While joined to a friendly Dark Angels unit, that unit gains Counter-Attack. If charged while controlling an Objective or occupying a fortification, ruin or building, Holguin may re-roll To Hit rolls of 1 that Assault phase.

Counter-Attack: If this unit is not engaged with any enemy models and an enemy unit successfully completes a charge move against it, the unit may take a Leadership test. If passed, this unit gains +1 Attack during the Assault phase.</description>
        </rule>
        <rule name="Master-crafted Terranic Greatsword" id="da22-holguin-sword" hidden="false">
          <description>Uses the normal Terranic Greatsword rules and is additionally Master-crafted.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="da22-holguin-cat" targetId="cat-hq" name="HQ" hidden="false" primary="true" />
      </categoryLinks>
