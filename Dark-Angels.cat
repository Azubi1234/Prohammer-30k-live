                  <rules>
                    <rule name="Iron Halo" id="r40-da-vow-terminator-terminator-sgt-halo-rule" hidden="false">
                      <description>4+ Invulnerable Save; normally no more than one Iron Halo may be selected in an army.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Master-crafted Weapon" hidden="false" id="r40-da-vow-terminator-terminator-sgt-mastercraft">
                  <constraints>
                    <constraint id="r40-da-vow-terminator-terminator-sgt-mastercraft-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <rules>
                    <rule name="Master-crafted Weapon" id="r40-da-vow-terminator-terminator-sgt-mastercraft-rule" hidden="false">
                      <description>Apply to one specific weapon; re-roll one failed To Hit roll with that weapon per player turn. Grenades and expendable equipment may not be Master-crafted.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="r40-da-vow-terminator-terminator-sgt-signum">
                  <constraints>
                    <constraint id="r40-da-vow-terminator-terminator-sgt-signum-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <rules>
                    <rule name="Signum" id="r40-da-vow-terminator-terminator-sgt-signum-rule" hidden="false">
                      <description>Once per friendly Shooting phase, the unit may re-roll one failed shooting To Hit roll. A unit may benefit from only one Signum per Shooting phase.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
              </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntryGroup>
