ue="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-group-2c4c1f6f6207-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r62-shat-assign-group-2c4c1f6f6207-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntryGroup></selectionEntryGroups>
      <categoryLinks>
        <categoryLink id="da22-deathwing-companions-cat" targetId="cat-elites" name="Elites" hidden="false" primary="true" />
      </categoryLinks>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Deathwing Terminator Companion Detachment" hidden="false" id="da22-deathwing-term-comp">
      <costs>
        <cost name="Points" typeId="pts" value="25" />
      </costs>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
          <condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
        </modifier>
      <modifier type="set" value="true" field="hidden" id="mod-r62-shat-1533f53c6efd">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-c75fbf58e1d6" shared="true" includeChildSelections="true" includeChildForces="false" />
          <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Deathwing Terminator Companion" typeId="prof-model" typeName="Model" hidden="false" id="da22-dwtc-prof">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">1</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">2</characteristic>
            <characteristic name="Ld" typeId="model-ld">9</characteristic>
            <characteristic name="Sv" typeId="model-sv">2+</characteristic>
          </characteristics>
        </profile>
        <profile name="Terminator Oathbearer" typeId="prof-model" typeName="Model" hidden="false" id="da22-dwtc-oath-prof">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">2</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">2</characteristic>
            <characteristic name="Ld" typeId="model-ld">10</characteristic>
            <characteristic name="Sv" typeId="model-sv">2+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Wargear" id="da22-dwtc-wg" hidden="false">
          <description>4 Terminator Companions + 1 Terminator Oathbearer. Entire unit chooses Tartaros or Cataphractii Terminator Armour at no additional cost. Combi-bolter and Calibanite Warblade.</description>
        </rule>
        <rule name="Special Rules" id="da22-dwtc-rules" hidden="false">
          <description>Legiones Astartes (Dark Angels); Deathwing (fixed); Stubborn; Death-sworn Companions; Deathwing Retinue.</description>
        </rule>
        <rule name="Deathwing Retinue" id="da22-dwtc-ret" hidden="false">
          <description>May replace a Legion Terminator Command Squad for an eligible Dark Angels Character wearing the same Terminator Armour pattern; no separate FOC slot.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Squad Size" hidden="false" id="da22-dwtc-extra-g" collective="false" import="true">
          <constraints>
            <constraint id="da22-dwtc-extra-g-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
            <constraint id="da22-dwtc-extra-g-r56-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="model" import="true" name="Terminator Companions" hidden="false" id="da22-dwtc-extra" defaultAmount="5">
              <costs>
                <cost name="Points" typeId="pts" value="40" />
              </costs>
              <constraints>
                <constraint id="da22-dwtc-extra-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
                <constraint id="da22-dwtc-extra-r56-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
              </constraints>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Terminator Armour Pattern" hidden="false" id="da22-dwtc-armour" collective="false" import="true">
          <constraints>
            <constraint id="da22-dwtc-armour-min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="da22-dwtc-armour-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <selectionEntries>
            <entryLink id="da22-dwtc-tart" name="Tartaros Terminator Armour" targetId="gear-hq-tartaros" type="selectionEntry" import="true" hidden="false"><constraints>
                <constraint id="da22-dwtc-tart-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </entryLink><entryLink id="da22-dwtc-cat" name="Cataphractii Terminator Armour" targetId="gear-hq-cataphractii" type="selectionEntry" import="true" hidden="false"><constraints>
                <constraint id="da22-dwtc-cat-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
            </entryLink></selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Calibanite Warblade Replacements" hidden="false" id="da22-dwtc-melee" collective="false" import="true">
          <constraints>
            <constraint id="da22-dwtc-melee-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <entryLinks>
            <entryLink import="true" name="Terranic Greatsword" hidden="false" id="da22-dwtc-terr" type="selectionEntry" targetId="da22-greatsword">
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <constraints>
                <constraint id="da22-dwtc-terr-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
            </entryLink>
            <entryLink import="true" name="Power Fist" hidden="false" id="da22-dwtc-fist" type="selectionEntry" targetId="gear-power-fist">
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
              <constraints>
                <constraint id="da22-dwtc-fist-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
            </entryLink>
            <entryLink import="true" name="Thunder Hammer" hidden="false" id="da22-dwtc-th" type="selectionEntry" targetId="gear-thunder">
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <constraints>
                <constraint id="da22-dwtc-th-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Replace both Combi-Bolter and Calibanite Warblade" hidden="false" id="da22-dwtc-pair" collective="false" import="true">
          <constraints>
            <constraint id="da22-dwtc-pair-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <entryLinks>
            <entryLink import="true" name="Pair of Lightning Claws" hidden="false" id="da22-dwtc-claws" type="selectionEntry" targetId="gear-pair-claws">
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <constraints>
                <constraint id="da22-dwtc-claws-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Combi-Bolter Replacements" hidden="false" id="da22-dwtc-ranged" collective="false" import="true">
          <constraints>
            <constraint id="da22-dwtc-ranged-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <entryLinks>
            <entryLink import="true" name="Combi-Flamer" hidden="false" id="da22-dwtc-cf" type="selectionEntry" targetId="gear-combi-flamer">
              <costs>
                <cost name="Points" typeId="pts" value="10" />
