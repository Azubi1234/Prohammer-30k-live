            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r40-da-serpent-assault-assault-standard-cs-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-serpent-assault-assault-standard-cs-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
