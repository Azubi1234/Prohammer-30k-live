          <entryLinks>
            <entryLink import="true" name="Land Raider (5 models)" hidden="false" id="da22-cen-lr" type="selectionEntry" targetId="hs-land-raider">
              <constraints>
                <constraint id="da22-cen-lr-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
            </entryLink>
            <entryLink import="true" name="Spartan Assault Tank (up to 10 models)" hidden="false" id="da22-cen-sp" type="selectionEntry" targetId="hs-spartan">
              <constraints>
                <constraint id="da22-cen-sp-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
            </entryLink>
          </entryLinks>
