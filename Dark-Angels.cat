    <selectionEntry type="unit" import="true" name="Legion Assault Squad (Storm of War compulsory)" hidden="true" id="r40-da-storm-assault">
      <rules>
        <rule name="Standard Wargear" id="r40-da-storm-assault-assault-standard-wargear" hidden="false">
          <description>Every model is equipped with Power Armour, a Bolt Pistol, a Chainsword, Frag Grenades and a Jump Pack.</description>
        </rule>
        <rule name="Power Armour" id="r40-da-storm-assault-assault-power-armour" hidden="false">
          <description>Models wearing Power Armour have a 3+ Armour Save.</description>
        </rule>
        <rule name="Legiones Astartes" id="r40-da-storm-assault-assault-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Frag Grenades" id="r40-da-storm-assault-assault-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
        <rule name="Jump Packs" id="r40-da-storm-assault-assault-jump-packs" hidden="false">
          <description>The squad is equipped with Jump Packs and is treated as Jump Infantry. It follows all normal ProHammer rules for Jump Infantry, including movement, terrain, Deep Strike, Fall Back movement and transport restrictions.</description>
        </rule>
        <rule id="r40-da-storm-assault-rite-rule" name="Storm of War — Compulsory Formation" hidden="false">
          <description>This Rite-specific entry represents a compulsory 20-model Stormwing Assault Squad. It may not select a Dedicated Transport.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink import="true" name="Bolt Pistol" hidden="false" id="r40-da-storm-assault-assault-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-standard-bp-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-standard-bp-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Chainsword" hidden="false" id="r40-da-storm-assault-assault-standard-cs" type="selectionEntry" targetId="gear-chainsword" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-standard-cs-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-standard-cs-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink id="r70-if-hammer-trans-1735" name="Teleportation Transponders — Hammerfall" type="selectionEntry" targetId="r64-if-gear-trans-unit" hidden="true" import="true">
          <constraints>
            <constraint id="r70-if-hammer-trans-1735-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r70-if-hammer-trans-show-1735" type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-vii-1-hammerfall-strike-force" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
        </entryLink>
      </entryLinks>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Assault Marine" hidden="false" id="r40-da-storm-assault-assault-marine" defaultAmount="9">
          <constraints>
            <constraint type="min" value="9" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-marine-min" includeChildSelections="false" />
            <constraint type="max" value="19" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-marine-max" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="18" />
          </costs>
          <profiles>
            <profile name="Legion Assault Marine" typeId="prof-model" typeName="Model" hidden="false" id="r40-da-storm-assault-prof-assault-marine">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">8</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        <modifiers><modifier id="r19-axis-max-r40-da-storm-assault-assault-marine" type="set" field="r40-da-storm-assault-assault-marine-min" value="19"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-xv-0-the-axis-of-dissolution" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers></selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Assault Sergeant" hidden="false" id="r40-da-storm-assault-assault-sergeant" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-sgt-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-sgt-max" includeChildSelections="false" automatic="true" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="18" />
          </costs>
          <profiles>
            <profile name="Legion Assault Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r40-da-storm-assault-prof-assault-sergeant">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Sergeant Armoury" id="r40-da-storm-assault-assault-rule-sgt-armoury" hidden="false">
              <description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. The Sergeant may carry no more than two weapons, only one of which may be two-handed. A pair of Lightning Claws counts as both weapon choices. No item may be selected more than once unless a unit entry specifically permits otherwise. Unit-specific replacement options are available at the points costs shown in this squad entry and are not repeated in the additional Armoury.</description>
            </rule>
          </rules>
          <selectionEntries>
            <entryLink id="r40-da-storm-assault-assault-sgt-pair-claws" name="Pair of Lightning Claws (replaces Bolt Pistol and Chainsword)" targetId="r41-universal-gear-a04af5f26d85b5" type="selectionEntry" import="true" hidden="false"><constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-sgt-pair-claws-max" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="20" />
              </costs>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="parent" childId="r40-da-storm-assault-assault-sgt-pistol" shared="true" includeChildSelections="true" />
                        <condition type="atLeast" value="1" field="selections" scope="parent" childId="r40-da-storm-assault-assault-sgt-melee" shared="true" includeChildSelections="true" />
                        <condition type="atLeast" value="1" field="selections" scope="parent" childId="r40-da-storm-assault-assault-sgt-armoury-weapons" shared="true" includeChildSelections="true" />
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
            </entryLink></selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup name="Replace Bolt Pistol" id="r40-da-storm-assault-assault-sgt-pistol" hidden="false">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-sgt-pistol-max" includeChildSelections="false" />
              </constraints>
              <modifiers>
                <modifier type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="parent" childId="r40-da-storm-assault-assault-sgt-pair-claws" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <entryLinks>
                <entryLink import="true" name="Volkite Serpenta" hidden="false" id="r40-da-storm-assault-assault-sgt-pistol-vs" type="selectionEntry" targetId="gear-volkite-serpenta">
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Hand Flamer" hidden="false" id="r40-da-storm-assault-assault-sgt-pistol-hf" type="selectionEntry" targetId="gear-hand-flamer">
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
