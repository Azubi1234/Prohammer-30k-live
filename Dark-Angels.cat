ces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-group-1ce86f69eca9-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r62-shat-assign-group-1ce86f69eca9-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntryGroup></selectionEntryGroups>
      <categoryLinks>
        <categoryLink id="r40-da-vow-veteran-cat" targetId="cat-troops" name="Troops" hidden="false" primary="true" />
