            <selectionEntry type="upgrade" import="true" name="Meltagun" hidden="false" id="r46-al-reward-49-donor-r41-unit-xvi-3-luperci-pack-opt-1-meltagun">
              <constraints>
                <constraint id="r46-al-reward-49-donor-r41-unit-xvi-3-luperci-pack-opt-1-meltagun-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
