        <selectionEntry id="r45-pech-ret-3-r71-nl-gen-7-stealth" name="Stealth Adept — whole squad" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="0" />
          </costs>
          <constraints>
            <constraint id="r45-pech-ret-3-r71-nl-gen-7-stealth-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <modifiers>
            <modifier id="r45-pech-ret-3-r71-nl-gen-7-stealth-cost-0" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r45-pech-ret-3-fa-seeker-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r45-pech-ret-3-r71-nl-gen-7-stealth-cost-1" type="increment" value="1" field="pts">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r45-pech-ret-3-fa-seeker-sgt" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" />
              </repeats>
            </modifier>
            <modifier id="r45-pech-ret-3-r71-nl-gen-7-stealth-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <rules>
            <rule id="r45-pech-ret-3-r71-nl-gen-7-stealth-rule" name="Stealth Adept — whole squad" hidden="false">
              <description>Every model in the unit gains Stealth. Models in Terminator Armour, Bikes, Jetbikes, Dreadnoughts and Vehicles are not eligible. An attached Independent Character must also possess Stealth Adept or the unit may not benefit while attached.

Stealth: Adds +1 to the value of Cover Saves conferred by terrain, to a maximum of 2+. If in the open, receives a 6+ Cover Save. Does not stack with Shrouded.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry id="r45-pech-ret-3-r71-nl-bj-8" name="Beyond Judgement — Trophies of Judgement &amp; Fear" type="upgrade" hidden="true" import="true">
          <costs>
            <cost name="Points" typeId="pts" value="25" />
          </costs>
          <constraints>
            <constraint id="r45-pech-ret-3-r71-nl-bj-8-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <rules>
            <rule id="r45-pech-ret-3-r71-nl-bj-8-rule" name="Beyond Judgement" hidden="false">
              <description>Every model is treated as equipped with Trophies of Judgement and the unit gains Fear. Measure the 8-inch Leadership penalty from any model. Trophies penalties are non-cumulative.

Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.</description>
            </rule>
          </rules>
          <modifiers>
            <modifier id="r45-pech-ret-3-r71-nl-bj-8-show" type="set" value="false" field="hidden">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" />
                    <condition type="atLeast" value="1" field="selections" scope="roster" childId="r25-rite-viii-1-horror-cult" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <rules>
        <rule name="Standard Wargear" id="r45-pech-ret-3-fa-seeker-std" hidden="false">
          <description>Power Armour; Bolter; Bolt Pistol; Frag Grenades; Special Issue Ammunition.</description>
        </rule>
        <rule name="Legiones Astartes" id="r45-pech-ret-3-fa-seeker-la" hidden="false">
          <description>Legiones Astartes; also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
        </rule>
        <rule name="Special Issue Ammunition" id="r45-pech-ret-3-fa-seeker-ammo-rule" hidden="false">
          <description>Whenever the squad fires Bolters, Foeblaster Boltguns or the bolter component of Combi-weapons, choose one ammunition type for all eligible models: Dragonfire, Hellfire, Kraken or Vengeance. Use the profiles shown below.</description>
        </rule>
      </rules>
