              </conditions>
            </modifier>
          </modifiers>
          <entryLinks>
            </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <rules>
        <rule id="r46-al-reward-5-donor-r57-iw-havoc-rule-1" name="Enhanced Targeting" hidden="false">
          <description>Iron Havocs have Ballistic Skill 5, as shown in their profile.</description>
        </rule>
