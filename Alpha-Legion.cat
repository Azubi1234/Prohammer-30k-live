          <rules>
            <rule id="r46-al-reward-5-donor-r57-iw-havoc-armoury" name="Sergeant Armoury" hidden="false">
              <description>The Iron Havoc Sergeant may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup id="r46-al-reward-5-donor-r57-iw-havoc-armoury-group" name="Iron Warriors Armoury" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="r46-al-reward-5-donor-r57-iw-havoc-armoury-group-shrapnel" name="Shrapnel Bolts" type="upgrade" hidden="false" import="true">
              <constraints>
                <constraint id="r46-al-reward-5-donor-r57-iw-havoc-armoury-group-shrapnel-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
