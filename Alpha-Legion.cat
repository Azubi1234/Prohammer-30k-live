name="Blessing of Nurgle" hidden="false"><description>All models gain +1 Toughness and Slow and Purposeful. Not available to Bikes, Jetbikes or Jump Infantry.

Slow and Purposeful: Relentless and always moves as if in Difficult Terrain.</description></rule></rules></selectionEntry><selectionEntry id="r45-pech-ret-3-fa-seeker-r32-blessing-tzeentch" name="Blessing of Tzeentch" type="upgrade" hidden="false" import="true"><constraints><constraint id="r45-pech-ret-3-fa-seeker-r32-blessing-tzeentch-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="8" /></costs><modifiers><modifier id="r45-pech-ret-3-fa-seeker-r32-blessing-tzeentch-scale" type="increment" field="pts" value="8"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r45-pech-ret-3-fa-seeker-included" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false" /></repeats></modifier></modifiers><rules><rule id="r45-pech-ret-3-fa-seeker-r32-blessing-tzeentch-rule" name="Blessing of Tzeentch" hidden="false"><description>All models gain a 5+ Invulnerable Save, or improve an existing Invulnerable Save by one step to a maximum of 4+.</description></rule></rules></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="r45-pech-ret-3-r43-rg-shar-seeker-group" name="Raven Guard Character Replacement" hidden="false"><constraints><constraint id="r45-pech-ret-3-r43-rg-shar-seeker-group-min" type="min" value="0" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /><constraint id="r45-pech-ret-3-r43-rg-shar-seeker-group-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints><selectionEntries><selectionEntry type="model" import="true" name="Nykona Sharrowkyn — replaces Seeker Sergeant" hidden="true" id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker">
      <rules><rule id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker-clone-r43-shar-wg" name="Wargear" hidden="false"><description>Artificer Armour, Refractor Field, Bolt Pistol, Sniper Rifle, Sudden Blade and Frag Grenades.</description></rule></rules><infoLinks><infoLink id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker-clone-r41-unit-xix-8-nykona-sharrowkyn-rg-surgical-strike" name="Surgical Strike" targetId="r43-rg-surgical-strike" type="rule" hidden="false" /><infoLink id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker-clone-r41-unit-xix-8-nykona-sharrowkyn-rg-rapid-reaction" name="Rapid Reaction" targetId="r43-rg-rapid-reaction" type="rule" hidden="false" /><infoLink id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker-clone-r41-unit-xix-8-nykona-sharrowkyn-rg-shadow-masters" name="Shadow Masters" targetId="r43-rg-shadow-masters" type="rule" hidden="false" /><infoLink id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker-clone-r41-unit-xix-8-nykona-sharrowkyn-rg-limited-vehicles" name="Limited Vehicles" targetId="r43-rg-limited-vehicles" type="rule" hidden="false" /><infoLink id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker-clone-r41-unit-xix-8-nykona-sharrowkyn-infiltrate" name="Infiltrate" targetId="r36-shared-infiltrate-88c13dc" type="rule" hidden="false" /><infoLink id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker-clone-r41-unit-xix-8-nykona-sharrowkyn-move-through-cover" name="Move Through Cover" targetId="r36-shared-move-through-cover-b95132d" type="rule" hidden="false" /><infoLink id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker-clone-r41-unit-xix-8-nykona-sharrowkyn-ghost-in-the-dark" name="Ghost in the Dark" targetId="r43-rg-ghost-in-the-dark" type="rule" hidden="false" /><infoLink id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker-clone-r41-unit-xix-8-nykona-sharrowkyn-perfect-ambusher" name="Perfect Ambusher" targetId="r43-rg-perfect-ambusher" type="rule" hidden="false" /><infoLink id="r45-pech-ret-3-r43-rg-sharrowkyn-seeker-clone-r43-shar-sudden" name="Sudden Blade" targetId="r43-rg-prof-sudden" type="profi