      <rules>
        <rule id="r63-sw-stalker-comp" name="Unit Composition" hidden="false">
          <description>4 Grey Stalkers and 1 Grey Stalker Huscarl; may include up to 10 additional Grey Stalkers (maximum 15 models). The Huscarl is a Character.</description>
        </rule>
        <rule id="r63-sw-stalker-wg" name="Wargear" hidden="false">
          <description>Power Armour, Bolter and Close-combat weapon.</description>
        </rule>
        <rule id="r63-sw-stalker-special" name="Special Rules" hidden="false">
          <description>Legiones Astartes (Space Wolves), Infiltrate, Move Through Cover, Night Vision.</description>
        </rule>
      </rules>
