              <selectionEntryGroup id="live-r2-fabius-enhanced-r63-sw-russ-honour-hq-praetor-ret-honour-group" name="Fabius Bile" hidden="false" collective="false" import="true"><selectionEntries><entryLink id="live-r2-fabius-enhanced-r63-sw-russ-honour-hq-praetor-ret-honour" name="Enhanced Warriors" targetId="r41-universal-gear-fee9d22f000bad" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="live-r2-fabius-enhanced-r63-sw-russ-honour-hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints><costs><cost name="Points" typeId="pts" value="0" /></costs><modifiers><modifier id="live-r2-fabius-enhanced-r63-sw-russ-honour-hq-praetor-ret-honour-scale-0" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r63-sw-russ-honour-hq-praetor-ret-honour-champ" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r63-sw-russ-honour-hq-praetor-ret-honour-scale-1" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r63-sw-russ-honour-hq-praetor-ret-honour-base" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r63-sw-russ-honour-hq-praetor-ret-honour-scale-2" type="increment" field="pts" value="3"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r63-sw-russ-honour-hq-praetor-ret-honour-land-land-raider-phobos" repeats="1" roundUp="false" /></repeats></modifier><modifier id="live-r2-fabius-enhanced-r63-sw-russ-honour-hq-praetor-ret-honour-scale-3" type="inc