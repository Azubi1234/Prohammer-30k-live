                <rule name="Squadron Composition" id="r63-sw-slayer-transport-lr-hs-lr-comp-rule" hidden="false">
                  <description>Dedicated Transport: select exactly one Land Raider pattern. Normal Transport Capacity restrictions apply.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Land Raider Patterns" id="r63-sw-slayer-transport-lr-hs-lr-patterns" hidden="false">
                  <constraints>
