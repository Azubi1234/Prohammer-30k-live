      <selectionEntryGroup id="r62-shat-assign-group-c69f8443158e" name="Shattered Legions — Assigned Legion" hidden="false"><selectionEntries><selectionEntry id="r62-shat-assign-28e355ca900a" name="Dark Angels" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-28e355ca900a-identity" name="Legiones Astartes (Dark Angels)" hidden="false"><description>This unit is assigned to Dark Angels for the Shattered Legions Theme. It uses the normal Dark Angels Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-28e355ca900a-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-i" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-28e355ca900a-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-cdee2cd53ecf" name="Emperor's Children" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-cdee2cd53ecf-identity" name="Legiones Astartes (Emperor's Children)" hidden="false"><description>This unit is assigned to Emperor's Children for the Shattered Legions Theme. It uses the normal Emperor's Children Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-cdee2cd53ecf-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-cons