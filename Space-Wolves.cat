      <rules>
        <rule id="r63-sw-hvarl-wg" name="Wargear" hidden="false">
          <description>Terminator Armour, Iron Halo, Heavy Bolter and the Red-Blade.</description>
        </rule>
        <rule id="r63-sw-hvarl-special" name="Special Rules" hidden="false">
          <description>Legiones Astartes (Space Wolves), Independent Character, Master of the Legion, Headsman.</description>
        </rule>
        <rule id="r63-sw-hvarl-redblade" name="Red-Blade" hidden="false">
          <description>Two-Handed Power Weapon. The bearer has +2 Strength and suffers -1 Initiative while using it.</description>
        </rule>
        <rule id="r63-sw-hvarl-headsman" name="Headsman" hidden="false">
          <description>At the start of an Assault phase, if Hvarl is engaged with one or more enemy Independent Characters, nominate one. Hvarl must attack that character if able and may re-roll failed To Wound rolls against enemy Independent Characters.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup id="r63-sw-hvarl-retinue" name="Retinue" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="r63-sw-hvarl-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="unit" name="Legion Terminator Command Squad" id="r63-sw-hvarl-term-hq-praetor-ret-termcommand" hidden="false" import="true">
              <constraints>
                <constraint id="r63-sw-hvarl-term-hq-praetor-ret-termcommand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="215" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="r63-sw-hvarl-term-hq-praetor-ret-tc-std" hidden="false">
                  <description>Five Terminator Veterans, each equipped with the selected Terminator Armour pattern, a Combi-Bolter and a Power Weapon.</description>
                </rule>
                <rule name="Legiones Astartes" id="r63-sw-hvarl-term-hq-praetor-ret-tc-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.

And They Shall Know No Fear: Automatically passes Regroup tests at the start of the turn and may be used normally for the rest of the turn. If caught by a pursuit, the unit automatically regroups and is re-engaged in close combat, and does not suffer extra wounds from being caught in a pursuit. Immune to Fear.
Fear: Enemy units in base contact must pass a Leadership test before resolving their close combat attacks. If the test fails, those units attack with WS1 in the melee engagement.
Fearless: Automatically passes all Morale and Pinning tests. May not Take Cover! or choose to voluntarily fail a break test.</description>
                </rule>
                <rule name="Retinue" id="r63-sw-hvarl-term-hq-praetor-ret-tc-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character equipped with Terminator, Tartaros or Cataphractii Terminator Armour. It occupies no separate Force Organisation slot; the character and squad count as one HQ selection but may deploy and operate separately.</description>
                </rule>
              </rules>
