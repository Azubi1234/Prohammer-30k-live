          <characteristics>
            <characteristic name="WS" typeId="walker-ws">5</characteristic>
            <characteristic name="BS" typeId="walker-bs">5</characteristic>
            <characteristic name="S" typeId="walker-s">6</characteristic>
            <characteristic name="Front" typeId="walker-front">12</characteristic>
            <characteristic name="Side" typeId="walker-side">12</characteristic>
            <characteristic name="Rear" typeId="walker-rear">10</characteristic>
            <characteristic name="I" typeId="walker-i">4</characteristic>
            <characteristic name="A" typeId="walker-a">3</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="r63-sw-bjorn-type" name="Unit Type" hidden="false">
          <description>Vehicle (Walker).</description>
        </rule>
        <rule id="r63-sw-bjorn-wg" name="Wargear" hidden="false">
          <description>Assault Cannon; Dreadnought Close Combat Weapon with built-in Heavy Flamer; Smoke Launchers; Searchlight.</description>
        </rule>
        <rule id="r63-sw-bjorn-old" name="Old and Wise" hidden="false">
          <description>If the mission uses a roll to determine who takes the first turn, a Space Wolves army containing Björn may re-roll that roll once. The second result stands.</description>
        </rule>
        <rule id="r63-sw-bjorn-hard" name="Hard to Kill" hidden="false">
          <description>Whenever a Glancing or Penetrating hit against Björn is rolled on the Vehicle Damage table, the Space Wolves player may force the opponent to re-roll that Damage result. The second result stands.</description>
        </rule>
      </rules>
    </selectionEntry>
