                    <constraint id="r63-sw-slayer-transport-lr-hs-lr-patterns-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="model" name="Land Raider Phobos" id="r63-sw-slayer-transport-lr-hs-lr-phobos" hidden="false" import="true" defaultAmount="1">
                      <constraints>
