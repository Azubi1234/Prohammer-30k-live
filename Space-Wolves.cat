      <rules>
        <rule id="r63-sw-ohthere-wg" name="Wargear" hidden="false">
          <description>Runic Armour, Bolt pistol, Runic Staff and Frag grenades.</description>
        </rule>
        <rule id="r63-sw-ohthere-special" name="Special Rules" hidden="false">
          <description>Legiones Astartes (Space Wolves), Independent Character, Psyker (Mastery Level 2), Legion Support Officer.</description>
        </rule>
        <rule id="r63-sw-ohthere-staff" name="Runic Staff" hidden="false">
          <description>Counts as a Force Weapon and a Psychic Hood.</description>
        </rule>
        <rule id="r63-sw-ohthere-winds" name="Mystic Winds of Fenris" hidden="false">
          <description>Blessing — Ohthere or one friendly Space Wolves unit with at least one model within 6 inches. On a successful Psychic Test, the nominated unit receives a 5+ Cover Save until the beginning of the next Space Wolves turn; improve an existing Cover Save by 1, to a maximum of 4+.</description>
        </rule>
        <rule id="r63-sw-ohthere-lightning-rule" name="Living Lightning" hidden="false">
          <description>Psychic Shooting Power. Resolve a successful manifestation using the Living Lightning weapon profile.</description>
        </rule>
      </rules>
