          <selectionEntries>
            <entryLink id="r63-sw-slayer-power" name="Power weapon" targetId="gear-power-weapon" type="selectionEntry" import="true" hidden="false"><constraints>
                <constraint id="r63-sw-slayer-power-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              </entryLink><selectionEntry id="r63-sw-slayer-frost" name="Frost Blade or Frost Axe" type="upgrade" hidden="false" import="true">
              <costs>
                <cost name="Points" typeId="pts" value="15" />
