      </constraints>
      <profiles>
        <profile name="Leman Russ" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-vi-11-vi-leman-russ-the-wolf-king-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">8</characteristic>
