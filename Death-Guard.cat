      <profiles>
        <profile name="Ignatius Grulgor" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xiv-6-ignatius-grulgor-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">6</characteristic>
            <characteristic name="BS" typeId="model-bs">5</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">3</characteristic>
            <characteristic name="I" typeId="model-i">5</characteristic>
            <characteristic name="A" typeId="model-a">3</characteristic>
            <characteristic name="Ld" typeId="model-ld">10</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+/5+</characteristic>
