                  <constraints>
                    <constraint id="live-r2-r41-unit-xiv-3-calas-typhon-first-captain-retinue-1-r73-nl-bj-11-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" />
