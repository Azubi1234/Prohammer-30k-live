      <rules>
        <rule name="Source Entry" id="r41-unit-xiv-0-deathshroud-terminators-source" hidden="true">
          <description>Deathshroud | 5 | 4 | 4 | 4 | 2 | 4 | 2 | 9 | 2+/5+
SILENT RETINUE A Death Guard character who would normally be permitted to select a Legion Terminator Command Squad may instead select one Deathshroud Terminator Squad as his retinue. The Deathshroud do not occupy a separate Force Organisation slot. The character and Deathshroud count as a single HQ selection.
Force Organisation:
• Elites
Unit Composition:
• 2 Deathshroud Terminators
Unit Type:
• Infantry
Wargear:
• Terminator Armour
• Manreaper
• Alchem Flamer
Special Rules:
• Legiones Astartes (Death Guard)
• Fearless
• Silent Retinue
OPTIONS
• The squad may include up to five additional Deathshroud Terminators for +55 points per model.
• The entire squad may exchange its Terminator Armour for Cataphractii Terminator Armour at no additional cost.
If this option is selected, the squad instead has a 2+/4+ Save and follows all normal rules and restrictions for Cataphractii Terminator Armour.
• The entire squad may take:
• Melta bombs .............................. +5 points per model
DEDICATED TRANSPORT
The squad may select a Land Raider, Dreadclaw Drop Pod or Spartan Assault Tank where Transport Capacity permits.</description>
        </rule>
      <rule id="r11-dg-ds-silent" name="Silent Retinue" hidden="false"><description>A Death Guard character who would normally be permitted to select a Legion Terminator Command Squad may instead select one Deathshroud Terminator Squad as his retinue. It occupies no separate Force Organisation slot.</description></rule><rule id="r11-dg-ds-wargear" name="Wargear" hidden="false"><description>Terminator Armour; Manreaper; Alchem Flamer.</description></rule></rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Squad Models" hidden="false" id="r41-unit-xiv-0-deathshroud-terminators-additional" defaultAmount="2">
          <constraints>
            <constraint id="r41-unit-xiv-0-deathshroud-terminators-additional-max" field="selections" scope="parent" value="7" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
            <constraint id="r41-unit-xiv-0-deathshroud-terminators-additional-min-total" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="55" />
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Options" hidden="false" id="r41-unit-xiv-0-deathshroud-terminators-options" collective="false" import="true">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Melta bombs — entire squad (+5 pts/model)" hidden="false" id="r41-unit-xiv-0-deathshroud-terminators-opt-0-melta-bombs">
              <constraints>
                <constraint id="r41-unit-xiv-0-deathshroud-terminators-opt-0-melta-bombs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <infoLinks><infoLink id="r36-link-7e5606db338a" name="Whole-squad Melta Bombs" hidden="false" targetId="r36-exact-whole-squad-melta-bombs-9e41e7a" type="rule" /></infoLinks><costs>
                <cost name="Points" typeId="pts" value="0" />
              </costs>
              <rules>
                <rule name="Option restriction" id="r41-unit-xiv-0-deathshroud-terminators-opt-0-context" hidden="false">
                  <description>• The entire squad may take:</description>
                </rule>
                <rule name="Squad-wide cost note" id="r41-unit-xiv-0-deathshroud-terminators-opt-0-squadwide" hidden="false">
                  <description>The source prices this option at +5 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</description>
                </rule>
              </rules>
            <modifiers><modifier id="r11-dg-ds-melta-scale" type="increment" field="pts" value="5"><repeats><repeat field="selections" scope="root-entry" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="r41-unit-xiv-0-deathshroud-terminators-additional" repeats="1" roundUp="false" /></repeats></modifier></modifiers></selectionEntry>
          <entryLink id="r11-dg-deathshroud-cataphractii" name="Exchange entire squad’s Terminator Armour for Cataphractii Terminator Armour — Free" targetId="r41-universal-gear-54b6d66012b244" type="selectionEntry" import="true" hidden="false"><constraints><constraint id="r11-dg-deathshroud-cataphractii-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></constraints></entryLink></selectionEntries>
        </selectionEntryGroup>
