                  <description>The source prices this option at +2 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</description>
                </rule>
              <rule id="r11-dg-mp-krak-rule" name="Whole-squad upgrade" hidden="false"><description>Every model in the squad takes Krak grenades for +2 points per model. The cost scales with squad size.</description></rule></rules>
