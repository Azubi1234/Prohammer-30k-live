      <profiles>
        <profile name="Mortarion" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xiv-8-xiv-mortarion-the-reaper-profile-0">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">7</characteristic>
            <characteristic name="BS" typeId="model-bs">6</characteristic>
            <characteristic name="S" typeId="model-s">6</characteristic>
            <characteristic name="T" typeId="model-t">7</characteristic>
            <characteristic name="W" typeId="model-w">6</characteristic>
