      <profiles>
        <profile name="Deathshroud" typeId="prof-model" typeName="Model" hidden="false" id="live-r2-r41-unit-xiv-3-calas-typhon-first-captain-retinue-0-r41-unit-xiv-0-deathshroud-terminators-profile-0">
