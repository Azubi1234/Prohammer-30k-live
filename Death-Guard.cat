            <constraint id="r11-dg-mortarion-deathshroud-r41-unit-xiv-0-deathshroud-terminators-additional-max" field="selections" scope="parent" value="7" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
            <constraint id="r11-dg-mortarion-deathshroud-r41-unit-xiv-0-deathshroud-terminators-additional-min-total" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" />
          </constraints>
          <costs>
