                  <modifier id="live-r2-r41-unit-xiv-5-durak-rask-retinue-0-r71-nl-gen-10-stealth-show-r62-shat-d4f53c90e71c" type="set" value="false" field="hidden">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r62-shat-assign-47420821f3bf" shared="true" includeChildSelections="true" includeChildForces="false" />
                          <condition type="atLeast" value="1" field="selections" scope="roster" childId="r62-shattered-theme" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions>
