pe="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-866c798c3098-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-b03f7a328bc7" name="Sons of Horus" type="upgrade" hidden="false"><rules><rule id="r62-shat-assign-b03f7a328bc7-identity" name="Legiones Astartes (Sons of Horus)" hidden="false"><description>This unit is assigned to Sons of Horus for the Shattered Legions Theme. It uses the normal Sons of Horus Legion rules and may purchase Legion-specific wargear/options which would normally be legal for this unit or its models. Rules belonging to another constituent Legion do not apply.</description></rule></rules><modifiers><modifier id="r62-shat-assign-b03f7a328bc7-hide-not-const" type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="roster" childId="r62-shat-const-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /></conditions></modifier></modifiers><constraints><constraint id="r62-shat-assign-b03f7a328bc7-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" includeChildForces="false" /></constraints></selectionEntry><selectionEntry id="r62-shat-assign-3f4c6fa57d64" name="Word Bearers" type="upgrade" hidden="false"><infoLinks><infoLink id="r62-shat-assign-3f4c6fa57d64-info-b38798b65544" name="And They Shall Know No Fear" targetId="r36-shared-and-they-shall-know-no-fear-c9d3c20" type="rule" hidden="false" /><infoLink id="r62-shat-assign-3f4c6fa57d64-info-a7919070e2c7" name="Fanatical Devotion" targetId="r37-wb-rule-fanatical-devotion" type="rule" hidden="false" /><infoLink id="r62-shat-assign-3f4c6