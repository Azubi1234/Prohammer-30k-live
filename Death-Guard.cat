              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="2" />
              </costs>
              <rules>
                <rule name="Option restriction" id="r41-unit-xiv-5-durak-rask-opt-0-context" hidden="false">
                  <description>• Durak Rask may take:</description>
                </rule>
