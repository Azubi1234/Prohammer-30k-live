      <selectionEntryGroup name="Poison-master — Additional Armoury (max 50 pts)" id="r11-dg-mp-master-destroyer-sgt-armoury" hidden="false">
              <constraints>
                <constraint id="r11-dg-mp-master-destroyer-sgt-armoury-pts-max" type="max" value="50" field="pts" scope="parent" shared="true" includeChildSelections="true" />
              </constraints>
              <entryLinks>
                </entryLinks>
              <rules>
                <rule name="Sergeant Armoury Restrictions" id="r11-dg-mp-master-destroyer-sgt-arm-rule" hidden="false">
                  <description>Unit-specific Chainsword replacements and standard equipment are not duplicated here. No item may be selected more than once unless specifically permitted. A Pair of Lightning Claws counts as two weapon choices. Artificer Armour is not present in the current Destroyer Sergeant entry and is therefore not offered.</description>
                </rule>
              </rules>
            </selectionEntryGroup>
